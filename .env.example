# second-brain 비용 라우팅 설정 (R4 엔진이 사용. R1~R3 레일은 이 파일 없이도 동작)
# llm-wiki(lib/anthropic.ts providerFor / lib/cost.ts)의 env 규약을 일반화.
# 실제 값은 .env 에 넣고, .env 는 커밋 금지(.gitignore 등록됨).

# ── 전역 기본 프로바이더 ─────────────────────────────
# 우선순위: 단계별(TIER) 지정 > LLM_PROVIDER > default(아래 model-tiers.yaml default_tier)
LLM_PROVIDER=

# ── 티어별 라우팅 (rails/model-tiers.yaml 의 tier 와 매칭) ──
# judgment = 판단 중요 소수 단계(유료 Claude 소액), bulk = 대량/지루(무료)
JUDGMENT_PROVIDER=anthropic
JUDGMENT_MODEL=claude-opus-4-8
BULK_PROVIDER=ollama
BULK_MODEL=qwen3:8b

# ── 프로바이더별 키/엔드포인트 ──────────────────────
# Anthropic (유료) — judgment 단계용. 비활성 시 ANTHROPIC_ENABLED 비움
ANTHROPIC_API_KEY=
ANTHROPIC_ENABLED=

# Ollama (무료·로컬) — bulk 단계 기본
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen3:8b

# Google Gemini (무료 등급·외부) — bulk fallback.
# ⚠️ 무료 등급은 입력을 Google이 학습에 사용. 민감자료 금지.
GEMINI_API_KEY=

# ── 비용 가드 ──────────────────────────────────────
# 프로젝트/일 단위 토큰 상한. 비우면 무제한. (R4에서 강제)
DAILY_TOKEN_LIMIT=
