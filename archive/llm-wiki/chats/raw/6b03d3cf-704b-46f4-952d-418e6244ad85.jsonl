{"parentUuid":"594f4dc0-a6a9-400e-89dc-423a6cec5f0a","isSidechain":false,"promptId":"72c47ca9-455c-407a-8764-3ca32f2b9ca5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018YBYDNgE5cewj2VzrDfurL","type":"tool_result","content":"1\timport { NextResponse } from \"next/server\";\n2\timport { getSessionUser } from \"@/lib/auth/session\";\n3\timport { allowedScopes, scopeWikiPrefix } from \"@/lib/acl/scope\";\n4\timport { prisma } from \"@/lib/db\";\n5\timport { analyzeSource, fileSourceAsIs } from \"@/lib/ingest\";\n6\timport { resolveIngestModel, recommendIngestModel } from \"@/lib/models\";\n7\timport { isTranscribedExtractor } from \"@/lib/stt\";\n8\timport { checkDailyBudget, budgetExceededMessage } from \"@/lib/cost\";\n9\timport { beginInflight, endInflight } from \"@/lib/inflight\";\n10\timport { enqueueIngest, shouldRunAsync } from \"@/lib/queue\";\n11\t\n12\t// 스테이징된 자료를 ★실행★ — mode:\"llm\"=LLM 분석(토큰), mode:\"raw\"=원본 그대로 파일링(토큰 0).\n13\texport const runtime = \"nodejs\";\n14\texport const maxDuration = 600; // 무거운 자료를 추론 모델(claude/codex)이 분석할 때 길어질 수 있음(타임아웃 600초와 정렬)\n15\t\n16\texport async function POST(req: Request, { params }: { params: Promise<{ id: string }> }) {\n17\t  const user = await getSessionUser();\n18\t  if (!user) return NextResponse.json({ error: \"로그인이 필요합니다.\" }, { status: 401 });\n19\t  const id = Number((await params).id);\n20\t  if (!Number.isInteger(id) || id <= 0) return NextResponse.json({ error: \"잘못된 id입니다.\" }, { status: 400 });\n21\t\n22\t  const source = await prisma.source.findUnique({ where: { id } });\n23\t  if (!source) return NextResponse.json({ error: \"자료를 찾을 수 없습니다.\" }, { status: 404 });\n24\t  // ACL: 접근 가능한 scope의 자료만(인제스트 적용 강제지점).\n25\t  const allowed = new Set((await allowedScopes(user)).map((s) => scopeWikiPrefix(s.id)));\n26\t  if (!allowed.has(source.teamScope)) return NextResponse.json({ error: \"접근 권한이 없습니다.\" }, { status: 403 });\n27\t\n28\t  const { mode, model, reanalyze, reTranscribe, diarize, meeting } = await req.json().catch(() => ({}));\n29\t  try {\n30\t    if (mode === \"raw\") {\n31\t      // 토큰 0 — 이미 정리된 텍스트를 위키 페이지로 직접 파일링.\n32\t      return NextResponse.json(await fileSourceAsIs(id));\n33\t    }\n34\t    // mode \"llm\"(기본): 비용 상한 체크 후 실제 LLM 인제스트.\n35\t    const budget = await checkDailyBudget(user.id, source.teamScope);\n36\t    if (budget.exceeded) {\n37\t      return NextResponse.json({ error: budgetExceededMessage(budget) }, { status: 429 });\n38\t    }\n39\t    // ★다시 분석★: 이미 분석된 자료를 재분석할 때, 기존 잡을 지워 ingestText의 dedup(SKIPPED_DUP)을 우회해\n40\t    //   실제 재인제스트가 돌게 한다. (증강 재실행은 원본의 '관련 분석' 섹션을 멱등하게 갱신.)\n41\t    if (reanalyze) await prisma.ingestJob.deleteMany({ where: { sourceId: id } });\n42\t    // ★음성 재분석/재처리는 raw에서 재전사★ — 저장된 (나쁜/끊긴) 전사문을 비워 analyzeSource가 raw로 다시 전사하게 한다.\n43\t    //   (첫 분석은 reanalyze·reTranscribe 둘 다 false라 업로드 전사문을 그대로 씀 — 이중 전사 방지.)\n44\t    if ((reanalyze || reTranscribe) && isTranscribedExtractor(source.extractor)) {\n45\t      await prisma.source.update({ where: { id }, data: { normalizedPath: null } }).catch(() => {});\n46\t    }\n47\t    // 모델 선택: 사용자가 셀렉트박스에서 ★직접 고른 경우만★ 그 모델을 쓰고, 아니면(자동) ★자료 형식 기반 추천★.\n48\t    //   → 신규 업로드뿐 아니라 ★재처리·원본추가★도 자료(확장자)에 맞는 최적 모델로 자동 분석된다(PDF·표·텍스트별).\n49\t    let picked: { model: string; provider: string; think: boolean };\n50\t    if (typeof model === \"string\" && model) {\n51\t      picked = await resolveIngestModel(model);\n52\t    } else {\n53\t      // ★전사 소스(extractor groq-/gemini-)는 byteSize가 '오디오 바이트'라 텍스트 길이가 아님 → 크기 휴리스틱 제외★\n54\t      //   (안 그러면 모든 음성이 '큰 자료'로 오인돼 유료 추론 모델로 자동 라우팅됨). 표시 추천과도 일치.\n55\t      const transcribed = isTranscribedExtractor(source.extractor);\n56\t      const reco = await recommendIngestModel({ type: source.type, chars: transcribed ? undefined : (source.byteSize ?? undefined), transcribed });\n57\t      picked = { model: reco.model, provider: reco.provider, think: false };\n58\t    }\n59\t    // ★L2 비동기 큐(ship-dark)★: INGEST_ASYNC=true면 무거운 분석을 백그라운드 워커로 넘기고 즉시 반환한다.\n60\t    //   QUEUED 추적 잡을 만들어 enqueue → 워커가 reuse 모드로 in-place 갱신(QUEUED→RUNNING→APPLIED).\n61\t    //   enqueue 실패(boss 없음 등)면 추적 잡을 지우고 ★아래 동기 경로로 폴백★(플래그 OFF와 동일 동작).\n62\t    if (shouldRunAsync({ INGEST_ASYNC: process.env.INGEST_ASYNC }, mode)) {\n63\t      const queuedJob = await prisma.ingestJob.create({\n64\t        data: { sourceId: id, teamScope: source.teamScope, status: \"QUEUED\", model: picked.model, phase: \"대기 중\" },\n65\t      });\n66\t      const ok = await enqueueIngest({\n67\t        ingestJobId: queuedJob.id, sourceId: id,\n68\t        model: picked.model, provider: picked.provider, think: picked.think,\n69\t        diarize: !!diarize, meeting: !!meeting, userId: user.id,\n70\t      });\n71\t      if (ok) return NextResponse.json({ queued: true, jobId: queuedJob.id });\n72\t      await prisma.ingestJob.delete({ where: { id: queuedJob.id } }).catch(() => {}); // 폴백 전 추적 잡 정리\n73\t    }\n74\t    // ★원본 보존 + 그래프 증강★: 원본이 이미 topic으로 보존돼 있으면 analyzeSource가 증강 모드로 처리(원본 유지,\n75\t    //   entities/concepts만 추가, 원본엔 링크만 덧붙임).\n76\t    // 취소: req.signal(클라 abort) + 서버측 in-flight 컨트롤러를 함께 사용한다. nginx 뒤에서 req.signal이\n77\t    //   발화하지 않아도, /cancel 엔드포인트가 이 컨트롤러를 직접 abort해 LLM 서브프로세스까지 중단을 전파한다.\n78\t    const inflight = beginInflight(\"analyze\", id, user.id, source.teamScope, req.signal);\n79\t    try {\n80\t      const result = await analyzeSource(id, { model: picked.model, provider: picked.provider, think: picked.think, signal: inflight.signal, diarize: !!diarize, meeting: !!meeting });\n81\t      return NextResponse.json(result);\n82\t    } finally {\n83\t      endInflight(\"analyze\", id, inflight);\n84\t    }\n85\t  } catch (err) {\n86\t    return NextResponse.json({ error: String(err) }, { status: 500 });\n87\t  }\n88\t}\n89\t"}]},"uuid":"1e2ee0a3-1e15-442f-bec4-a5a4646fd223","timestamp":"2026-06-28T11:14:34.289Z","toolUseResult":{"type":"text","file":{"filePath":"E:\\llm-wiki\\app\\api\\materials\\[id]\\analyze\\route.ts","content":"import { NextResponse } from \"next/server\";\nimport { getSessionUser } from \"@/lib/auth/session\";\nimport { allowedScopes, scopeWikiPrefix } from \"@/lib/acl/scope\";\nimport { prisma } from \"@/lib/db\";\nimport { analyzeSource, fileSourceAsIs } from \"@/lib/ingest\";\nimport { resolveIngestModel, recommendIngestModel } from \"@/lib/models\";\nimport { isTranscribedExtractor } from \"@/lib/stt\";\nimport { checkDailyBudget, budgetExceededMessage } from \"@/lib/cost\";\nimport { beginInflight, endInflight } from \"@/lib/inflight\";\nimport { enqueueIngest, shouldRunAsync } from \"@/lib/queue\";\n\n// 스테이징된 자료를 ★실행★ — mode:\"llm\"=LLM 분석(토큰), mode:\"raw\"=원본 그대로 파일링(토큰 0).\nexport const runtime = \"nodejs\";\nexport const maxDuration = 600; // 무거운 자료를 추론 모델(claude/codex)이 분석할 때 길어질 수 있음(타임아웃 600초와 정렬)\n\nexport async function POST(req: Request, { params }: { params: Promise<{ id: string }> }) {\n  const user = await getSessionUser();\n  if (!user) return NextResponse.json({ error: \"로그인이 필요합니다.\" }, { status: 401 });\n  const id = Number((await params).id);\n  if (!Number.isInteger(id) || id <= 0) return NextResponse.json({ error: \"잘못된 id입니다.\" }, { status: 400 });\n\n  const source = await prisma.source.findUnique({ where: { id } });\n  if (!source) return NextResponse.json({ error: \"자료를 찾을 수 없습니다.\" }, { status: 404 });\n  // ACL: 접근 가능한 scope의 자료만(인제스트 적용 강제지점).\n  const allowed = new Set((await allowedScopes(user)).map((s) => scopeWikiPrefix(s.id)));\n  if (!allowed.has(source.teamScope)) return NextResponse.json({ error: \"접근 권한이 없습니다.\" }, { status: 403 });\n\n  const { mode, model, reanalyze, reTranscribe, diarize, meeting } = await req.json().catch(() => ({}));\n  try {\n    if (mode === \"raw\") {\n      // 토큰 0 — 이미 정리된 텍스트를 위키 페이지로 직접 파일링.\n      return NextResponse.json(await fileSourceAsIs(id));\n    }\n    // mode \"llm\"(기본): 비용 상한 체크 후 실제 LLM 인제스트.\n    const budget = await checkDailyBudget(user.id, source.teamScope);\n    if (budget.exceeded) {\n      return NextResponse.json({ error: budgetExceededMessage(budget) }, { status: 429 });\n    }\n    // ★다시 분석★: 이미 분석된 자료를 재분석할 때, 기존 잡을 지워 ingestText의 dedup(SKIPPED_DUP)을 우회해\n    //   실제 재인제스트가 돌게 한다. (증강 재실행은 원본의 '관련 분석' 섹션을 멱등하게 갱신.)\n    if (reanalyze) await prisma.ingestJob.deleteMany({ where: { sourceId: id } });\n    // ★음성 재분석/재처리는 raw에서 재전사★ — 저장된 (나쁜/끊긴) 전사문을 비워 analyzeSource가 raw로 다시 전사하게 한다.\n    //   (첫 분석은 reanalyze·reTranscribe 둘 다 false라 업로드 전사문을 그대로 씀 — 이중 전사 방지.)\n    if ((reanalyze || reTranscribe) && isTranscribedExtractor(source.extractor)) {\n      await prisma.source.update({ where: { id }, data: { normalizedPath: null } }).catch(() => {});\n    }\n    // 모델 선택: 사용자가 셀렉트박스에서 ★직접 고른 경우만★ 그 모델을 쓰고, 아니면(자동) ★자료 형식 기반 추천★.\n    //   → 신규 업로드뿐 아니라 ★재처리·원본추가★도 자료(확장자)에 맞는 최적 모델로 자동 분석된다(PDF·표·텍스트별).\n    let picked: { model: string; provider: string; think: boolean };\n    if (typeof model === \"string\" && model) {\n      picked = await resolveIngestModel(model);\n    } else {\n      // ★전사 소스(extractor groq-/gemini-)는 byteSize가 '오디오 바이트'라 텍스트 길이가 아님 → 크기 휴리스틱 제외★\n      //   (안 그러면 모든 음성이 '큰 자료'로 오인돼 유료 추론 모델로 자동 라우팅됨). 표시 추천과도 일치.\n      const transcribed = isTranscribedExtractor(source.extractor);\n      const reco = await recommendIngestModel({ type: source.type, chars: transcribed ? undefined : (source.byteSize ?? undefined), transcribed });\n      picked = { model: reco.model, provider: reco.provider, think: false };\n    }\n    // ★L2 비동기 큐(ship-dark)★: INGEST_ASYNC=true면 무거운 분석을 백그라운드 워커로 넘기고 즉시 반환한다.\n    //   QUEUED 추적 잡을 만들어 enqueue → 워커가 reuse 모드로 in-place 갱신(QUEUED→RUNNING→APPLIED).\n    //   enqueue 실패(boss 없음 등)면 추적 잡을 지우고 ★아래 동기 경로로 폴백★(플래그 OFF와 동일 동작).\n    if (shouldRunAsync({ INGEST_ASYNC: process.env.INGEST_ASYNC }, mode)) {\n      const queuedJob = await prisma.ingestJob.create({\n        data: { sourceId: id, teamScope: source.teamScope, status: \"QUEUED\", model: picked.model, phase: \"대기 중\" },\n      });\n      const ok = await enqueueIngest({\n        ingestJobId: queuedJob.id, sourceId: id,\n        model: picked.model, provider: picked.provider, think: picked.think,\n        diarize: !!diarize, meeting: !!meeting, userId: user.id,\n      });\n      if (ok) return NextResponse.json({ queued: true, jobId: queuedJob.id });\n      await prisma.ingestJob.delete({ where: { id: queuedJob.id } }).catch(() => {}); // 폴백 전 추적 잡 정리\n    }\n    // ★원본 보존 + 그래프 증강★: 원본이 이미 topic으로 보존돼 있으면 analyzeSource가 증강 모드로 처리(원본 유지,\n    //   entities/concepts만 추가, 원본엔 링크만 덧붙임).\n    // 취소: req.signal(클라 abort) + 서버측 in-flight 컨트롤러를 함께 사용한다. nginx 뒤에서 req.signal이\n    //   발화하지 않아도, /cancel 엔드포인트가 이 컨트롤러를 직접 abort해 LLM 서브프로세스까지 중단을 전파한다.\n    const inflight = beginInflight(\"analyze\", id, user.id, source.teamScope, req.signal);\n    try {\n      const result = await analyzeSource(id, { model: picked.model, provider: picked.provider, think: picked.think, signal: inflight.signal, diarize: !!diarize, meeting: !!meeting });\n      return NextResponse.json(result);\n    } finally {\n      endInflight(\"analyze\", id, inflight);\n    }\n  } catch (err) {\n    return NextResponse.json({ error: String(err) }, { status: 500 });\n  }\n}\n","numLines":89,"startLine":1,"totalLines":89}},"sourceToolAssistantUUID":"594f4dc0-a6a9-400e-89dc-423a6cec5f0a","userType":"external","entrypoint":"cli","cwd":"E:\\llm-wiki","sessionId":"6b03d3cf-704b-46f4-952d-418e6244ad85","version":"2.1.195","gitBranch":"feat/backlog-chunked-and-storage","slug":"serene-singing-papert"}
