{"parentUuid":"96fa7b06-aee4-40eb-859b-e7febccab5e9","isSidechain":false,"message":{"model":"claude-opus-4-8","id":"msg_01CrBwDfZi7TRM9LcWbWG1oU","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LKk2o2S2mHx5fddyhRNn99","name":"Write","input":{"file_path":"E:\\llm-wiki\\lib\\materials\\stage.ts","content":"import { NextResponse } from \"next/server\";\nimport { getSessionUser } from \"@/lib/auth/session\";\nimport { assertScopeAllowed, scopeWikiPrefix } from \"@/lib/acl/scope\";\nimport { storeForAnalysis, storeRawOnly } from \"@/lib/ingest\";\nimport { extractAsset, SUPPORTED_EXTS, STT_EXTS } from \"@/lib/extract\";\nimport { STT_FFMPEG_EXTS, sttAvailable, sttAsync, isTranscribedExtractor } from \"@/lib/stt\";\nimport { CONVERT_ONLY_EXTS, libreOfficeAvailable, ffmpegAvailable } from \"@/lib/convert\";\nimport { uploadPolicyForModel } from \"@/lib/uploadPolicy\";\nimport { resolveIngestModel, recommendIngestModel } from \"@/lib/models\";\n\n// 업로드 스테이징 공유 코어 — multipart·raw-body 스트리밍·★청크/resumable★(app/api/materials/upload) 세 진입점이\n//   ★같은 게이팅·추출·보관 불변식★을 공유한다(전수 점검 원칙 [[sweep-all-dont-claim-fixed]] — 중복 구현 금지).\n\n// 업로드 용량 상한(MB). 음성·영상은 L1 청크 전사로 긴 회의 수용(100), 문서는 L3a 스트리밍으로 상향(500).\nexport const CAP_MB_AUDIO_VIDEO = 100;\nexport const CAP_MB_DOC = 500; // L3a 스트리밍 업로드 + L3b 응축(거대 텍스트 분석 가능) → 500MB. Ingress 512m와 정합.\nexport const STREAM_THRESHOLD = 25 * 1024 * 1024; // 이 이상은 raw-body 스트리밍/청크 권장(클라/서버 공통 기준)\n\nexport type SessionUser = NonNullable<Awaited<ReturnType<typeof getSessionUser>>>;\nexport interface StageOpts { scope: string; title: string; anonymous: boolean; diarize: boolean; modelField: string; geminiOptIn?: boolean }\n\n/** 파일 확장자가 음성·영상(STT 대상)인지 — 용량 cap 분기용(순수). */\nexport function isAudioVideoExt(ext: string, mimeType = \"\"): boolean {\n  return mimeType.startsWith(\"audio/\") || mimeType.startsWith(\"video/\") || STT_EXTS.includes(ext) || STT_FFMPEG_EXTS.includes(ext);\n}\n\n/** 확장자(+mime)별 업로드 용량 상한(바이트). 음성·영상 100MB, 그 외 500MB. */\nexport function capBytesFor(ext: string, mimeType = \"\"): number {\n  return (isAudioVideoExt(ext, mimeType) ? CAP_MB_AUDIO_VIDEO : CAP_MB_DOC) * 1024 * 1024;\n}\n\n// 업로드 버퍼 1건을 ★스테이징★(게이팅→추출→보관, 토큰 0)한다. multipart·raw-body·청크 finalize가 공유.\n//   ACL 강제지점3·형식/모델 게이팅·용량 cap·추출(docs/17)·원본 보존을 한 곳에 모아 경로 간 불일치를 막는다.\nexport async function stageBuffer(user: SessionUser, buf: Buffer, filename: string, mimeType: string, opts: StageOpts): Promise<NextResponse> {\n  const { scope, anonymous, diarize, modelField } = opts;\n  try {\n    await assertScopeAllowed(user, scope); // ACL 강제지점3\n  } catch {\n    return NextResponse.json({ error: \"접근 권한이 없는 scope입니다.\" }, { status: 403 });\n  }\n  // 사용자가 자료 탭에서 고른 인제스트 모델(검증·폴백) → ★그 모델★ 능력 기준으로 게이팅·인제스트.\n  const picked = await resolveIngestModel(modelField || undefined);\n  const ext = (filename.toLowerCase().match(/\\.([a-z0-9]+)$/)?.[1]) || \"\";\n  const pol = uploadPolicyForModel(picked.model, picked.provider);\n  const isImg = [\"image/png\", \"image/jpeg\", \"image/gif\", \"image/webp\"].includes(mimeType) || [\"png\", \"jpg\", \"jpeg\", \"gif\", \"webp\"].includes(ext);\n  const isPdf = mimeType === \"application/pdf\" || ext === \"pdf\";\n  // 게이팅(서버 강제): ① 형식 자체 미지원이면 400, ② 형식은 지원하나 선택 모델로는 불가면 415.\n  const sttExts = sttAvailable() ? [...STT_EXTS, ...(ffmpegAvailable() ? STT_FFMPEG_EXTS : [])] : [];\n  const allExts = [...SUPPORTED_EXTS, ...(libreOfficeAvailable() ? CONVERT_ONLY_EXTS : []), ...sttExts];\n  if (!allExts.includes(ext)) {\n    return NextResponse.json({ error: `지원하지 않는 형식입니다(.${ext || \"?\"}). 지원: ${allExts.join(\", \")}` }, { status: 400 });\n  }\n  if (!pol.exts.includes(ext)) {\n    return NextResponse.json({ error: pol.note }, { status: 415 });\n  }\n  const isAudioVideo = isAudioVideoExt(ext, mimeType);\n  const capMb = isAudioVideo ? CAP_MB_AUDIO_VIDEO : CAP_MB_DOC;\n  if (buf.byteLength > capMb * 1024 * 1024) {\n    return NextResponse.json({ error: `파일은 ${capMb}MB 이하만 가능합니다.${isAudioVideo ? \" 더 긴 음성·영상은 잘라서 올려주세요.\" : \"\"}` }, { status: 400 });\n  }\n  const wikiScope = scopeWikiPrefix(scope);\n  const title = opts.title.trim() || filename.replace(/\\.[^.]+$/, \"\") || \"자료\";\n  const rawExt = ext || (isPdf ? \"pdf\" : \"bin\");\n  const typeLabel = isPdf ? \"PDF\" : isImg ? \"IMAGE\" : (ext ? ext.toUpperCase() : \"FILE\");\n  const meta = { mimeType: mimeType || undefined, byteSize: buf.byteLength, originalName: filename };\n  try {\n    // ★J 전사 비동기화(ship-dark)★: STT_ASYNC면 음성·영상은 ★업로드 시 전사하지 않고★ raw만 스테이징한다.\n    if (sttAsync() && isAudioVideo) {\n      const result = await storeForAnalysis({\n        scope: wikiScope, title, type: typeLabel, text: \"\", userId: user.id, anonymous, rawBytes: buf, rawExt,\n        ...meta, extractor: \"stt-pending\", extractStatus: \"NONE\",\n      });\n      return NextResponse.json({ ...result, extractor: \"stt-pending\", recommended: await recommendIngestModel({ type: typeLabel, transcribed: true }) });\n    }\n    // ★스테이징★ — 추출(토큰0)·원본 보관만. LLM 분석은 사용자가 목록에서 [분석] 버튼을 눌렀을 때.\n    const ex = await extractAsset(buf, filename, mimeType, { diarize, geminiOptIn: opts.geminiOptIn });\n    if (ex.text.trim() && ex.quality !== \"none\") {\n      const result = await storeForAnalysis({\n        scope: wikiScope, title, text: ex.text, type: typeLabel, userId: user.id, anonymous, rawBytes: buf, rawExt,\n        ...meta, extractor: ex.extractor, extractStatus: ex.quality === \"full\" ? \"FULL\" : \"PARTIAL\",\n        normalizedText: ex.text, assets: ex.assets,\n      });\n      return NextResponse.json({ ...result, extractor: ex.extractor, recommended: await recommendIngestModel({ chars: ex.text.length, type: typeLabel, transcribed: isTranscribedExtractor(ex.extractor) }) });\n    }\n    // 텍스트 없음: 이미지·스캔 PDF는 비전 필요 — 비전 없는 모델 선택 시 명확히 안내.\n    if (!pol.vision) {\n      return NextResponse.json({ error: \"이 모델은 텍스트 추출만 가능합니다. 텍스트가 없는 스캔본 PDF·이미지는 Gemini나 Claude 모델을 선택해 올려주세요.\" }, { status: 422 });\n    }\n    if (isImg) {\n      const result = await storeForAnalysis({ scope: wikiScope, title, type: \"IMAGE\", text: \"\", userId: user.id, anonymous, rawBytes: buf, rawExt, ...meta, extractor: \"vision\", extractStatus: \"NONE\" });\n      return NextResponse.json({ ...result, extractor: \"vision\", recommended: await recommendIngestModel({ type: \"IMAGE\" }) });\n    }\n    if (isPdf) {\n      const result = await storeForAnalysis({ scope: wikiScope, title, type: \"PDF\", text: \"\", userId: user.id, anonymous, rawBytes: buf, rawExt: \"pdf\", ...meta, extractor: \"pdf-vision\", extractStatus: \"NONE\" });\n      return NextResponse.json({ ...result, extractor: \"pdf-vision\", recommended: await recommendIngestModel({ type: \"PDF\" }) });\n    }\n    // 추출 불가(인식했으나 본문 없음) → 원본은 보존(미분석, REQ-MAT-010)\n    const result = await storeRawOnly({ scope: wikiScope, title, rawBytes: buf, rawExt, userId: user.id, anonymous, ...meta });\n    return NextResponse.json({ ...result, extractor: \"none\", unanalyzed: true, recommended: await recommendIngestModel({ type: typeLabel }) });\n  } catch (err) {\n    return NextResponse.json({ error: String(err) }, { status: 500 });\n  }\n}\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1022,"cache_read_input_tokens":184072,"output_tokens":5428,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1022,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":5428,"cache_read_input_tokens":184072,"cache_creation_input_tokens":1022,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1022},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CcVZyH4k3WdAc1NJsF3nK","type":"assistant","uuid":"39fc91d4-6246-4ed2-b573-d946694f5895","timestamp":"2026-06