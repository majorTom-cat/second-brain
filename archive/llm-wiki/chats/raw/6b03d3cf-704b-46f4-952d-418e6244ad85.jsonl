{"parentUuid":"5a5b429a-8a09-47a4-a79e-ba4ca17fb9c5","isSidechain":false,"promptId":"72c47ca9-455c-407a-8764-3ca32f2b9ca5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R4AV6F6eimDof6D2ja4zta","type":"tool_result","content":"676\t        const procM = modelUserPicked ? analyzeModelId : (it.reco?.model ?? analyzeModelId);\n677\t        const ctrl = new AbortController(); // 항목별 취소(이 항목만 중단하고 다음 항목은 계속)\n678\t        const startedAt = Date.now();\n679\t        setStaged((p) => p.map((x) => (x.key === it.key ? { ...x, status: \"running\", at: startedAt, ctrl, note: uploadMode === \"raw\" ? \"추가 중…\" : (procM ? `분석 중… · ${modelLabel(procM)}` : \"분석 중…\") } : x)));\n680\t        // ★최근 자료(sources) 행도 '처리 중'으로★ — 대기목록과 싱크(같은 자료가 한쪽 '분석중'·다른쪽 '분석 대기'로 어긋나던 문제).\n681\t        if (it.sourceId) setActing((a) => new Map(a).set(it.sourceId!, { label: procM ? modelLabel(procM) : \"\", at: startedAt, ctrl }));\n682\t        let r: { ok: boolean; note: string; queued?: boolean };\n683\t        try {\n684\t          r = await runProcess(it.sourceId!, it.hasText, ctrl.signal);\n685\t        } catch (e) {\n686\t          const aborted = e instanceof Error && e.name === \"AbortError\";\n687\t          r = { ok: false, note: aborted ? \"분석 취소됨\" : `오류: ${toUserMessage(e)}` };\n688\t        }\n689\t        if (it.sourceId) { if (!r.queued) markDuration(it.sourceId, Date.now() - startedAt); setActing((a) => { const c = new Map(a); c.delete(it.sourceId!); return c; }); } // 소요 기록(★비동기 예약은 건너뜀=서버 durationMs가 표시★) + '처리 중' 해제\n690\t        setStaged((p) => p.map((x) => (x.key === it.key ? { ...x, status: r.ok ? \"done\" : \"error\", at: undefined, ctrl: undefined, note: r.note } : x)));\n691\t        // ★각 항목이 끝나는 즉시★ 최근 자료·위키 갱신 — 전부 끝날 때까지 기다리지 않게(완료분이 바로 보임).\n692\t        await load();\n693\t        onDataChanged?.();\n694\t      }\n695\t    } finally {\n696\t      setBusyFor(qScope, false);\n697\t      await load();\n698\t      onDataChanged?.(); // 최종 갱신(위키 트리/리더)\n699\t    }\n700\t  }\n701\t\n702\t  function clearStaged() { setStaged([]); setModelUserPicked(false); } // 비우면 자동추천 재개\n703\t  // 대기 항목 ★개별 삭제★ — 큐에서만 제거('비우기'와 동일 동작, 소스는 그대로). 처리 중 항목은 대신 취소 버튼.\n704\t  function removeStaged(u: Staged) { setStaged((p) => p.filter((x) => x.key !== u.key)); }\n705\t  // 진행 중 분석 취소 — (1) 클라 fetch abort(즉시) + (2) ★서버측 명시 취소★(배포 보강).\n706\t  //   nginx 뒤에서 abort가 req.signal을 발화 못 해도 /cancel이 서버 in-flight 컨트롤러를 직접 abort해 중단을 전파한다.\n707\t  function cancelItem(s: SourceItem) {\n708\t    acting.get(s.id)?.ctrl.abort();\n709\t    setCanceling((c) => new Set(c).add(s.id));\n710\t    fetch(`/api/materials/${s.id}/cancel`, { method: \"POST\" }).catch(() => { /* best-effort */ });\n711\t  }\n712\t\n713\t  // 잔여(PENDING/FAILED) 복구 — 업로드 중 이탈 등으로 남은 항목을 현재 모드로 다시 처리.\n714\t  async function recover(s: SourceItem, modelOverride?: string) {\n715\t    if (acting.has(s.id)) return;\n716\t    const lbl = (uploadMode === \"raw\" && s.hasText) ? \"\" : modelLabel(modelOverride || (modelUserPicked ? analyzeModelId : (s.recoModel ?? analyzeModelId))); // raw 복구는 모델 없음, 팝업/자동 모델\n717\t    const ctrl = new AbortController();\n718\t    const startedAt = Date.now();\n719\t    setActing((a) => new Map(a).set(s.id, { label: lbl, at: startedAt, ctrl }));\n720\t    setNotes((n) => { const c = { ...n }; delete c[s.id]; return c; });\n721\t    let queued = false; // ★비동기 예약이면 클라 측정(≈0)을 박제하지 않음 — 서버 durationMs가 실제 소요를 표시★\n722\t    try {\n723\t      const r = await runProcess(s.id, !!s.hasText, ctrl.signal, modelOverride, true); // ★재처리=음성이면 raw 재전사★\n724\t      queued = !!r.queued;\n725\t      setNotes((n) => ({ ...n, [s.id]: r.note }));\n726\t    } catch (e) {\n727\t      const aborted = e instanceof Error && e.name === \"AbortError\";\n728\t      setNotes((n) => ({ ...n, [s.id]: aborted ? \"분석 취소됨\" : `오류: ${toUserMessage(e)}` }));\n729\t    } finally {\n730\t      if (!queued) markDuration(s.id, Date.now() - startedAt);\n731\t      setActing((a) => { const c = new Map(a); c.delete(s.id); return c; });\n732\t      await load(); onDataChanged?.();\n733\t    }\n734\t  }\n735\t\n736\t  // [AI로 분석]/[다시 분석] 클릭 → ★모델 선택 팝업★(추천 순 정렬·추천 뱃지·1순위/백업 같이). [분석]에서 실제 실행.\n737\t  function openPick(s: SourceItem, reanalyze = false) {\n738\t    if (acting.has(s.id)) return;\n739\t    const reco = (s.recoModel && enabledHas(s.recoModel)) ? s.recoModel : recommendedId; // 항목 추천(없으면 기본 추천)\n740\t    setPickId(reco);\n741\t    setPickDiarize(false); // 재분석 화자 구분 선택 초기화(음성 소스에서만 노출)\n742\t    setPickFor({ s, reanalyze });\n743\t  }\n744\t  // ★재처리도 모델 선택 팝업★ — 분석이 필요한 항목만. raw 복구(텍스트 보존·모델 무관)는 팝업 없이 바로 실행.\n745\t  function openRecoverPick(s: SourceItem) {\n746\t    if (acting.has(s.id)) return;\n747\t    if (uploadMode === \"raw\" && s.hasText) { void recover(s); return; }\n748\t    const reco = (s.recoModel && enabledHas(s.recoModel)) ? s.recoModel : recommendedId;\n749\t    setPickId(reco);\n750\t    setPickFor({ s, reanalyze: false, recover: true });\n751\t  }\n752\t\n753\t  // [AI로 분석] — 엔티티·개념에 반영(옛 raw 페이지는 서버가 대체). modelOverride=팝업에서 고른 모델.\n754\t  async function analyzeItem(s: SourceItem, reanalyze = false, modelOverride?: string, diarize = false) {\n755\t    if (acting.has(s.id)) return;\n756\t    const chosen = modelOverride || (modelUserPicked ? analyzeModelId : undefined); // 고른 모델 우선, 없으면 자동(서버 결정)\n757\t    // ★음성·영상 재분석★: 회의록 처리는 서버가 자동(전사 소스), 화자 구분만 팝업에서 고른 값(diarize 파라미터).\n758\t    const isAudio = isTranscribedExtractor(s.extractor);\n759\t    const startedAt = Date.now();\n760\t    const ctrl = new AbortController();\n761\t    setActing((a) => new Map(a).set(s.id, { label: modelLabel(chosen || s.recoModel || analyzeModelId), at: startedAt, ctrl }));\n762\t    setNotes((n) => { const c = { ...n }; delete c[s.id]; return c; });\n763\t    let queued = false; // ★비동기 예약이면 클라 측정(≈0)을 박제하지 않음 — 서버 durationMs가 실제 소요를 표시★\n764\t    try {\n765\t      const res = await fetch(`/api/materials/${s.id}/analyze`, {\n766\t        method: \"POST\", headers: { \"content-type\": \"application/json\" },\n767\t        body: JSON.stringify({ mode: \"llm\", reanalyze, model: chosen || undefined, diarize: (isAudio && diarize) || undefined }),\n768\t        signal: ctrl.signal,\n769\t      });\n770\t      const data = await res.json();\n771\t      const took = ` · ${fmtElapsed(Date.now() - startedAt)}`; // 완료/실패 시 최종 경과 시간\n772\t      if (!res.ok) setNotes((n) => ({ ...n, [s.id]: `분석 실패: ${data.error || \"\"}${took}` }));\n773\t      else if (data.queued) { queued = true; setNotes((n) => ({ ...n, [s.id]: \"분석 예약됨 · 백그라운드에서 처리 중\" })); } // ★L2 비동기★\n774\t      else {\n775\t        const sw = data.fallback ? \" · 백업 모델로 자동 전환됨\" : \"\";\n776\t        const md = data.usedModel ? ` · 모델 ${modelLabel(data.usedModel)}` : \"\";\n777\t        const dup = data.status === \"SKIPPED_DUP\";\n778\t        const msg = dup ? \"이미 분석된 자료입니다\"\n779\t          : data.status === \"NEEDS_REVIEW\" ? \"검토 대기\" : (reanalyze ? \"다시 분석 반영됨\" : \"AI 분석 반영됨\");\n780\t        setNotes((n) => ({ ...n, [s.id]: msg + md + sw + (dup ? \"\" : took) }));\n781\t      }\n782\t    } catch (e) {\n783\t      const aborted = e instanceof Error && e.name === \"AbortError\";\n784\t      setNotes((n) => ({ ...n, [s.id]: `${aborted ? \"분석 취소됨\" : `오류: ${toUserMessage(e)}`} · ${fmtElapsed(Date.now() - startedAt)}` }));\n785\t    } finally {\n786\t      if (!queued) markDuration(s.id, Date.now() - startedAt); // 완료/실패 최종 소요 — 배지에 남김(★비동기 예약은 서버 durationMs★)\n787\t      setActing((a) => { const c = new Map(a); c.delete(s.id); return c; });\n788\t      await load(); onDataChanged?.(); // 새 엔티티/개념 페이지 → 위키 트리/리더 갱신\n789\t    }\n790\t  }\n791\t\n792\t  // ★원본 그대로 추가★(토큰 0) — AI 정리 없이 원문 텍스트를 위키 페이지로 보존. 분석이 너무 커서 실패한 자료의\n793\t  //   권장 대안(출력 길이 한도와 무관). 기존 FAILED 잡은 최신 APPLIED(RAW_IMPORT) 잡으로 자연스레 대체된다.\n794\t  async function fileAsRaw(s: SourceItem) {\n795\t    if (acting.has(s.id)) return;\n796\t    if (!await confirmDialog(`「${s.title}」을(를) 원본 그대로 추가할까요?\\nAI 정리 없이 원문 텍스트를 위키 페이지로 보존합니다. (토큰 0)`)) return;\n797\t    const ctrl = new AbortController();\n798\t    setActing((a) => new Map(a).set(s.id, { label: \"\", at: Date.now(), ctrl })); // 원본 그대로 = 모델 없음\n799\t    setNotes((n) => { const c = { ...n }; delete c[s.id]; return c; });\n800\t    try {\n801\t      const res = await fetch(`/api/materials/${s.id}/analyze`, {\n802\t        method: \"POST\", headers: { \"content-type\": \"application/json\" }, body: JSON.stringify({ mode: \"raw\" }), signal: ctrl.signal,\n803\t      });\n804\t      const data = await res.json();\n805\t      setNotes((n) => ({ ...n, [s.id]: res.ok ? \"원본 그대로 추가됨 · 토큰 0\" : `추가 실패: ${data.error || \"\"}` }));\n806\t    } catch (e) {\n807\t      setNotes((n) => ({ ...n, [s.id]: `오류: ${toUserMessage(e)}` }));\n808\t    } finally {\n809\t      setActing((a) => { const c = new Map(a); c.delete(s.id); return c; });\n810\t      await load(); onDataChanged?.();\n811\t    }\n812\t  }\n813\t\n814\t  // 선택된 분석 모델의 공급자(외부 전송 경고 판단). 미선택 시 추천값으로 폴백.\n815\t  const provider = analyzeModels.find((m) => m.id === analyzeModelId)?.provider ?? analyzeModel?.provider;\n816\t  const external = uploadMode === \"llm\" && (provider === \"gemini\" || provider === \"openai-compat\" || provider === \"codex\" || provider === \"claude-cli\");\n817\t  // ★화자 구분(diarize)★은 Gemini 전사가 필요(Groq는 화자 구분 미지원). 기본 모델은 Groq을 유지하되,\n818\t  //   화자 구분을 켜면 분석 모델을 ★자동으로 Gemini로 전환★하고(말풍선으로 사유 안내), 끄면 직전 모델로 되돌린다.\n819\t  //   geminiAvailable(=Gemini 키로 모델이 떠 있음)일 때만 토글을 노출한다(키 없으면 화자 구분 자체가 불가).\n820\t  const geminiModel = analyzeModels.find((m) => m.provider === \"gemini\" && m.enabled);\n821\t  const geminiAvailable = !!geminiModel;\n822\t  const onToggleDiarize = (on: boolean) => {\n823\t    setDiarize(on);\n824\t    if (on) {\n825\t      if (geminiModel && provider !== \"gemini\") {\n826\t        preDiarizeRef.current = { model: analyzeModelId, picked: modelUserPicked };\n827\t        setModelUserPicked(true); setAnalyzeModelId(geminiModel.id); setDiarizeSwitched(true);\n828\t      }\n829\t    } else {\n830\t      if (diarizeSwitched && preDiarizeRef.current) {\n831\t        setModelUserPicked(preDiarizeRef.current.picked);\n832\t        if (preDiarizeRef.current.model) setAnalyzeModelId(preDiarizeRef.current.model);\n833\t      }\n834\t      setDiarizeSwitched(false); preDiarizeRef.current = null;\n835\t    }\n836\t  };\n837\t  const procCount = staged.filter((s) => s.status === \"staged\" && s.sourceId).length;\n838\t  // I 배치 결과 요약(§I) — 대기 항목의 종결 상태를 신규/중복/실패로 집계(순수 헬퍼). done=신규, skip=중복, error=실패.\n839\t  const batchText = batchSummaryText(summarizeBatch(staged.map((u) =>\n840\t    u.status === \"done\" ? \"APPLIED\" : u.status === \"skip\" ? \"SKIPPED_DUP\" : u.status === \"error\" ? \"FAILED\" : \"RUNNING\")));\n841\t  // H 파일별/그룹 추천(§H) — 추천 모델이 ★둘 이상으로 갈리면★ 그룹 요약을 보여 형식 제각각 파일의 추천 차이를 가시화.\n842\t  const stagedGroups = groupStagedByModel(\n843\t    staged.filter((s) => s.sourceId && s.reco).map((s) => ({ id: s.sourceId!, recoModel: s.reco!.model, title: s.name })),\n844\t  );\n845\t  // 화자 구분 토글 노출 조건: ★음성·영상이 대기 목록에 있고★ + ★분석 모델로 Gemini 선택★일 때만(Groq는 화자분리 미지원).\n846\t  const AV_EXTS = [\"mp3\", \"wav\", \"m4a\", \"flac\", \"ogg\", \"mpga\", \"mp4\", \"mpeg\", \"webm\", \"mov\", \"mkv\", \"avi\", \"m4v\", \"wmv\", \"flv\"];\n847\t  const hasAudioVideoStaged = staged.some((s) => AV_EXTS.includes((s.name.toLowerCase().match(/\\.([a-z0-9]+)$/)?.[1]) || \"\"));\n848\t  // ★음성·영상이 대기열에서 모두 빠지면 화자 구분 토글·자동전환·말풍선을 초기화★ — 지운 뒤에도 말풍선/상태가 남던 버그 수정.\n849\t  useEffect(() => {\n850\t    if (hasAudioVideoStaged || !(diarize || diarizeSwitched)) return;\n851\t    if (diarizeSwitched && preDiarizeRef.current) {\n852\t      setModelUserPicked(preDiarizeRef.current.picked);\n853\t      if (preDiarizeRef.current.model) setAnalyzeModelId(preDiarizeRef.current.model);\n854\t    }\n855\t    setDiarize(false); setDiarizeSwitched(false); preDiarizeRef.current = null;\n856\t  }, [hasAudioVideoStaged, diarize, diarizeSwitched]);\n857\t  const accept = policy?.accept ?? (\".md,.markdown,.txt,.csv,.html,.htm,.json,.pdf,.docx,.doc,.xlsx,.xls,.pptx,.odt,.ods,.odp,.rtf,.hwp,.hwpx,.png,.jpg,.jpeg,.gif,.webp\" + convertExts.map((e) => `,.${e}`).join(\"\"));\n858\t\n859\t  return (\n860\t    <div className={`mat-wrap${hidden ? \" hidden\" : \"\"}`}>\n861\t      <div className=\"mat-col mat-col-upload\">\n862\t        <div className=\"mat-card\">\n863\t          <div className=\"mat-card-head\"><IconUpload size={15} />자료 추가</div>\n864\t          <p className=\"mat-desc\">\n865\t            올리면 먼저 <b>대기 목록</b>에 담깁니다. 처리 방식을 고르고 <b>[처리 시작]</b>을 눌러야 위키에 반영됩니다. 원본은 항상 그대로 보관됩니다.\n866\t          </p>\n867\t\n868\t          {/* 처리 방식 선택 — 분석(엔티티·개념 연결) vs 원본 그대로(토큰 0 보관) */}\n869\t          <div className=\"mat-mode\">\n870\t            <button type=\"button\" className={`mat-mode-btn${uploadMode === \"llm\" ? \" on\" : \"\"}`} disabled={busy} onClick={() => setUploadMode(\"llm\")}>\n871\t              분석해서 추가<span className=\"mat-mode-sub\">엔티티·개념에 반영 · 다른 자료와 연결</span>\n872\t            </button>\n873\t            <button type=\"button\" className={`mat-mode-btn${uploadMode === \"raw\" ? \" on\" : \"\"}`} disabled={busy} onClick={() => setUploadMode(\"raw\")}>\n874\t              원본 그대로 추가<span className=\"mat-mode-sub\">topics에 그대로 보관 · 토큰 0 · 연결 안 됨</span>\n875\t            </button>\n876\t          </div>\n877\t\n878\t          {/* 익명 업로드 — 동료 화면엔 '익명 기여자'로, 단 작성자는 감사 기록에 유지(관리자 확인 가능). 토글(다크모드 일관). */}\n879\t          <div className=\"mat-anon\">\n880\t            <label className={`web-toggle${busy ? \" disabled\" : \"\"}`} title=\"동료에겐 ‘익명 기여자’로 표시 · 작성자는 감사 기록에 유지(관리자 확인 가능)\">\n881\t              <input type=\"checkbox\" role=\"switch\" aria-checked={anonUpload} checked={anonUpload} disabled={busy} onChange={(e) => setAnonUpload(e.target.checked)} />\n882\t              <span className={`web-toggle-label${anonUpload ? \" on\" : \"\"}`}>익명으로 올리기 <span className=\"web-state\">{anonUpload ? \"켜짐\" : \"꺼짐\"}</span></span>\n883\t            </label>\n884\t            <span className=\"mat-anon-sub\">동료에겐 ‘익명 기여자’ · 작성자는 감사 기록에 유지</span>\n885\t          </div>\n886\t\n887\t          {/* 회의록 처리는 ★토글 없이 자동★(전사 소스는 서버가 무조건 회의록으로). 사용자에겐 안내만. */}\n888\t          {hasAudioVideoStaged && (\n889\t            <div className=\"mat-switch-note\"><IconInfoCircle size={13} />\n890\t              <span>음성·영상은 <b>회의록(요약·결정·할일·안건)</b>으로 자동 정리됩니다.{geminiAvailable ? \" 누가 말했는지 나누려면 아래 ‘화자 구분’을 켜세요.\" : \"\"}</span>\n891\t            </div>\n892\t          )}\n893\t\n894\t          {/* 화자 구분(선택) — '누가 말했는지'(화자1/2). Gemini 전용(Groq 미지원)·staged 음성·영상 + Gemini 키 있을 때.\n895\t              켜면 분석 모델을 자동으로 Gemini로 전환(말풍선 안내)·끄면 직전 모델 복귀. [처리 시작] 때 적용. */}\n896\t          {hasAudioVideoStaged && geminiAvailable && (\n897\t            <div className=\"mat-anon\">\n898\t              <label className={`web-toggle${busy ? \" disabled\" : \"\"}`} title=\"음성·영상에서 '누가 말했는지'를 화자1/화자2로 구분합니다. Gemini로 텍스트 변환되어 데이터가 Google로 전송·학습됩니다(민감 자료엔 쓰지 마세요).\">\n899\t                <input type=\"checkbox\" role=\"switch\" aria-checked={diarize} checked={diarize} disabled={busy} onChange={(e) => onToggleDiarize(e.target.checked)} />\n900\t                <span className={`web-toggle-label${diarize ? \" on\" : \"\"}`}>화자 구분 <span className=\"web-state\">{diarize ? \"켜짐\" : \"꺼짐\"}</span></span>\n901\t              </label>\n902\t              <span className=\"mat-anon-sub\"><b>누가 말했는지</b> 화자1/2로 구분(선택) · Gemini로 텍스트 변환 → 외부 전송·학습</span>\n903\t            </div>\n904\t          )}\n905\t\n906\t          {/* 분석 모델 — ★자료를 판단해 자동 추천★(셀렉트에 미리 잡힘). 원하면 직접 바꿔 분석. ⓘ에 사유. */}\n907\t          {uploadMode === \"llm\" && analyzeModels.length > 0 && (\n908\t            <div className=\"mat-automodel\">\n909\t              <IconSparkles size={13} />\n910\t              <span className=\"mat-automodel-lbl\">분석 모델</span>\n911\t              <ModelSelect models={analyzeModels} value={analyzeModelId} variant=\"mat\" title=\"자료를 분석할 모델\"\n912\t                onChange={(id) => { setModelUserPicked(true); setAnalyzeModelId(id); setDiarizeSwitched(false); }} />\n913\t              {!modelUserPicked && effReco && <span className=\"mat-automodel-auto\">자동</span>}\n914\t              {(effReco || analyzeModel) && (\n915\t                <span className=\"mat-automodel-info\" tabIndex={0} aria-label={(effReco || analyzeModel)!.reason}>\n916\t                  <IconInfoCircle size={13} />\n917\t                  <span className=\"mat-automodel-tip\" role=\"tooltip\">\n918\t                    {modelUserPicked\n919\t                      ? `직접 고른 모델로 분석합니다.${effReco ? `\\n(자료 기준 자동 추천: ${effReco.label})` : \"\"}`\n920\t                      : `자료를 판단해 자동 추천한 모델입니다.\\n${(effReco || analyzeModel)!.reason}`}\n921\t                  </span>\n922\t                </span>\n923\t              )}\n924\t            </div>\n925\t          )}\n926\t\n927\t          {/* 화자 구분이 모델을 Gemini로 자동 전환했을 때 ★왜 바뀌었는지★ 말풍선으로 안내. */}\n928\t          {diarizeSwitched && uploadMode === \"llm\" && (\n929\t            <div className=\"mat-diarize-note\" role=\"status\">\n930\t              <IconInfoCircle size={13} />\n931\t              <span>화자 구분을 켜서 분석 모델을 <b>Gemini</b>로 바꿨어요 — <b>Groq은 화자 구분을 못 해서요</b>. 화자 구분을 끄면 Groq으로 돌아갑니다. (Gemini는 외부 전송·학습)</span>\n932\t            </div>\n933\t          )}\n934\t\n935\t          {uploadMode === \"raw\" && (\n936\t            <div className=\"mat-switch-note\"><IconArrowsExchange size={13} />\n937\t              <span>분석 없이 원본을 그대로 위키에 보관합니다(<b>토큰 0</b>). 엔티티·개념엔 정리되지 않으니, 연결이 필요하면 <b>분석해서 추가</b>를 쓰거나 나중에 목록에서 <b>AI로 분석</b>을 누르세요. (텍스트 없는 PDF·이미지는 자동으로 분석됩니다.)</span>\n938\t            </div>\n939\t          )}\n940\t\n941\t          {external && (\n942\t            <div className=\"gemini-warn\"><IconAlertTriangle size={13} />\n943\t              <span>{provider === \"gemini\"\n944\t                ? <>Gemini(외부)는 빠르지만 <b>올린 자료가 Google로 전송·학습</b>됩니다. <br />민감 자료는 올리지 마세요.</>\n945\t                : <>이 모델(외부)은 빠르지만 <b>올린 자료가 외부 서버로 전송</b>됩니다. <br />민감 자료는 올리지 마세요.</>}</span>\n946\t            </div>\n947\t          )}\n948\t\n949\t          <div className={`mat-drop${busy ? \" busy\" : \"\"}${dragOver ? \" dragover\" : \"\"}`}\n950\t            onClick={() => { if (!busy) fileRef.current?.click(); }}\n951\t            onDragOver={(e) => { e.preventDefault(); if (!busy) setDragOver(true); }}\n952\t            onDragLeave={() => setDragOver(false)}\n953\t            onDrop={onDrop}>\n954\t            <IconUpload size={20} />\n955\t            <span><b>{policy?.textOnly ? \"텍스트 파일(.txt·.md)을 끌어다 놓거나\" : \"파일을 끌어다 놓거나\"}</b> 클릭해 선택<br /><span className=\"mat-multi\">(여러 개 가능 · 대기 목록에 담김)</span></span>\n956\t            <input ref={fileRef} type=\"file\" hidden multiple disabled={busy} accept={accept} onChange={onPickFile} />\n957\t          </div>\n958\t          <div className={`mat-formats${policy?.textOnly ? \" mat-formats-note\" : \"\"}`}>\n959\t            {policy?.note ?? \"지원 형식: 텍스트(.md .txt) · PDF · 이미지 · 한글 · Word · Excel · PowerPoint · 오픈오피스 · RTF · HTML\"}\n960\t          </div>\n961\t\n962\t          <div className=\"mat-or\">또는 직접 입력</div>\n963\t          <input className=\"mat-input\" placeholder=\"제목 (단건 업로드/직접 입력 시, 비우면 자동)\" value={title} maxLength={80} onChange={(e) => setTitle(e.target.value)} />\n964\t          <textarea className=\"mat-input mat-textarea\" placeholder=\"여기에 내용을 붙여넣으세요…\" value={text} onChange={(e) => setText(e.target.value)} />\n965\t          <button className=\"mat-stage-add\" onClick={stageText} disabled={busy || !text.trim()}>대기 목록에 추가</button>\n966\t\n967\t          {/* 대기(스테이징) 목록 */}\n968\t          {staged.length > 0 && (\n969\t            <div className=\"mat-queue\">\n970\t              <div className=\"mat-queue-head\">대기 {staged.filter((u) => u.status === \"done\" || u.status === \"skip\").length}/{staged.length} 처리됨{batchText && <span style={{ marginLeft: 8, fontWeight: 400, opacity: 0.85 }}>· {batchText}</span>}</div>\n971\t              {staged.map((u) => {\n972\t                const cls = u.status === \"running\" || u.status === \"staging\" ? \"running\" : u.status === \"error\" ? \"error\" : u.status === \"staged\" ? \"pending\" : \"done\";\n973\t                const statusWord = u.status === \"staging\" ? \"올리는 중…\" : u.status === \"staged\" ? \"대기\" : u.status === \"running\" ? (u.note || \"처리 중…\") : u.status === \"error\" ? \"실패\" : \"완료\";\n974\t                // 에러·결과 메모는 길 수 있어 ★별도 줄에서 전부 줄바꿈★으로 보여준다(한 줄 잘림 방지).\n975\t                const detail = (u.status === \"error\" || u.status === \"done\" || u.status === \"skip\") ? (u.note || \"\") : \"\";\n976\t                return (\n977\t                  <div key={u.key} className={`mat-queue-item ${cls}`}>\n978\t                    <div className=\"mq-top\">\n979\t                      <span className=\"mq-dot\" />\n980\t                      <span className=\"mq-name\" title={u.name}>{u.name}</span>\n981\t                      <span className=\"mq-status\">{statusWord}{u.status === \"running\" && u.at ? ` · ${fmtElapsed(now - u.at)}` : \"\"}</span>\n982\t                      {u.status === \"running\" && u.ctrl && (\n983\t                        <button className=\"mq-cancel\" onClick={() => { u.ctrl?.abort(); if (u.sourceId) fetch(`/api/materials/${u.sourceId}/cancel`, { method: \"POST\" }).catch(() => {}); }} title=\"분석 취소 (서버 작업도 중단)\"><IconX size={11} />취소</button>\n984\t                      )}\n985\t                      {u.status !== \"running\" && (\n986\t                        <button className=\"mq-del\" onClick={() => removeStaged(u)} title=\"대기 목록에서 삭제\"><IconX size={12} /></button>\n987\t                      )}\n988\t                    </div>\n989\t                    {detail && <div className=\"mq-detail\">{detail}</div>}\n990\t                  </div>\n991\t                );\n992\t              })}\n993\t            </div>\n994\t          )}\n995\t\n996\t          {err && <div className=\"mat-banner err\"><IconAlertTriangle size={14} />{err}</div>}\n997\t\n998\t          {/* ★처리 직전 분석 모델 — [처리 시작] 바로 위에 다시 노출. 폼 위쪽 셀렉트가 드롭존 위라 안 보일 수 있어\n999\t              (특히 음성·영상은 전사→분석 2단계라 분석 모델을 여기서 확인·변경하게 한다). 위 셀렉트와 상태 공유. */}\n1000\t          {uploadMode === \"llm\" && procCount > 0 && analyzeModels.length > 0 && (\n1001\t            <div className=\"mat-automodel mat-automodel-run\">\n1002\t              <IconSparkles size={13} />\n1003\t              <span className=\"mat-automodel-lbl\">분석 모델</span>\n1004\t              <ModelSelect models={analyzeModels} value={analyzeModelId} variant=\"mat\" title=\"이 자료를 분석할 모델\"\n1005\t                onChange={(id) => { setModelUserPicked(true); setAnalyzeModelId(id); setDiarizeSwitched(false); }} />\n1006\t              {!modelUserPicked && effReco && <span className=\"mat-automodel-auto\">자동</span>}\n1007\t            </div>\n1008\t          )}\n1009\t          {/* H: 추천 모델이 둘 이상으로 갈리는 혼합 업로드면 그룹 요약을 안내(형식별 추천 차이 가시화). 적용은 위 분석 모델 1개(그룹별 오버라이드는 후속). */}\n1010\t          {uploadMode === \"llm\" && stagedGroups.length > 1 && (\n1011\t            <p className=\"set-note\" style={{ margin: \"2px 0 6px\" }}>\n1012\t              파일별 추천: {stagedGroups.map((g) => `${modelLabel(g.model)} ${g.ids.length}개`).join(\" · \")}\n1013\t            </p>\n1014\t          )}\n1015\t\n1016\t          <button className=\"mat-submit\" onClick={runStaged} disabled={busy || acting.size > 0 || procCount === 0}>\n1017\t            {busy ? <><IconClockHour4 size={14} />{uploadMode === \"raw\" ? \"추가 중…\" : \"분석 중…\"}</> : (\n1018\t              procCount === 0 ? \"처리 시작 (대기 항목 없음)\" : `${uploadMode === \"raw\" ? \"원본 그대로 추가\" : \"분석해서 추가\"} (${procCount}개)`\n1019\t            )}\n1020\t          </button>\n1021\t          {/* 다른 자료를 처리(분석/원본추가)하는 중엔 대기 비우기를 숨긴다 — 처리 중 실수 클릭으로 인한 혼동 방지.\n1022\t              (분석은 서버에서 끝까지 돌므로 비워도 취소되진 않지만, UI 혼동을 막는다.) */}\n1023\t          {staged.length > 0 && !busy && (\n1024\t            <button className=\"mat-stage-clear\" onClick={clearStaged}>대기 목록 비우기 ({staged.length})</button>\n1025\t          )}\n1026\t        </div>\n1027\t      </div>\n1028\t\n1029\t      <div className=\"mat-col mat-col-list\">\n1030\t        <div className=\"mat-card\">\n1031\t          <div className=\"mat-card-head\"><IconFileText size={15} />최근 자료 {sources.length > 0 && `(${sources.length})`}</div>\n1032\t          {delNote && <div className=\"mat-banner muted\" style={{ marginBottom: 10 }}>{delNote}</div>}\n1033\t          {sources.length === 0 ? (\n1034\t            <p className=\"mat-desc\">아직 올린 자료가 없습니다.</p>\n1035\t          ) : (\n1036\t            <div className=\"mat-tree\">\n1037\t              {groupByMonthThenDay(sources).map(([month, days], mi) => (\n1038\t                <MonthGroup key={month} month={month} count={days.reduce((n, [, it]) => n + it.length, 0)} defaultOpen={mi === 0}>\n1039\t                  {days.map(([ym, items], di) => (\n1040\t                    <SourceGroup key={ym} ym={ym} items={items} defaultOpen={mi === 0 && di === 0} onArchive={archiveSource} onWiki={openWiki}\n1041\t                      onRecover={openRecoverPick} onAnalyze={openPick} onFileRaw={fileAsRaw} onCancel={cancelItem}\n1042\t                      deleting={deleting} acting={acting} canceling={canceling} now={now} notes={notes} durations={durations} canManage={canManage}\n1043\t                      seenNew={seenNew} onSeen={(s) => dismissNew(`mat:${s.id}`)} />\n1044\t                  ))}\n1045\t                </MonthGroup>\n1046\t              ))}\n1047\t            </div>\n1048\t          )}\n1049\t\n1050\t          {/* 아카이브(소프트 삭제) 섹션 — 룸 관리자만. 펼칠 때 조회. */}\n1051\t          {canManage && (\n1052\t            <div className=\"mat-archive\">\n1053\t              <button className=\"mat-archive-head\" onClick={() => { const n = !showArchived; setShowArchived(n); if (n) loadArchived(); }}>\n1054\t                <IconChevronRight size={13} className={`tree-caret${showArchived ? \" open\" : \"\"}`} />\n1055\t                <IconArchive size={14} />아카이브{archivedSources.length > 0 ? ` (${archivedSources.length})` : \"\"}\n1056\t              </button>\n1057\t              {showArchived && (\n1058\t                archivedSources.length === 0 ? (\n1059\t                  <p className=\"mat-desc mat-archive-empty\">아카이브된 자료가 없습니다.</p>\n1060\t                ) : (\n1061\t                  <div className=\"mat-tree\">\n1062\t                    {groupByMonthThenDay(archivedSources).map(([month, days], mi) => (\n1063\t                      <MonthGroup key={month} month={month} count={days.reduce((n, [, it]) => n + it.length, 0)} defaultOpen={mi === 0}>\n1064\t                        {days.map(([ym, items], di) => (\n1065\t                          <SourceGroup key={ym} ym={ym} items={items} defaultOpen={mi === 0 && di === 0} archivedMode canManage={canManage}\n1066\t                            onArchive={archiveSource} onWiki={openWiki} onRecover={openRecoverPick} onAnalyze={openPick} onFileRaw={fileAsRaw} onCancel={cancelItem}\n1067\t                            onRestore={restoreSource} onPurge={purgeSource}\n1068\t                            deleting={deleting} acting={acting} now={now} notes={notes} durations={durations}\n1069\t                            seenNew={seenNew} onSeen={(s) => dismissNew(`mat:${s.id}`)} />\n1070\t                        ))}\n1071\t                      </MonthGroup>\n1072\t                    ))}\n1073\t                  </div>\n1074\t                )\n1075\t              )}\n1076\t            </div>\n1077\t          )}\n1078\t        </div>\n1079\t      </div>\n1080\t\n1081\t      {/* AI로 분석/다시 분석 — 모델 선택 팝업(추천 순 정렬·추천 뱃지·사용가능 1순위/백업 같이). */}\n1082\t      {pickFor && (() => {\n1083\t        const reco = (pickFor.s.recoModel && enabledHas(pickFor.s.recoModel)) ? pickFor.s.recoModel : recommendedId;\n1084\t        // ★그룹(1순위+그 백업)을 통째로★ 정렬 — 추천이 속한 그룹만 최상단으로, 나머지·그룹 내부 순서는 원본 유지(안정 정렬).\n1085\t        //   기존엔 추천만 위로 끌어올리고 모든 백업을 아래로 보내 ‘추천의 백업’이 추천과 떨어져 꼬였다.\n1086\t        const groupOf = (m: ModelOpt) => (m.kind === \"backup\" ? (m.backupOf || m.id) : m.id);\n1087\t        const recoM = analyzeModels.find((m) => m.id === reco);\n1088\t        const recoGroup = recoM ? groupOf(recoM) : reco;\n1089\t        const list = analyzeModels.filter((m) => m.enabled).slice()\n1090\t          .sort((a, b) => (groupOf(a) === recoGroup ? 0 : 1) - (groupOf(b) === recoGroup ? 0 : 1));\n1091\t        return (\n1092\t          <div className=\"modal-overlay\" onClick={() => setPickFor(null)}>\n1093\t            <div className=\"set-modal-card\" style={{ width: 460, maxWidth: \"calc(100% - 32px)\" }} onClick={(e) => e.stopPropagation()}>\n1094\t              <div className=\"set-modal-head\">\n1095\t                <span className=\"set-modal-title\">{pickFor.recover ? \"재처리\" : pickFor.reanalyze ? \"다시 분석\" : \"AI로 분석\"} · 모델 선택</span>\n1096\t                <button className=\"modal-x\" onClick={() => setPickFor(null)} aria-label=\"닫기\"><IconX size={17} /></button>\n1097\t              </div>\n1098\t              <div style={{ padding: \"12px 18px 16px\" }}>\n1099\t                <div className=\"mat-item-title\" title={pickFor.s.title} style={{ marginBottom: 8 }}>「{pickFor.s.title}」</div>\n1100\t                {/* ★음성·영상 = 전사+분석 2단계★ — 사용자는 어느 모델이 전사용인지 모를 수 있어 명시 + 추천(무료·미학습)을 강하게 어필. */}\n1101\t                {isTranscribedExtractor(pickFor.s.extractor) && (\n1102\t                  <div className=\"set-note\" style={{ margin: \"0 0 10px\", lineHeight: 1.55 }}>\n1103\t                    🎙 <b>음성·영상 자료는 2단계</b>예요 — <b>① 텍스트 변환</b>은 이미 끝났고(자동), 지금 고르는 건 <b>② 분석 모델</b>뿐입니다.<br />\n1104\t                    전사된 텍스트 분석은 아래 <b style={{ color: \"var(--color-accent)\" }}>✓추천</b> 모델(무료·미학습)로 충분해요 — 외부학습 Gemini·유료 Claude를 굳이 고를 필요 없습니다.\n1105\t                  </div>\n1106\t                )}\n1107\t                {list.length === 0 && <div className=\"set-note\" style={{ margin: 0 }}>사용 가능한 모델이 없습니다(관리자 모델 관리·키 확인).</div>}\n1108\t                <div style={{ display: \"flex\", flexDirection: \"column\", gap: 4, maxHeight: 320, overflowY: \"auto\" }}>\n1109\t                  {list.map((m) => {\n1110\t                    const nm = m.label.replace(/^↳ 백업 · /, \"\");\n1111\t                    const isReco = m.id === reco;\n1112\t                    const sel = m.id === pickId;\n1113\t                    return (\n1114\t                      <button key={m.id} type=\"button\" onClick={() => setPickId(m.id)} className=\"model-admin-row\"\n1115\t                        style={{ textAlign: \"left\", cursor: \"pointer\", borderRadius: \"var(--border-radius-md)\", border: sel ? \"1px solid var(--color-accent)\" : \"1px solid transparent\", background: sel ? \"color-mix(in srgb, var(--color-accent) 8%, transparent)\" : \"transparent\" }}>\n1116\t                        {/* 동그라미+정보를 좌측 그룹으로 묶음 — 행이 space-between이라 직접 두면 정보와 떨어짐 */}\n1117\t                        <div style={{ display: \"flex\", alignItems: \"center\", gap: 8, minWidth: 0 }}>\n1118\t                          <ModelDot provider={m.provider} />\n1119\t                          <div className=\"model-admin-info\">\n1120\t                            <span className=\"model-admin-name\">{m.kind === \"backup\" ? \"↳ \" : \"\"}{nm}{isReco && <span style={{ marginLeft: 6, fontSize: 10.5, fontWeight: 600, color: \"var(--color-accent)\" }}>추천</span>}<ModelBadges provider={m.provider} /></span>\n1121\t                            <span className=\"model-admin-meta\">{m.kind === \"backup\" ? \"백업\" : \"1순위\"}</span>\n1122\t                          </div>\n1123\t                        </div>\n1124\t                        {sel && <IconCircleCheck size={15} style={{ color: \"var(--color-accent)\" }} />}\n1125\t                      </button>\n1126\t                    );\n1127\t                  })}\n1128\t                </div>\n1129\t                {pickFor.reanalyze && <div className=\"set-note\" style={{ marginTop: 8 }}>원본은 그대로 두고 엔티티·개념 분석을 새로 만듭니다(토큰 사용).</div>}\n1130\t                {/* ★음성·영상 재분석 시 화자 구분 선택★ — 처음엔 안 했어도 다시 분석에서 켤 수 있다(Gemini 필요). */}\n1131\t                {isTranscribedExtractor(pickFor.s.extractor) && geminiAvailable && (\n1132\t                  <label className=\"web-toggle\" style={{ marginTop: 10 }} title=\"음성·영상에서 누가 말했는지 화자1/화자2로 구분 · Gemini로 텍스트 변환되어 외부 전송·학습됩니다(민감 자료엔 쓰지 마세요)\">\n1133\t                    <input type=\"checkbox\" role=\"switch\" aria-checked={pickDiarize} checked={pickDiarize} onChange={(e) => setPickDiarize(e.target.checked)} />\n1134\t                    <span className={`web-toggle-label${pickDiarize ? \" on\" : \"\"}`}>화자 구분 (누가 말했는지 · Gemini) <span className=\"web-state\">{pickDiarize ? \"켜짐\" : \"꺼짐\"}</span></span>\n1135\t                  </label>\n1136\t                )}\n1137\t                <div style={{ display: \"flex\", justifyContent: \"flex-end\", marginTop: 14 }}>\n1138\t                  <button className=\"mat-rowbtn analyze\" disabled={!pickId} onClick={async () => {\n1139\t                    const f = pickFor;\n1140\t                    const prov = analyzeModels.find((m) => m.id === pickId)?.provider;\n1141\t                    if (isPaidProvider(prov) && !await confirmDialog(\"이 모델은 사용량만큼 과금됩니다(OpenAI·Claude API). 이 모델로 분석할까요?\")) return;\n1142\t                    setPickFor(null); if (f.recover) void recover(f.s, pickId); else void analyzeItem(f.s, f.reanalyze, pickId, pickDiarize);\n1143\t                  }}>\n1144\t                    <IconSparkles size={13} />{pickFor.recover ? \"이 모델로 재처리\" : \"이 모델로 분석\"}\n1145\t                  </button>\n1146\t                </div>\n1147\t              </div>\n1148\t            </div>\n1149\t          </div>\n1150\t        );\n1151\t      })()}\n1152\t    </div>\n1153\t  );\n1154\t}\n1155\t"}]},"uuid":"2f72bcb4-ca8f-4f01-a8e4-ad5fa805cbfd","timestamp":"2026-06-28T11:14:51.815Z","toolUseResult":{"type":"text","file":{"filePath":"E:\\llm-wiki\\components\\wiki\\MaterialsTab.tsx","content":"        const procM = modelUserPicked ? analyzeModelId : (it.reco?.model ?? analyzeModelId);\n        const ctrl = new AbortController(); // 항목별 취소(이 항목만 중단하고 다음 항목은 계속)\n        const startedAt = Date.now();\n        setStaged((p) => p.map((x) => (x.key === it.key ? { ...x, status: \"running\", at: startedAt, ctrl, note: uploadMode === \"raw\" ? \"추가 중…\" : (procM ? `분석 중… · ${modelLabel(procM)}` : \"분석 중…\") } : x)));\n        // ★최근 자료(sources) 행도 '처리 중'으로★ — 대기목록과 싱크(같은 자료가 한쪽 '분석중'·다른쪽 '분석 대기'로 어긋나던 문제).\n        if (it.sourceId) setActing((a) => new Map(a).set(it.sourceId!, { label: procM ? modelLabel(procM) : \"\", at: startedAt, ctrl }));\n        let r: { ok: boolean; note: string; queued?: boolean };\n        try {\n          r = await runProcess(it.sourceId!, it.hasText, ctrl.signal);\n        } catch (e) {\n          const aborted = e instanceof Error && e.name === \"AbortError\";\n          r = { ok: false, note: aborted ? \"분석 취소됨\" : `오류: ${toUserMessage(e)}` };\n        }\n        if (it.sourceId) { if (!r.queued) markDuration(it.sourceId, Date.now() - startedAt); setActing((a) => { const c = new Map(a); c.delete(it.sourceId!); return c; }); } // 소요 기록(★비동기 예약은 건너뜀=서버 durationMs가 표시★) + '처리 중' 해제\n        setStaged((p) => p.map((x) => (x.key === it.key ? { ...x, status: r.ok ? \"done\" : \"error\", at: undefined, ctrl: undefined, note: r.note } : x)));\n        // ★각 항목이 끝나는 즉시★ 최근 자료·위키 갱신 — 전부 끝날 때까지 기다리지 않게(완료분이 바로 보임).\n        await load();\n        onDataChanged?.();\n      }\n    } finally {\n      setBusyFor(qScope, false);\n      await load();\n      onDataChanged?.(); // 최종 갱신(위키 트리/리더)\n    }\n  }\n\n  function clearStaged() { setStaged([]); setModelUserPicked(false); } // 비우면 자동추천 재개\n  // 대기 항목 ★개별 삭제★ — 큐에서만 제거('비우기'와 동일 동작, 소스는 그대로). 처리 중 항목은 대신 취소 버튼.\n  function removeStaged(u: Staged) { setStaged((p) => p.filter((x) => x.key !== u.key)); }\n  // 진행 중 분석 취소 — (1) 클라 fetch abort(즉시) + (2) ★서버측 명시 취소★(배포 보강).\n  //   nginx 뒤에서 abort가 req.signal을 발화 못 해도 /cancel이 서버 in-flight 컨트롤러를 직접 abort해 중단을 전파한다.\n  function cancelItem(s: SourceItem) {\n    acting.get(s.id)?.ctrl.abort();\n    setCanceling((c) => new Set(c).add(s.id));\n    fetch(`/api/materials/${s.id}/cancel`, { method: \"POST\" }).catch(() => { /* best-effort */ });\n  }\n\n  // 잔여(PENDING/FAILED) 복구 — 업로드 중 이탈 등으로 남은 항목을 현재 모드로 다시 처리.\n  async function recover(s: SourceItem, modelOverride?: string) {\n    if (acting.has(s.id)) return;\n    const lbl = (uploadMode === \"raw\" && s.hasText) ? \"\" : modelLabel(modelOverride || (modelUserPicked ? analyzeModelId : (s.recoModel ?? analyzeModelId))); // raw 복구는 모델 없음, 팝업/자동 모델\n    const ctrl = new AbortController();\n    const startedAt = Date.now();\n    setActing((a) => new Map(a).set(s.id, { label: lbl, at: startedAt, ctrl }));\n    setNotes((n) => { const c = { ...n }; delete c[s.id]; return c; });\n    let queued = false; // ★비동기 예약이면 클라 측정(≈0)을 박제하지 않음 — 서버 durationMs가 실제 소요를 표시★\n    try {\n      const r = await runProcess(s.id, !!s.hasText, ctrl.signal, modelOverride, true); // ★재처리=음성이면 raw 재전사★\n      queued = !!r.queued;\n      setNotes((n) => ({ ...n, [s.id]: r.note }));\n    } catch (e) {\n      const aborted = e instanceof Error && e.name === \"AbortError\";\n      setNotes((n) => ({ ...n, [s.id]: aborted ? \"분석 취소됨\" : `오류: ${toUserMessage(e)}` }));\n    } finally {\n      if (!queued) markDuration(s.id, Date.now() - startedAt);\n      setActing((a) => { const c = new Map(a); c.delete(s.id); return c; });\n      await load(); onDataChanged?.();\n    }\n  }\n\n  // [AI로 분석]/[다시 분석] 클릭 → ★모델 선택 팝업★(추천 순 정렬·추천 뱃지·1순위/백업 같이). [분석]에서 실제 실행.\n  function openPick(s: SourceItem, reanalyze = false) {\n    if (acting.has(s.id)) return;\n    const reco = (s.recoModel && enabledHas(s.recoModel)) ? s.recoModel : recommendedId; // 항목 추천(없으면 기본 추천)\n    setPickId(reco);\n    setPickDiarize(false); // 재분석 화자 구분 선택 초기화(음성 소스에서만 노출)\n    setPickFor({ s, reanalyze });\n  }\n  // ★재처리도 모델 선택 팝업★ — 분석이 필요한 항목만. raw 복구(텍스트 보존·모델 무관)는 팝업 없이 바로 실행.\n  function openRecoverPick(s: SourceItem) {\n    if (acting.has(s.id)) return;\n    if (uploadMode === \"raw\" && s.hasText) { void recover(s); return; }\n    const reco = (s.recoModel && enabledHas(s.recoModel)) ? s.recoModel : recommendedId;\n    setPickId(reco);\n    setPickFor({ s, reanalyze: false, recover: true });\n  }\n\n  // [AI로 분석] — 엔티티·개념에 반영(옛 raw 페이지는 서버가 대체). modelOverride=팝업에서 고른 모델.\n  async function analyzeItem(s: SourceItem, reanalyze = false, modelOverride?: string, diarize = false) {\n    if (acting.has(s.id)) return;\n    const chosen = modelOverride || (modelUserPicked ? analyzeModelId : undefined); // 고른 모델 우선, 없으면 자동(서버 결정)\n    // ★음성·영상 재분석★: 회의록 처리는 서버가 자동(전사 소스), 화자 구분만 팝업에서 고른 값(diarize 파라미터).\n    const isAudio = isTranscribedExtractor(s.extractor);\n    const startedAt = Date.now();\n    const ctrl = new AbortController();\n    setActing((a) => new Map(a).set(s.id, { label: modelLabel(chosen || s.recoModel || analyzeModelId), at: startedAt, ctrl }));\n    setNotes((n) => { const c = { ...n }; delete c[s.id]; return c; });\n    let queued = false; // ★비동기 예약이면 클라 측정(≈0)을 박제하지 않음 — 서버 durationMs가 실제 소요를 표시★\n    try {\n      const res = await fetch(`/api/materials/${s.id}/analyze`, {\n        method: \"POST\", headers: { \"content-type\": \"application/json\" },\n        body: JSON.stringify({ mode: \"llm\", reanalyze, model: chosen || undefined, diarize: (isAudio && diarize) || undefined }),\n        signal: ctrl.signal,\n      });\n      const data = await res.json();\n      const took = ` · ${fmtElapsed(Date.now() - startedAt)}`; // 완료/실패 시 최종 경과 시간\n      if (!res.ok) setNotes((n) => ({ ...n, [s.id]: `분석 실패: ${data.error || \"\"}${took}` }));\n      else if (data.queued) { queued = true; setNotes((n) => ({ ...n, [s.id]: \"분석 예약됨 · 백그라운드에서 처리 중\" })); } // ★L2 비동기★\n      else {\n        const sw = data.fallback ? \" · 백업 모델로 자동 전환됨\" : \"\";\n        const md = data.usedModel ? ` · 모델 ${modelLabel(data.usedModel)}` : \"\";\n        const dup = data.status === \"SKIPPED_DUP\";\n        const msg = dup ? \"이미 분석된 자료입니다\"\n          : data.status === \"NEEDS_REVIEW\" ? \"검토 대기\" : (reanalyze ? \"다시 분석 반영됨\" : \"AI 분석 반영됨\");\n        setNotes((n) => ({ ...n, [s.id]: msg + md + sw + (dup ? \"\" : took) }));\n      }\n    } catch (e) {\n      const aborted = e instanceof Error && e.name === \"AbortError\";\n      setNotes((n) => ({ ...n, [s.id]: `${aborted ? \"분석 취소됨\" : `오류: ${toUserMessage(e)}`} · ${fmtElapsed(Date.now() - startedAt)}` }));\n    } finally {\n      if (!queued) markDuration(s.id, Date.now() - startedAt); // 완료/실패 최종 소요 — 배지에 남김(★비동기 예약은 서버 durationMs★)\n      setActing((a) => { const c = new Map(a); c.delete(s.id); return c; });\n      await load(); onDataChanged?.(); // 새 엔티티/개념 페이지 → 위키 트리/리더 갱신\n    }\n  }\n\n  // ★원본 그대로 추가★(토큰 0) — AI 정리 없이 원문 텍스트를 위키 페이지로 보존. 분석이 너무 커서 실패한 자료의\n  //   권장 대안(출력 길이 한도와 무관). 기존 FAILED 잡은 최신 APPLIED(RAW_IMPORT) 잡으로 자연스레 대체된다.\n  async function fileAsRaw(s: SourceItem) {\n    if (acting.has(s.id)) return;\n    if (!await confirmDialog(`「${s.title}」을(를) 원본 그대로 추가할까요?\\nAI 정리 없이 원문 텍스트를 위키 페이지로 보존합니다. (토큰 0)`)) return;\n    const ctrl = new AbortController();\n    setActing((a) => new Map(a).set(s.id, { label: \"\", at: Date.now(), ctrl })); // 원본 그대로 = 모델 없음\n    setNotes((n) => { const c = { ...n }; delete c[s.id]; return c; });\n    try {\n      const res = await fetch(`/api/materials/${s.id}/analyze`, {\n        method: \"POST\", headers: { \"content-type\": \"application/json\" }, body: JSON.stringify({ mode: \"raw\" }), signal: ctrl.signal,\n      });\n      const data = await res.json();\n      setNotes((n) => ({ ...n, [s.id]: res.ok ? \"원본 그대로 추가됨 · 토큰 0\" : `추가 실패: ${data.error || \"\"}` }));\n    } catch (e) {\n      setNotes((n) => ({ ...n, [s.id]: `오류: ${toUserMessage(e)}` }));\n    } finally {\n      setActing((a) => { const c = new Map(a); c.delete(s.id); return c; });\n      await load(); onDataChanged?.();\n    }\n  }\n\n  // 선택된 분석 모델의 공급자(외부 전송 경고 판단). 미선택 시 추천값으로 폴백.\n  const provider = analyzeModels.find((m) => m.id === analyzeModelId)?.provider ?? analyzeModel?.provider;\n  const external = uploadMode === \"llm\" && (provider === \"gemini\" || provider === \"openai-compat\" || provider === \"codex\" || provider === \"claude-cli\");\n  // ★화자 구분(diarize)★은 Gemini 전사가 필요(Groq는 화자 구분 미지원). 기본 모델은 Groq을 유지하되,\n  //   화자 구분을 켜면 분석 모델을 ★자동으로 Gemini로 전환★하고(말풍선으로 사유 안내), 끄면 직전 모델로 되돌린다.\n  //   geminiAvailable(=Gemini 키로 모델이 떠 있음)일 때만 토글을 노출한다(키 없으면 화자 구분 자체가 불가).\n  const geminiModel = analyzeModels.find((m) => m.provider === \"gemini\" && m.enabled);\n  const geminiAvailable = !!geminiModel;\n  const onToggleDiarize = (on: boolean) => {\n    setDiarize(on);\n    if (on) {\n      if (geminiModel && provider !== \"gemini\") {\n        preDiarizeRef.current = { model: analyzeModelId, picked: modelUserPicked };\n        setModelUserPicked(true); setAnalyzeModelId(geminiModel.id); setDiarizeSwitched(true);\n      }\n    } else {\n      if (diarizeSwitched && preDiarizeRef.current) {\n        setModelUserPicked(preDiarizeRef.current.picked);\n        if (preDiarizeRef.current.model) setAnalyzeModelId(preDiarizeRef.current.model);\n      }\n      setDiarizeSwitched(false); preDiarizeRef.current = null;\n    }\n  };\n  const procCount = staged.filter((s) => s.status === \"staged\" && s.sourceId).length;\n  // I 배치 결과 요약(§I) — 대기 항목의 종결 상태를 신규/중복/실패로 집계(순수 헬퍼). done=신규, skip=중복, error=실패.\n  const batchText = batchSummaryText(summarizeBatch(staged.map((u) =>\n    u.status === \"done\" ? \"APPLIED\" : u.status === \"skip\" ? \"SKIPPED_DUP\" : u.status === \"error\" ? \"FAILED\" : \"RUNNING\")));\n  // H 파일별/그룹 추천(§H) — 추천 모델이 ★둘 이상으로 갈리면★ 그룹 요약을 보여 형식 제각각 파일의 추천 차이를 가시화.\n  const stagedGroups = groupStagedByModel(\n    staged.filter((s) => s.sourceId && s.reco).map((s) => ({ id: s.sourceId!, recoModel: s.reco!.model, title: s.name })),\n  );\n  // 화자 구분 토글 노출 조건: ★음성·영상이 대기 목록에 있고★ + ★분석 모델로 Gemini 선택★일 때만(Groq는 화자분리 미지원).\n  const AV_EXTS = [\"mp3\", \"wav\", \"m4a\", \"flac\", \"ogg\", \"mpga\", \"mp4\", \"mpeg\", \"webm\", \"mov\", \"mkv\", \"avi\", \"m4v\", \"wmv\", \"flv\"];\n  const hasAudioVideoStaged = staged.some((s) => AV_EXTS.includes((s.name.toLowerCase().match(/\\.([a-z0-9]+)$/)?.[1]) || \"\"));\n  // ★음성·영상이 대기열에서 모두 빠지면 화자 구분 토글·자동전환·말풍선을 초기화★ — 지운 뒤에도 말풍선/상태가 남던 버그 수정.\n  useEffect(() => {\n    if (hasAudioVideoStaged || !(diarize || diarizeSwitched)) return;\n    if (diarizeSwitched && preDiarizeRef.current) {\n      setModelUserPicked(preDiarizeRef.current.picked);\n      if (preDiarizeRef.current.model) setAnalyzeModelId(preDiarizeRef.current.model);\n    }\n    setDiarize(false); setDiarizeSwitched(false); preDiarizeRef.current = null;\n  }, [hasAudioVideoStaged, diarize, diarizeSwitched]);\n  const accept = policy?.accept ?? (\".md,.markdown,.txt,.csv,.html,.htm,.json,.pdf,.docx,.doc,.xlsx,.xls,.pptx,.odt,.ods,.odp,.rtf,.hwp,.hwpx,.png,.jpg,.jpeg,.gif,.webp\" + convertExts.map((e) => `,.${e}`).join(\"\"));\n\n  return (\n    <div className={`mat-wrap${hidden ? \" hidden\" : \"\"}`}>\n      <div className=\"mat-col mat-col-upload\">\n        <div className=\"mat-card\">\n          <div className=\"mat-card-head\"><IconUpload size={15} />자료 추가</div>\n          <p className=\"mat-desc\">\n            올리면 먼저 <b>대기 목록</b>에 담깁니다. 처리 방식을 고르고 <b>[처리 시작]</b>을 눌러야 위키에 반영됩니다. 원본은 항상 그대로 보관됩니다.\n          </p>\n\n          {/* 처리 방식 선택 — 분석(엔티티·개념 연결) vs 원본 그대로(토큰 0 보관) */}\n          <div className=\"mat-mode\">\n            <button type=\"button\" className={`mat-mode-btn${uploadMode === \"llm\" ? \" on\" : \"\"}`} disabled={busy} onClick={() => setUploadMode(\"llm\")}>\n              분석해서 추가<span className=\"mat-mode-sub\">엔티티·개념에 반영 · 다른 자료와 연결</span>\n            </button>\n            <button type=\"button\" className={`mat-mode-btn${uploadMode === \"raw\" ? \" on\" : \"\"}`} disabled={busy} onClick={() => setUploadMode(\"raw\")}>\n              원본 그대로 추가<span className=\"mat-mode-sub\">topics에 그대로 보관 · 토큰 0 · 연결 안 됨</span>\n            </button>\n          </div>\n\n          {/* 익명 업로드 — 동료 화면엔 '익명 기여자'로, 단 작성자는 감사 기록에 유지(관리자 확인 가능). 토글(다크모드 일관). */}\n          <div className=\"mat-anon\">\n            <label className={`web-toggle${busy ? \" disabled\" : \"\"}`} title=\"동료에겐 ‘익명 기여자’로 표시 · 작성자는 감사 기록에 유지(관리자 확인 가능)\">\n              <input type=\"checkbox\" role=\"switch\" aria-checked={anonUpload} checked={anonUpload} disabled={busy} onChange={(e) => setAnonUpload(e.target.checked)} />\n              <span className={`web-toggle-label${anonUpload ? \" on\" : \"\"}`}>익명으로 올리기 <span className=\"web-state\">{anonUpload ? \"켜짐\" : \"꺼짐\"}</span></span>\n            </label>\n            <span className=\"mat-anon-sub\">동료에겐 ‘익명 기여자’ · 작성자는 감사 기록에 유지</span>\n          </div>\n\n          {/* 회의록 처리는 ★토글 없이 자동★(전사 소스는 서버가 무조건 회의록으로). 사용자에겐 안내만. */}\n          {hasAudioVideoStaged && (\n            <div className=\"mat-switch-note\"><IconInfoCircle size={13} />\n              <span>음성·영상은 <b>회의록(요약·결정·할일·안건)</b>으로 자동 정리됩니다.{geminiAvailable ? \" 누가 말했는지 나누려면 아래 ‘화자 구분’을 켜세요.\" : \"\"}</span>\n            </div>\n          )}\n\n          {/* 화자 구분(선택) — '누가 말했는지'(화자1/2). Gemini 전용(Groq 미지원)·staged 음성·영상 + Gemini 키 있을 때.\n              켜면 분석 모델을 자동으로 Gemini로 전환(말풍선 안내)·끄면 직전 모델 복귀. [처리 시작] 때 적용. */}\n          {hasAudioVideoStaged && geminiAvailable && (\n            <div className=\"mat-anon\">\n              <label className={`web-toggle${busy ? \" disabled\" : \"\"}`} title=\"음성·영상에서 '누가 말했는지'를 화자1/화자2로 구분합니다. Gemini로 텍스트 변환되어 데이터가 Google로 전송·학습됩니다(민감 자료엔 쓰지 마세요).\">\n                <input type=\"checkbox\" role=\"switch\" aria-checked={diarize} checked={diarize} disabled={busy} onChange={(e) => onToggleDiarize(e.target.checked)} />\n                <span className={`web-toggle-label${diarize ? \" on\" : \"\"}`}>화자 구분 <span className=\"web-state\">{diarize ? \"켜짐\" : \"꺼짐\"}</span></span>\n              </label>\n              <span className=\"mat-anon-sub\"><b>누가 말했는지</b> 화자1/2로 구분(선택) · Gemini로 텍스트 변환 → 외부 전송·학습</span>\n            </div>\n          )}\n\n          {/* 분석 모델 — ★자료를 판단해 자동 추천★(셀렉트에 미리 잡힘). 원하면 직접 바꿔 분석. ⓘ에 사유. */}\n          {uploadMode === \"llm\" && analyzeModels.length > 0 && (\n            <div className=\"mat-automodel\">\n              <IconSparkles size={13} />\n              <span className=\"mat-automodel-lbl\">분석 모델</span>\n              <ModelSelect models={analyzeModels} value={analyzeModelId} variant=\"mat\" title=\"자료를 분석할 모델\"\n                onChange={(id) => { setModelUserPicked(true); setAnalyzeModelId(id); setDiarizeSwitched(false); }} />\n              {!modelUserPicked && effReco && <span className=\"mat-automodel-auto\">자동</span>}\n              {(effReco || analyzeModel) && (\n                <span className=\"mat-automodel-info\" tabIndex={0} aria-label={(effReco || analyzeModel)!.reason}>\n                  <IconInfoCircle size={13} />\n                  <span className=\"mat-automodel-tip\" role=\"tooltip\">\n                    {modelUserPicked\n                      ? `직접 고른 모델로 분석합니다.${effReco ? `\\n(자료 기준 자동 추천: ${effReco.label})` : \"\"}`\n                      : `자료를 판단해 자동 추천한 모델입니다.\\n${(effReco || analyzeModel)!.reason}`}\n                  </span>\n                </span>\n              )}\n            </div>\n          )}\n\n          {/* 화자 구분이 모델을 Gemini로 자동 전환했을 때 ★왜 바뀌었는지★ 말풍선으로 안내. */}\n          {diarizeSwitched && uploadMode === \"llm\" && (\n            <div className=\"mat-diarize-note\" role=\"status\">\n              <IconInfoCircle size={13} />\n              <span>화자 구분을 켜서 분석 모델을 <b>Gemini</b>로 바꿨어요 — <b>Groq은 화자 구분을 못 해서요</b>. 화자 구분을 끄면 Groq으로 돌아갑니다. (Gemini는 외부 전송·학습)</span>\n            </div>\n          )}\n\n          {uploadMode === \"raw\" && (\n            <div className=\"mat-switch-note\"><IconArrowsExchange size={13} />\n              <span>분석 없이 원본을 그대로 위키에 보관합니다(<b>토큰 0</b>). 엔티티·개념엔 정리되지 않으니, 연결이 필요하면 <b>분석해서 추가</b>를 쓰거나 나중에 목록에서 <b>AI로 분석</b>을 누르세요. (텍스트 없는 PDF·이미지는 자동으로 분석됩니다.)</span>\n            </div>\n          )}\n\n          {external && (\n            <div className=\"gemini-warn\"><IconAlertTriangle size={13} />\n              <span>{provider === \"gemini\"\n                ? <>Gemini(외부)는 빠르지만 <b>올린 자료가 Google로 전송·학습</b>됩니다. <br />민감 자료는 올리지 마세요.</>\n                : <>이 모델(외부)은 빠르지만 <b>올린 자료가 외부 서버로 전송</b>됩니다. <br />민감 자료는 올리지 마세요.</>}</span>\n            </div>\n          )}\n\n          <div className={`mat-drop${busy ? \" busy\" : \"\"}${dragOver ? \" dragover\" : \"\"}`}\n            onClick={() => { if (!busy) fileRef.current?.click(); }}\n            onDragOver={(e) => { e.preventDefault(); if (!busy) setDragOver(true); }}\n            onDragLeave={() => setDragOver(false)}\n            onDrop={onDrop}>\n            <IconUpload size={20} />\n            <span><b>{policy?.textOnly ? \"텍스트 파일(.txt·.md)을 끌어다 놓거나\" : \"파일을 끌어다 놓거나\"}</b> 클릭해 선택<br /><span className=\"mat-multi\">(여러 개 가능 · 대기 목록에 담김)</span></span>\n            <input ref={fileRef} type=\"file\" hidden multiple disabled={busy} accept={accept} onChange={onPickFile} />\n          </div>\n          <div className={`mat-formats${policy?.textOnly ? \" mat-formats-note\" : \"\"}`}>\n            {policy?.note ?? \"지원 형식: 텍스트(.md .txt) · PDF · 이미지 · 한글 · Word · Excel · PowerPoint · 오픈오피스 · RTF · HTML\"}\n          </div>\n\n          <div className=\"mat-or\">또는 직접 입력</div>\n          <input className=\"mat-input\" placeholder=\"제목 (단건 업로드/직접 입력 시, 비우면 자동)\" value={title} maxLength={80} onChange={(e) => setTitle(e.target.value)} />\n          <textarea className=\"mat-input mat-textarea\" placeholder=\"여기에 내용을 붙여넣으세요…\" value={text} onChange={(e) => setText(e.target.value)} />\n          <button className=\"mat-stage-add\" onClick={stageText} disabled={busy || !text.trim()}>대기 목록에 추가</button>\n\n          {/* 대기(스테이징) 목록 */}\n          {staged.length > 0 && (\n            <div className=\"mat-queue\">\n              <div className=\"mat-queue-head\">대기 {staged.filter((u) => u.status === \"done\" || u.status === \"skip\").length}/{staged.length} 처리됨{batchText && <span style={{ marginLeft: 8, fontWeight: 400, opacity: 0.85 }}>· {batchText}</span>}</div>\n              {staged.map((u) => {\n                const cls = u.status === \"running\" || u.status === \"staging\" ? \"running\" : u.status === \"error\" ? \"error\" : u.status === \"staged\" ? \"pending\" : \"done\";\n                const statusWord = u.status === \"staging\" ? \"올리는 중…\" : u.status === \"staged\" ? \"대기\" : u.status === \"running\" ? (u.note || \"처리 중…\") : u.status === \"error\" ? \"실패\" : \"완료\";\n                // 에러·결과 메모는 길 수 있어 ★별도 줄에서 전부 줄바꿈★으로 보여준다(한 줄 잘림 방지).\n                const detail = (u.status === \"error\" || u.status === \"done\" || u.status === \"skip\") ? (u.note || \"\") : \"\";\n                return (\n                  <div key={u.key} className={`mat-queue-item ${cls}`}>\n                    <div className=\"mq-top\">\n                      <span className=\"mq-dot\" />\n                      <span className=\"mq-name\" title={u.name}>{u.name}</span>\n                      <span className=\"mq-status\">{statusWord}{u.status === \"running\" && u.at ? ` · ${fmtElapsed(now - u.at)}` : \"\"}</span>\n                      {u.status === \"running\" && u.ctrl && (\n                        <button className=\"mq-cancel\" onClick={() => { u.ctrl?.abort(); if (u.sourceId) fetch(`/api/materials/${u.sourceId}/cancel`, { method: \"POST\" }).catch(() => {}); }} title=\"분석 취소 (서버 작업도 중단)\"><IconX size={11} />취소</button>\n                      )}\n                      {u.status !== \"running\" && (\n                        <button className=\"mq-del\" onClick={() => removeStaged(u)} title=\"대기 목록에서 삭제\"><IconX size={12} /></button>\n                      )}\n                    </div>\n                    {detail && <div className=\"mq-detail\">{detail}</div>}\n                  </div>\n                );\n              })}\n            </div>\n          )}\n\n          {err && <div className=\"mat-banner err\"><IconAlertTriangle size={14} />{err}</div>}\n\n          {/* ★처리 직전 분석 모델 — [처리 시작] 바로 위에 다시 노출. 폼 위쪽 셀렉트가 드롭존 위라 안 보일 수 있어\n              (특히 음성·영상은 전사→분석 2단계라 분석 모델을 여기서 확인·변경하게 한다). 위 셀렉트와 상태 공유. */}\n          {uploadMode === \"llm\" && procCount > 0 && analyzeModels.length > 0 && (\n            <div className=\"mat-automodel mat-automodel-run\">\n              <IconSparkles size={13} />\n              <span className=\"mat-automodel-lbl\">분석 모델</span>\n              <ModelSelect models={analyzeModels} value={analyzeModelId} variant=\"mat\" title=\"이 자료를 분석할 모델\"\n                onChange={(id) => { setModelUserPicked(true); setAnalyzeModelId(id); setDiarizeSwitched(false); }} />\n              {!modelUserPicked && effReco && <span className=\"mat-automodel-auto\">자동</span>}\n            </div>\n          )}\n          {/* H: 추천 모델이 둘 이상으로 갈리는 혼합 업로드면 그룹 요약을 안내(형식별 추천 차이 가시화). 적용은 위 분석 모델 1개(그룹별 오버라이드는 후속). */}\n          {uploadMode === \"llm\" && stagedGroups.length > 1 && (\n            <p className=\"set-note\" style={{ margin: \"2px 0 6px\" }}>\n              파일별 추천: {stagedGroups.map((g) => `${modelLabel(g.model)} ${g.ids.length}개`).join(\" · \")}\n            </p>\n          )}\n\n          <button className=\"mat-submit\" onClick={runStaged} disabled={busy || acting.size > 0 || procCount === 0}>\n            {busy ? <><IconClockHour4 size={14} />{uploadMode === \"raw\" ? \"추가 중…\" : \"분석 중…\"}</> : (\n              procCount === 0 ? \"처리 시작 (대기 항목 없음)\" : `${uploadMode === \"raw\" ? \"원본 그대로 추가\" : \"분석해서 추가\"} (${procCount}개)`\n            )}\n          </button>\n          {/* 다른 자료를 처리(분석/원본추가)하는 중엔 대기 비우기를 숨긴다 — 처리 중 실수 클릭으로 인한 혼동 방지.\n              (분석은 서버에서 끝까지 돌므로 비워도 취소되진 않지만, UI 혼동을 막는다.) */}\n          {staged.length > 0 && !busy && (\n            <button className=\"mat-stage-clear\" onClick={clearStaged}>대기 목록 비우기 ({staged.length})</button>\n          )}\n        </div>\n      </div>\n\n      <div className=\"mat-col mat-col-list\">\n        <div className=\"mat-card\">\n          <div className=\"mat-card-head\"><IconFileText size={15} />최근 자료 {sources.length > 0 && `(${sources.length})`}</div>\n          {delNote && <div className=\"mat-banner muted\" style={{ marginBottom: 10 }}>{delNote}</div>}\n          {sources.length === 0 ? (\n            <p className=\"mat-desc\">아직 올린 자료가 없습니다.</p>\n          ) : (\n            <div className=\"mat-tree\">\n              {groupByMonthThenDay(sources).map(([month, days], mi) => (\n                <MonthGroup key={month} month={month} count={days.reduce((n, [, it]) => n + it.length, 0)} defaultOpen={mi === 0}>\n                  {days.map(([ym, items], di) => (\n                    <SourceGroup key={ym} ym={ym} items={items} defaultOpen={mi === 0 && di === 0} onArchive={archiveSource} onWiki={openWiki}\n                      onRecover={openRecoverPick} onAnalyze={openPick} onFileRaw={fileAsRaw} onCancel={cancelItem}\n                      deleting={deleting} acting={acting} canceling={canceling} now={now} notes={notes} durations={durations} canManage={canManage}\n                      seenNew={seenNew} onSeen={(s) => dismissNew(`mat:${s.id}`)} />\n                  ))}\n                </MonthGroup>\n              ))}\n            </div>\n          )}\n\n          {/* 아카이브(소프트 삭제) 섹션 — 룸 관리자만. 펼칠 때 조회. */}\n          {canManage && (\n            <div className=\"mat-archive\">\n              <button className=\"mat-archive-head\" onClick={() => { const n = !showArchived; setShowArchived(n); if (n) loadArchived(); }}>\n                <IconChevronRight size={13} className={`tree-caret${showArchived ? \" open\" : \"\"}`} />\n                <IconArchive size={14} />아카이브{archivedSources.length > 0 ? ` (${archivedSources.length})` : \"\"}\n              </button>\n              {showArchived && (\n                archivedSources.length === 0 ? (\n                  <p className=\"mat-desc mat-archive-empty\">아카이브된 자료가 없습니다.</p>\n                ) : (\n                  <div className=\"mat-tree\">\n                    {groupByMonthThenDay(archivedSources).map(([month, days], mi) => (\n                      <MonthGroup key={month} month={month} count={days.reduce((n, [, it]) => n + it.length, 0)} defaultOpen={mi === 0}>\n                        {days.map(([ym, items], di) => (\n                          <SourceGroup key={ym} ym={ym} items={items} defaultOpen={mi === 0 && di === 0} archivedMode canManage={canManage}\n                            onArchive={archiveSource} onWiki={openWiki} onRecover={openRecoverPick} onAnalyze={openPick} onFileRaw={fileAsRaw} onCancel={cancelItem}\n                            onRestore={restoreSource} onPurge={purgeSource}\n                            deleting={deleting} acting={acting} now={now} notes={notes} durations={durations}\n                            seenNew={seenNew} onSeen={(s) => dismissNew(`mat:${s.id}`)} />\n                        ))}\n                      </MonthGroup>\n                    ))}\n                  </div>\n                )\n              )}\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* AI로 분석/다시 분석 — 모델 선택 팝업(추천 순 정렬·추천 뱃지·사용가능 1순위/백업 같이). */}\n      {pickFor && (() => {\n        const reco = (pickFor.s.recoModel && enabledHas(pickFor.s.recoModel)) ? pickFor.s.recoModel : recommendedId;\n        // ★그룹(1순위+그 백업)을 통째로★ 정렬 — 추천이 속한 그룹만 최상단으로, 나머지·그룹 내부 순서는 원본 유지(안정 정렬).\n        //   기존엔 추천만 위로 끌어올리고 모든 백업을 아래로 보내 ‘추천의 백업’이 추천과 떨어져 꼬였다.\n        const groupOf = (m: ModelOpt) => (m.kind === \"backup\" ? (m.backupOf || m.id) : m.id);\n        const recoM = analyzeModels.find((m) => m.id === reco);\n        const recoGroup = recoM ? groupOf(recoM) : reco;\n        const list = analyzeModels.filter((m) => m.enabled).slice()\n          .sort((a, b) => (groupOf(a) === recoGroup ? 0 : 1) - (groupOf(b) === recoGroup ? 0 : 1));\n        return (\n          <div className=\"modal-overlay\" onClick={() => setPickFor(null)}>\n            <div className=\"set-modal-card\" style={{ width: 460, maxWidth: \"calc(100% - 32px)\" }} onClick={(e) => e.stopPropagation()}>\n              <div className=\"set-modal-head\">\n                <span className=\"set-modal-title\">{pickFor.recover ? \"재처리\" : pickFor.reanalyze ? \"다시 분석\" : \"AI로 분석\"} · 모델 선택</span>\n                <button className=\"modal-x\" onClick={() => setPickFor(null)} aria-label=\"닫기\"><IconX size={17} /></button>\n              </div>\n              <div style={{ padding: \"12px 18px 16px\" }}>\n                <div className=\"mat-item-title\" title={pickFor.s.title} style={{ marginBottom: 8 }}>「{pickFor.s.title}」</div>\n                {/* ★음성·영상 = 전사+분석 2단계★ — 사용자는 어느 모델이 전사용인지 모를 수 있어 명시 + 추천(무료·미학습)을 강하게 어필. */}\n                {isTranscribedExtractor(pickFor.s.extractor) && (\n                  <div className=\"set-note\" style={{ margin: \"0 0 10px\", lineHeight: 1.55 }}>\n                    🎙 <b>음성·영상 자료는 2단계</b>예요 — <b>① 텍스트 변환</b>은 이미 끝났고(자동), 지금 고르는 건 <b>② 분석 모델</b>뿐입니다.<br />\n                    전사된 텍스트 분석은 아래 <b style={{ color: \"var(--color-accent)\" }}>✓추천</b> 모델(무료·미학습)로 충분해요 — 외부학습 Gemini·유료 Claude를 굳이 고를 필요 없습니다.\n                  </div>\n                )}\n                {list.length === 0 && <div className=\"set-note\" style={{ margin: 0 }}>사용 가능한 모델이 없습니다(관리자 모델 관리·키 확인).</div>}\n                <div style={{ display: \"flex\", flexDirection: \"column\", gap: 4, maxHeight: 320, overflowY: \"auto\" }}>\n                  {list.map((m) => {\n                    const nm = m.label.replace(/^↳ 백업 · /, \"\");\n                    const isReco = m.id === reco;\n                    const sel = m.id === pickId;\n                    return (\n                      <button key={m.id} type=\"button\" onClick={() => setPickId(m.id)} className=\"model-admin-row\"\n                        style={{ textAlign: \"left\", cursor: \"pointer\", borderRadius: \"var(--border-radius-md)\", border: sel ? \"1px solid var(--color-accent)\" : \"1px solid transparent\", background: sel ? \"color-mix(in srgb, var(--color-accent) 8%, transparent)\" : \"transparent\" }}>\n                        {/* 동그라미+정보를 좌측 그룹으로 묶음 — 행이 space-between이라 직접 두면 정보와 떨어짐 */}\n                        <div style={{ display: \"flex\", alignItems: \"center\", gap: 8, minWidth: 0 }}>\n                          <ModelDot provider={m.provider} />\n                          <div className=\"model-admin-info\">\n                            <span className=\"model-admin-name\">{m.kind === \"backup\" ? \"↳ \" : \"\"}{nm}{isReco && <span style={{ marginLeft: 6, fontSize: 10.5, fontWeight: 600, color: \"var(--color-accent)\" }}>추천</span>}<ModelBadges provider={m.provider} /></span>\n                            <span className=\"model-admin-meta\">{m.kind === \"backup\" ? \"백업\" : \"1순위\"}</span>\n                          </div>\n                        </div>\n                        {sel && <IconCircleCheck size={15} style={{ color: \"var(--color-accent)\" }} />}\n                      </button>\n                    );\n                  })}\n                </div>\n                {pickFor.reanalyze && <div className=\"set-note\" style={{ marginTop: 8 }}>원본은 그대로 두고 엔티티·개념 분석을 새로 만듭니다(토큰 사용).</div>}\n                {/* ★음성·영상 재분석 시 화자 구분 선택★ — 처음엔 안 했어도 다시 분석에서 켤 수 있다(Gemini 필요). */}\n                {isTranscribedExtractor(pickFor.s.extractor) && geminiAvailable && (\n                  <label className=\"web-toggle\" style={{ marginTop: 10 }} title=\"음성·영상에서 누가 말했는지 화자1/화자2로 구분 · Gemini로 텍스트 변환되어 외부 전송·학습됩니다(민감 자료엔 쓰지 마세요)\">\n                    <input type=\"checkbox\" role=\"switch\" aria-checked={pickDiarize} checked={pickDiarize} onChange={(e) => setPickDiarize(e.target.checked)} />\n                    <span className={`web-toggle-label${pickDiarize ? \" on\" : \"\"}`}>화자 구분 (누가 말했는지 · Gemini) <span className=\"web-state\">{pickDiarize ? \"켜짐\" : \"꺼짐\"}</span></span>\n                  </label>\n                )}\n                <div style={{ display: \"flex\", justifyContent: \"flex-end\", marginTop: 14 }}>\n                  <button className=\"mat-rowbtn analyze\" disabled={!pickId} onClick={async () => {\n                    const f = pickFor;\n                    const prov = analyzeModels.find((m) => m.id === pickId)?.provider;\n                    if (isPaidProvider(prov) && !await confirmDialog(\"이 모델은 사용량만큼 과금됩니다(OpenAI·Claude API). 이 모델로 분석할까요?\")) return;\n                    setPickFor(null); if (f.recover) void recover(f.s, pickId); else void analyzeItem(f.s, f.reanalyze, pickId, pickDiarize);\n                  }}>\n                    <IconSparkles size={13} />{pickFor.recover ? \"이 모델로 재처리\" : \"이 모델로 분석\"}\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        );\n      })()}\n    </div>\n  );\n}\n","numLines":480,"startLine":676,"totalLines":1155}},"sourceToolAssistantUUID":"5a5b429a-8a09-47a4-a79e-ba4ca17fb9c5","userType":"external","entrypoint":"cli","cwd":"E:\\llm-wiki","sessionId":"6b03d3cf-704b-46f4-952d-418e6244ad85","version":"2.1.195","gitBranch":"feat/backlog-chunked-and-storage","slug":"serene-singing-papert"}
