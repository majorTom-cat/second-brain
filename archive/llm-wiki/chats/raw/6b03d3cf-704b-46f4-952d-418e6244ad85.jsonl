{"parentUuid":"6ddf4e4e-894d-4bb8-a398-cf1d7520e16b","isSidechain":false,"promptId":"72c47ca9-455c-407a-8764-3ca32f2b9ca5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Noy7qLLv9eGiexqz8pknJE","type":"tool_result","content":"1\t// ── I 배치 결과 요약 (PLAN-multi-upload §I) ──────────────────────────────────────────────\n2\t// 멀티 업로드/분석 후 \"신규 N · 중복 M · 실패 K · 검토 L\" 배너용 순수 집계. dedup(중복)은 분석 시점에\n3\t//   SKIPPED_DUP로 드러나므로(ingestText), 자료들의 ★잡 상태★를 분류해 카운트한다. UI 배너는 후속.\n4\t\n5\texport interface BatchSummary {\n6\t  applied: number;  // 신규 반영(APPLIED)\n7\t  duplicate: number; // 이미 분석된 중복(SKIPPED_DUP)\n8\t  failed: number;   // 실패(FAILED)\n9\t  review: number;   // 검토 대기(NEEDS_REVIEW)\n10\t  pending: number;  // 처리 중/대기(QUEUED·RUNNING·APPLYING·PENDING·UNANALYZED 등)\n11\t  total: number;\n12\t}\n13\t\n14\t/** 자료들의 상태 문자열 목록 → 분류 카운트(순수). 알 수 없는/진행 상태는 pending으로 모은다. */\n15\texport function summarizeBatch(statuses: (string | null | undefined)[]): BatchSummary {\n16\t  const s: BatchSummary = { applied: 0, duplicate: 0, failed: 0, review: 0, pending: 0, total: statuses.length };\n17\t  for (const st of statuses) {\n18\t    switch (st) {\n19\t      case \"APPLIED\": s.applied++; break;\n20\t      case \"SKIPPED_DUP\": s.duplicate++; break;\n21\t      case \"FAILED\": s.failed++; break;\n22\t      case \"NEEDS_REVIEW\": s.review++; break;\n23\t      default: s.pending++; break; // QUEUED/RUNNING/APPLYING/PENDING/UNANALYZED/null 등\n24\t    }\n25\t  }\n26\t  return s;\n27\t}\n28\t\n29\t/** 사람이 읽는 한 줄 요약(\"신규 2 · 중복 1 · 실패 0\") — 0인 항목은 생략. 비면 빈 문자열. */\n30\texport function batchSummaryText(s: BatchSummary): string {\n31\t  const parts: string[] = [];\n32\t  if (s.applied) parts.push(`신규 ${s.applied}`);\n33\t  if (s.duplicate) parts.push(`중복 ${s.duplicate}`);\n34\t  if (s.review) parts.push(`검토 대기 ${s.review}`);\n35\t  if (s.failed) parts.push(`실패 ${s.failed}`);\n36\t  if (s.pending) parts.push(`처리 중 ${s.pending}`);\n37\t  return parts.join(\" · \");\n38\t}\n39\t\n40\t// ── H 파일별/그룹 추천 (PLAN-multi-upload §H) ──────────────────────────────────────────────\n41\t// 멀티 업로드 시 형식 제각각 파일을 ★추천 모델별 그룹★으로 묶어(\"전사본 2→Groq\", \"스캔PDF 1→Gemini\")\n42\t//   그룹 단위 오버라이드. 기본=파일별 서버 reco. 순수 그룹화(입력순 안정) — UI 결선은 후속.\n43\texport interface StagedItem { id: number; recoModel: string; title?: string }\n44\texport interface ModelGroup { model: string; ids: number[]; titles: string[] }\n45\t\n46\t/** 스테이징 파일들을 추천 모델별로 묶는다(순수). 그룹은 ★처음 등장한 모델 순서★ 유지(입력 안정). */\n47\texport function groupStagedByModel(items: StagedItem[]): ModelGroup[] {\n48\t  const order: string[] = [];\n49\t  const byModel = new Map<string, ModelGroup>();\n50\t  for (const it of items) {\n51\t    const m = it.recoModel || \"(미지정)\";\n52\t    let g = byModel.get(m);\n53\t    if (!g) { g = { model: m, ids: [], titles: [] }; byModel.set(m, g); order.push(m); }\n54\t    g.ids.push(it.id);\n55\t    g.titles.push(it.title ?? String(it.id));\n56\t  }\n57\t  return order.map((m) => byModel.get(m)!);\n58\t}\n59\t"}]},"uuid":"6c71a75c-7057-4fe8-8b01-8c4bd50778d2","timestamp":"2026-06-28T11:17:04.016Z","toolUseResult":{"type":"text","file":{"filePath":"E:\\llm-wiki\\lib\\uploadBatch.ts","content":"// ── I 배치 결과 요약 (PLAN-multi-upload §I) ──────────────────────────────────────────────\n// 멀티 업로드/분석 후 \"신규 N · 중복 M · 실패 K · 검토 L\" 배너용 순수 집계. dedup(중복)은 분석 시점에\n//   SKIPPED_DUP로 드러나므로(ingestText), 자료들의 ★잡 상태★를 분류해 카운트한다. UI 배너는 후속.\n\nexport interface BatchSummary {\n  applied: number;  // 신규 반영(APPLIED)\n  duplicate: number; // 이미 분석된 중복(SKIPPED_DUP)\n  failed: number;   // 실패(FAILED)\n  review: number;   // 검토 대기(NEEDS_REVIEW)\n  pending: number;  // 처리 중/대기(QUEUED·RUNNING·APPLYING·PENDING·UNANALYZED 등)\n  total: number;\n}\n\n/** 자료들의 상태 문자열 목록 → 분류 카운트(순수). 알 수 없는/진행 상태는 pending으로 모은다. */\nexport function summarizeBatch(statuses: (string | null | undefined)[]): BatchSummary {\n  const s: BatchSummary = { applied: 0, duplicate: 0, failed: 0, review: 0, pending: 0, total: statuses.length };\n  for (const st of statuses) {\n    switch (st) {\n      case \"APPLIED\": s.applied++; break;\n      case \"SKIPPED_DUP\": s.duplicate++; break;\n      case \"FAILED\": s.failed++; break;\n      case \"NEEDS_REVIEW\": s.review++; break;\n      default: s.pending++; break; // QUEUED/RUNNING/APPLYING/PENDING/UNANALYZED/null 등\n    }\n  }\n  return s;\n}\n\n/** 사람이 읽는 한 줄 요약(\"신규 2 · 중복 1 · 실패 0\") — 0인 항목은 생략. 비면 빈 문자열. */\nexport function batchSummaryText(s: BatchSummary): string {\n  const parts: string[] = [];\n  if (s.applied) parts.push(`신규 ${s.applied}`);\n  if (s.duplicate) parts.push(`중복 ${s.duplicate}`);\n  if (s.review) parts.push(`검토 대기 ${s.review}`);\n  if (s.failed) parts.push(`실패 ${s.failed}`);\n  if (s.pending) parts.push(`처리 중 ${s.pending}`);\n  return parts.join(\" · \");\n}\n\n// ── H 파일별/그룹 추천 (PLAN-multi-upload §H) ──────────────────────────────────────────────\n// 멀티 업로드 시 형식 제각각 파일을 ★추천 모델별 그룹★으로 묶어(\"전사본 2→Groq\", \"스캔PDF 1→Gemini\")\n//   그룹 단위 오버라이드. 기본=파일별 서버 reco. 순수 그룹화(입력순 안정) — UI 결선은 후속.\nexport interface StagedItem { id: number; recoModel: string; title?: string }\nexport interface ModelGroup { model: string; ids: number[]; titles: string[] }\n\n/** 스테이징 파일들을 추천 모델별로 묶는다(순수). 그룹은 ★처음 등장한 모델 순서★ 유지(입력 안정). */\nexport function groupStagedByModel(items: StagedItem[]): ModelGroup[] {\n  const order: string[] = [];\n  const byModel = new Map<string, ModelGroup>();\n  for (const it of items) {\n    const m = it.recoModel || \"(미지정)\";\n    let g = byModel.get(m);\n    if (!g) { g = { model: m, ids: [], titles: [] }; byModel.set(m, g); order.push(m); }\n    g.ids.push(it.id);\n    g.titles.push(it.title ?? String(it.id));\n  }\n  return order.map((m) => byModel.get(m)!);\n}\n","numLines":59,"startLine":1,"totalLines":59}},"sourceToolAssistantUUID":"6ddf4e4e-894d-4bb8-a398-cf1d7520e16b","userType":"external","entrypoint":"cli","cwd":"E:\\llm-wiki","sessionId":"6b03d3cf-704b-46f4-952d-418e6244ad85","version":"2.1.195","gitBranch":"fe