{"parentUuid":"0b318f21-38b7-4fc4-bd36-15ff8530a501","isSidechain":false,"promptId":"72c47ca9-455c-407a-8764-3ca32f2b9ca5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012eHFbdZwpUYJQzUNvBFzSV","type":"tool_result","content":"1\t// 전사(STT) 관련 ★클라이언트·서버 공용★ 순수 헬퍼 — 서버 전용 의존(child_process 등) 없이 클라 번들에 안전.\n2\t// (lib/stt.ts는 convert.ts→node:child_process를 끌고 와 클라 컴포넌트에서 import 불가 → 순수 판별만 여기로 분리.)\n3\t\n4\t/**\n5\t * extractor가 음성·영상 전사 소스인지 — 모델 자동추천에서 byteSize 크기 휴리스틱을 건너뛰거나\n6\t * (전사 소스 byteSize는 '오디오 바이트'라 텍스트 길이가 아님) UI/회의모드에서 음성 소스를 식별하는 데 쓴다.\n7\t *\n8\t * ★`groq-`/`gemini-`(전사 완료) + `stt-`(STT_ASYNC 전사 대기/실패: stt-pending·stt-failed·stt-unconfigured)★ 를 모두 포함한다.\n9\t *   ★회귀 주의★: J 전사 비동기화가 업로드 음성을 `stt-pending`으로 스테이징하는데, 이게 빠지면 비동기 음성이\n10\t *   '전사 소스'로 인식되지 않아 byteSize(=오디오 바이트, 거대)가 텍스트 길이로 오인 → ★유료 추론 모델로 오라우팅★\n11\t *   (무료 Groq이 기본이어야 함) + 회의 모드 미적용. (lib/models pickIngestModel · ingest analyzeSource meeting)\n12\t */\n13\texport function isTranscribedExtractor(extractor: string | null | undefined): boolean {\n14\t  return /^(groq|gemini)-|^stt-/.test(extractor ?? \"\");\n15\t}\n16\t\n17\t// ── 전사 품질 가드: 환각 반복 루프 감지·정리 (PLAN-multi-upload §F) ──────────────────────\n18\t// 증상(실측): Gemini가 대용량 음성을 청크 없이 inline 전사하다 후반부에 짧은 구절을 무한 반복\n19\t//   (\"아, 그래. 아, 안 줬어.\"×N) → 그 쓰레기가 normalized 텍스트로 저장돼 분석에 투입됨.\n20\t// 대책: 연속(또는 주기 A·B·A·B) 반복을 ★1주기로 접어★ garbage를 분석에서 제거하되 ★앞부분(정상)은 보존★.\n21\t//   ★루프가 없으면 입력 텍스트를 100% 그대로 반환★(회귀 0). 순수 함수 — 클라/서버 공용·테스트 용이.\n22\t\n23\texport interface TranscriptLoopInfo {\n24\t  collapsed: boolean; // 한 번이라도 접었나\n25\t  removed: number;    // 생략된 구절(clause) 수\n26\t  phrase?: string;    // 대표 반복 구절(가장 많이 생략된 것)\n27\t}\n28\t\n29\t// 비교용 정규화 — 공백·문장부호 제거 + 소문자(반복 판정은 내용 동일성만 본다).\n30\tfunction normClause(s: string): string {\n31\t  return s.replace(/[\\s.!?。…,'\"·~\\-—()[\\]]/g, \"\").toLowerCase();\n32\t}\n33\t\n34\t/**\n35\t * 전사 텍스트의 ★반복 루프★(연속 동일 구절 또는 주기적 A·B 반복)를 1주기로 접는다.\n36\t * - 구절 경계(문장부호·줄바꿈)로 나눠, 길이 1~4 주기가 minRepeats회 이상 연속 반복되면 1주기만 남기고 생략 표시.\n37\t * - ★짧은 구절만★ 대상(maxUnitLen) — 정당하게 반복되는 긴 문단은 건드리지 않는다.\n38\t * - 반복이 없으면 입력을 ★그대로★ 반환(text 동일·collapsed=false). 분리는 lookbehind라 미접촉부 원문 보존.\n39\t */\n40\texport function collapseTranscriptLoops(\n41\t  text: string,\n42\t  opts?: { minRepeats?: number; maxCycleLen?: number; maxUnitLen?: number },\n43\t): { text: string; info: TranscriptLoopInfo } {\n44\t  const minRepeats = opts?.minRepeats ?? 4; // 같은 구절이 4회 이상 반복돼야 루프로 본다(정상 반복 보호)\n45\t  const maxCycleLen = opts?.maxCycleLen ?? 4; // 주기 최대 4구절(A·B·C·D 반복까지)\n46\t  const maxUnitLen = opts?.maxUnitLen ?? 40; // 한 구절 정규화 길이 상한 — 짧은 구절 환각만 대상(긴 문단 반복은 보호)\n47\t  if (!text) return { text, info: { collapsed: false, removed: 0 } };\n48\t\n49\t  // 구절 분리: 문장부호/줄바꿈 ★뒤에서★ 자른다(lookbehind) → 각 조각이 구분자를 보유 → 단순 concat이 원문 복원.\n50\t  const pieces = text.split(/(?<=[.!?。…\\n])/);\n51\t  if (pieces.length < minRepeats) return { text, info: { collapsed: false, removed: 0 } };\n52\t  const norm = pieces.map(normClause);\n53\t\n54\t  const out: string[] = [];\n55\t  const removedByPhrase = new Map<string, number>();\n56\t  let removed = 0;\n57\t  let i = 0;\n58\t  while (i < pieces.length) {\n59\t    let didCollapse = false;\n60\t    // 더 긴 주기부터 시도(최대 압축). 주기 L이 minRepeats회 이상 연속 반복되는지 본다.\n61\t    for (let L = Math.min(maxCycleLen, Math.floor((pieces.length - i) / minRepeats)); L >= 1; L--) {\n62\t      // 주기 블록의 정규화가 모두 비었으면(구분자만) 스킵, 길이 상한 위반도 스킵.\n63\t      const block = norm.slice(i, i + L);\n64\t      if (block.some((b) => b.length === 0) || block.some((b) => b.length > maxUnitLen)) continue;\n65\t      let reps = 1;\n66\t      while (i + (reps + 1) * L <= pieces.length) {\n67\t        let same = true;\n68\t        for (let k = 0; k < L; k++) { if (norm[i + reps * L + k] !== block[k]) { same = false; break; } }\n69\t        if (!same) break;\n70\t        reps++;\n71\t      }\n72\t      if (reps >= minRepeats) {\n73\t        for (let k = 0; k < L; k++) out.push(pieces[i + k]); // 1주기만 보존\n74\t        const omitted = (reps - 1) * L;\n75\t        removed += omitted;\n76\t        const phrase = pieces.slice(i, i + L).join(\"\").trim().slice(0, 40);\n77\t        removedByPhrase.set(phrase, (removedByPhrase.get(phrase) ?? 0) + omitted);\n78\t        out.push(`\\n[⚠ 전사 품질: 같은 구절이 ${reps}회 반복되어 전사 환각으로 판단, ${reps - 1}회 생략함]\\n`);\n79\t        i += reps * L;\n80\t        didCollapse = true;\n81\t        break;\n82\t      }\n83\t    }\n84\t    if (!didCollapse) { out.push(pieces[i]); i++; }\n85\t  }\n86\t\n87\t  if (removed === 0) return { text, info: { collapsed: false, removed: 0 } }; // ★불변: 루프 없으면 원문 그대로★\n88\t  const phrase = [...removedByPhrase.entries()].sort((a, b) => b[1] - a[1])[0]?.[0];\n89\t  return { text: out.join(\"\"), info: { collapsed: true, removed, phrase } };\n90\t}\n91\t\n92\t// ── G: 대용량 음성 안내 — ffmpeg 없이 큰 음성 전사 시 ★조용한 Gemini inline 폴백=환각★ 방지 (PLAN-multi-upload §G) ──\n93\t// ffmpeg가 있으면 청크 분할로 Groq가 처리. 없으면 25MB 초과는 Groq 한도 초과→Gemini inline 전사로 빠져\n94\t//   긴 음성이 환각(반복 루프 등)으로 망가진다. → 정직하게 '분할 업로드'를 안내(geminiOptIn으로 명시 허용 시만 통과).\n95\t// 순수 함수 — 클라/서버 공용·테스트.\n96\texport function oversizeAudioNeedsSplit(\n97\t  sizeBytes: number,\n98\t  groqLimitBytes: number,\n99\t  ffmpegAvailable: boolean,\n100\t  geminiOptIn: boolean,\n101\t): boolean {\n102\t  return sizeBytes > groqLimitBytes && !ffmpegAvailable && !geminiOptIn;\n103\t}\n104\t\n105\t// ── J 전사 비동기화: 진행률 매핑 (PLAN-remaining-backlog-design §6) ──────────────────────\n106\t// 전사를 분석 잡의 ★전반부(0~40%)★로 표시 — 이후 응축(요약)·분석이 뒤를 채운다. 순수·테스트.\n107\texport function sttProgressPct(done: number, total: number): number {\n108\t  if (total <= 0) return 0;\n109\t  const frac = Math.min(1, Math.max(0, done / total));\n110\t  return Math.round(frac * 40);\n111\t}\n112\t"}]},"uuid":"989539c1-7ddb-40f3-8dca-139f1aef021a","timestamp":"2026-06-28T11:14:34.339Z","toolUseResult":{"type":"text","file":{"filePath":"E:\\llm-wiki\\lib\\transcript.ts","content":"// 전사(STT) 관련 ★클라이언트·서버 공용★ 순수 헬퍼 — 서버 전용 의존(child_process 등) 없이 클라 번들에 안전.\n// (lib/stt.ts는 convert.ts→node:child_process를 끌고 와 클라 컴포넌트에서 import 불가 → 순수 판별만 여기로 분리.)\n\n/**\n * extractor가 음성·영상 전사 소스인지 — 모델 자동추천에서 byteSize 크기 휴리스틱을 건너뛰거나\n * (전사 소스 byteSize는 '오디오 바이트'라 텍스트 길이가 아님) UI/회의모드에서 음성 소스를 식별하는 데 쓴다.\n *\n * ★`groq-`/`gemini-`(전사 완료) + `stt-`(STT_ASYNC 전사 대기/실패: stt-pending·stt-failed·stt-unconfigured)★ 를 모두 포함한다.\n *   ★회귀 주의★: J 전사 비동기화가 업로드 음성을 `stt-pending`으로 스테이징하는데, 이게 빠지면 비동기 음성이\n *   '전사 소스'로 인식되지 않아 byteSize(=오디오 바이트, 거대)가 텍스트 길이로 오인 → ★유료 추론 모델로 오라우팅★\n *   (무료 Groq이 기본이어야 함) + 회의 모드 미적용. (lib/models pickIngestModel · ingest analyzeSource meeting)\n */\nexport function isTranscribedExtractor(extractor: string | null | undefined): boolean {\n  return /^(groq|gemini)-|^stt-/.test(extractor ?? \"\");\n}\n\n// ── 전사 품질 가드: 환각 반복 루프 감지·정리 (PLAN-multi-upload §F) ──────────────────────\n// 증상(실측): Gemini가 대용량 음성을 청크 없이 inline 전사하다 후반부에 짧은 구절을 무한 반복\n//   (\"아, 그래. 아, 안 줬어.\"×N) → 그 쓰레기가 normalized 텍스트로 저장돼 분석에 투입됨.\n// 대책: 연속(또는 주기 A·B·A·B) 반복을 ★1주기로 접어★ garbage를 분석에서 제거하되 ★앞부분(정상)은 보존★.\n//   ★루프가 없으면 입력 텍스트를 100% 그대로 반환★(회귀 0). 순수 함수 — 클라/서버 공용·테스트 용이.\n\nexport interface TranscriptLoopInfo {\n  collapsed: boolean; // 한 번이라도 접었나\n  removed: number;    // 생략된 구절(clause) 수\n  phrase?: string;    // 대표 반복 구절(가장 많이 생략된 것)\n}\n\n// 비교용 정규화 — 공백·문장부호 제거 + 소문자(반복 판정은 내용 동일성만 본다).\nfunction normClause(s: string): string {\n  return s.replace(/[\\s.!?。…,'\"·~\\-—()[\\]]/g, \"\").toLowerCase();\n}\n\n/**\n * 전사 텍스트의 ★반복 루프★(연속 동일 구절 또는 주기적 A·B 반복)를 1주기로 접는다.\n * - 구절 경계(문장부호·줄바꿈)로 나눠, 길이 1~4 주기가 minRepeats회 이상 연속 반복되면 1주기만 남기고 생략 표시.\n * - ★짧은 구절만★ 대상(maxUnitLen) — 정당하게 반복되는 긴 문단은 건드리지 않는다.\n * - 반복이 없으면 입력을 ★그대로★ 반환(text 동일·collapsed=false). 분리는 lookbehind라 미접촉부 원문 보존.\n */\nexport function collapseTranscriptLoops(\n  text: string,\n  opts?: { minRepeats?: number; maxCycleLen?: number; maxUnitLen?: number },\n): { text: string; info: TranscriptLoopInfo } {\n  const minRepeats = opts?.minRepeats ?? 4; // 같은 구절이 4회 이상 반복돼야 루프로 본다(정상 반복 보호)\n  const maxCycleLen = opts?.maxCycleLen ?? 4; // 주기 최대 4구절(A·B·C·D 반복까지)\n  const maxUnitLen = opts?.maxUnitLen ?? 40; // 한 구절 정규화 길이 상한 — 짧은 구절 환각만 대상(긴 문단 반복은 보호)\n  if (!text) return { text, info: { collapsed: false, removed: 0 } };\n\n  // 구절 분리: 문장부호/줄바꿈 ★뒤에서★ 자른다(lookbehind) → 각 조각이 구분자를 보유 → 단순 concat이 원문 복원.\n  const pieces = text.split(/(?<=[.!?。…\\n])/);\n  if (pieces.length < minRepeats) return { text, info: { collapsed: false, removed: 0 } };\n  const norm = pieces.map(normClause);\n\n  const out: string[] = [];\n  const removedByPhrase = new Map<string, number>();\n  let removed = 0;\n  let i = 0;\n  while (i < pieces.length) {\n    let didCollapse = false;\n    // 더 긴 주기부터 시도(최대 압축). 주기 L이 minRepeats회 이상 연속 반복되는지 본다.\n    for (let L = Math.min(maxCycleLen, Math.floor((pieces.length - i) / minRepeats)); L >= 1; L--) {\n      // 주기 블록의 정규화가 모두 비었으면(구분자만) 스킵, 길이 상한 위반도 스킵.\n      const block = norm.slice(i, i + L);\n      if (block.some((b) => b.length === 0) || block.some((b) => b.length > maxUnitLen)) continue;\n      let reps = 1;\n      while (i + (reps + 1) * L <= pieces.length) {\n        let same = true;\n        for (let k = 0; k < L; k++) { if (norm[i + reps * L + k] !== block[k]) { same = false; break; } }\n        if (!same) break;\n        reps++;\n      }\n      if (reps >= minRepeats) {\n        for (let k = 0; k < L; k++) out.push(pieces[i + k]); // 1주기만 보존\n        const omitted = (reps - 1) * L;\n        removed += omitted;\n        const phrase = pieces.slice(i, i + L).join(\"\").trim().slice(0, 40);\n        removedByPhrase.set(phrase, (removedByPhrase.get(phrase) ?? 0) + omitted);\n        out.push(`\\n[⚠ 전사 품질: 같은 구절이 ${reps}회 반복되어 전사 환각으로 판단, ${reps - 1}회 생략함]\\n`);\n        i += reps * L;\n        didCollapse = true;\n        break;\n      }\n    }\n    if (!didCollapse) { out.push(pieces[i]); i++; }\n  }\n\n  if (removed === 0) return { text, info: { collapsed: false, removed: 0 } }; // ★불변: 루프 없으면 원문 그대로★\n  const phrase = [...removedByPhrase.entries()].sort((a, b) => b[1] - a[1])[0]?.[0];\n  return { text: out.join(\"\"), info: { collapsed: true, removed, phrase } };\n}\n\n// ── G: 대용량 음성 안내 — ffmpeg 없이 큰 음성 전사 시 ★조용한 Gemini inline 폴백=환각★ 방지 (PLAN-multi-upload §G) ──\n// ffmpeg가 있으면 청크 분할로 Groq가 처리. 없으면 25MB 초과는 Groq 한도 초과→Gemini inline 전사로 빠져\n//   긴 음성이 환각(반복 루프 등)으로 망가진다. → 정직하게 '분할 업로드'를 안내(geminiOptIn으로 명시 허용 시만 통과).\n// 순수 함수 — 클라/서버 공용·테스트.\nexport function oversizeAudioNeedsSplit(\n  sizeBytes: number,\n  groqLimitBytes: number,\n  ffmpegAvailable: boolean,\n  geminiOptIn: boolean,\n): boolean {\n  return sizeBytes > groqLimitBytes && !ffmpegAvailable && !geminiOptIn;\n}\n\n// ── J 전사 비동기화: 진행률 매핑 (PLAN-remaining-backlog-design §6) ──────────────────────\n// 전사를 분석 잡의 ★전반부(0~40%)★로 표시 — 이후 응축(요약)·분석이 뒤를 채운다. 순수·테스트.\nexport function sttProgressPct(done: number, total: number): number {\n  if (total <= 0) return 0;\n  const frac = Math.min(1, Math.max(0, done / total));\n  return Math.round(frac * 40);\n}\n","numLines":112,"startLine":1,"totalLines":112}},"sourceToolAssistantUUID":"0b318f21-38b7-4fc4-bd36-15ff8530a501","userType":"external","entrypoint":"cli","cwd":"E:\\llm-wiki","sessionId":"6b03d3cf-704b-46f4-952d-418e6244ad85","version":"2.1.195","gitBranch":"feat/backlog-chunked-and-storage","slug":"serene-singing-papert"}
