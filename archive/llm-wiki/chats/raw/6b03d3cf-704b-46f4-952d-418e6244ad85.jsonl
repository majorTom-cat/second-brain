{"parentUuid":"87f5ca04-be71-467d-acb4-a1ed2dae9a66","isSidechain":false,"promptId":"72c47ca9-455c-407a-8764-3ca32f2b9ca5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X4KZo1WvsNys8U4nHzjkYP","type":"tool_result","content":"The file E:\\llm-wiki\\lib\\jobs\\retention.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"uuid":"3ce1d45d-d0a7-44b7-9be9-ee2633305da3","timestamp":"2026-06-28T11:28:21.461Z","toolUseResult":{"filePath":"E:\\llm-wiki\\lib\\jobs\\retention.ts","oldString":"import { promises as fs } from \"node:fs\";\nimport { prisma } from \"../db\";\nimport { wikiAbsPath } from \"../wiki/paths\";\nimport { withWikiWriteLock, commitAll } from \"../wiki/repo\";","newString":"import { promises as fs } from \"node:fs\";\nimport { prisma } from \"../db\";\nimport { wikiAbsPath } from \"../wiki/paths\";\nimport { getRawStore } from \"../wiki/rawStore\";\nimport { withWikiWriteLock, commitAll } from \"../wiki/repo\";","originalFile":"// ── L4 대용량 원본 보존정책 (docs/PLAN-large-files-and-chunking §11.6) ───────────────────\n// L3가 \"raw=불변 보존(저렴)\" 가정을 깸(500MB 바이너리) → 오래된 대용량 원본 바이트를 정리한다.\n// ★원본 바이트(raw/<sha>.<ext> + .assets)만 제거★ — 지식(위키 페이지)·정규화 사이드카(.normalized.md)·\n//   Source 메타·git 이력은 ★보존★. 즉 검색·재질의는 그대로, 원본 다운로드만 불가해진다(rawEvictedAt 표시).\n// ★자율 cron 삭제 금지★(cron 원칙) → 관리자 수동 트리거 + 미리보기. 기본 OFF(days<=0).\nimport { promises as fs } from \"node:fs\";\nimport { prisma } from \"../db\";\nimport { wikiAbsPath } from \"../wiki/paths\";\nimport { withWikiWriteLock, commitAll } from \"../wiki/repo\";\n\nexport interface RetentionConfig {\n  days: number; // 이 일수보다 오래된 원본이 대상. <=0이면 ★비활성(아무것도 안 함)★.\n  minBytes: number; // 이 크기 이상 원본만 대상(작은 raw는 저렴 → 유지).\n}\n\n// env 기반 기본 정책(관리자가 미리보기에서 override 가능). RETENTION_RAW_DAYS 미설정/0 = OFF.\nexport function retentionConfig(): RetentionConfig {\n  return {\n    days: Number(process.env.RETENTION_RAW_DAYS || 0), // 0 = ship-dark(비활성)\n    minBytes: Number(process.env.RETENTION_RAW_MIN_MB || 25) * 1024 * 1024,\n  };\n}\n\nexport interface RawCandidate {\n  id: number;\n  createdAt: Date;\n  byteSize: number | null;\n  rawEvictedAt: Date | null;\n  analyzed: boolean; // APPLIED 잡 있음(지식 추출됨) — ★UNANALYZED(raw가 유일본)는 false★\n}\n\n// ★순수★ 선택기 — 정리 대상 원본을 고른다(테스트 대상). days<=0이면 빈 배열(비활성).\n//   조건: 미정리(rawEvictedAt null) ∧ 분석완료(analyzed) ∧ byteSize≥minBytes ∧ createdAt이 days일보다 오래됨.\nexport function selectEvictableRaw(items: RawCandidate[], opts: { days: number; minBytes: number; now: Date }): RawCandidate[] {\n  if (opts.days <= 0) return []; // ship-dark\n  const cutoff = opts.now.getTime() - opts.days * 86_400_000;\n  return items.filter(\n    (it) => it.rawEvictedAt == null && it.analyzed && (it.byteSize ?? 0) >= opts.minBytes && it.createdAt.getTime() <= cutoff,\n  );\n}\n\n// 미리보기(읽기 전용) — 정책에 맞는 정리 후보 + 합계 용량. 관리자 UI가 보여주고 확인받는다.\nexport async function previewRawRetention(cfg: RetentionConfig, now: Date = new Date()): Promise<{ enabled: boolean; candidates: { id: number; title: string; scope: string; byteSize: number; createdAt: string }[]; totalBytes: number }> {\n  if (cfg.days <= 0) return { enabled: false, candidates: [], totalBytes: 0 };\n  // 분석완료(APPLIED 잡) ∧ 미정리 ∧ 크기 임계 후보를 DB에서 1차 추림 → 순수 선택기로 확정.\n  const rows = await prisma.source.findMany({\n    where: { rawEvictedAt: null, byteSize: { gte: cfg.minBytes }, ingestJobs: { some: { status: \"APPLIED\" } } },\n    select: { id: true, title: true, teamScope: true, byteSize: true, createdAt: true },\n    orderBy: { byteSize: \"desc\" },\n    take: 500,\n  });\n  const cand = selectEvictableRaw(\n    rows.map((r) => ({ id: r.id, createdAt: r.createdAt, byteSize: r.byteSize, rawEvictedAt: null, analyzed: true })),\n    { days: cfg.days, minBytes: cfg.minBytes, now },\n  );\n  const ids = new Set(cand.map((c) => c.id));\n  const picked = rows.filter((r) => ids.has(r.id));\n  return {\n    enabled: true,\n    candidates: picked.map((r) => ({ id: r.id, title: r.title, scope: r.teamScope, byteSize: r.byteSize ?? 0, createdAt: r.createdAt.toISOString() })),\n    totalBytes: picked.reduce((s, r) => s + (r.byteSize ?? 0), 0),\n  };\n}\n\n// ★실제 정리★(관리자 확인한 id만) — 원본 바이트+.assets 제거, normalized·페이지·메타 보존, rawEvictedAt 표시.\n//   단일 라이터(withWikiWriteLock) + 1커밋. UNANALYZED 등 안전 가드를 다시 확인(미리보기와 시점차 방어).\nexport async function evictRawForSources(ids: number[]): Promise<{ evicted: number; freedBytes: number; skipped: number }> {\n  let evicted = 0, freedBytes = 0, skipped = 0;\n  for (const id of ids) {\n    const source = await prisma.source.findUnique({ where: { id }, include: { ingestJobs: { where: { status: \"APPLIED\" }, take: 1 } } });\n    // 안전 가드: 없거나·이미 정리됨·미분석(APPLIED 잡 없음)이면 ★건너뜀★(원본이 유일본인 자료 보호).\n    if (!source || source.rawEvictedAt || source.ingestJobs.length === 0) { skipped++; continue; }\n    const bytes = source.byteSize ?? 0;\n    const rawAbs = wikiAbsPath(source.rawPath);\n    const assetsAbs = wikiAbsPath(`${source.rawPath.replace(/\\.[^.]+$/, \"\")}.assets`);\n    try {\n      // ★멱등★: 직전 실행이 파일 삭제·커밋까지 했으나 rawEvictedAt 설정 직전 끊긴 경우, 이 자료가 미리보기에\n      //   다시 잡힌다(rawEvictedAt 여전히 null) → 재실행 시 파일은 이미 없음. 그때 ★빈 커밋★을 시도하면\n      //   commitAll이 실패해 flag가 영영 안 박힌다 → ‘실제로 지울 게 있을 때만 커밋’ + flag는 항상 확정.\n      let existed = false;\n      try { await fs.access(rawAbs); existed = true; } catch { /* raw 이미 없음 */ }\n      if (!existed) { try { await fs.access(assetsAbs); existed = true; } catch { /* assets도 없음 */ } }\n      await withWikiWriteLock(async () => {\n        try { await fs.unlink(rawAbs); } catch { /* 이미 없음 */ }\n        try { await fs.rm(assetsAbs, { recursive: true, force: true }); } catch { /* 없음 */ }\n        // ★normalized 사이드카는 보존★(재인제스트·검색 근거). 실제로 지운 게 있을 때만 커밋(빈 커밋 방지).\n        if (existed) await commitAll(`retain-evict(${source.teamScope}): ${source.title} [원본 정리]`, { team: source.teamScope, gate: \"RETENTION\" });\n      });\n      // 파일이 (이미) 없든 방금 지웠든 ★rawEvictedAt를 확정★ → 멱등·자가치유(중복 후보 재등장 종결).\n      await prisma.source.update({ where: { id }, data: { rawEvictedAt: new Date() } });\n      evicted++; freedBytes += bytes;\n    } catch {\n      skipped++;\n    }\n  }\n  return { evicted, freedBytes, skipped };\n}\n","structuredPatch":[{"oldStart":6,"oldLines":6,"newStart":6,"newLines":7,"lines":[" import { promises as fs } from \"node:fs\";"," import { prisma } from \"../db\";"," import { wikiAbsPath } from \"../wiki/paths\";","+import { getRawStore } from \"../wiki/rawStore\";"," import { withWikiWriteLock, commitAll } from \"../wiki/repo\";"," "," export interface RetentionConfig {"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"87f5ca04-be71-467d-acb4-a1ed2dae9a66","userType":"external","entrypoint":"cli","cwd":"E:\\llm-wiki","sessionId":"6b03d3cf-704b-46f4-952d-418e6244ad85","version":"2.1.195","gitBranch":"feat/backlog-chunked-and-storage","slug":"serene-singing-papert"}
