{"parentUuid":"e4ac2184-01dd-4224-a6e0-f7a5fe26316d","isSidechain":false,"message":{"model":"claude-opus-4-8","id":"msg_01CdC532sUnQAfwmzcVcuuAy","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QNsU4cWuvrcfavS761gzAc","name":"Write","input":{"file_path":"E:\\llm-wiki\\components\\wiki\\chunkedUpload.ts","content":"// ── 청크/resumable 업로드 클라이언트(PLAN-remaining-backlog-design §8) ──────────────────────\n// 큰 파일을 고정 크기 청크로 나눠 순차 전송하고, 네트워크 오류·청크 실패 시 ★그 지점부터 재시도★한다.\n//   서버는 /api/materials/upload (create→PATCH append→finalize). File.slice(Blob)를 body로 보내 클라도 RAM\n//   통적재를 피한다(스트리밍). 진행률 콜백으로 업로드 % 표시 가능.\n// ★ship-dark★: NEXT_PUBLIC_CHUNKED_UPLOAD=\"true\"일 때만 큰 파일에 사용(아니면 기존 octet-stream 경로).\n\nexport function chunkedUploadEnabled(): boolean {\n  return process.env.NEXT_PUBLIC_CHUNKED_UPLOAD === \"true\";\n}\n\nexport interface ChunkedUploadOpts { scope: string; title?: string; anonymous?: boolean; geminiOptIn?: boolean }\n\nconst MAX_CHUNK_RETRIES = 4;\nconst RETRY_DELAY_MS = 800;\n\nconst sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));\n\n/**\n * 파일을 청크로 업로드하고 finalize 결과(JSON)를 반환한다. 기존 단건 업로드와 동일한 응답 형태\n * (sourceId·status·recommended 등)라 호출측 toStaged가 그대로 소비한다.\n * @returns { ok, status, data } — data는 finalize(=stageBuffer) JSON.\n */\nexport async function chunkedUpload(\n  file: File,\n  opts: ChunkedUploadOpts,\n  onProgress?: (sent: number, total: number) => void,\n  signal?: AbortSignal,\n): Promise<{ ok: boolean; status: number; data: Record<string, unknown> }> {\n  // 1) 세션 생성\n  const createRes = await fetch(\"/api/materials/upload\", {\n    method: \"POST\", headers: { \"content-type\": \"application/json\" }, signal,\n    body: JSON.stringify({ action: \"create\", scope: opts.scope, filename: file.name, size: file.size, mime: file.type || \"\", title: opts.title, anonymous: opts.anonymous, geminiOptIn: opts.geminiOptIn }),\n  });\n  const created = await createRes.json().catch(() => ({}));\n  if (!createRes.ok) return { ok: false, status: createRes.status, data: created };\n  const uploadId: string = created.uploadId;\n  const chunkSize: number = created.chunkSize || 8 * 1024 * 1024;\n\n  // 2) 청크 순차 전송(실패 청크만 재시도, 409 gap이면 서버가 알려준 offset으로 재동기화)\n  let offset = 0;\n  while (offset < file.size) {\n    if (signal?.aborted) throw new DOMException(\"Aborted\", \"AbortError\");\n    const end = Math.min(offset + chunkSize, file.size);\n    const blob = file.slice(offset, end);\n    let attempt = 0;\n    for (;;) {\n      try {\n        const res = await fetch(`/api/materials/upload?uploadId=${encodeURIComponent(uploadId)}&offset=${offset}`, {\n          method: \"PATCH\", headers: { \"content-type\": \"application/octet-stream\" }, body: blob, signal,\n        });\n        if (res.status === 409) {\n          // gap: 서버가 기대하는 received로 점프(중복/누락 보정).\n          const d = await res.json().catch(() => ({}));\n          if (typeof d.received === \"number\") { offset = d.received; break; }\n          throw new Error(d.error || \"청크 동기화 실패\");\n        }\n        if (!res.ok) {\n          const d = await res.json().catch(() => ({}));\n          throw new Error(d.error || `청크 업로드 실패(${res.status})`);\n        }\n        const d = await res.json();\n        offset = typeof d.received === \"number\" ? d.received : end; // 서버 received를 신뢰(재개 정합)\n        onProgress?.(offset, file.size);\n        break;\n      } catch (e) {\n        if (signal?.aborted || (e instanceof DOMException && e.name === \"AbortError\")) throw e;\n        if (++attempt > MAX_CHUNK_RETRIES) throw e;\n        await sleep(RETRY_DELAY_MS * attempt); // 점증 백오프\n        // 재시도 전 실제 서버 진행상태로 재동기화(중복 전송 회피).\n        try {\n          const st = await fetch(`/api/materials/upload?uploadId=${encodeURIComponent(uploadId)}`, { signal });\n          if (st.ok) { const sd = await st.json(); if (typeof sd.received === \"number\") offset = sd.received; }\n        } catch { /* status 실패는 무시하고 같은 offset 재시도 */ }\n      }\n    }\n  }\n\n  // 3) finalize → stageBuffer 결과 반환\n  const finRes = await fetch(\"/api/materials/upload\", {\n    method: \"POST\", headers: { \"content-type\": \"application/json\" }, signal,\n    body: JSON.stringify({ action: \"finalize\", uploadId }),\n  });\n  const finData = await finRes.json().catch(() => ({}));\n  return { ok: finRes.ok, status: finRes.status, data: finData };\n}\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3030,"cache_read_input_tokens":204509,"output_tokens":2498,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3030,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":2498,"cache_read_input_tokens":204509,"cache_creation_input_tokens":3030,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3030},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CcVaHdjxLZzSVqZgD8Nad","type":"assistant","uuid":"bc0f0365-f740-43fe-acc4-9e78ab557e02","timestamp":"2026-06-28T11:25:46.949Z","userType":"external","entrypoint":"cli","cwd":"E:\\llm-wiki","sessionId":"6b03d3cf-704b-46f4-952d-418e6244ad85","version":"2.1.195","gitBranch":"feat/backlog-chunked-and-storage","slug":"serene-singing-papert"}
