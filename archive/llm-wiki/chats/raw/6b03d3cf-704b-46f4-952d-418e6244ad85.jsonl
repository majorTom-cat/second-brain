없음 */ }\n85\t        try { await fs.rm(assetsAbs, { recursive: true, force: true }); } catch { /* 없음 */ }\n86\t        // ★normalized 사이드카는 보존★(재인제스트·검색 근거). 실제로 지운 게 있을 때만 커밋(빈 커밋 방지).\n87\t        if (existed) await commitAll(`retain-evict(${source.teamScope}): ${source.title} [원본 정리]`, { team: source.teamScope, gate: \"RETENTION\" });\n88\t      });\n89\t      // 파일이 (이미) 없든 방금 지웠든 ★rawEvictedAt를 확정★ → 멱등·자가치유(중복 후보 재등장 종결).\n90\t      await prisma.source.update({ where: { id }, data: { rawEvictedAt: new Date() } });\n91\t      evicted++; freedBytes += bytes;\n92\t    } catch {\n93\t      skipped++;\n94\t    }\n95\t  }\n96\t  return { evicted, freedBytes, skipped };\n97\t}\n98\t"}]},"uuid":"52f7e096-57e1-44f7-a1b0-7e7178128b95","timestamp":"2026-06-28T11:27:25.176Z","toolUseResult":{"type":"text","file":{"filePath":"E:\\llm-wiki\\lib\\jobs\\retention.ts","content":"    candidates: picked.map((r) => ({ id: r.id, title: r.title, scope: r.teamScope, byteSize: r.byteSize ?? 0, createdAt: r.createdAt.toISOString() })),\n    totalBytes: picked.reduce((s, r) => s + (r.byteSize ?? 0), 0),\n  };\n}\n\n// ★실제 정리★(관리자 확인한 id만) — 원본 바이트+.assets 제거, normalized·페이지·메타 보존, rawEvictedAt 표시.\n//   단일 라이터(withWikiWriteLock) + 1커밋. UNANALYZED 등 안전 가드를 다시 확인(미리보기와 시점차 방어).\nexport async function evictRawForSources(ids: number[]): Promise<{ evicted: number; freedBytes: number; skipped: number }> {\n  let evicted = 0, freedBytes = 0, skipped = 0;\n  for (const id of ids) {\n    const source = await prisma.source.findUnique({ where: { id }, include: { ingestJobs: { where: { status: \"APPLIED\" }, take: 1 } } });\n    // 안전 가드: 없거나·이미 정리됨·미분석(APPLIED 잡 없음)이면 ★건너뜀★(원본이 유일본인 자료 보호).\n    if (!source || source.rawEvictedAt || source.ingestJobs.length === 0) { skipped++; continue; }\n    const bytes = source.byteSize ?? 0;\n    const rawAbs = wikiAbsPath(source.rawPath);\n    const assetsAbs = wikiAbsPath(`${source.rawPath.replace(/\\.[^.]+$/, \"\")}.assets`);\n    try {\n      // ★멱등★: 직전 실행이 파일 삭제·커밋까지 했으나 rawEvictedAt 설정 직전 끊긴 경우, 이 자료가 미리보기에\n      //   다시 잡힌다(rawEvictedAt 여전히 null) → 재실행 시 파일은 이미 없음. 그때 ★빈 커밋★을 시도하면\n      //   commitAll이 실패해 flag가 영영 안 박힌다 → ‘실제로 지울 게 있을 때만 커밋’ + flag는 항상 확정.\n      let existed = false;\n      try { await fs.access(rawAbs); existed = true; } catch { /* raw 이미 없음 */ }\n      if (!existed) { try { await fs.access(assetsAbs); existed = true; } catch { /* assets도 없음 */ } }\n      await withWikiWriteLock(async () => {\n        try { await fs.unlink(rawAbs); } catch { /* 이미 없음 */ }\n        try { await fs.rm(assetsAbs, { recursive: true, force: true }); } catch { /* 없음 */ }\n        // ★normalized 사이드카는 보존★(재인제스트·검색 근거). 실제로 지운 게 있을 때만 커밋(빈 커밋 방지).\n        if (existed) await commitAll(`retain-evict(${source.teamScope}): ${source.title} [원본 정리]`, { team: source.teamScope, gate: \"RETENTION\" });\n      });\n      // 파일이 (이미) 없든 방금 지웠든 ★rawEvictedAt를 확정★ → 멱등·자가치유(중복 후보 재등장 종결).\n      await prisma.source.update({ where: { id }, data: { rawEvictedAt: new Date() } });\n      evicted++; freedBytes += bytes;\n    } catch {\n      skipped++;\n    }\n  }\n  return { evicted, freedBytes, skipped };\n}\n","numLines":39,"startLine":60,"totalLines":98}},"sourceToolAssistantUUID":"85b59657-7275-4725-a065-3713a257d31c","userType":"external","entrypoint":"cli","cwd":"E:\\llm-wiki","sessionId":"6b03d3cf-704b-46f4-952d-418e6244ad85","version":"2.1.195","gitBranch":"feat/backlog-chunked-and-storage","slug":"serene-singing-papert"}
