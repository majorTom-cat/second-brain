{"parentUuid":"1ffa96ff-c3c8-46bc-b6f7-f40cb47fd437","isSidechain":false,"promptId":"72c47ca9-455c-407a-8764-3ca32f2b9ca5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01283pwuxFrtCKG6fhz3DYUN","type":"tool_result","content":"265\t  return { text, quality: text ? \"partial\" : \"none\", extractor: \"hwp(prvtext)\" };\n266\t}\n267\t\n268\t/** 인프로세스 포맷 dispatch. 추출 가능 포맷만 처리하고, 그 외(이미지 등)는 quality:'none'. */\n269\tasync function dispatchInProcess(buf: Buffer, filename: string, mime: string, ext: string, opts?: ExtractOpts): Promise<ExtractResult> {\n270\t  try {\n271\t    // 음성·영상 → STT 전사(오디오만). 영상(.mov 등)은 ffmpeg 선행(5c). Groq 키 없으면 graceful 'none'.\n272\t    if (STT_EXTS.includes(ext) || STT_FFMPEG_EXTS.includes(ext) || mime.startsWith(\"audio/\") || mime.startsWith(\"video/\")) {\n273\t      return await transcribe(buf, filename, mime, { diarize: opts?.diarize });\n274\t    }\n275\t    if (ext === \"pdf\" || mime === \"application/pdf\") return await extractPdf(buf);\n276\t    if (ext === \"docx\" || mime.includes(\"wordprocessingml\")) return await extractDocx(buf);\n277\t    if (ext === \"xlsx\" || ext === \"xls\" || mime.includes(\"spreadsheetml\") || mime.includes(\"ms-excel\")) {\n278\t      return extractWorkbook(XLSX.read(buf, { type: \"buffer\" }), \"xlsx\");\n279\t    }\n280\t    if (ext === \"csv\" || mime === \"text/csv\") {\n281\t      return extractWorkbook(XLSX.read(await decodeText(buf), { type: \"string\" }), \"csv\");\n282\t    }\n283\t    if (ext === \"html\" || ext === \"htm\" || mime === \"text/html\") return await extractHtml(await decodeText(buf));\n284\t    if (OFFICEPARSER_EXTS.includes(ext)) return await extractOfficeparser(buf, ext);\n285\t    if (ext === \"doc\" || mime === \"application/msword\") return await extractDoc(buf);\n286\t    if (ext === \"hwpx\") return await extractHwpx(buf);\n287\t    if (ext === \"hwp\") return await extractHwp(buf);\n288\t    if (ext === \"txt\" || ext === \"md\" || ext === \"markdown\" || ext === \"json\" || mime.startsWith(\"text/\")) {\n289\t      const text = (await decodeText(buf)).trim();\n290\t      return { text, quality: text ? \"full\" : \"none\", extractor: \"text\" };\n291\t    }\n292\t  } catch (e) {\n293\t    return { text: \"\", quality: \"none\", extractor: `error:${ext}`, meta: { error: String(e) } };\n294\t  }\n295\t  return { text: \"\", quality: \"none\", extractor: \"none\" }; // 파서 없음(이미지 등) → 네이티브 폴백\n296\t}\n297\t\n298\t/** 추출 옵션 — 음성·영상 STT 전용(현재 화자 구분만). 그 외 포맷엔 무영향. */\n299\texport interface ExtractOpts { diarize?: boolean }\n300\t\n301\t/**\n302\t * 포맷 dispatch + LibreOffice 변환 폴백(4j).\n303\t * 인프로세스 추출이 실패(quality:none)하고 LibreOffice가 열 수 있는 문서형 포맷이면\n304\t * PDF로 변환해 pdfjs로 재추출한다(env LIBREOFFICE_CMD 미설정 시 폴백 없음).\n305\t */\n306\texport async function extractAsset(buf: Buffer, filename: string, mime: string, opts?: ExtractOpts): Promise<ExtractResult> {\n307\t  const ext = extOf(filename);\n308\t  const res = await dispatchInProcess(buf, filename, mime, ext, opts);\n309\t  if (res.quality !== \"none\") return res;\n310\t\n311\t  if (isLibreOfficeConvertible(ext) && libreOfficeAvailable()) {\n312\t    const pdf = await convertToPdf(buf, ext);\n313\t    if (pdf) {\n314\t      try {\n315\t        const px = await extractPdf(pdf);\n316\t        if (px.text.trim() && px.quality !== \"none\") {\n317\t          return { ...px, extractor: \"libreoffice+pdfjs\", meta: { ...px.meta, via: \"libreoffice\", from: ext } };\n318\t        }\n319\t      } catch { /* 변환본 추출도 실패 → 원 결과 유지 */ }"}]},"uuid":"c32edffb-9f12-4a62-a7fa-46fd583ac4ed","timestamp":"2026-06-28T11:19:37.644Z","toolUseResult":{"type":"text","file":{"filePath":"E:\\llm-wiki\\lib\\extract.ts","content":"  return { text, quality: text ? \"partial\" : \"none\", extractor: \"hwp(prvtext)\" };\n}\n\n/** 인프로세스 포맷 dispatch. 추출 가능 포맷만 처리하고, 그 외(이미지 등)는 quality:'none'. */\nasync function dispatchInProcess(buf: Buffer, filename: string, mime: string, ext: string, opts?: ExtractOpts): Promise<ExtractResult> {\n  try {\n    // 음성·영상 → STT 전사(오디오만). 영상(.mov 등)은 ffmpeg 선행(5c). Groq 키 없으면 graceful 'none'.\n    if (STT_EXTS.includes(ext) || STT_FFMPEG_EXTS.includes(ext) || mime.startsWith(\"audio/\") || mime.startsWith(\"video/\")) {\n      return await transcribe(buf, filename, mime, { diarize: opts?.diarize });\n    }\n    if (ext === \"pdf\" || mime === \"application/pdf\") return await extractPdf(buf);\n    if (ext === \"docx\" || mime.includes(\"wordprocessingml\")) return await extractDocx(buf);\n    if (ext === \"xlsx\" || ext === \"xls\" || mime.includes(\"spreadsheetml\") || mime.includes(\"ms-excel\")) {\n      return extractWorkbook(XLSX.read(buf, { type: \"buffer\" }), \"xlsx\");\n    }\n    if (ext === \"csv\" || mime === \"text/csv\") {\n      return extractWorkbook(XLSX.read(await decodeText(buf), { type: \"string\" }), \"csv\");\n    }\n    if (ext === \"html\" || ext === \"htm\" || mime === \"text/html\") return await extractHtml(await decodeText(buf));\n    if (OFFICEPARSER_EXTS.includes(ext)) return await extractOfficeparser(buf, ext);\n    if (ext === \"doc\" || mime === \"application/msword\") return await extractDoc(buf);\n    if (ext === \"hwpx\") return await extractHwpx(buf);\n    if (ext === \"hwp\") return await extractHwp(buf);\n    if (ext === \"txt\" || ext === \"md\" || ext === \"markdown\" || ext === \"json\" || mime.startsWith(\"text/\")) {\n      const text = (await decodeText(buf)).trim();\n      return { text, quality: text ? \"full\" : \"none\", extractor: \"text\" };\n    }\n  } catch (e) {\n    return { text: \"\", quality: \"none\", extractor: `error:${ext}`, meta: { error: String(e) } };\n  }\n  return { text: \"\", quality: \"none\", extractor: \"none\" }; // 파서 없음(이미지 등) → 네이티브 폴백\n}\n\n/** 추출 옵션 — 음성·영상 STT 전용(현재 화자 구분만). 그 외 포맷엔 무영향. */\nexport interface ExtractOpts { diarize?: boolean }\n\n/**\n * 포맷 dispatch + LibreOffice 변환 폴백(4j).\n * 인프로세스 추출이 실패(quality:none)하고 LibreOffice가 열 수 있는 문서형 포맷이면\n * PDF로 변환해 pdfjs로 재추출한다(env LIBREOFFICE_CMD 미설정 시 폴백 없음).\n */\nexport async function extractAsset(buf: Buffer, filename: string, mime: string, opts?: ExtractOpts): Promise<ExtractResult> {\n  const ext = extOf(filename);\n  const res = await dispatchInProcess(buf, filename, mime, ext, opts);\n  if (res.quality !== \"none\") return res;\n\n  if (isLibreOfficeConvertible(ext) && libreOfficeAvailable()) {\n    const pdf = await convertToPdf(buf, ext);\n    if (pdf) {\n      try {\n        const px = await extractPdf(pdf);\n        if (px.text.trim() && px.quality !== \"none\") {\n          return { ...px, extractor: \"libreoffice+pdfjs\", meta: { ...px.meta, via: \"libreoffice\", from: ext } };\n        }\n      } catch { /* 변환본 추출도 실패 → 원 결과 유지 */ }","numLines":55,"startLine":265,"totalLines":331}},"sourceToolAssistantUUID":"1ffa96ff-c3c8-46bc-b6f7-f40cb47fd437","userType":"external","entrypoint":"cli","cwd":"E:\\llm-wiki","sessionId":"6b03d3cf-704b-46f4-952d-418e6244ad85","version":"2.1.195","gitBranch":"feat/backlog-chunked-and-storage","slug":"serene-singing-papert"}
