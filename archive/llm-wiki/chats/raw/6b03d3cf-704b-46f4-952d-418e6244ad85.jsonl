{"parentUuid":"4e17c195-e734-400f-b024-c1e3f2d8b23c","isSidechain":false,"message":{"model":"claude-opus-4-8","id":"msg_01S4QFMVSqXKMsvvtfo8jNUd","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PbCx5AHa5fGpMyiNPdfzGg","name":"Read","input":{"file_path":"E:\\llm-wiki\\lib\\gemini.ts"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4574,"cache_read_input_tokens":75106,"output_tokens":432,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":4574,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":432,"cache_read_input_tokens":75106,"cache_creation_input_tokens":4574,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4574},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CcVZRWT1pDEnfhykQW2ua","type":"assistant","uuid":"36e70234-ca43-41e8-bede-c1e383c64c97","timestamp":"2026-06-28T11:13:59.169Z","userType":"external","entrypoint":"cli","cwd":"E:\\llm-wiki","sessionId":"6b03d3cf-704b-46f4-952d-418e6244ad85","version":"2.1.195","gitBranch":"feat/backlog-chunked-and-storage","slug":"serene-singing-papert"}
{"parentUuid":"36e70234-ca43-41e8-bede-c1e383c64c97","isSidechain":false,"promptId":"72c47ca9-455c-407a-8764-3ca32f2b9ca5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PbCx5AHa5fGpMyiNPdfzGg","type":"tool_result","content":"1\timport type { Usage } from \"./anthropic\";\n2\timport { firstKey, slotHasKey } from \"./secrets\";\n3\timport { fetchAbort } from \"./httpTimeout\";\n4\timport { attachmentMode } from \"./attachments\";\n5\t\n6\t// Google Gemini 어댑터(무료 등급=빠름, 단 데이터가 Google로 전송·학습됨 → 비민감 자료만).\n7\t// Anthropic/Ollama callStructured와 동일 인터페이스. 구조화 출력은 controlled generation\n8\t// (responseMimeType: application/json + responseSchema)로 강제한다.\n9\t\n10\texport function geminiApiKey(): string | null {\n11\t  return firstKey(\"gemini\"); // DB(관리자 입력) 우선, 없으면 env GEMINI_API_KEY\n12\t}\n13\texport function geminiEnabled(): boolean {\n14\t  return slotHasKey(\"gemini\");\n15\t}\n16\texport function geminiDefaultModel(): string {\n17\t  return process.env.GEMINI_MODEL?.trim() || \"gemini-2.5-flash\";\n18\t}\n19\t\n20\t// JSON Schema → Gemini responseSchema(OpenAPI 부분집합). type 대문자화 + 지원 키만 통과.\n21\ttype JSchema = Record<string, unknown>;\n22\tfunction toGeminiSchema(s: unknown): unknown {\n23\t  if (!s || typeof s !== \"object\") return s;\n24\t  const o = s as JSchema;\n25\t  const out: JSchema = {};\n26\t  if (o.type) out.type = String(o.type).toUpperCase();\n27\t  if (o.description) out.description = o.description;\n28\t  if (o.enum) out.enum = o.enum;\n29\t  if (o.nullable) out.nullable = o.nullable;\n30\t  if (o.items) out.items = toGeminiSchema(o.items);\n31\t  if (o.properties && typeof o.properties === \"object\") {\n32\t    const props: JSchema = {};\n33\t    for (const [k, v] of Object.entries(o.properties as JSchema)) props[k] = toGeminiSchema(v);\n34\t    out.properties = props;\n35\t    if (Array.isArray(o.required)) out.required = o.required;\n36\t  }\n37\t  return out;\n38\t}\n39\t\n40\texport interface GeminiOpts {\n41\t  model: string;\n42\t  system: string;\n43\t  userText: string;\n44\t  schema: Record<string, unknown>;\n45\t  maxTokens?: number;\n46\t  images?: { mediaType: string; dataBase64: string }[];\n47\t  documents?: { mediaType: string; dataBase64: string }[];\n48\t  signal?: AbortSignal; // 취소 — abort 시 fetch 중단\n49\t  apiKey?: string; // 회전 주입 키(미지정 시 geminiApiKey())\n50\t}\n51\t\n52\t// ★L3c: inline 한도 초과 첨부는 Files API로★(docs/PLAN §11.4). Gemini generateContent의 inline(base64)\n53\t//   요청 총량 한도(~20MB)를 넘는 대용량 스캔 PDF·이미지는 ★Files API에 먼저 업로드★ 후 fileUri로 참조한다.\n54\t//   임계는 env(GEMINI_INLINE_MAX_BYTES, 기본 15MB)로 조정 — 작은 파일로 Files API 경로를 검증할 때 낮춘다.\n55\tfunction inlineMaxBytes(): number {\n56\t  return Number(process.env.GEMINI_INLINE_MAX_BYTES || 0) || 15 * 1024 * 1024;\n57\t}\n58\t\n59\t// Files API 업로드(raw 프로토콜) → ACTIVE까지 폴링 → fileUri 반환. PDF·이미지는 보통 즉시 ACTIVE.\n60\tasync function uploadGeminiFile(bytes: Buffer, mimeType: string, key: string, signal?: AbortSignal): Promise<{ fileUri: string; mimeType: string }> {\n61\t  const up = await fetch(\"https://generativelanguage.googleapis.com/upload/v1beta/files\", {\n62\t    method: \"POST\",\n63\t    signal: fetchAbort(signal, 300_000), // 대용량 업로드(최대 5분) — hang 방지(R1)\n64\t    headers: {\n65\t      \"x-goog-api-key\": key,\n66\t      \"X-Goog-Upload-Protocol\": \"raw\",\n67\t      \"X-Goog-Upload-Header-Content-Type\": mimeType,\n68\t      \"content-type\": mimeType,\n69\t    },\n70\t    body: new Uint8Array(bytes),\n71\t  });\n72\t  if (!up.ok) throw new Error(`Gemini Files 업로드 실패 ${up.status}: ${(await up.text().catch(() => \"\")).slice(0, 200)}`);\n73\t  const uj = (await up.json()) as { file?: { uri?: string; name?: string; state?: string; mimeType?: string } };\n74\t  const file = uj.file;\n75\t  if (!file?.uri || !file?.name) throw new Error(\"Gemini Files 업로드 응답에 file.uri/name 없음\");\n76\t  // 상태 폴링(PROCESSING→ACTIVE). 문서·이미지는 대개 즉시 ACTIVE — 최대 ~30초.\n77\t  let state = file.state ?? \"ACTIVE\";\n78\t  for (let i = 0; state === \"PROCESSING\" && i < 30; i++) {\n79\t    await new Promise((r) => setTimeout(r, 1000));\n80\t    const st = await fetch(`https://generativelanguage.googleapis.com/v1beta/${file.name}`, { headers: { \"x-goog-api-key\": key }, signal: fetchAbort(signal, 30_000) });\n81\t    if (st.ok) state = ((await st.json()) as { state?: string }).state ?? state;\n82\t  }\n83\t  if (state === \"FAILED\") throw new Error(\"Gemini Files 처리 실패(state=FAILED)\");\n84\t  return { fileUri: file.uri, mimeType: file.mimeType ?? mimeType };\n85\t}\n86\t\n87\t// 첨부(PDF·이미지)가 있는데 400 INVALID_ARGUMENT가 오면, 거의 ★페이지 이미지 해상도/용량 과대★다(순수·테스트).\n88\t//   업로드(Files API)는 됐는데 generateContent가 거부 = 모델이 그 이미지를 못 다룸. 암호 같은 원문 대신 해결을 안내.\n89\t//   (예: A4 4장이 70MB+인 초고DPI 스캔 → Gemini 페이지 이미지 한도 초과.)\n90\texport function geminiAttachment400Message(body: string): string {\n91\t  return `Gemini가 첨부 파일을 처리하지 못했습니다(400). 스캔 PDF/이미지의 ★해상도·용량이 과도하게 큰★ 경우입니다 — 해상도를 낮춰(예: 150~300 DPI로 재저장) 용량을 줄여 다시 올리세요. (원문: ${body.slice(0, 200)})`;\n92\t}\n93\t\n94\texport async function geminiStructured<T>(opts: GeminiOpts): Promise<{ data: T; usage: Usage }> {\n95\t  const key = opts.apiKey ?? geminiApiKey();\n96\t  if (!key) throw new Error(\"GEMINI_API_KEY 미설정 — Gemini 공급자를 쓰려면 키가 필요합니다(AI Studio에서 발급).\");\n97\t\n98\t  const hadAttachment = (opts.images?.length ?? 0) + (opts.documents?.length ?? 0) > 0;\n99\t  const parts: Record<string, unknown>[] = [{ text: opts.userText }];\n100\t  // 첨부(이미지·문서): inline 한도 이하는 base64 inline, 초과는 ★Files API 업로드 후 fileData 참조★(L3c).\n101\t  const limit = inlineMaxBytes();\n102\t  for (const att of [...(opts.images ?? []), ...(opts.documents ?? [])]) {\n103\t    if (attachmentMode(att.dataBase64.length, limit) === \"files-api\") {\n104\t      const bytes = Buffer.from(att.dataBase64, \"base64\");\n105\t      console.log(`[gemini] inline 한도 초과(${bytes.byteLength}B) → Files API 업로드(${att.mediaType})`);\n106\t      const f = await uploadGeminiFile(bytes, att.mediaType, key, opts.signal);\n107\t      parts.push({ fileData: { mimeType: f.mimeType, fileUri: f.fileUri } });\n108\t    } else {\n109\t      parts.push({ inlineData: { mimeType: att.mediaType, data: att.dataBase64 } });\n110\t    }\n111\t  }\n112\t\n113\t  const url = `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(opts.model)}:generateContent`;\n114\t  let res: Response;\n115\t  try {\n116\t    res = await fetch(url, {\n117\t      method: \"POST\",\n118\t      signal: fetchAbort(opts.signal), // ★타임아웃★ — hang 방지(R1)\n119\t      headers: { \"content-type\": \"application/json\", \"x-goog-api-key\": key },\n120\t      body: JSON.stringify({\n121\t        systemInstruction: { parts: [{ text: opts.system }] },\n122\t        contents: [{ role: \"user\", parts }],\n123\t        generationConfig: {\n124\t          responseMimeType: \"application/json\",\n125\t          responseSchema: toGeminiSchema(opts.schema),\n126\t          maxOutputTokens: opts.maxTokens ?? 16384,\n127\t          temperature: 0,\n128\t        },\n129\t      }),\n130\t    });\n131\t  } catch (e) {\n132\t    throw new Error(`Gemini 연결 실패: ${String(e)}`);\n133\t  }\n134\t  if (!res.ok) {\n135\t    const body = await res.text().catch(() => \"\");\n136\t    if (res.status === 404) throw new Error(`Gemini 모델 '${opts.model}' 없음 — GEMINI_MODEL을 현행 모델명으로 설정하세요. ${body.slice(0, 200)}`);\n137\t    if (res.status === 429) throw new Error(`Gemini 사용량 한도 초과(무료 등급). 잠시 후 다시 시도하세요. ${body.slice(0, 150)}`);\n138\t    if (res.status === 400 && hadAttachment) throw new Error(geminiAttachment400Message(body)); // 첨부 해상도/용량 과대 안내\n139\t    throw new Error(`Gemini ${res.status}: ${body.slice(0, 300)}`);\n140\t  }\n141\t  const j = (await res.json()) as {\n142\t    candidates?: { content?: { parts?: { text?: string }[] }; finishReason?: string }[];\n143\t    promptFeedback?: { blockReason?: string };\n144\t    usageMetadata?: { promptTokenCount?: number; candidatesTokenCount?: number };\n145\t  };\n146\t  const cand = j.candidates?.[0];\n147\t  const text = (cand?.content?.parts ?? []).map((p) => p.text ?? \"\").join(\"\");\n148\t  const finish = cand?.finishReason;\n149\t  if (!text) {\n150\t    const reason = finish || j.promptFeedback?.blockReason || \"unknown\";\n151\t    throw new Error(`Gemini가 응답을 반환하지 않았습니다(이유=${reason}).`);\n152\t  }\n153\t  // ★출력 잘림/차단★ — text가 있어도 불완전(특히 MAX_TOKENS면 JSON이 잘려 파싱 실패). 명확히 안내한다.\n154\t  // ★주의: 이 에러는 retryable로 만들지 않는다(폴백 체인의 Groq는 TPM이 더 작아 큰 자료엔 거의 100% 413).\n155\t  //   잘림은 같은 Gemini에서 출력 상한↑(maxOutputTokens)이나 자료 분할로 푼다. (Groq 'length' 에러와 동일 문구.)\n156\t  if (finish === \"MAX_TOKENS\") {\n157\t    throw new Error(\"Gemini 출력이 최대 길이(maxOutputTokens)에 도달해 응답이 잘렸습니다. 자료가 너무 큽니다 — 더 작게 나눠 올려주세요.\");\n158\t  }\n159\t  if (finish === \"SAFETY\" || finish === \"RECITATION\") {\n160\t    throw new Error(`Gemini가 콘텐츠 정책(${finish})으로 응답을 제한했습니다. 다른 모델을 선택하거나 자료를 조정해 주세요.`);\n161\t  }\n162\t  let data: T;\n163\t  try {\n164\t    data = JSON.parse(text) as T;\n165\t  } catch {\n166\t    // 원시 모델 출력은 사용자에게 노출하지 않는다(잘린 JSON이 그대로 보였던 버그) — 서버 로그에만 남김.\n167\t    console.error(`[gemini] JSON 파싱 실패 (model=${opts.model}, finish=${finish ?? \"?\"}): ${text.slice(0, 500)}`);\n168\t    throw new Error(\"Gemini가 형식에 맞는 JSON을 반환하지 못했습니다(파싱 실패). 다시 시도하거나 자료를 더 작게 나눠 올려주세요.\");\n169\t  }\n170\t  const um = j.usageMetadata ?? {};\n171\t  return { data, usage: { inputTokens: um.promptTokenCount ?? 0, outputTokens: um.candidatesTokenCount ?? 0 } };\n172\t}\n173\t\n174\t// ── 음성·영상 전사(STT) 폴백 — Gemini 네이티브 오디오 ──────────────────────\n175\t// Groq(1순위) 실패 시 폴백. inline 100MB 한도(2026) — 초과는 Files API(후속 5d). ★영상 mime를 그대로 보내면\n176\t// Gemini가 '영상'으로 처리(초당 258토큰=비용↑) → 가능하면 오디오만(ffmpeg 5c) 권장. docs/PLAN-audio-video-ingest §4.\n177\t// ★무료등급=데이터가 Google로 전송·학습됨 → 호출측이 extractor 'gemini-'로 표시·경고(민감 자료 금지).\n178\texport const GEMINI_INLINE_MAX_BYTES = 100 * 1024 * 1024;\n179\t\n180\texport interface GeminiTranscribeResult { text: string; durationSec?: number; model: string }\n181\t\n182\t/** 전사 프롬프트 — diarize면 화자 구분 라벨 요청(화자1/화자2…). 순수함수(테스트용). */\n183\texport function transcribePrompt(diarize?: boolean): string {\n184\t  const nonSpeech = \"기침·웃음·박수·전화벨처럼 의미 있는 비음성 소리는 (기침)·(웃음)처럼 괄호로 표시하되, 없는 소리를 지어내지 마세요.\";\n185\t  return diarize\n186\t    ? `이 오디오를 한국어로 전사하되, 서로 다른 목소리를 [화자1], [화자2]처럼 구분해 각 발화 앞에 표시하세요. 들리는 말을 빠짐없이 그대로 옮기고(요약·생략 금지), ${nonSpeech} 설명·머리말 없이 전사 텍스트만 출력하세요.`\n187\t    : `이 오디오를 한국어로 정확히 전사하세요. 들리는 말을 빠짐없이 그대로 옮기고(요약·생략 금지), ${nonSpeech} 설명·머리말 없이 전사 텍스트만 출력하세요.`;\n188\t}\n189\t\n190\texport async function geminiTranscribe(\n191\t  buf: Buffer,\n192\t  filename: string,\n193\t  mime: string,\n194\t  opts?: { apiKey?: string; model?: string; diarize?: boolean },\n195\t): Promise<GeminiTranscribeResult> {\n196\t  const key = opts?.apiKey ?? geminiApiKey();\n197\t  if (!key) throw new Error(\"GEMINI_API_KEY 미설정 — Gemini 텍스트 변환를 쓰려면 키가 필요합니다(AI Studio에서 발급).\");\n198\t  if (buf.byteLength > GEMINI_INLINE_MAX_BYTES) {\n199\t    throw new Error(`텍스트 변환 파일이 Gemini inline 한도(100MB)를 초과했습니다(${(buf.byteLength / 1048576).toFixed(1)}MB) — 더 짧게 나눠 올려주세요(Files API는 후속).`);\n200\t  }\n201\t  const model = opts?.model || geminiDefaultModel();\n202\t  const prompt = transcribePrompt(opts?.diarize);\n203\t  const url = `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:generateContent`;\n204\t  let res: Response;\n205\t  try {\n206\t    res = await fetch(url, {\n207\t      method: \"POST\",\n208\t      signal: fetchAbort(undefined, 300_000), // 전사(긴 음성 여유) — hang 방지(R1)\n209\t      headers: { \"content-type\": \"application/json\", \"x-goog-api-key\": key },\n210\t      body: JSON.stringify({\n211\t        contents: [{ role: \"user\", parts: [{ text: prompt }, { inlineData: { mimeType: mime || \"audio/mpeg\", data: buf.toString(\"base64\") } }] }],\n212\t        generationConfig: { temperature: 0, maxOutputTokens: 8192 },\n213\t      }),\n214\t    });\n215\t  } catch (e) {\n216\t    throw new Error(`Gemini 텍스트 변환 연결 실패: ${String(e)}`);\n217\t  }\n218\t  if (!res.ok) {\n219\t    const body = await res.text().catch(() => \"\");\n220\t    if (res.status === 404) throw new Error(`Gemini 모델 '${model}' 없음 — GEMINI_MODEL을 확인하세요. ${body.slice(0, 180)}`);\n221\t    if (res.status === 429) throw new Error(`Gemini 텍스트 변환 한도 초과(429·무료 등급). 잠시 후 다시 시도하세요. ${body.slice(0, 150)}`);\n222\t    throw new Error(`Gemini 텍스트 변환 ${res.status}: ${body.slice(0, 300)}`);\n223\t  }\n224\t  const j = (await res.json()) as {\n225\t    candidates?: { content?: { parts?: { text?: string }[] }; finishReason?: string }[];\n226\t    promptFeedback?: { blockReason?: string };\n227\t  };\n228\t  const cand = j.candidates?.[0];\n229\t  const text = (cand?.content?.parts ?? []).map((p) => p.text ?? \"\").join(\"\").trim();\n230\t  if (!text) {\n231\t    const reason = cand?.finishReason || j.promptFeedback?.blockReason || \"unknown\";\n232\t    throw new Error(`Gemini 텍스트 변환가 빈 응답을 반환했습니다(이유=${reason}).`);\n233\t  }\n234\t  return { text, model };\n235\t}\n236\t\n237\t// ── Gemini 웹 검색(Google Search 그라운딩) ──────────────────────────────\n238\t// 무료 등급에서도 자체 Google 검색으로 최신 외부 사실에 답한다. ★답변·출처만 반환하고\n239\t// git 위키·queries·검색인덱스엔 절대 저장하지 않는다(REQ-SEARCH-003 — 호출부가 webSourced로만 보관).\n240\tconst WEB_SYSTEM =\n241\t  \"당신은 사내 위키 어시스턴트입니다. 사용자의 질문에 Google 검색으로 최신·외부 사실을 확인해 한국어로 간결·정확히 답하세요. \" +\n242\t  \"핵심 주장에는 근거를 들고, 확실하지 않으면 불확실함을 밝히세요. \" +\n243\t  \"이 답변은 '외부 웹' 기반이며 사내 위키에는 저장되지 않습니다(세션 한정).\";\n244\t// 룸(프로젝트 방) 위키 컨텍스트가 주어지면 ★룸 지식 우선 + 웹 보강★으로 답하게 한다.\n245\tconst ROOM_HINT =\n246\t  \"아래 '이 룸의 위키'는 이 프로젝트 룸의 내부 지식이다. ★먼저 이 룸 위키를 근거로★ 답하고, 웹 검색은 룸 위키에 없는 최신·외부 사실을 보강할 때만 써라. \" +\n247\t  \"룸 위키 기반 내용과 웹 기반 내용을 구분해 표기하라(예: 출처 '룸 위키'/'웹'). 룸 위키에 답이 있으면 그것을 우선한다.\";\n248\t\n249\texport interface GeminiWebAnswer { answer: string; citations: { url: string; title: string }[]; usage: Usage }\n250\t\n251\texport async function geminiWebSearch(input: {\n252\t  question: string;\n253\t  history?: { role: \"user\" | \"assistant\"; content: string }[];\n254\t  model?: string;\n255\t  roomContext?: string; // 이 룸의 위키(목차+관련 페이지) — 있으면 룸 우선 + 웹 보강\n256\t}): Promise<GeminiWebAnswer> {\n257\t  const key = geminiApiKey();\n258\t  if (!key) throw new Error(\"GEMINI_API_KEY 미설정 — Gemini 웹 검색을 쓰려면 키가 필요합니다.\");\n259\t  const model = input.model || geminiDefaultModel();\n260\t  const contents = [\n261\t    ...(input.history ?? []).map((m) => ({ role: m.role === \"assistant\" ? \"model\" : \"user\", parts: [{ text: m.content }] })),\n262\t    { role: \"user\", parts: [{ text: input.question }] },\n263\t  ];\n264\t  const url = `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:generateContent`;\n265\t  let res: Response;\n266\t  try {\n267\t    res = await fetch(url, {\n268\t      method: \"POST\",\n269\t      signal: fetchAbort(), // ★타임아웃★ — hang 방지(R1)\n270\t      headers: { \"content-type\": \"application/json\", \"x-goog-api-key\": key },\n271\t      // 그라운딩(google_search) 사용 시 responseSchema/JSON 모드는 못 쓰므로 자유 텍스트로 받는다.\n272\t      body: JSON.stringify({\n273\t        systemInstruction: { parts: [{ text: input.roomContext ? `${WEB_SYSTEM}\\n\\n${ROOM_HINT}\\n\\n# 이 룸의 위키(내부 지식)\\n${input.roomContext}` : WEB_SYSTEM }] },\n274\t        contents,\n275\t        tools: [{ google_search: {} }],\n276\t        generationConfig: { temperature: 0, maxOutputTokens: 2048 },\n277\t      }),\n278\t    });\n279\t  } catch (e) {\n280\t    throw new Error(`Gemini 웹 검색 연결 실패: ${String(e)}`);\n281\t  }\n282\t  if (!res.ok) {\n283\t    const body = await res.text().catch(() => \"\");\n284\t    if (res.status === 404) throw new Error(`Gemini 모델 '${model}' 없음/웹검색 미지원 — GEMINI_MODEL을 확인하세요. ${body.slice(0, 180)}`);\n285\t    if (res.status === 429) throw new Error(`Gemini 사용량 한도 초과(무료 등급). 잠시 후 다시 시도하세요. ${body.slice(0, 150)}`);\n286\t    throw new Error(`Gemini 웹 ${res.status}: ${body.slice(0, 300)}`);\n287\t  }\n288\t  const j = (await res.json()) as {\n289\t    candidates?: {\n290\t      content?: { parts?: { text?: string }[] };\n291\t      finishReason?: string;\n292\t      groundingMetadata?: { groundingChunks?: { web?: { uri?: string; title?: string } }[] };\n293\t    }[];\n294\t    promptFeedback?: { blockReason?: string };\n295\t    usageMetadata?: { promptTokenCount?: number; candidatesTokenCount?: number };\n296\t  };\n297\t  const cand = j.candidates?.[0];\n298\t  const answer = (cand?.content?.parts ?? []).map((p) => p.text ?? \"\").join(\"\");\n299\t  const cites = new Map<string, string>();\n300\t  for (const c of cand?.groundingMetadata?.groundingChunks ?? []) {\n301\t    if (c.web?.uri) cites.set(c.web.uri, c.web.title || c.web.uri);\n302\t  }\n303\t  const um = j.usageMetadata ?? {};\n304\t  return {\n305\t    answer: answer.trim() || \"(웹 검색에서 충분한 결과를 찾지 못했습니다)\",\n306\t    citations: [...cites].map(([uri, title]) => ({ url: uri, title })),\n307\t    usage: { inputTokens: um.promptTokenCount ?? 0, outputTokens: um.candidatesTokenCount ?? 0 },\n308\t  };\n309\t}\n310\t"}]},"uuid":"4fb63ba3-6cc4-4baf-b747-f57c90813ee7","timestamp":"2026-06-28T11:13:59.179Z","toolUseResult":{"type":"text","file":{"filePath":"E:\\llm-wiki\\lib\\gemini.ts","content":"import type { Usage } from \"./anthropic\";\nimport { firstKey, slotHasKey } from \"./secrets\";\nimport { fetchAbort } from \"./httpTimeout\";\nimport { attachmentMode } from \"./attachments\";\n\n// Google Gemini 어댑터(무료 등급=빠름, 단 데이터가 Google로 전송·학습됨 → 비민감 자료만).\n// Anthropic/Ollama callStructured와 동일 인터페이스. 구조화 출력은 controlled generation\n// (responseMimeType: application/json + responseSchema)로 강제한다.\n\nexport function geminiApiKey(): string | null {\n  return firstKey(\"gemini\"); // DB(관리자 입력) 우선, 없으면 env GEMINI_API_KEY\n}\nexport function geminiEnabled(): boolean {\n  return slotHasKey(\"gemini\");\n}\nexport function geminiDefaultModel(): string {\n  return process.env.GEMINI_MODEL?.trim() || \"gemini-2.5-flash\";\n}\n\n// JSON Schema → Gemini responseSchema(OpenAPI 부분집합). type 대문자화 + 지원 키만 통과.\ntype JSchema = Record<string, unknown>;\nfunction toGeminiSchema(s: unknown): unknown {\n  if (!s || typeof s !== \"object\") return s;\n  const o = s as JSchema;\n  const out: JSchema = {};\n  if (o.type) out.type = String(o.type).toUpperCase();\n  if (o.description) out.description = o.description;\n  if (o.enum) out.enum = o.enum;\n  if (o.nullable) out.nullable = o.nullable;\n  if (o.items) out.items = toGeminiSchema(o.items);\n  if (o.properties && typeof o.properties === \"object\") {\n    const props: JSchema = {};\n    for (const [k, v] of Object.entries(o.properties as JSchema)) props[k] = toGeminiSchema(v);\n    out.properties = props;\n    if (Array.isArray(o.required)) out.required = o.required;\n  }\n  return out;\n}\n\nexport interface GeminiOpts {\n  model: string;\n  system: string;\n  userText: string;\n  schema: Record<string, unknown>;\n  maxTokens?: number;\n  images?: { mediaType: string; dataBase64: string }[];\n  documents?: { mediaType: string; dataBase64: string }[];\n  signal?: AbortSignal; // 취소 — abort 시 fetch 중단\n  apiKey?: string; // 회전 주입 키(미지정 시 geminiApiKey())\n}\n\n// ★L3c: inline 한도 초과 첨부는 Files API로★(docs/PLAN §11.4). Gemini generateContent의 inline(base64)\n//   요청 총량 한도(~20MB)를 넘는 대용량 스캔 PDF·이미지는 ★Files API에 먼저 업로드★ 후 fileUri로 참조한다.\n//   임계는 env(GEMINI_INLINE_MAX_BYTES, 기본 15MB)로 조정 — 작은 파일로 Files API 경로를 검증할 때 낮춘다.\nfunction inlineMaxBytes(): number {\n  return Number(process.env.GEMINI_INLINE_MAX_BYTES || 0) || 15 * 1024 * 1024;\n}\n\n// Files API 업로드(raw 프로토콜) → ACTIVE까지 폴링 → fileUri 반환. PDF·이미지는 보통 즉시 ACTIVE.\nasync function uploadGeminiFile(bytes: Buffer, mimeType: string, key: string, signal?: AbortSignal): Promise<{ fileUri: string; mimeType: string }> {\n  const up = await fetch(\"https://generativelanguage.googleapis.com/upload/v1beta/files\", {\n    method: \"POST\",\n    signal: fetchAbort(signal, 300_000), // 대용량 업로드(최대 5분) — hang 방지(R1)\n    headers: {\n      \"x-goog-api-key\": key,\n      \"X-Goog-Upload-Protocol\": \"raw\",\n      \"X-Goog-Upload-Header-Content-Type\": mimeType,\n      \"content-type\": mimeType,\n    },\n    body: new Uint8Array(bytes),\n  });\n  if (!up.ok) throw new Error(`Gemini Files 업로드 실패 ${up.status}: ${(await up.text().catch(() => \"\")).slice(0, 200)}`);\n  const uj = (await up.json()) as { file?: { uri?: string; name?: string; state?: string; mimeType?: string } };\n  const file = uj.file;\n  if (!file?.uri || !file?.name) throw new Error(\"Gemini Files 업로드 응답에 file.uri/name 없음\");\n  // 상태 폴링(PROCESSING→ACTIVE). 문서·이미지는 대개 즉시 ACTIVE — 최대 ~30초.\n  let state = file.state ?? \"ACTIVE\";\n  for (let i = 0; state === \"PROCESSING\" && i < 30; i++) {\n    await new Promise((r) => setTimeout(r, 1000));\n    const st = await fetch(`https://generativelanguage.googleapis.com/v1beta/${file.name}`, { headers: { \"x-goog-api-key\": key }, signal: fetchAbort(signal, 30_000) });\n    if (st.ok) state = ((await st.json()) as { state?: string }).state ?? state;\n  }\n  if (state === \"FAILED\") throw new Error(\"Gemini Files 처리 실패(state=FAILED)\");\n  return { fileUri: file.uri, mimeType: file.mimeType ?? mimeType };\n}\n\n// 첨부(PDF·이미지)가 있는데 400 INVALID_ARGUMENT가 오면, 거의 ★페이지 이미지 해상도/용량 과대★다(순수·테스트).\n//   업로드(Files API)는 됐는데 generateContent가 거부 = 모델이 그 이미지를 못 다룸. 암호 같은 원문 대신 해결을 안내.\n//   (예: A4 4장이 70MB+인 초고DPI 스캔 → Gemini 페이지 이미지 한도 초과.)\nexport function geminiAttachment400Message(body: string): string {\n  return `Gemini가 첨부 파일을 처리하지 못했습니다(400). 스캔 PDF/이미지의 ★해상도·용량이 과도하게 큰★ 경우입니다 — 해상도를 낮춰(예: 150~300 DPI로 재저장) 용량을 줄여 다시 올리세요. (원문: ${body.slice(0, 200)})`;\n}\n\nexport async function geminiStructured<T>(opts: GeminiOpts): Promise<{ data: T; usage: Usage }> {\n  const key = opts.apiKey ?? geminiApiKey();\n  if (!key) throw new Error(\"GEMINI_API_KEY 미설정 — Gemini 공급자를 쓰려면 키가 필요합니다(AI Studio에서 발급).\");\n\n  const hadAttachment = (opts.images?.length ?? 0) + (opts.documents?.length ?? 0) > 0;\n  const parts: Record<string, unknown>[] = [{ text: opts.userText }];\n  // 첨부(이미지·문서): inline 한도 이하는 base64 inline, 초과는 ★Files API 업로드 후 fileData 참조★(L3c).\n  const limit = inlineMaxBytes();\n  for (const att of [...(opts.images ?? []), ...(opts.documents ?? [])]) {\n    if (attachmentMode(att.dataBase64.length, limit) === \"files-api\") {\n      const bytes = Buffer.from(att.dataBase64, \"base64\");\n      console.log(`[gemini] inline 한도 초과(${bytes.byteLength}B) → Files API 업로드(${att.mediaType})`);\n      const f = await uploadGeminiFile(bytes, att.mediaType, key, opts.signal);\n      parts.push({ fileData: { mimeType: f.mimeType, fileUri: f.fileUri } });\n    } else {\n      parts.push({ inlineData: { mimeType: att.mediaType, data: att.dataBase64 } });\n    }\n  }\n\n  const url = `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(opts.model)}:generateContent`;\n  let res: Response;\n  try {\n    res = await fetch(url, {\n      method: \"POST\",\n      signal: fetchAbort(opts.signal), // ★타임아웃★ — hang 방지(R1)\n      headers: { \"content-type\": \"application/json\", \"x-goog-api-key\": key },\n      body: JSON.stringify({\n        systemInstruction: { parts: [{ text: opts.system }] },\n        contents: [{ role: \"user\", parts }],\n        generationConfig: {\n          responseMimeType: \"application/json\",\n          responseSchema: toGeminiSchema(opts.schema),\n          maxOutputTokens: opts.maxTokens ?? 16384,\n          temperature: 0,\n        },\n      }),\n    });\n  } catch (e) {\n    throw new Error(`Gemini 연결 실패: ${String(e)}`);\n  }\n  if (!res.ok) {\n    const body = await res.text().catch(() => \"\");\n    if (res.status === 404) throw new Error(`Gemini 모델 '${opts.model}' 없음 — GEMINI_MODEL을 현행 모델명으로 설정하세요. ${body.slice(0, 200)}`);\n    if (res.status === 429) throw new Error(`Gemini 사용량 한도 초과(무료 등급). 잠시 후 다시 시도하세요. ${body.slice(0, 150)}`);\n    if (res.status === 400 && hadAttachment) throw new Error(geminiAttachment400Message(body)); // 첨부 해상도/용량 과대 안내\n    throw new Error(`Gemini ${res.status}: ${body.slice(0, 300)}`);\n  }\n  const j = (await res.json()) as {\n    candidates?: { content?: { parts?: { text?: string }[] }; finishReason?: string }[];\n    promptFeedback?: { blockReason?: string };\n    usageMetadata?: { promptTokenCount?: number; candidatesTokenCount?: number };\n  };\n  const cand = j.candidates?.[0];\n  const text = (cand?.content?.parts ?? []).map((p) => p.text ?? \"\").join(\"\");\n  const finish = cand?.finishReason;\n  if (!text) {\n    const reason = finish || j.promptFeedback?.blockReason || \"unknown\";\n    throw new Error(`Gemini가 응답을 반환하지 않았습니다(이유=${reason}).`);\n  }\n  // ★출력 잘림/차단★ — text가 있어도 불완전(특히 MAX_TOKENS면 JSON이 잘려 파싱 실패). 명확히 안내한다.\n  // ★주의: 이 에러는 retryable로 만들지 않는다(폴백 체인의 Groq는 TPM이 더 작아 큰 자료엔 거의 100% 413).\n  //   잘림은 같은 Gemini에서 출력 상한↑(maxOutputTokens)이나 자료 분할로 푼다. (Groq 'length' 에러와 동일 문구.)\n  if (finish === \"MAX_TOKENS\") {\n    throw new Error(\"Gemini 출력이 최대 길이(maxOutputTokens)에 도달해 응답이 잘렸습니다. 자료가 너무 큽니다 — 더 작게 나눠 올려주세요.\");\n  }\n  if (finish === \"SAFETY\" || finish === \"RECITATION\") {\n    throw new Error(`Gemini가 콘텐츠 정책(${finish})으로 응답을 제한했습니다. 다른 모델을 선택하거나 자료를 조정해 주세요.`);\n  }\n  let data: T;\n  try {\n    data = JSON.parse(text) as T;\n  } catch {\n    // 원시 모델 출력은 사용자에게 노출하지 않는다(잘린 JSON이 그대로 보였던 버그) — 서버 로그에만 남김.\n    console.error(`[gemini] JSON 파싱 실패 (model=${opts.model}, finish=${finish ?? \"?\"}): ${text.slice(0, 500)}`);\n    throw new Error(\"Gemini가 형식에 맞는 JSON을 반환하지 못했습니다(파싱 실패). 다시 시도하거나 자료를 더 작게 나눠 올려주세요.\");\n  }\n  const um = j.usageMetadata ?? {};\n  return { data, usage: { inputTokens: um.promptTokenCount ?? 0, outputTokens: um.candidatesTokenCount ?? 0 } };\n}\n\n// ── 음성·영상 전사(STT) 폴백 — Gemini 네이티브 오디오 ──────────────────────\n// Groq(1순위) 실패 시 폴백. inline 100MB 한도(2026) — 초과는 Files API(후속 5d). ★영상 mime를 그대로 보내면\n// Gemini가 '영상'으로 처리(초당 258토큰=비용↑) → 가능하면 오디오만(ffmpeg 5c) 권장. docs/PLAN-audio-video-ingest §4.\n// ★무료등급=데이터가 Google로 전송·학습됨 → 호출측이 extractor 'gemini-'로 표시·경고(민감 자료 금지).\nexport const GEMINI_INLINE_MAX_BYTES = 100 * 1024 * 1024;\n\nexport interface GeminiTranscribeResult { text: string; durationSec?: number; model: string }\n\n/** 전사 프롬프트 — diarize면 화자 구분 라벨 요청(화자1/화자2…). 순수함수(테스트용). */\nexport function transcribePrompt(diarize?: boolean): string {\n  const nonSpeech = \"기침·웃음·박수·전화벨처럼 의미 있는 비음성 소리는 (기침)·(웃음)처럼 괄호로 표시하되, 없는 소리를 지어내지 마세요.\";\n  return diarize\n    ? `이 오디오를 한국어로 전사하되, 서로 다른 목소리를 [화자1], [화자2]처럼 구분해 각 발화 앞에 표시하세요. 들리는 말을 빠짐없이 그대로 옮기고(요약·생략 금지), ${nonSpeech} 설명·머리말 없이 전사 텍스트만 출력하세요.`\n    : `이 오디오를 한국어로 정확히 전사하세요. 들리는 말을 빠짐없이 그대로 옮기고(요약·생략 금지), ${nonSpeech} 설명·머리말 없이 전사 텍스트만 출력하세요.`;\n}\n\nexport async function geminiTranscribe(\n  buf: Buffer,\n  filename: string,\n  mime: string,\n  opts?: { apiKey?: string; model?: string; diarize?: boolean },\n): Promise<GeminiTranscribeResult> {\n  const key = opts?.apiKey ?? geminiApiKey();\n  if (!key) throw new Error(\"GEMINI_API_KEY 미설정 — Gemini 텍스트 변환를 쓰려면 키가 필요합니다(AI Studio에서 발급).\");\n  if (buf.byteLength > GEMINI_INLINE_MAX_BYTES) {\n    throw new Error(`텍스트 변환 파일이 Gemini inline 한도(100MB)를 초과했습니다(${(buf.byteLength / 1048576).toFixed(1)}MB) — 더 짧게 나눠 올려주세요(Files API는 후속).`);\n  }\n  const model = opts?.model || geminiDefaultModel();\n  const prompt = transcribePrompt(opts?.diarize);\n  const url = `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:generateContent`;\n  let res: Response;\n  try {\n    res = await fetch(url, {\n      method: \"POST\",\n      signal: fetchAbort(undefined, 300_000), // 전사(긴 음성 여유) — hang 방지(R1)\n      headers: { \"content-type\": \"application/json\", \"x-goog-api-key\": key },\n      body: JSON.stringify({\n        contents: [{ role: \"user\", parts: [{ text: prompt }, { inlineData: { mimeType: mime || \"audio/mpeg\", data: buf.toString(\"base64\") } }] }],\n        generationConfig: { temperature: 0, maxOutputTokens: 8192 },\n      }),\n    });\n  } catch (e) {\n    throw new Error(`Gemini 텍스트 변환 연결 실패: ${String(e)}`);\n  }\n  if (!res.ok) {\n    const body = await res.text().catch(() => \"\");\n    if (res.status === 404) throw new Error(`Gemini 모델 '${model}' 없음 — GEMINI_MODEL을 확인하세요. ${body.slice(0, 180)}`);\n    if (res.status === 429) throw new Error(`Gemini 텍스트 변환 한도 초과(429·무료 등급). 잠시 후 다시 시도하세요. ${body.slice(0, 150)}`);\n    throw new Error(`Gemini 텍스트 변환 ${res.status}: ${body.slice(0, 300)}`);\n  }\n  const j = (await res.json()) as {\n    candidates?: { content?: { parts?: { text?: string }[] }; finishReason?: string }[];\n    promptFeedback?: { blockReason?: string };\n  };\n  const cand = j.candidates?.[0];\n  const text = (cand?.content?.parts ?? []).map((p) => p.text ?? \"\").join(\"\").trim();\n  if (!text) {\n    const reason = cand?.finishReason || j.promptFeedback?.blockReason || \"unknown\";\n    throw new Error(`Gemini 텍스트 변환가 빈 응답을 반환했습니다(이유=${reason}).`);\n  }\n  return { text, model };\n}\n\n// ── Gemini 웹 검색(Google Search 그라운딩) ──────────────────────────────\n// 무료 등급에서도 자체 Google 검색으로 최신 외부 사실에 답한다. ★답변·출처만 반환하고\n// git 위키·queries·검색인덱스엔 절대 저장하지 않는다(REQ-SEARCH-003 — 호출부가 webSourced로만 보관).\nconst WEB_SYSTEM =\n  \"당신은 사내 위키 어시스턴트입니다. 사용자의 질문에 Google 검색으로 최신·외부 사실을 확인해 한국어로 간결·정확히 답하세요. \" +\n  \"핵심 주장에는 근거를 들고, 확실하지 않으면 불확실함을 밝히세요. \" +\n  \"이 답변은 '외부 웹' 기반이며 사내 위키에는 저장되지 않습니다(세션 한정).\";\n// 룸(프로젝트 방) 위키 컨텍스트가 주어지면 ★룸 지식 우선 + 웹 보강★으로 답하게 한다.\nconst ROOM_HINT =\n  \"아래 '이 룸의 위키'는 이 프로젝트 룸의 내부 지식이다. ★먼저 이 룸 위키를 근거로★ 답하고, 웹 검색은 룸 위키에 없는 최신·외부 사실을 보강할 때만 써라. \" +\n  \"룸 위키 기반 내용과 웹 기반 내용을 구분해 표기하라(예: 출처 '룸 위키'/'웹'). 룸 위키에 답이 있으면 그것을 우선한다.\";\n\nexport interface GeminiWebAnswer { answer: string; citations: { url: string; title: string }[]; usage: Usage }\n\nexport async function geminiWebSearch(input: {\n  question: string;\n  history?: { role: \"user\" | \"assistant\"; content: string }[];\n  model?: string;\n  roomContext?: string; // 이 룸의 위키(목차+관련 페이지) — 있으면 룸 우선 + 웹 보강\n}): Promise<GeminiWebAnswer> {\n  const key = geminiApiKey();\n  if (!key) throw new Error(\"GEMINI_API_KEY 미설정 — Gemini 웹 검색을 쓰려면 키가 필요합니다.\");\n  const model = input.model || geminiDefaultModel();\n  const contents = [\n    ...(input.history ?? []).map((m) => ({ role: m.role === \"assistant\" ? \"model\" : \"user\", parts: [{ text: m.content }] })),\n    { role: \"user\", parts: [{ text: input.question }] },\n  ];\n  const url = `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:generateContent`;\n  let res: Response;\n  try {\n    res = await fetch(url, {\n      method: \"POST\",\n      signal: fetchAbort(), // ★타임아웃★ — hang 방지(R1)\n      headers: { \"content-type\": \"application/json\", \"x-goog-api-key\": key },\n      // 그라운딩(google_search) 사용 시 responseSchema/JSON 모드는 못 쓰므로 자유 텍스트로 받는다.\n      body: JSON.stringify({\n        systemInstruction: { parts: [{ text: input.roomContext ? `${WEB_SYSTEM}\\n\\n${ROOM_HINT}\\n\\n# 이 룸의 위키(내부 지식)\\n${input.roomContext}` : WEB_SYSTEM }] },\n        contents,\n        tools: [{ google_search: {} }],\n        generationConfig: { temperature: 0, maxOutputTokens: 2048 },\n      }),\n    });\n  } catch (e) {\n    throw new Error(`Gemini 웹 검색 연결 실패: ${String(e)}`);\n  }\n  if (!res.ok) {\n    const body = await res.text().catch(() => \"\");\n    if (res.status === 404) throw new Error(`Gemini 모델 '${model}' 없음/웹검색 미지원 — GEMINI_MODEL을 확인하세요. ${body.slice(0, 180)}`);\n    if (res.status === 429) throw new Error(`Gemini 사용량 한도 초과(무료 등급). 잠시 후 다시 시도하세요. ${body.slice(0, 150)}`);\n    throw new Error(`Gemini 웹 ${res.status}: ${body.slice(0, 300)}`);\n  }\n  const j = (await res.json()) as {\n    candidates?: {\n      content?: { parts?: { text?: string }[] };\n      finishReason?: string;\n      groundingMetadata?: { groundingChunks?: { web?: { uri?: string; title?: string } }[] };\n    }[];\n    promptFeedback?: { blockReason?: string };\n    usageMetadata?: { promptTokenCount?: number; candidatesTokenCount?: number };\n  };\n  const cand = j.candidates?.[0];\n  const answer = (cand?.content?.parts ?? []).map((p) => p.text ?? \"\").join(\"\");\n  const cites = new Map<string, string>();\n  for (const c of cand?.groundingMetadata?.groundingChunks ?? []) {\n    if (c.web?.uri) cites.set(c.web.uri, c.web.title || c.web.uri);\n  }\n  const um = j.usageMetadata ?? {};\n  return {\n    answer: answer.trim() || \"(웹 검색에서 충분한 결과를 찾지 못했습니다)\",\n    citations: [...cites].map(([uri, title]) => ({ url: uri, title })),\n    usage: { inputTokens: um.promptTokenCount ?? 0, outputTokens: um.candidatesTokenCount ?? 0 },\n  };\n}\n","numLines":310,"startLine":1,"totalLines":310}},"sourceToolAssistantUUID":"36e70234-ca43-41e8-bede-c1e383c64c97","userType":"external","entrypoint":"cli","cwd":"E:\\llm-wiki","sessionId":"6b03d3cf-704b-46f4-952d-418e6244ad85","version":"2.1.195","gitBranch":"feat/backlog-chunked-and-storage","slug":"serene-singing-papert"}
{"parentUuid":"4fb63ba3-6cc4-4baf-b747-f57c90813ee7","isSidechain":false,"message":{"model":"claude-opus-4-8","id":"msg_01S4QFMVSqXKMsvvtfo8jNUd","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01S7YywXEJmBWZNEUujCLfa3","name":"Read","input":{"file_path":"E:\\llm-wiki\\lib\\stt.ts"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4574,"cache_read_input_tokens":75106,"output_tokens":432,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":4574,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":432,"cache_read_input_tokens":75106,"cache_creation_input_tokens":4574,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4574},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CcVZRWT1pDEnfhykQW2ua","type":"assistant","uuid":"17972151-2328-4a67-a666-43440f94b99b","timestamp":"2026-06-28T11:13:59.521Z","userType":"external","entrypoint":"cli","cwd":"E:\\llm-wiki","sessionId":"6b03d3cf-704b-46f4-952d-418e6244ad85","version":"2.1.195","gitBranch":"feat/backlog-chunked-and-storage","slug":"serene-singing-papert"}
{"parentUuid":"17972151-2328-4a67-a666-43440f94b99b","isSidechain":false,"promptId":"72c47ca9-455c-407a-8764-3ca32f2b9ca5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S7YywXEJmBWZNEUujCLfa3","type":"tool_result","content":"1\timport type { ExtractResult } from \"./extract\";\n2\timport { groqTranscribe, openaiCompatEnabled, groqSttModel, GROQ_STT_MAX_BYTES, type TranscribeResult } from \"./openai-compat\";\n3\timport { geminiTranscribe, geminiEnabled } from \"./gemini\";\n4\timport { ffmpegAvailable, extractAudioMp3, splitAudioMp3 } from \"./convert\";\n5\timport { collapseTranscriptLoops, oversizeAudioNeedsSplit } from \"./transcript\";\n6\t\n7\t// 긴 음성 청크 전사(L1) — Groq 25MB 한도를 ffmpeg 분할로 우회. 10분 청크(16kHz mono 64k ≈ 4.8MB), 제한 병렬.\n8\tconst STT_CHUNK_SEC = 600;\n9\tconst STT_CHUNK_CONCURRENCY = 3;\n10\t\n11\t/** 청크 전사 결과들을 순서대로 이어붙임(L1). 텍스트는 빈 줄로 결합, duration 합산. 순수(테스트용). */\n12\texport function stitchTranscripts(parts: { text: string; durationSec?: number }[]): { text: string; durationSec?: number } {\n13\t  const text = parts.map((p) => (p.text || \"\").trim()).filter(Boolean).join(\"\\n\\n\");\n14\t  const dur = parts.reduce((s, p) => s + (p.durationSec ?? 0), 0);\n15\t  return { text, durationSec: dur > 0 ? dur : undefined };\n16\t}\n17\t\n18\t/** 큰 오디오를 ffmpeg로 분할해 청크별 Groq 전사 후 이어붙임. 분할/전부 실패면 null(폴백). 일부 실패는 부분 보존.\n19\t *  onProgress(done,total)=청크 완료마다 호출(J 진행률 — '전사 k/N'). */\n20\tasync function groqTranscribeChunked(buf: Buffer, filename: string, onProgress?: (done: number, total: number) => void): Promise<TranscribeResult | null> {\n21\t  const split = await splitAudioMp3(buf, STT_CHUNK_SEC);\n22\t  if (!split || !split.length) return null;\n23\t  const chunks: Buffer[] = split; // 비-null 확정(클로저 안에서도 narrowing 유지)\n24\t  const base = filename.replace(/\\.[^.]+$/, \"\");\n25\t  const results: (TranscribeResult | null)[] = new Array(chunks.length).fill(null);\n26\t  let next = 0;\n27\t  let done = 0;\n28\t  onProgress?.(0, chunks.length); // 시작 표시\n29\t  async function worker() {\n30\t    while (next < chunks.length) {\n31\t      const i = next++;\n32\t      try { results[i] = await groqTranscribe(chunks[i], `${base}.part${String(i).padStart(4, \"0\")}.mp3`, \"audio/mpeg\"); }\n33\t      catch (e) { console.warn(`[stt] 청크 ${i + 1}/${chunks.length} 전사 실패: ${String(e)}`); results[i] = null; }\n34\t      onProgress?.(++done, chunks.length); // 병렬이라도 완료 누적(순서 무관)\n35\t    }\n36\t  }\n37\t  await Promise.all(Array.from({ length: Math.min(STT_CHUNK_CONCURRENCY, chunks.length) }, worker));\n38\t  const ok = results.filter((r): r is TranscribeResult => !!r); // 순서 유지(인덱스 순)\n39\t  if (!ok.length) return null;\n40\t  const s = stitchTranscripts(ok);\n41\t  return { text: s.text, durationSec: s.durationSec, model: ok[0].model };\n42\t}\n43\t\n44\t// ffmpeg 선행이 필요한 컨테이너 — Groq가 직접 못 받는 영상(.mov 등). FFMPEG_CMD 설정 시에만 처리(5c).\n45\t//   (STT_EXTS=Groq 직수 컨테이너는 extract.ts. 여기 set은 업로드 게이팅·dispatch가 import.)\n46\texport const STT_FFMPEG_EXTS = [\"mov\", \"mkv\", \"avi\", \"m4v\", \"wmv\", \"flv\"];\n47\t\n48\tfunction extLower(name: string): string {\n49\t  return (name || \"\").toLowerCase().match(/\\.([a-z0-9]+)$/)?.[1] ?? \"\";\n50\t}\n51\t\n52\t// 음성·영상 전사(STT) 오케스트레이션 — 추출 레이어(lib/extract.ts)의 한 추출기.\n53\t// 전사문을 정규화 markdown(ExtractResult.text)으로 돌려주면, 그 뒤는 기존 ingestText가 처리한다.\n54\t// 설계: docs/PLAN-audio-video-ingest.md.\n55\t//   5a = Groq 기본. 5b = Groq 실패(429·오류) 시 Gemini 폴백(★Gemini는 외부 전송+무료=학습 → UI 경고는 extractor가\n56\t//        'gemini-'로 시작하는지로 판별·표시). ★전사 모델 ≠ 분석 모델: 여기 텍스트는 .txt와 동일 취급 → 분석은 별도 선택.\n57\t\n58\t// Gemini STT 폴백 허용 여부(기본 on). ★외부학습 차단 정책★이면 STT_GEMINI_FALLBACK=false로 끈다(docs §E).\n59\texport function sttGeminiFallback(): boolean {\n60\t  return process.env.STT_GEMINI_FALLBACK !== \"false\";\n61\t}\n62\t\n63\t// ★J 전사 비동기화★(기본 OFF=현행 동기). ON이면 업로드 시 전사를 ★건너뛰고★(raw만 스테이징) [분석] 단계에서\n64\t//   워커가 raw에서 전사 → 진행률·타이머·상태가 전 구간 일관(긴 음성 업로드 무진행 대기 해소). ship-dark.\n65\texport function sttAsync(): boolean {\n66\t  return process.env.STT_ASYNC === \"true\";\n67\t}\n68\t// 전사 공급자 한도(429) 오류 판별(순수) — 한도는 일시적이라 폴백보다 '재처리'가 정답.\n69\texport function isRateLimitError(msg: string): boolean {\n70\t  return /\\b429\\b|rate limit|한도 초과|RESOURCE_EXHAUSTED|quota/i.test(msg);\n71\t}\n72\t\n73\t/** 초 → \"m:ss\"(헤더 표기용). 없거나 비정상이면 빈 문자열. */\n74\texport function fmtDuration(sec?: number): string {\n75\t  if (!sec || !Number.isFinite(sec) || sec < 0) return \"\";\n76\t  const m = Math.floor(sec / 60);\n77\t  const s = Math.floor(sec % 60);\n78\t  return `${m}:${String(s).padStart(2, \"0\")}`;\n79\t}\n80\t\n81\t/**\n82\t * 전사 텍스트 → 정규화 ExtractResult. 네트워크 없음(순수) — 테스트·재사용 가능.\n83\t * quality는 전사문 글자수 기준(기존 extract 패턴). extractor는 공급자 포함 전체 라벨(예: groq-... / gemini-...).\n84\t */\n85\texport function buildTranscriptResult(\n86\t  text: string,\n87\t  filename: string,\n88\t  durationSec: number | undefined,\n89\t  extractor: string,\n90\t): ExtractResult {\n91\t  const raw = (text || \"\").trim();\n92\t  // ★전사 품질 가드(§F)★: 환각 반복 루프를 1주기로 접어 garbage가 분석에 들어가지 않게 한다(앞부분 정상 보존).\n93\t  //   루프 없으면 clean===raw(불변·회귀0). 접혔으면 meta.loopCollapsed로 UI 배지/검토 신호.\n94\t  const { text: clean, info: loop } = collapseTranscriptLoops(raw);\n95\t  const len = clean.replace(/\\s/g, \"\").length;\n96\t  const dur = fmtDuration(durationSec);\n97\t  const header = `## 음성 텍스트 변환 (${filename}${dur ? `, ${dur}` : \"\"})`;\n98\t  return {\n99\t    text: clean ? `${header}\\n\\n${clean}` : \"\",\n100\t    quality: len >= 40 ? \"full\" : len > 0 ? \"partial\" : \"none\", // 글자수 기준(기존) — 루프 가드는 본문 정리+마커로 처리\n101\t    extractor,\n102\t    meta: { durationSec, transcribed: true, ...(loop.collapsed ? { loopCollapsed: loop.removed, loopPhrase: loop.phrase } : {}) },\n103\t  };\n104\t}\n105\t\n106\t/**\n107\t * 오디오/영상 버퍼 → 전사 ExtractResult. ★Groq 기본 → Gemini 폴백★.\n108\t * - 둘 다 키 없으면 quality:'none'(graceful 미분석 — 호출측 dispatch가 흡수).\n109\t * - Groq 실패(429·오류)면 Gemini로 폴백(가능할 때). 전사 오류는 throw → dispatch try/catch가 'none'+error로 흡수.\n110\t */\n111\texport async function transcribe(\n112\t  buf: Buffer,\n113\t  filename: string,\n114\t  mime: string,\n115\t  opts?: { diarize?: boolean; onProgress?: (done: number, total: number) => void },\n116\t): Promise<ExtractResult> {\n117\t  const groq = openaiCompatEnabled();\n118\t  const gem = geminiEnabled();\n119\t  if (!groq && !gem) {\n120\t    // 전사 공급자 미설정 → 원본은 보존되고 '미분석'으로 남는다(4j 패턴).\n121\t    return { text: \"\", quality: \"none\", extractor: \"stt-unconfigured\" };\n122\t  }\n123\t  // 영상(.mov 등)·대용량(>25MB)은 ffmpeg로 오디오만 추출해 한도·비용 회피(5c). 미설정/실패 시 원본 그대로 시도.\n124\t  const a = await prepareAudio(buf, filename, mime);\n125\t  // ★G★: ffmpeg로도 못 줄인 큰 음성(>한도)은 ★조용한 Gemini inline 폴백=환각★을 막고 분할 업로드를 안내한다.\n126\t  //   프로드는 Dockerfile ffmpeg 보유라 미발동. (geminiOptIn=false 기본 — 향후 업로드 폼 토글로 명시 허용 가능.)\n127\t  if (oversizeAudioNeedsSplit(a.buf.byteLength, GROQ_STT_MAX_BYTES, ffmpegAvailable(), false)) {\n128\t    throw new Error(\"긴 음성(25MB 초과)을 처리할 변환기(ffmpeg)가 서버에 없습니다. 음성을 더 짧게 나눠 올려주세요 — 큰 음성을 그대로 외부(Gemini)로 보내면 전사가 망가질 수 있어 막았습니다.\");\n129\t  }\n130\t  // ★화자 구분(diarize) 요청 → Gemini 전용★(Groq Whisper는 화자분리 미지원). Gemini 없으면 아래 일반 경로(Groq 평문, 구분 없음).\n131\t  if (opts?.diarize && gem) {\n132\t    const g = await geminiTranscribe(a.buf, a.filename, a.mime, { diarize: true });\n133\t    return buildTranscriptResult(g.text, filename, g.durationSec, `gemini-${g.model}`);\n134\t  }\n135\t  // 1순위: Groq(무료·초고속). ★25MB 초과 + ffmpeg 있으면 청크 분할 전사(L1)★.\n136\t  if (groq) {\n137\t    const chunked = a.buf.byteLength > GROQ_STT_MAX_BYTES && ffmpegAvailable();\n138\t    try {\n139\t      let r: TranscribeResult | null;\n140\t      if (chunked) {\n141\t        r = await groqTranscribeChunked(a.buf, a.filename, opts?.onProgress);\n142\t      } else {\n143\t        // 비청크(≤한도) 단일 전사도 진행 표시('전사 중 1/1') — J 상태 일관(작은 음성은 빠르게 지나감).\n144\t        opts?.onProgress?.(0, 1);\n145\t        r = await groqTranscribe(a.buf, a.filename, a.mime);\n146\t        opts?.onProgress?.(1, 1);\n147\t      }\n148\t      if (r) return buildTranscriptResult(r.text, filename, r.durationSec, `groq-${r.model}${chunked ? \"-chunked\" : \"\"}`);\n149\t      console.warn(\"[stt] Groq 청크 전사가 결과를 못 냄 → 폴백 시도\"); // r=null(분할/전부 실패)\n150\t    } catch (e) {\n151\t      const msg = String(e);\n152\t      // ★Groq 한도(429)는 일시적★ — Gemini 폴백은 긴 음성에서 잘림·환각으로 ★쓰레기 전사★를 만든다(실측).\n153\t      //   폴백하지 말고 명확히 실패시켜 '잠시 후 재처리'를 유도(Groq 한도는 수~십분 내 리셋). (docs §E)\n154\t      if (isRateLimitError(msg)) {\n155\t        throw new Error(\"음성 텍스트 변환 한도(Groq 무료 등급, 시간당 약 2시간)를 초과했습니다. 잠시 후(약 10분) [재처리]하면 정상 변환됩니다. 급하면 음성을 더 짧게 잘라 올려주세요.\");\n156\t      }\n157\t      if (!gem || !sttGeminiFallback()) throw e; // 폴백 없음/비활성(STT_GEMINI_FALLBACK=false) → 그대로 전파\n158\t      console.warn(`[stt] Groq 전사 실패 → Gemini 폴백: ${msg}`);\n159\t    }\n160\t    if (!gem || !sttGeminiFallback()) return { text: \"\", quality: \"none\", extractor: \"stt-failed\" }; // Groq뿐/폴백 비활성 → 미분석 보존\n161\t  }\n162\t  // 폴백(또는 Groq 미설정·Gemini만): Gemini. ★외부 전송+무료=학습 → extractor 'gemini-'로 UI 경고 판별.\n163\t  const g = await geminiTranscribe(a.buf, a.filename, a.mime);\n164\t  return buildTranscriptResult(g.text, filename, g.durationSec, `gemini-${g.model}`);\n165\t}\n166\t\n167\t/** 영상/대용량이면 ffmpeg로 오디오(mp3)만 추출. ffmpeg 미설정/실패면 원본을 그대로 반환(graceful). */\n168\tasync function prepareAudio(buf: Buffer, filename: string, mime: string): Promise<{ buf: Buffer; filename: string; mime: string }> {\n169\t  const ext = extLower(filename);\n170\t  const needFfmpeg = STT_FFMPEG_EXTS.includes(ext) || mime.startsWith(\"video/\") || buf.byteLength > GROQ_STT_MAX_BYTES;\n171\t  if (needFfmpeg && ffmpegAvailable()) {\n172\t    const audio = await extractAudioMp3(buf, ext || \"bin\");\n173\t    if (audio && audio.byteLength > 0) {\n174\t      return { buf: audio, filename: filename.replace(/\\.[^.]+$/, \"\") + \".mp3\", mime: \"audio/mpeg\" };\n175\t    }\n176\t  }\n177\t  return { buf, filename, mime };\n178\t}\n179\t\n180\t/** 현재 STT(전사) 사용 가능 여부 — uploadPolicy 게이팅용. Groq 또는 Gemini 키. */\n181\texport function sttAvailable(): boolean {\n182\t  return openaiCompatEnabled() || geminiEnabled();\n183\t}\n184\t\n185\t// 전사 소스 판별은 ★클라이언트 공용★이라 순수 모듈로 분리해 re-export(서버 import `from \"./stt\"`는 그대로 동작).\n186\t//   (이 파일은 convert.ts→node:child_process를 끌어 클라 번들에 못 들어가므로, 순수 함수는 ./transcript에 둔다.)\n187\texport { isTranscribedExtractor } from \"./transcript\";\n188\t\n189\t/** 진단·라벨용 현행 1순위 전사 모델명. */\n190\texport function sttModelLabel(): string {\n191\t  return openaiCompatEnabled() ? `groq-${groqSttModel()}` : \"gemini\";\n192\t}\n193\t"}]},"uuid":"8ba04e91-5465-41f5-825d-cdbcaffb5e2c","timestamp":"2026-06-28T11:13:59.531Z","toolUseResult":{"type":"text","file":{"filePath":"E:\\llm-wiki\\lib\\stt.ts","content":"import type { ExtractResult } from \"./extract\";\nimport { groqTranscribe, openaiCompatEnabled, groqSttModel, GROQ_STT_MAX_BYTES, type TranscribeResult } from \"./openai-compat\";\nimport { geminiTranscribe, geminiEnabled } from \"./gemini\";\nimport { ffmpegAvailable, extractAudioMp3, splitAudioMp3 } from \"./convert\";\nimport { collapseTranscriptLoops, oversizeAudioNeedsSplit } from \"./transcript\";\n\n// 긴 음성 청크 전사(L1) — Groq 25MB 한도를 ffmpeg 분할로 우회. 10분 청크(16kHz mono 64k ≈ 4.8MB), 제한 병렬.\nconst STT_CHUNK_SEC = 600;\nconst STT_CHUNK_CONCURRENCY = 3;\n\n/** 청크 전사 결과들을 순서대로 이어붙임(L1). 텍스트는 빈 줄로 결합, duration 합산. 순수(테스트용). */\nexport function stitchTranscripts(parts: { text: string; durationSec?: number }[]): { text: string; durationSec?: number } {\n  const text = parts.map((p) => (p.text || \"\").trim()).filter(Boolean).join(\"\\n\\n\");\n  const dur = parts.reduce((s, p) => s + (p.durationSec ?? 0), 0);\n  return { text, durationSec: dur > 0 ? dur : undefined };\n}\n\n/** 큰 오디오를 ffmpeg로 분할해 청크별 Groq 전사 후 이어붙임. 분할/전부 실패면 null(폴백). 일부 실패는 부분 보존.\n *  onProgress(done,total)=청크 완료마다 호출(J 진행률 — '전사 k/N'). */\nasync function groqTranscribeChunked(buf: Buffer, filename: string, onProgress?: (done: number, total: number) => void): Promise<TranscribeResult | null> {\n  const split = await splitAudioMp3(buf, STT_CHUNK_SEC);\n  if (!split || !split.length) return null;\n  const chunks: Buffer[] = split; // 비-null 확정(클로저 안에서도 narrowing 유지)\n  const base = filename.replace(/\\.[^.]+$/, \"\");\n  const results: (TranscribeResult | null)[] = new Array(chunks.length).fill(null);\n  let next = 0;\n  let done = 0;\n  onProgress?.(0, chunks.length); // 시작 표시\n  async function worker() {\n    while (next < chunks.length) {\n      const i = next++;\n      try { results[i] = await groqTranscribe(chunks[i], `${base}.part${String(i).padStart(4, \"0\")}.mp3`, \"audio/mpeg\"); }\n      catch (e) { console.warn(`[stt] 청크 ${i + 1}/${chunks.length} 전사 실패: ${String(e)}`); results[i] = null; }\n      onProgress?.(++done, chunks.length); // 병렬이라도 완료 누적(순서 무관)\n    }\n  }\n  await Promise.all(Array.from({ length: Math.min(STT_CHUNK_CONCURRENCY, chunks.length) }, worker));\n  const ok = results.filter((r): r is TranscribeResult => !!r); // 순서 유지(인덱스 순)\n  if (!ok.length) return null;\n  const s = stitchTranscripts(ok);\n  return { text: s.text, durationSec: s.durationSec, model: ok[0].model };\n}\n\n// ffmpeg 선행이 필요한 컨테이너 — Groq가 직접 못 받는 영상(.mov 등). FFMPEG_CMD 설정 시에만 처리(5c).\n//   (STT_EXTS=Groq 직수 컨테이너는 extract.ts. 여기 set은 업로드 게이팅·dispatch가 import.)\nexport const STT_FFMPEG_EXTS = [\"mov\", \"mkv\", \"avi\", \"m4v\", \"wmv\", \"flv\"];\n\nfunction extLower(name: string): string {\n  return (name || \"\").toLowerCase().match(/\\.([a-z0-9]+)$/)?.[1] ?? \"\";\n}\n\n// 음성·영상 전사(STT) 오케스트레이션 — 추출 레이어(lib/extract.ts)의 한 추출기.\n// 전사문을 정규화 markdown(ExtractResult.text)으로 돌려주면, 그 뒤는 기존 ingestText가 처리한다.\n// 설계: docs/PLAN-audio-video-ingest.md.\n//   5a = Groq 기본. 5b = Groq 실패(429·오류) 시 Gemini 폴백(★Gemini는 외부 전송+무료=학습 → UI 경고는 extractor가\n//        'gemini-'로 시작하는지로 판별·표시). ★전사 모델 ≠ 분석 모델: 여기 텍스트는 .txt와 동일 취급 → 분석은 별도 선택.\n\n// Gemini STT 폴백 허용 여부(기본 on). ★외부학습 차단 정책★이면 STT_GEMINI_FALLBACK=false로 끈다(docs §E).\nexport function sttGeminiFallback(): boolean {\n  return process.env.STT_GEMINI_FALLBACK !== \"false\";\n}\n\n// ★J 전사 비동기화★(기본 OFF=현행 동기). ON이면 업로드 시 전사를 ★건너뛰고★(raw만 스테이징) [분석] 단계에서\n//   워커가 raw에서 전사 → 진행률·타이머·상태가 전 구간 일관(긴 음성 업로드 무진행 대기 해소). ship-dark.\nexport function sttAsync(): boolean {\n  return process.env.STT_ASYNC === \"true\";\n}\n// 전사 공급자 한도(429) 오류 판별(순수) — 한도는 일시적이라 폴백보다 '재처리'가 정답.\nexport function isRateLimitError(msg: string): boolean {\n  return /\\b429\\b|rate limit|한도 초과|RESOURCE_EXHAUSTED|quota/i.test(msg);\n}\n\n/** 초 → \"m:ss\"(헤더 표기용). 없거나 비정상이면 빈 문자열. */\nexport function fmtDuration(sec?: number): string {\n  if (!sec || !Number.isFinite(sec) || sec < 0) return \"\";\n  const m = Math.floor(sec / 60);\n  const s = Math.floor(sec % 60);\n  return `${m}:${String(s).padStart(2, \"0\")}`;\n}\n\n/**\n * 전사 텍스트 → 정규화 ExtractResult. 네트워크 없음(순수) — 테스트·재사용 가능.\n * quality는 전사문 글자수 기준(기존 extract 패턴). extractor는 공급자 포함 전체 라벨(예: groq-... / gemini-...).\n */\nexport function buildTranscriptResult(\n  text: string,\n  filename: string,\n  durationSec: number | undefined,\n  extractor: string,\n): ExtractResult {\n  const raw = (text || \"\").trim();\n  // ★전사 품질 가드(§F)★: 환각 반복 루프를 1주기로 접어 garbage가 분석에 들어가지 않게 한다(앞부분 정상 보존).\n  //   루프 없으면 clean===raw(불변·회귀0). 접혔으면 meta.loopCollapsed로 UI 배지/검토 신호.\n  const { text: clean, info: loop } = collapseTranscriptLoops(raw);\n  const len = clean.replace(/\\s/g, \"\").length;\n  const dur = fmtDuration(durationSec);\n  const header = `## 음성 텍스트 변환 (${filename}${dur ? `, ${dur}` : \"\"})`;\n  return {\n    text: clean ? `${header}\\n\\n${clean}` : \"\",\n    quality: len >= 40 ? \"full\" : len > 0 ? \"partial\" : \"none\", // 글자수 기준(기존) — 루프 가드는 본문 정리+마커로 처리\n    extractor,\n    meta: { durationSec, transcribed: true, ...(loop.collapsed ? { loopCollapsed: loop.removed, loopPhrase: loop.phrase } : {}) },\n  };\n}\n\n/**\n * 오디오/영상 버퍼 → 전사 ExtractResult. ★Groq 기본 → Gemini 폴백★.\n * - 둘 다 키 없으면 quality:'none'(graceful 미분석 — 호출측 dispatch가 흡수).\n * - Groq 실패(429·오류)면 Gemini로 폴백(가능할 때). 전사 오류는 throw → dispatch try/catch가 'none'+error로 흡수.\n */\nexport async function transcribe(\n  buf: Buffer,\n  filename: string,\n  mime: string,\n  opts?: { diarize?: boolean; onProgress?: (done: number, total: number) => void },\n): Promise<ExtractResult> {\n  const groq = openaiCompatEnabled();\n  const gem = geminiEnabled();\n  if (!groq && !gem) {\n    // 전사 공급자 미설정 → 원본은 보존되고 '미분석'으로 남는다(4j 패턴).\n    return { text: \"\", quality: \"none\", extractor: \"stt-unconfigured\" };\n  }\n  // 영상(.mov 등)·대용량(>25MB)은 ffmpeg로 오디오만 추출해 한도·비용 회피(5c). 미설정/실패 시 원본 그대로 시도.\n  const a = await prepareAudio(buf, filename, mime);\n  // ★G★: ffmpeg로도 못 줄인 큰 음성(>한도)은 ★조용한 Gemini inline 폴백=환각★을 막고 분할 업로드를 안내한다.\n  //   프로드는 Dockerfile ffmpeg 보유라 미발동. (geminiOptIn=false 기본 — 향후 업로드 폼 토글로 명시 허용 가능.)\n  if (oversizeAudioNeedsSplit(a.buf.byteLength, GROQ_STT_MAX_BYTES, ffmpegAvailable(), false)) {\n    throw new Error(\"긴 음성(25MB 초과)을 처리할 변환기(ffmpeg)가 서버에 없습니다. 음성을 더 짧게 나눠 올려주세요 — 큰 음성을 그대로 외부(Gemini)로 보내면 전사가 망가질 수 있어 막았습니다.\");\n  }\n  // ★화자 구분(diarize) 요청 → Gemini 전용★(Groq Whisper는 화자분리 미지원). Gemini 없으면 아래 일반 경로(Groq 평문, 구분 없음).\n  if (opts?.diarize && gem) {\n    const g = await geminiTranscribe(a.buf, a.filename, a.mime, { diarize: true });\n    return buildTranscriptResult(g.text, filename, g.durationSec, `gemini-${g.model}`);\n  }\n  // 1순위: Groq(무료·초고속). ★25MB 초과 + ffmpeg 있으면 청크 분할 전사(L1)★.\n  if (groq) {\n    const chunked = a.buf.byteLength > GROQ_STT_MAX_BYTES && ffmpegAvailable();\n    try {\n      let r: TranscribeResult | null;\n      if (chunked) {\n        r = await groqTranscribeChunked(a.buf, a.filename, opts?.onProgress);\n      } else {\n        // 비청크(≤한도) 단일 전사도 진행 표시('전사 중 1/1') — J 상태 일관(작은 음성은 빠르게 지나감).\n        opts?.onProgress?.(0, 1);\n        r = await groqTranscribe(a.buf, a.filename, a.mime);\n        opts?.onProgress?.(1, 1);\n      }\n      if (r) return buildTranscriptResult(r.text, filename, r.durationSec, `groq-${r.model}${chunked ? \"-chunked\" : \"\"}`);\n      console.warn(\"[stt] Groq 청크 전사가 결과를 못 냄 → 폴백 시도\"); // r=null(분할/전부 실패)\n    } catch (e) {\n      const msg = String(e);\n      // ★Groq 한도(429)는 일시적★ — Gemini 폴백은 긴 음성에서 잘림·환각으로 ★쓰레기 전사★를 만든다(실측).\n      //   폴백하지 말고 명확히 실패시켜 '잠시 후 재처리'를 유도(Groq 한도는 수~십분 내 리셋). (docs §E)\n      if (isRateLimitError(msg)) {\n        throw new Error(\"음성 텍스트 변환 한도(Groq 무료 등급, 시간당 약 2시간)를 초과했습니다. 잠시 후(약 10분) [재처리]하면 정상 변환됩니다. 급하면 음성을 더 짧게 잘라 올려주세요.\");\n      }\n      if (!gem || !sttGeminiFallback()) throw e; // 폴백 없음/비활성(STT_GEMINI_FALLBACK=false) → 그대로 전파\n      console.warn(`[stt] Groq 전사 실패 → Gemini 폴백: ${msg}`);\n    }\n    if (!gem || !sttGeminiFallback()) return { text: \"\", quality: \"none\", extractor: \"stt-failed\" }; // Groq뿐/폴백 비활성 → 미분석 보존\n  }\n  // 폴백(또는 Groq 미설정·Gemini만): Gemini. ★외부 전송+무료=학습 → extractor 'gemini-'로 UI 경고 판별.\n  const g = await geminiTranscribe(a.buf, a.filename, a.mime);\n  return buildTranscriptResult(g.text, filename, g.durationSec, `gemini-${g.model}`);\n}\n\n/** 영상/대용량이면 ffmpeg로 오디오(mp3)만 추출. ffmpeg 미설정/실패면 원본을 그대로 반환(graceful). */\nasync function prepareAudio(buf: Buffer, filename: string, mime: string): Promise<{ buf: Buffer; filename: string; mime: string }> {\n  const ext = extLower(filename);\n  const needFfmpeg = STT_FFMPEG_EXTS.includes(ext) || mime.startsWith(\"video/\") || buf.byteLength > GROQ_STT_MAX_BYTES;\n  if (needFfmpeg && ffmpegAvailable()) {\n    const audio = await extractAudioMp3(buf, ext || \"bin\");\n    if (audio && audio.byteLength > 0) {\n      return { buf: audio, filename: filename.replace(/\\.[^.]+$/, \"\") + \".mp3\", mime: \"audio/mpeg\" };\n    }\n  }\n  return { buf, filename, mime };\n}\n\n/** 현재 STT(전사) 사용 가능 여부 — uploadPolicy 게이팅용. Groq 또는 Gemini 키. */\nexport function sttAvailable(): boolean {\n  return openaiCompatEnabled() || geminiEnabled();\n}\n\n// 전사 소스 판별은 ★클라이언트 공용★이라 순수 모듈로 분리해 re-export(서버 import `from \"./stt\"`는 그대로 동작).\n//   (이 파일은 convert.ts→node:child_process를 끌어 클라 번들에 못 들어가므로, 순수 함수는 ./transcript에 둔다.)\nexport { isTranscribedExtractor } from \"./transcript\";\n\n/** 진단·라벨용 현행 1순위 전사 모델명. */\nexport function sttModelLabel(): string {\n  return openaiCompatEnabled() ? `groq-${groqSttModel()}` : \"gemini\";\n}\n","numLines":193,"startLine":1,"totalLines":193}},"sourceToolAssistantUUID":"17972151-2328-4a67-a666-43440f94b99b","userType":"external","entrypoint":"cli","cwd":"E:\\llm-wiki","sessionId":"6b03d3cf-704b-46f4-952d-418e6244ad85","version":"2.1.195","gitBranch":"feat/backlog-chunked-and-storage","slug":"serene-singing-papert"}
