{"parentUuid":"9732e7b1-ae74-4ed3-ab76-8c30871542d0","isSidechain":false,"promptId":"72c47ca9-455c-407a-8764-3ca32f2b9ca5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018ahBUuiNjBGWyPHHci81HQ","type":"tool_result","content":"The file E:\\llm-wiki\\app\\api\\materials\\[id]\\raw\\route.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"uuid":"13b16d6b-d902-481a-9be5-1e95de82d340","timestamp":"2026-06-28T11:27:57.399Z","toolUseResult":{"filePath":"E:\\llm-wiki\\app\\api\\materials\\[id]\\raw\\route.ts","oldString":"import { promises as fs } from \"node:fs\";\nimport { getSessionUser } from \"@/lib/auth/session\";\nimport { allowedScopes, scopeWikiPrefix } from \"@/lib/acl/scope\";\nimport { prisma } from \"@/lib/db\";\nimport { wikiAbsPath } from \"@/lib/wiki/paths\";","newString":"import { getSessionUser } from \"@/lib/auth/session\";\nimport { allowedScopes, scopeWikiPrefix } from \"@/lib/acl/scope\";\nimport { prisma } from \"@/lib/db\";\nimport { getRawStore } from \"@/lib/wiki/rawStore\";","originalFile":"import { promises as fs } from \"node:fs\";\nimport { getSessionUser } from \"@/lib/auth/session\";\nimport { allowedScopes, scopeWikiPrefix } from \"@/lib/acl/scope\";\nimport { prisma } from \"@/lib/db\";\nimport { wikiAbsPath } from \"@/lib/wiki/paths\";\n\n// 원본 자료 열람 — 업로드한 PDF·이미지·md 원본 그대로 반환(미리보기/다운로드). ACL 검사.\nexport const runtime = \"nodejs\";\n\nconst CTYPE: Record<string, string> = {\n  pdf: \"application/pdf\",\n  png: \"image/png\",\n  jpg: \"image/jpeg\",\n  jpeg: \"image/jpeg\",\n  gif: \"image/gif\",\n  webp: \"image/webp\",\n  md: \"text/markdown; charset=utf-8\",\n  txt: \"text/plain; charset=utf-8\",\n};\n\nexport async function GET(req: Request, { params }: { params: Promise<{ id: string }> }) {\n  const user = await getSessionUser();\n  if (!user) return new Response(\"로그인이 필요합니다.\", { status: 401 });\n  const id = Number((await params).id);\n  if (!Number.isInteger(id) || id <= 0) return new Response(\"잘못된 id입니다.\", { status: 400 });\n\n  const source = await prisma.source.findUnique({ where: { id } });\n  if (!source) return new Response(\"자료를 찾을 수 없습니다.\", { status: 404 });\n\n  // ACL: 접근 가능한 scope의 자료만\n  const allowed = new Set((await allowedScopes(user)).map((s) => scopeWikiPrefix(s.id)));\n  if (!allowed.has(source.teamScope)) return new Response(\"접근 권한이 없습니다.\", { status: 403 });\n\n  // L4 보존정책: 원본이 정리된 자료(rawEvictedAt)는 410 Gone — 지식·정규화본은 유지(추출본/위키로 안내).\n  if (source.rawEvictedAt) return new Response(\"이 자료의 원본은 보존정책에 따라 정리되었습니다(분석본·위키 지식은 유지). 추출본을 보거나 위키 페이지를 참고하세요.\", { status: 410 });\n\n  let bytes: Buffer;\n  try {\n    bytes = await fs.readFile(wikiAbsPath(source.rawPath));\n  } catch {\n    return new Response(\"원본 파일을 찾을 수 없습니다.\", { status: 404 });\n  }\n\n  const ext = (source.rawPath.split(\".\").pop() || \"\").toLowerCase();\n  const ctype = CTYPE[ext] || \"application/octet-stream\";\n  const filename = encodeURIComponent(`${source.title}.${ext}`);\n  return new Response(new Uint8Array(bytes), {\n    headers: {\n      \"content-type\": ctype,\n      \"content-disposition\": `inline; filename*=UTF-8''${filename}`,\n      \"cache-control\": \"private, max-age=60\",\n    },\n  });\n}\n","structuredPatch":[{"oldStart":1,"oldLines":8,"newStart":1,"newLines":7,"lines":["-import { promises as fs } from \"node:fs\";"," import { getSessionUser } from \"@/lib/auth/session\";"," import { allowedScopes, scopeWikiPrefix } from \"@/lib/acl/scope\";"," import { prisma } from \"@/lib/db\";","-import { wikiAbsPath } from \"@/lib/wiki/paths\";","+import { getRawStore } from \"@/lib/wiki/rawStore\";"," "," // 원본 자료 열람 — 업로드한 PDF·이미지·md 원본 그대로 반환(미리보기/다운로드). ACL 검사."," export const runtime = \"nodejs\";"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"9732e7b1-ae74-4ed3-ab76-8c30871542d0","userType":"external","entrypoint":"cli","cwd":"E:\\llm-wiki","sessionId":"6b03d3cf-704b-46f4-952d-418