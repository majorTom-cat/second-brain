tton({ text, label = \"복사\" }: { text: string; label?: string }) {\n27\t  const [done, setDone] = useState(false);\n28\t  return (\n29\t    <button type=\"button\" className=\"mat-rowbtn\" style={{ alignSelf: \"flex-start\" }}\n30\t      onClick={async () => { if (await copyToClipboard(text)) { setDone(true); setTimeout(() => setDone(false), 1500); } }}>\n31\t      <IconCopy size={12} />{done ? \"복사됨\" : label}\n32\t    </button>\n33\t  );\n34\t}\n35\t\n36\t// 모델 id를 사람이 읽기 좋은 짧은 라벨로(예: claude-cli/sonnet → \"Claude sonnet (구독)\"). 없으면 id 그대로.\n37\tfunction modelLabel(id?: string | null): string {\n38\t  if (!id) return \"\";\n39\t  if (id.startsWith(\"claude-cli/\")) return `Claude ${id.split(\"/\")[1]} (구독)`;\n40\t  if (id === \"codex\") return \"Codex\";\n41\t  if (id.startsWith(\"claude\")) return \"Claude API\";\n42\t  return id; // gemini-2.5-flash 등은 id 그대로 (정보성 충분)\n43\t}\n44\t\n45\t// 사용량만큼 ★종량 과금★되는 공급자(API 결제) — 경고 뱃지·확인 팝업용. 구독(codex/claude-cli)·무료(gemini/groq)·로컬 제외.\n46\tconst isPaidProvider = (p?: string) => p === \"openai\" || p === \"anthropic\";\n47\t\n48\t// 경과 시간 mm:ss 표기 (분석 진행 중·완료·실패 시간 표시용).\n49\tfunction fmtElapsed(ms: number): string {\n50\t  const s = Math.max(0, Math.floor(ms / 1000));\n51\t  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, \"0\")}`;\n52\t}\n53\t\n54\t// 원본 파일 용량 표시(B/KB/MB/GB) — 10단위 미만은 소수 1자리로 가독성.\n55\tfunction fmtBytes(n?: number | null): string {\n56\t  if (n == null || n < 0) return \"\";\n57\t  if (n < 1024) return `${n} B`;\n58\t  const u = [\"KB\", \"MB\", \"GB\", \"TB\"]; let v = n / 1024, i = 0;\n59\t  while (v >= 1024 && i < u.length - 1) { v /= 1024; i++; }\n60\t  return `${v < 10 ? v.toFixed(1) : Math.round(v)} ${u[i]}`;\n61\t}\n62\t\n63\tfunction SourceGroup({ ym, items, onArchive, onWiki, onRecover, onAnalyze, onFileRaw, onCancel, onRestore, onPurge, deleting, acting, canceling, now, notes, durations, canManage, archivedMode, defaultOpen, seenNew, onSeen }: {\n64\t  ym: string; items: SourceItem[]; onArchive: (s: SourceItem) => void; onWiki: (s: SourceItem) => void;\n65\t  onRecover: (s: SourceItem) => void; onAnalyze: (s: SourceItem, reanalyze?: boolean) => void;\n66\t  onFileRaw: (s: SourceItem) => void; onCancel: (s: SourceItem) => void;\n67\t  onRestore?: (s: SourceItem) => void; onPurge?: (s: SourceItem) => void;\n68\t  deleting: number | null; acting: Map<number, { label: string; at: number; ctrl: AbortController }>; canceling?: Set<number>; now: number; notes: Record<number, string>; durations: Map<number, number>; canManage: boolean; archivedMode?: boolean; defaultOpen?: boolean;\n69\t  seenNew: (id: string) => boolean; onSeen: (s: SourceItem) => void; // 'N(최근)' 마크 — 클릭 시 제거\n70\t}) {\n71\t  const [open, setOpen] = useState(defaultOpen ?? false);\n72\t  return (\n73\t    <div>\n74\t      <button className=\"mat-group\" onClick={() => setOpen((o) => !o)}>\n75\t        <IconChevronRight size={13} className={`tree-caret${open ? \" open\" : \"\"}`} />\n76\t        <IconCalendar size={14} />{ym}<span className=\"mat-group-count\">({items.length})</span>\n77\t      </button>\n78\t      {open && items.map((s) => {\n79\t        const FIcon = typeIcon(s.type);\n80\t        // '잔여'(재처리 복구) = ★텍스트 없는 중단 PENDING·FAILED만★. 전사·추출이 끝난(hasText) PENDING은\n81\t        //   분석 대기 상태이므로 [AI로 분석]을 띄운다(음성 전사만 하고 분석 전인데 '재처리'가 뜨던 문제 수정).\n82\t        const stuck = (s.status === \"PENDING\" && !s.hasText) || s.status === \"FAILED\";\n83\t        const isRaw = s.status === \"APPLIED\" && s.gate === \"RAW_IMPORT\"; // '원본 그대로' 보관 — 아직 분석 안 됨\n84\t        // [AI로 분석] 대상: 원본 그대로 보관본 + 미분석 보존본 + ★전사·추출만 되고 분석 전(PENDING+hasText)★.\n85\t        const canAnalyze = !archivedMode && (isRaw || s.status === \"UNANALYZED\" || (s.status === \"PENDING\" && s.hasText));\n86\t        // [다시 분석] 대상: 이미 분석된 자료(원본 보존하며 엔티티·개념 갱신).\n87\t        const canReanalyze = !archivedMode && s.status === \"APPLIED\" && !isRaw;\n88\t        const act = acting.get(s.id);\n89\t        const busy = !!act;\n90\t        const serverProc = !busy && (s.status === \"RUNNING\" || s.status === \"APPLYING\" || s.status === \"QUEUED\"); // 다른 세션·비동기 큐 등 서버측 처리 중\n91\t        const isCanceling = !!canceling && canceling.has(s.id) && (busy || serverProc); // 취소 누른 직후~서버가 취소 확정(상태 전환)하기 전까지\n92\t        // 처리 중 모델 + 경과 시간 — 로컬(이 클라가 누름) 시작시각 우선, 없으면 ★서버 잡 시작시각(startedAt)★.\n93\t        //   → 비동기 큐·새로고침·다른 세션이 시작한 작업도 경과가 1초마다 증가(이전엔 클라 시작분만 카운트).\n94\t        const procLabel = busy ? act.label : (serverProc ? modelLabel(s.model) : \"\");\n95\t        // 서버 경과는 QUEUED·RUNNING(비동기 인제스트)만 — APPLYING(검토승인)은 잡 createdAt이 오래돼 경과가 틀림.\n96\t        const startMs = busy ? act.at : (serverProc && (s.status === \"QUEUED\" || s.status === \"RUNNING\") && s.startedAt ? Date.parse(s.startedAt) : 0);\n97\t        const elapsed = (busy || serverProc) && startMs ? fmtElapsed(now - startMs) : \"\";\n98\t        // 처리 배지 문구: 단계(phase)와 경과를 함께. QUEUED는 phase(대기 중/요약 k/N), 그 외는 '처리 중 {모델} · {phase}'.\n99\t        const procText = isCanceling ? \"취소 중…\" : (() => {\n100\t          const label = s.status === \"QUEUED\" ? (s.phase || \"대기 중\") : `처리 중${procLabel ? ` ${procLabel}` : \"\"}${s.phase ? ` · ${s.phase}` : \"\"}`;\n101\t          return elapsed ? `${label} · ${elapsed}` : label;\n102\t        })();\n103\t        const note = notes[s.id];\n104\t        return (\n105\t          <div key={s.id} className=\"mat-item-row\" style={{ paddingLeft: 16 }} onClick={() => onSeen(s)}>\n106\t            <div className=\"mat-item tree\">\n107\t              <FIcon size={17} className=\"mat-ficon\" />\n108\t              <div className=\"mat-item-main\">\n109\t                <div className=\"mat-item-title\" title={s.title}>{s.title}</div>\n110\t                <div className=\"mat-item-sub\"><span className=\"mat-ext\">{typeLabel(s.type)}</span> · <span title={kstStamp(new Date(s.createdAt))}>{kstTimeStr(new Date(s.createdAt))}</span>\n111\t                  {s.byteSize != null && <> · <span title={s.extractor && (s.extractor.startsWith(\"groq-\") || s.extractor.startsWith(\"gemini-\")) ? \"원본 음성·영상 용량\" : \"원본 파일 용량\"}>{fmtBytes(s.byteSize)}</span></>}\n112\t                  {isRecent(s.createdAt) && !seenNew(`mat:${s.id}`) && <span className=\"new-badge\" title={`최근 ${RECENT_DAYS}일 이내 추가됨 (클릭하면 사라짐)`}>N</span>}\n113\t                  {s.uploader\n114\t                    ? <> · <span className=\"mat-uploader\" title={s.anonymous ? \"익명 요청 자료 — 관리자에게만 실명 표시(감사)\" : \"업로더\"}>\n115\t                        <Avatar className=\"mat-uploader-av\" initials={s.uploader.avatar.initials} color={s.uploader.avatar.color} imageUrl={s.uploader.avatar.imageUrl} />\n116\t                        {s.uploader.name}{s.anonymous ? \" 🔒\" : \"\"}</span></>\n117\t                    : s.anonymous ? <> · <span className=\"mat-uploader anon\" title=\"익명 기여자 (작성자는 감사 기록에 유지됨)\">익명 기여자</span></> : null}\n118\t                  {/* ★처리 중엔 '처리 중 {모델}', 완료 후엔 '분석 {모델}'★ — 어떤 모델이 도는지/분석했는지. */}\n119\t                  {busy || serverProc ? (\n120\t                    <span className=\"mat-model-badge proc\" title={isCanceling ? \"취소 중\" : \"처리 중\"}>{procText}</span>\n121\t                  ) : s.model && ((s.status === \"APPLIED\" && !isRaw) || s.status === \"NEEDS_REVIEW\") ? (\n122\t                    <span className=\"mat-model-badge\" title=\"이 자료를 분석한 모델\">분석 {modelLabel(s.model)}{durations.has(s.id) ? ` · ${fmtElapsed(durations.get(s.id)!)}` : s.durationMs != null ? ` · ${fmtElapsed(s.durationMs)}` : \"\"}</span>\n123\t                  ) : null}\n124\t                  {/* ★음성·영상 전사 출처★ — Gemini 전사는 외부 학습 경고(민감 자료 주의), Groq는 외부 전송(미학습). 분석 모델과 별개. */}\n125\t                  {s.extractor?.startsWith(\"gemini-\") ? (\n126\t                    <span className=\"mat-model-badge warn\" title=\"이 자료는 Gemini로 음성을 텍스트로 변환함 — 오디오가 Google로 전송·학습됩니다. 민감 자료엔 쓰지 마세요.\">Gemini 텍스트 변환 · 외부학습</span>\n127\t                  ) : s.extractor?.startsWith(\"groq-\") ? (\n128\t                    <span className=\"mat-model-badge\" title=\"이 자료는 Groq Whisper로 음성을 텍스트로 변환함(외부 전송, 학습엔 미사용)\">Groq 텍스트 변환</span>\n129\t                  ) : null}\n130\t                  {/* ★스캔 PDF 처리★ — 페이지를 이미지에서 전사(OCR)했고, 모델 한도에 맞춰 해상도를 낮췄음(다운스케일)을 명시. 원본 보존 — 품질 저하 투명성. */}\n131\t                  {s.extractor?.startsWith(\"pdf-scan\") && (\n132\t                    <span className=\"mat-model-badge\" title=\"스캔 PDF라 각 페이지를 이미지에서 전사(OCR)했습니다. 모델 한도에 맞춰 페이지 해상도를 낮춰(다운스케일) 전사했으며, ★원본 파일은 그대로 보존★됩니다(필요하면 더 높은 해상도로 다시 분석 가능).\">스캔 전사 · 다운스케일</span>\n133\t                  )}\n134\t                </div>\n135\t                {note && <div className=\"mat-item-note\">{note}</div>}\n136\t              </div>\n137\t              {!archivedMode && (\n138\t                <span className={`mat-status ${s.status === \"APPLIED\" ? (isRaw ? \"muted\" : \"ok\") : s.status === \"FAILED\" ? \"err\" : s.status === \"UNANALYZED\" ? \"warn\" : s.status === \"PENDING\" || s.status === \"RUNNING\" || s.status === \"APPLYING\" || s.status === \"QUEUED\" ? \"pend\" : \"muted\"}`}>\n139\t                  {isCanceling ? \"취소 중…\" : busy ? \"처리 중…\" : s.status === \"APPLIED\" ? (isRaw ? \"원본 보관\" : \"반영됨\") : s.status === \"FAILED\" ? \"실패\" : s.status === \"SKIPPED_DUP\" ? \"중복\" : s.status === \"UNANALYZED\" ? \"미분석\" : s.status === \"QUEUED\" ? \"대기 중\" : s.status === \"PENDING\" ? \"분석 대기\" : s.status === \"RUNNING\" ? \"분석 중…\" : s.status === \"APPLYING\" ? \"반영 중…\" : s.status === \"NEEDS_REVIEW\" ? \"검토 대기\" : s.status ?? \"-\"}\n140\t                </span>\n141\t              )}\n142\t              {/* 액션은 ★아이콘만★(고정폭) — 상태 배지·아이콘 열 정렬 유지. '재처리'·'AI로 분석'은 아래 별도 줄로 뺀다. */}\n143\t              <div className=\"mat-acts\">\n144\t                {/* L4: 원본 정리됨이면 열기 비활성(지식·추출본은 유지). */}\n145\t                {s.rawEvicted\n146\t                  ? <span className=\"mat-act\" style={{ opacity: 0.4, cursor: \"default\" }} title=\"원본은 보존정책에 따라 정리됨(분석본·위키 지식은 유지)\"><IconExternalLink size={13} /></span>\n147\t                  : <a className=\"mat-act\" href={`/api/materials/${s.id}/raw`} target=\"_blank\" rel=\"noreferrer\" title=\"원본 열기\"><IconExternalLink size={13} /></a>}\n148\t                {archivedMode ? (\n149\t                  <>\n150\t                    <button className=\"mat-act\" disabled={busy} onClick={() => onRestore!(s)} title=\"복원\"><IconArrowBackUp size={14} /></button>\n151\t                    <button className=\"mat-del\" disabled={deleting === s.id || busy} onClick={() => onPurge!(s)} title=\"영구삭제\"><IconTrashX size={14} /></button>\n152\t                  </>\n153\t                ) : (\n154\t                  <>\n155\t                    {/* A-ⓕ: 분석이 콘텐츠 페이지를 0개 만든 경우(resultPages===0) '페이지로' 링크 숨김(가짜 404 방지). null=구버전/RAW→현행 유지. */}\n156\t                    {!stuck && s.resultPages !== 0 && <button className=\"mat-act\" onClick={() => onWiki(s)} title=\"위키 페이지로 이동\"><IconArrowUpRight size={13} /></button>}\n157\t                    {s.hasExtracted && (\n158\t                      <a className=\"mat-act\" href={`/api/materials/${s.id}/extracted`} target=\"_blank\" rel=\"noreferrer\" title=\"추출본(읽은 텍스트)\"><IconArticle size={13} /></a>\n159\t                    )}\n160\t                    {canManage && <button className=\"mat-del\" disabled={deleting === s.id || busy} onClick={() => onArchive(s)} title=\"아카이브(삭제)\"><IconTrash size={13} /></button>}\n161\t                  </>\n162\t                )}\n163\t              </div>\n164\t            </div>\n165\t            {/* 별도 줄: 잔여 재처리 / AI로 분석(눈에 띄는 라벨 버튼) — 행 정렬에 영향 없음 */}\n166\t            {!archivedMode && stuck && !busy && (\n167\t              <button className=\"mat-rowbtn\" onClick={() => onRecover(s)} title=\"이 자료를 (위쪽에서 고른 방식으로) 다시 처리\">재처리</button>\n168\t            )}\n169\t            {!archivedMode && !busy && canAnalyze && (\n170\t              <button className=\"mat-rowbtn analyze\" onClick={() => onAnalyze(s)}\n171\t                title=\"AI로 분석해 엔티티·개념으로 정리합니다\">\n172\t                <IconSparkles size={13} />AI로 분석\n173\t              </button>\n174\t            )}\n175\t            {!archivedMode && !busy && canReanalyze && (\n176\t              <button className=\"mat-rowbtn\" onClick={() => onAnalyze(s, true)}\n177\t                title=\"이미 분석된 자료를 최신 방식으로 다시 분석 (원본 보존, 엔티티·개념 갱신)\">\n178\t                <IconRefresh size={13} />다시 분석\n179\t              </button>\n180\t            )}\n181\t            {/* 처리 중: '분석 중' 버튼(툴팁 유지·비활성)과 취소를 ★나란히★(취소가 '분석 중'을 대체하지 않게). 경과 시간은 위 배지에. */}\n182\t            {!archivedMode && busy && (\n183\t              <div className=\"mat-busy-row\">\n184\t                <button className={`mat-rowbtn ${canReanalyze ? \"\" : \"analyze\"}`} disabled\n185\t                  title={canReanalyze ? \"이미 분석된 자료를 최신 방식으로 다시 분석 (원본 보존, 엔티티·개념 갱신)\" : \"AI로 분석해 엔티티·개념으로 정리합니다\"}>\n186\t                  {canReanalyze ? <IconRefresh size={13} /> : <IconSparkles size={13} />}분석 중…\n187\t                </button>\n188\t                <button className=\"mat-rowbtn cancel\" onClick={() => onCancel(s)} title=\"분석 취소 (서버 작업도 중단)\">\n189\t                  <IconX size={13} />취소\n190\t                </button>\n191\t              </div>\n192\t            )}\n193\t            {/* 실패 사유 — 전문 표시 + 복사. (오래 걸려 실패한 PDF 등의 원인 진단·공유용) */}\n194\t            {!archivedMode && s.status === \"FAILED\" && s.error && (\n195\t              <div className=\"mat-failbox\">\n196\t                <div className=\"mat-failbox-head\">\n197\t                  <span style={{ flex: 1, minWidth: 0, fontSize: 11.5, fontWeight: 600, color: \"var(--color-text-danger)\", overflow: \"hidden\", textOverflow: \"ellipsis\", whiteSpace: \"nowrap\" }}>「{s.title}」 실패{s.model ? ` · 모델 ${modelLabel(s.model)}` : \"\"}</span>\n198\t                  <CopyButton text={s.error} label=\"사유 복사\" />\n199\t                </div>\n200\t                <pre style={{ margin: 0, maxHeight: 160, overflow: \"auto\", whiteSpace: \"pre-wrap\", wordBreak: \"break-word\", fontSize: 11.5, lineHeight: 1.5, fontFamily: \"var(--font-mono, monospace)\", color: \"var(--color-text-secondary)\", userSelect: \"text\" }}>{s.error}</pre>\n201\t                {/* 출력 길이 초과(자료가 너무 큼)면 → 토큰 0인 '원본 그대로 추가'를 권장 + 바로 실행 */}\n202\t                {isTooLargeErr(s.error) && s.hasText && (\n203\t                  <div style={{ marginTop: 8, fontSize: 11.5, color: \"var(--color-text-secondary)\", lineHeight: 1.5 }}>\n204\t                    💡 자료가 커서 AI 정리 결과가 한 번에 안 담깁니다. 원문을 그대로 보존하는 <b>원본 그대로 추가</b>(토큰 0)를 권장합니다. 더 잘게 나눠 올려 분석할 수도 있어요.\n205\t                    <div style={{ marginTop: 6 }}>\n206\t                      <button className=\"mat-rowbtn analyze\" disabled={busy} onClick={() => onFileRaw(s)}>\n207\t                        <IconFileText size={13} />원본 그대로 추가\n208\t                      </button>\n209\t                    </div>\n210\t                  </div>\n211\t                )}\n212\t              </div>\n213\t            )}\n214\t          </div>\n215\t        );\n216\t      })}\n217\t    </div>\n218\t  );\n219\t}\n220\t\n221\tinterface SourceItem { id: number; title: string; type: string; createdAt: string; status: string | null; confidence: number | null; gate: string | null; phase?: string | null; progress?: number | null; resultPages?: number | null; startedAt?: string | null; durationMs?: number | null; byteSize?: number | null; extractStatus?: string | null; extractor?: string | null; hasExtracted?: boolean; hasText?: boolean; looksOrganized?: boolean; archived?: boolean; rawEvicted?: boolean; error?: string | null; model?: string | null; recoModel?: string | null; anonymous?: boolean; uploader?: { name: string; avatar: { initials: string; color: string; imageUrl: string | null } } | null }\n222\tinterface UploadPolicy { provider: string; tier?: string; textOnly: boolean; vision?: boolean; exts: string[]; accept: string; note: string }\n223\tinterface AnalyzeModel { model: string; provider: string; label: string; reason: string }\n224\t// 스테이징(보관됨)된 한 파일/입력 — 사용자가 [처리 시작]을 누르기 전까지 대기.\n225\tinterface Reco { model: string; provider: string; label: string; reason: string }\n226\tinterface Staged { key: number; sourceId: number | null; name: string; hasText: boolean; status: \"staging\" | \"staged\" | \"running\" | \"done\" | \"error\" | \"skip\"; note?: string; reco?: Reco; at?: number; ctrl?: AbortController }\n227\t\n228\tconst extOf = (n: string) => n.toLowerCase().match(/\\.([a-z0-9]+)$/)?.[1] ?? \"\";\n229\t\n230\t// 새로고침 복원 시 ★아직 서버로 안 보낸 대기 항목만★ 남긴다(sourceId 있고 status===\"staged\").\n231\t//   'running'은 서버가 이미 처리 중이거나 처리한 것(결과는 '최근 자료'에 RUNNING/반영됨으로 보임)이라\n232\t//   ★대기에 되살리지 않는다★(같은 파일이 분석 중인데 대기에도 뜨는 중복 방지). 업로드 중('staging')·\n233\t//   완료/실패(done/skip/error)도 버린다(결과·재처리는 '최근 자료'에서).\n234\tfunction normalizeStaged(arr: Staged[]): Staged[] {\n235\t  return (Array.isArray(arr) ? arr : [])\n236\t    .filter((s) => s && s.sourceId && s.status === \"staged\")\n237\t    .map((s) => ({ ...s, note: undefined, at: undefined, ctrl: undefined }));\n238\t}\n239\t\n240\t// 업로드 원본을 ★일자(YYYY-MM-DD)★로 묶어 최신순 트리로. 항목은 하위로 들여쓰고 시각(초)만 표시.\n241\tfunction groupByDay(sources: SourceItem[]): [string, SourceItem[]][] {\n242\t  const m = new Map<string, SourceItem[]>();\n243\t  for (const s of sources) {\n244\t    const k = kstDateStr(new Date(s.createdAt)); // ★한국 시간(KST) 일자★로 묶음\n245\t    const arr = m.get(k);\n246\t    if (arr) arr.push(s); else m.set(k, [s]);\n247\t  }\n248\t  return [...m.entries()].sort((a, b) => b[0].localeCompare(a[0]));\n249\t}\n250\t\n251\t// ★월(상위) → 일(하위)★ 2단계. 둘 다 최신순. 월 큰 묶음 아래에 일자별로 나눠 보기 쉽게.\n252\tfunction groupByMonthThenDay(sources: SourceItem[]): [string, [string, SourceItem[]][]][] {\n253\t  const m = new Map<string, [string, SourceItem[]][]>();\n254\t  for (const [day, items] of groupByDay(sources)) {       // 이미 일자 최신순\n255\t    const month = day.slice(0, 7);\n256\t    const arr = m.get(month);\n257\t    if (arr) arr.push([day, items]); else m.set(month, [[day, items]]);\n258\t  }\n259\t  return [...m.entries()].sort((a, b) => b[0].localeCompare(a[0]));\n260\t}\n261\t\n262\t// 상위 '월' 묶음 — 펼치면 그 아래 일자 그룹(SourceGroup)들을 한 칸 들여써 보여준다.\n263\tfunction MonthGroup({ month, count, children, defaultOpen }: { month: string; count: number; children: ReactNode; defaultOpen?: boolean }) {\n264\t  const [open, setOpen] = useState(defaultOpen ?? false);\n265\t  return (\n266\t    <div className=\"mat-month\">\n267\t      <button className=\"mat-group\" onClick={() => setOpen((o) => !o)}>\n268\t        <IconChevronRight size={13} className={`tree-caret${open ? \" open\" : \"\"}`} />\n269\t        <IconCalendar size={14} />{month}<span className=\"mat-group-count\">({count})</span>\n270\t      </button>\n271\t      {open && <div style={{ paddingLeft: 14 }}>{children}</div>}\n272\t    </div>\n273\t  );\n274\t}\n275\t\n276\texport default function MaterialsTab({ scope, hidden, onOpenWiki, modelsRev, dataRev, onDataChanged }: {\n277\t  scope: string; hidden?: boolean; onOpenWiki: (path: string) => void; modelsRev?: number; dataRev?: number; onDataChanged?: () => void;\n278\t}) {\n279\t  const [title, setTitle] = useState(\"\");\n280\t  const [text, setText] = useState(\"\");\n281\t  // ★룸(scope)별 처리중 상태★ — '분석 중…'·입력 잠금이 그 처리를 시작한 룸에서만 보이게(다른 룸으로 새지 않음, ChatTab streamingScopes와 동일 패턴).\n282\t  const [busyScopes, setBusyScopes] = useState<Set<string>>(new Set());\n283\t  const busy = busyScopes.has(scope); // [처리 시작] 진행 중(현재 룸 기준)\n284\t  const setBusyFor = (sc: string, on: boolean) => setBusyScopes((s) => { const n = new Set(s); if (on) n.add(sc); else n.delete(sc); return n; });\n285\t  const [err, setErr] = useState<string | null>(null);\n286\t  const [uploadMode, setUploadMode] = useState<\"llm\" | \"raw\">(\"llm\"); // 처리 방식(확정 시 적용)\n287\t  const [staged, setStaged] = useState<Staged[]>([]); // 대기(스테이징)된 항목\n288\t  const [sources, setSources] = useState<SourceItem[]>([]);\n289\t  const [anonUpload, setAnonUpload] = useState(false); // 익명으로 업로드(표시만 숨김, uploadedBy는 감사용 유지)\n290\t  const [diarize, setDiarize] = useState(false); // 음성·영상 화자 구분(Gemini 전용·외부학습) — STT에만 적용\n291\t  // (회의록 처리 토글은 제거 — 전사 소스는 서버가 ★무조건 회의록으로★ 처리)\n292\t  const [diarizeSwitched, setDiarizeSwitched] = useState(false); // 화자 구분이 분석 모델을 Gemini로 자동 전환했나(말풍선 표시)\n293\t  const preDiarizeRef = useRef<{ model: string; picked: boolean } | null>(null); // 화자 구분 끄면 되돌릴 직전 모델\n294\t  const [deleting, setDeleting] = useState<number | null>(null);\n295\t  const [delNote, setDelNote] = useState<string | null>(null);\n296\t  const [canManage, setCanManage] = useState(false); // 아카이브·영구삭제 권한(룸 관리자)\n297\t  const [archivedSources, setArchivedSources] = useState<SourceItem[]>([]);\n298\t  const [showArchived, setShowArchived] = useState(false);\n299\t  const [convertExts, setConvertExts] = useState<string[]>([]);\n300\t  const [policy, setPolicy] = useState<UploadPolicy | null>(null);\n301\t  const [analyzeModel, setAnalyzeModel] = useState<AnalyzeModel | null>(null); // 서버 추천(기본값·사유 툴팁용)\n302\t  const [analyzeModels, setAnalyzeModels] = useState<ModelOpt[]>([]);          // 고를 수 있는 분석 모델 목록\n303\t  const [analyzeModelId, setAnalyzeModelId] = useState<string>(\"\");            // 적용할 분석 모델(자동추천 또는 사용자 선택)\n304\t  const [modelUserPicked, setModelUserPicked] = useState(false);              // 사용자가 셀렉트박스로 직접 바꿨나(=자동추천 끔)\n305\t  const [pickFor, setPickFor] = useState<{ s: SourceItem; reanalyze: boolean; recover?: boolean } | null>(null); // AI로 분석/다시 분석/재처리 모델 선택 팝업 대상\n306\t  const [pickDiarize, setPickDiarize] = useState(false); // 재분석 팝업: 음성 소스의 화자 구분 선택(Gemini)\n307\t  const { has: seenNew, dismiss: dismissNew } = useDismissedNew(); // 'N(최근)' 마크 — 자료 항목 클릭 시 제거\n308\t  const [pickId, setPickId] = useState<string>(\"\");                            // 팝업에서 고른 모델\n309\t  const [dragOver, setDragOver] = useState(false);\n310\t  const [acting, setActing] = useState<Map<number, { label: string; at: number; ctrl: AbortController }>>(new Map()); // 처리 중 소스 id → {모델 라벨, 시작 시각, 취소 컨트롤러}\n311\t  const [canceling, setCanceling] = useState<Set<number>>(new Set()); // 취소 누른 소스 id — 즉시 '취소 중…' 표시(서버가 상태 전환하면 폴링이 해제)\n312\t  const [durations, setDurations] = useState<Map<number, number>>(new Map()); // 분석 끝난 소스 id → ★최종 소요(ms)★ — 완료 후에도 배지에 남겨 표시\n313\t  const markDuration = (id: number, ms: number) => setDurations((d) => new Map(d).set(id, ms));\n314\t  const [notes, setNotes] = useState<Record<number, string>>({}); // 처리 결과 메모(자동전환·반영 등)\n315\t  const fileRef = useRef<HTMLInputElement>(null);\n316\t  // 분석 경과 시간 — 처리 중(acting)일 때 1초마다 now를 갱신해 배지의 경과 시간이 흐르게 한다.\n317\t  const [now, setNow] = useState(0);\n318\t  const stagingRunning = staged.some((s) => s.status === \"running\"); // 대기열 처리 중에도 경과 시간 tick\n319\t  // 서버측 처리 중(비동기 큐·다른 세션·새로고침 후) — 경과 타이머(A)가 이때도 흘러야 한다.\n320\t  const anyServerProc = sources.some((s) => s.status === \"RUNNING\" || s.status === \"APPLYING\" || s.status === \"QUEUED\");\n321\t  useEffect(() => {\n322\t    // ★서버 작업도 포함★ — 빠지면 now가 갱신 안 돼(초기 0) 서버 경과가 0:00에 박제된다.\n323\t    if (acting.size === 0 && !stagingRunning && !anyServerProc) return;\n324\t    setNow(Date.now());\n325\t    const t = setInterval(() => setNow(Date.now()), 1000);\n326\t    return () => clearInterval(t);\n327\t  }, [acting.size, stagingRunning, anyServerProc]);\n328\t  // 대기 큐 영속화(sessionStorage) — ★scope별 저장소★. AppShell이 새로고침 후 scope를 비동기로 복원해도\n329\t  // 해당 scope의 큐를 정확히 되살리려면 모든 scope의 큐를 ref 맵에 들고 있어야 한다(chat·위키탭과 동일 패턴).\n330\t  const stagedStore = useRef<Record<string, Staged[]>>({});\n331\t  const stagedRef = useRef(staged); stagedRef.current = staged;\n332\t  const matPrevScope = useRef(scope);\n333\t  const matFirstSave = useRef(true); // 첫(빈) 저장은 건너뛰어 복원본을 덮어쓰지 않음\n334\t  const matRestored = useRef(false); // mount 복원 완료 전엔 빈 staged를 store에 저장하지 않음\n335\t\n336\t  const load = useCallback(async () => {\n337\t    try {\n338\t      const res = await fetch(`/api/materials?scope=${encodeURIComponent(scope)}`, { cache: \"no-store\" });\n339\t      const d = await res.json();\n340\t      if (res.ok) {\n341\t        setSources(d.sources); setConvertExts(d.convertExts || []); setPolicy(d.policy || null);\n342\t        setCanManage(Boolean(d.canManage)); setAnalyzeModel(d.analyzeModel || null);\n343\t      }\n344\t    } catch { /* noop */ }\n345\t  }, [scope]);\n346\t\n347\t  // ★서버측 처리 중(RUNNING/APPLYING) 항목이 있으면 자동 폴링★ — 취소·완료가 수동 새로고침 없이 반영되게.\n348\t  //   (취소=abort는 즉시 보내지만 서버가 상태를 '취소됨'으로 바꾸는 덴 시간차가 있어, 폴링으로 따라잡는다.)\n349\t  //   anyServerProc는 위(경과 타이머)에서 정의 — 같은 값 재사용.\n350\t  useEffect(() => {\n351\t    if (!anyServerProc) return;\n352\t    const t = setInterval(() => { void load(); }, 2000);\n353\t    return () => clearInterval(t);\n354\t  }, [anyServerProc, load]);\n355\t  // ★서버측 처리(비동기 큐 등)가 끝나는 순간 위키 탭 등에 갱신 신호★ — 분석이 백그라운드에서 끝나면\n356\t  //   (anyServerProc true→false 전이) 새 엔티티/개념 페이지가 위키 탭에 ★새로고침 없이★ 바로 보이게 한다.\n357\t  //   (동기 경로는 analyzeItem/runStaged가 직접 onDataChanged를 부르고, 이건 폴링으로만 끝을 아는 비동기 완료를 커버.)\n358\t  const prevServerProc = useRef(false);\n359\t  useEffect(() => {\n360\t    if (prevServerProc.current && !anyServerProc) onDataChanged?.();\n361\t    prevServerProc.current = anyServerProc;\n362\t  }, [anyServerProc, onDataChanged]);\n363\t  // 서버 상태가 더 이상 처리중이 아니면 '취소 중' 표시 해제(취소 확정 → 실패/완료 박스로 전환).\n364\t  useEffect(() => {\n365\t    setCanceling((c) => {\n366\t      if (c.size === 0) return c;\n367\t      const next = new Set([...c].filter((id) => { const s = sources.find((x) => x.id === id); return !!s && (s.status === \"RUNNING\" || s.status === \"APPLYING\"); }));\n368\t      return next.size === c.size ? c : next;\n369\t    });\n370\t  }, [sources]);\n371\t\n372\t  // 고를 수 있는 분석 모델 목록(질의와 동일 라인업). 관리자가 모델을 토글하면(modelsRev) 다시 읽는다.\n373\t  useEffect(() => {\n374\t    fetch(\"/api/models\", { cache: \"no-store\" }).then((r) => r.json()).then((d) => {\n375\t      setAnalyzeModels(d.models || []);\n376\t    }).catch(() => { /* noop */ });\n377\t  }, [modelsRev]);\n378\t  // ★자료를 판단해 분석 모델 자동 추천★ — 무겁/복잡한 게 있으면 구독 고품질(claude-cli·codex), 아니면 기본(Gemini).\n379\t  //   서버가 업로드 응답에 reco(추천 모델+사유)를 실어 주고, 그중 구독 고품질 추천이 하나라도 있으면 그걸 택한다.\n380\t  const enabledHas = (id: string) => analyzeModels.some((m) => m.id === id && m.enabled);\n381\t  const stagedRecos = staged.map((s) => s.reco).filter((r): r is Reco => !!r);\n382\t  const effReco: Reco | null =\n383\t    stagedRecos.find((r) => r.provider === \"claude-cli\" && enabledHas(r.model)) // 무거운 자료 → Claude 구독 우선\n384\t    ?? stagedRecos.find((r) => r.provider === \"codex\" && enabledHas(\"codex\"))   // 또는 codex\n385\t    ?? stagedRecos.find((r) => enabledHas(r.model))                             // 그 외 자료 추천\n386\t    ?? (analyzeModel && enabledHas(analyzeModel.model) ? analyzeModel : null); // 스테이징 전 = 서버 기본 추천\n387\t  const recommendedId = effReco && enabledHas(effReco.model) ? effReco.model : (analyzeModels.find((m) => m.enabled)?.id || \"\");\n388\t  // 추천을 셀렉트박스에 자동 반영(자료 올리면 그에 맞게 바뀜).\n389\t  //  ★관리자가 모델을 끄면★ 현재 선택이 비활성이 될 수 있으므로 — 사용자가 직접 골랐어도(modelUserPicked)\n390\t  //   그 선택이 더는 활성이 아니면 ★활성 추천으로 교정★한다(비활성 모델이 선택된 채 남지 않게).\n391\t  useEffect(() => {\n392\t    const curEnabled = !!analyzeModelId && enabledHas(analyzeModelId);\n393\t    if (modelUserPicked && curEnabled) return; // 사용자가 고른 ★활성★ 모델은 유지\n394\t    if (recommendedId && recommendedId !== analyzeModelId) setAnalyzeModelId(recommendedId);\n395\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n396\t  }, [recommendedId, modelUserPicked, analyzeModelId, analyzeModels]);\n397\t\n398\t  // 아카이브된 자료 목록(복원/영구삭제 뷰) — 별도 조회(?archived=1).\n399\t  const loadArchived = useCallback(async () => {\n400\t    try {\n401\t      const res = await fetch(`/api/materials?scope=${encodeURIComponent(scope)}&archived=1`, { cache: \"no-store\" });\n402\t      const d = await res.json();\n403\t      if (res.ok) setArchivedSources(d.sources || []);\n404\t    } catch { /* noop */ }\n405\t  }, [scope]);\n406\t\n407\t  // scope 전환: 이전 룸 큐를 store에 저장 + 새 룸 큐를 store에서 복원(없으면 빈 큐). 목록·메모는 초기화.\n408\t  useEffect(() => {\n409\t    const prev = matPrevScope.current;\n410\t    if (prev !== scope) {\n411\t      if (matRestored.current) stagedStore.current[prev] = stagedRef.current; // 복원 완료 후에만 이전 큐 저장\n412\t      matPrevScope.current = scope;\n413\t    }\n414\t    setSources([]); setErr(null); setDelNote(null); setArchivedSources([]); setShowArchived(false); setModelUserPicked(false);\n415\t    // ★룸 전환 시 업로드 토글 초기화★ — 회의록·화자구분·자동전환·익명이 다른 룸으로 새지 않게(버그 수정).\n416\t    setDiarize(false); setDiarizeSwitched(false); preDiarizeRef.current = null; setAnonUpload(false);\n417\t    setStaged(normalizeStaged(stagedStore.current[scope] || []));\n418\t    load();\n419\t  }, [scope, load]);\n420\t\n421\t  // ★마운트 복원★ — 저장된 모드 + scope별 큐 맵을 ref로 적재하고 현재 scope 큐 복원.\n422\t  //   (scope 효과 뒤 선언 → 마운트 시 scope 효과의 빈 큐를 덮어쓴다. store는 ref라 동기 적재되어\n423\t  //    이후 AppShell이 scope를 바꿔도 scope 효과가 그 scope의 큐를 정확히 복원한다.)\n424\t  useEffect(() => {\n425\t    try {\n426\t      const raw = sessionStorage.getItem(\"llmwiki_materials_v1\");\n427\t      if (raw) {\n428\t        const d = JSON.parse(raw);\n429\t        if (d.mode === \"llm\" || d.mode === \"raw\") setUploadMode(d.mode);\n430\t        if (d.staged && typeof d.staged === \"object\") stagedStore.current = d.staged;\n431\t      }\n432\t    } catch { /* noop */ }\n433\t    matRestored.current = true;\n434\t    setStaged(normalizeStaged(stagedStore.current[scope] || []));\n435\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n436\t  }, []);\n437\t  // 영속화 — 현재 scope 큐를 store에 반영 후 SS 저장(첫 빈 저장은 건너뜀). scope는 클로저 최신값.\n438\t  useEffect(() => {\n439\t    if (matFirstSave.current) { matFirstSave.current = false; return; }\n440\t    stagedStore.current[scope] = staged;\n441\t    try { sessionStorage.setItem(\"llmwiki_materials_v1\", JSON.stringify({ mode: uploadMode, staged: stagedStore.current })); } catch { /* noop */ }\n442\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n443\t  }, [staged, uploadMode]);\n444\t\n445\t  // ★대기↔최근자료 정합성★ — 대기 항목은 그 소스가 ★아직 살아있고 미처리(PENDING)★일 때만 유지한다.\n446\t  //   소스가 처리됐거나(RUNNING·반영됨·검토대기 등) ★삭제·교체돼 사라졌으면★(분석 시 dedup이 원본을 지우고\n447\t  //   새로 만들어 sourceId가 바뀜) 대기에서 제거 → '분석된 파일이 대기에 그대로 남는' 중복을 막는다.\n448\t  //   (소스 생성 직후 staging 중인 항목은 sourceId 없음 → 유지.)\n449\t  useEffect(() => {\n450\t    if (!sources.length) return;\n451\t    setStaged((prev) => {\n452\t      const next = prev.filter((s) => {\n453\t        if (!s.sourceId) return true; // 업로드(staging) 진행 중 — 유지\n454\t        const src = sources.find((x) => x.id === s.sourceId);\n455\t        return !!src && src.status === \"PENDING\"; // 살아있고 아직 미처리일 때만 대기 유지\n456\t      });\n457\t      return next.length === prev.length ? prev : next;\n458\t    });\n459\t  }, [sources]);\n460\t\n461\t  // 교차 갱신: 위키 배너에서 [AI로 분석]하거나 다른 경로로 데이터가 바뀌면 목록 재조회(초기 마운트는 건너뜀).\n462\t  const firstRev = useRef(true);\n463\t  useEffect(() => {\n464\t    if (firstRev.current) { firstRev.current = false; return; }\n465\t    load(); if (showArchived) loadArchived();\n466\t  }, [dataRev]); // eslint-disable-line react-hooks/exhaustive-deps\n467\t\n468\t  // ★자료 탭으로 (다시) 들어올 때 자동 새로고침★ — 다른 세션·경로로 바뀐 최근 자료/상태가 탭만 바꾸면 바로 보이게\n469\t  //   한다(WikiTab과 동일 패턴, 수동 새로고침 불필요). hidden true→false 전이에만 발동.\n470\t  const matPrevHidden = useRef(hidden);\n471\t  useEffect(() => {\n472\t    if (matPrevHidden.current && !hidden) { load(); if (showArchived) loadArchived(); }\n473\t    matPrevHidden.current = hidden;\n474\t  }, [hidden, load]); // eslint-disable-line react-hooks/exhaustive-deps\n475\t\n476\t  async function openWiki(s: SourceItem) {\n477\t    try {\n478\t      const res = await fetch(`/api/materials/${s.id}/pages`);\n479\t      const d = await res.json();\n480\t      // ★자료 자체의 주제(topic) 페이지로 이동★ — 분석이 만든 개념/개체 중 첫 항목이 아니라, 그 자료를 정리한\n481\t      //   topics/ 페이지를 우선한다(없으면 첫 페이지로 폴백).\n482\t      const paths: string[] = d.paths ?? [];\n483\t      const target = paths.find((p) => /\\/topics\\//.test(p)) ?? paths[0];\n484\t      if (res.ok && target) onOpenWiki(target);\n485\t      else setDelNote(`「${s.title}」에서 생성된 위키 페이지를 찾지 못했습니다.`);\n486\t    } catch {\n487\t      setDelNote(\"위키 페이지를 찾지 못했습니다.\");\n488\t    }\n489\t  }\n490\t\n491\t  // 자료 아카이브(소프트 삭제) — 목록에서 숨기고 아카이브로. 원본·위키 페이지는 보존. 룸 관리자만.\n492\t  async function archiveSource(s: SourceItem) {\n493\t    if (!await confirmDialog(`원본 「${s.title}」을(를) 아카이브할까요?\\n목록에서 숨겨지며, 아카이브에서 복원하거나 영구삭제할 수 있습니다. (위키 페이지는 그대로 유지됩니다)`)) return;\n494\t    setDeleting(s.id); setDelNote(null);\n495\t    try {\n496\t      const res = await fetch(`/api/materials/${s.id}`, { method: \"PATCH\", headers: { \"content-type\": \"application/json\" }, body: JSON.stringify({ action: \"archive\" }) });\n497\t      const d = await res.json();\n498\t      if (!res.ok) throw new Error(d.error || \"아카이브에 실패했습니다.\");\n499\t      setDelNote(`「${s.title}」 아카이브됨`);\n500\t      await Promise.all([load(), loadArchived()]);\n501\t    } catch (e) {\n502\t      setDelNote(`오류: ${toUserMessage(e)}`);\n503\t    } finally {\n504\t      setDeleting(null);\n505\t    }\n506\t  }\n507\t\n508\t  // 아카이브에서 복원 — 다시 활성 목록으로.\n509\t  async function restoreSource(s: SourceItem) {\n510\t    setDeleting(s.id); setDelNote(null);\n511\t    try {\n512\t      const res = await fetch(`/api/materials/${s.id}`, { method: \"PATCH\", headers: { \"content-type\": \"application/json\" }, body: JSON.stringify({ action: \"restore\" }) });\n513\t      const d = await res.json();\n514\t      if (!res.ok) throw new Error(d.error || \"복원에 실패했습니다.\");\n515\t      setDelNote(`「${s.title}」 복원됨`);\n516\t      await Promise.all([load(), loadArchived()]);\n517\t    } catch (e) {\n518\t      setDelNote(`오류: ${toUserMessage(e)}`);\n519\t    } finally {\n520\t      setDeleting(null);\n521\t    }\n522\t  }\n523\t\n524\t  // 영구삭제 — 원본·사이드카 제거 + 인용 위키 페이지에 '출처 소실' 표시. 되돌릴 수 없음.\n525\t  async function purgeSource(s: SourceItem) {\n526\t    if (!await confirmDialog(`원본 「${s.title}」을(를) 영구삭제할까요? 되돌릴 수 없습니다.\\n매핑된 위키 페이지는 보존되며 '출처 소실' 표시가 남습니다.`)) return;\n527\t    setDeleting(s.id); setDelNote(null);\n528\t    try {\n529\t      const res = await fetch(`/api/materials/${s.id}`, { method: \"DELETE\" });\n530\t      const d = await res.json();\n531\t      if (!res.ok) throw new Error(d.error || \"삭제에 실패했습니다.\");\n532\t      setDelNote(`「${s.title}」 영구삭제됨 · 위키 ${d.annotated}곳에 출처 소실 표시`);\n533\t      await Promise.all([load(), loadArchived()]);\n534\t      onDataChanged?.(); // 위키 페이지에 흔적 → 트리/리더 갱신\n535\t    } catch (e) {\n536\t      setDelNote(`오류: ${toUserMessage(e)}`);\n537\t    } finally {\n538\t      setDeleting(null);\n539\t    }\n540\t  }\n541\t\n542\t  // 파일 선택/드롭 → ★스테이징만★(자동 처리 안 함). 사용자가 모드 고르고 [처리 시작]을 눌러야 인제스트.\n543\t  function onPickFile(e: React.ChangeEvent<HTMLInputElement>) {\n544\t    const files = e.target.files ? [...e.target.files] : [];\n545\t    e.target.value = \"\";\n546\t    if (files.length) void stageFiles(files);\n547\t  }\n548\t  function onDrop(e: React.DragEvent) {\n549\t    e.preventDefault();\n550\t    setDragOver(false);\n551\t    const files = e.dataTransfer?.files ? [...e.dataTransfer.files] : [];\n552\t    if (files.length) void stageFiles(files);\n553\t  }\n554\t\n555\t  // 스테이징 결과 해석: 중복/미분석은 더 처리할 수 없으니 'skip'(완료), 그 외는 'staged'(처리 대기).\n556\t  function toStaged(prev: Staged, data: { status?: string; sourceId?: number; hasText?: boolean; unanalyzed?: boolean; recommended?: Reco }): Staged {\n557\t    if (data.status === \"SKIPPED_DUP\") return { ...prev, status: \"skip\", note: \"중복(건너뜀)\", reco: data.recommended };\n558\t    if (data.unanalyzed || !data.sourceId) return { ...prev, status: \"skip\", note: \"원본 보존(미분석)\", reco: data.recommended };\n559\t    return { ...prev, status: \"staged\", sourceId: data.sourceId, hasText: !!data.hasText, reco: data.recommended };\n560\t  }\n561\t\n562\t  // 파일을 스테이징(추출·보관만, 토큰 0). 허용 안 되는 확장자는 에러로 표시.\n563\t  async function stageFiles(files: File[]) {\n564\t    const allowExt = (n: string) => !policy || policy.exts.includes(extOf(n));\n565\t    const ok = files.filter((f) => allowExt(f.name));\n566\t    const blocked = files.filter((f) => !allowExt(f.name));\n567\t    setErr(null);\n568\t    const base = Date.now();\n569\t    setStaged((prev) => [\n570\t      ...prev,\n571\t      ...blocked.map((f, i) => ({ key: base + 9000 + i, sourceId: null, name: f.name, hasText: false, status: \"error\" as const, note: policy?.note || \"지원하지 않는 형식\" })),\n572\t      ...ok.map((f, i) => ({ key: base + i, sourceId: null, name: f.name, hasText: false, status: \"staging\" as const })),\n573\t    ]);\n574\t    const single = ok.length === 1 ? (title.trim() || undefined) : undefined;\n575\t    for (let i = 0; i < ok.length; i++) {\n576\t      const key = base + i;\n577\t      const f = ok[i];\n578\t      try {\n579\t        // ★diarize는 업로드가 아니라 [처리 시작](분석) 때 적용★ — 업로드 전사는 항상 Groq 평문(빠른 미리보기).\n580\t        // 모델 미전송 → 서버가 자동 모델 기준 게이팅.\n581\t        let res: Response;\n582\t        if (f.size > 25 * 1024 * 1024) {\n583\t          // ★대용량(>25MB): raw-body 스트리밍★ — 서버가 RAM 통적재 없이 디스크로 흘려 받는다(§11.2).\n584\t          //   File(디스크 기반 Blob)을 body로 보내면 클라도 메모리 사본을 안 만든다. 메타는 쿼리스트링.\n585\t          const qs = new URLSearchParams({ scope, filename: f.name, mime: f.type || \"\" });\n586\t          if (single) qs.set(\"title\", single);\n587\t          if (anonUpload) qs.set(\"anonymous\", \"true\");\n588\t          res = await fetch(`/api/materials?${qs.toString()}`, {\n589\t            method: \"POST\", headers: { \"content-type\": \"application/octet-stream\" }, body: f,\n590\t          });\n591\t        } else {\n592\t          const fd = new FormData();\n593\t          fd.append(\"scope\", scope);\n594\t          if (single) fd.append(\"title\", single);\n595\t          if (anonUpload) fd.append(\"anonymous\", \"true\");\n596\t          fd.append(\"file\", f);\n597\t          res = await fetch(\"/api/materials\", { method: \"POST\", body: fd });\n598\t        }\n599\t        const data = await res.json();\n600\t        if (!res.ok) { setStaged((p) => p.map((x) => (x.key === key ? { ...x, status: \"error\", note: data.error || \"업로드 실패\" } : x))); continue; }\n601\t        setStaged((p) => p.map((x) => (x.key === key ? toStaged(x, data) : x)));\n602\t      } catch (e) {\n603\t        setStaged((p) => p.map((x) => (x.key === key ? { ...x, status: \"error\", note: toUserMessage(e) } : x)));\n604\t      }\n605\t    }\n606\t    if (single) setTitle(\"\");\n607\t  }\n608\t\n609\t  // 직접 입력 텍스트를 스테이징(대기열에 추가).\n610\t  async function stageText() {\n611\t    if (busy || !text.trim()) return;\n612\t    setErr(null);\n613\t    const key = Date.now();\n614\t    const name = title.trim() || text.trim().split(\"\\n\")[0].slice(0, 40) || \"직접 입력\";\n615\t    setStaged((prev) => [...prev, { key, sourceId: null, name, hasText: true, status: \"staging\" }]);\n616\t    try {\n617\t      const res = await fetch(\"/api/materials\", {\n618\t        method: \"POST\", headers: { \"content-type\": \"application/json\" },\n619\t        body: JSON.stringify({ scope, title: title.trim() || undefined, text, anonymous: anonUpload }),\n620\t      });\n621\t      const data = await res.json();\n622\t      if (!res.ok) { setStaged((p) => p.map((x) => (x.key === key ? { ...x, status: \"error\", note: data.error || \"추가 실패\" } : x))); return; }\n623\t      setStaged((p) => p.map((x) => (x.key === key ? toStaged(x, data) : x)));\n624\t      setText(\"\"); setTitle(\"\");\n625\t    } catch (e) {\n626\t      setStaged((p) => p.map((x) => (x.key === key ? { ...x, status: \"error\", note: toUserMessage(e) } : x)));\n627\t    }\n628\t  }\n629\t\n630\t  // 스테이징된 소스를 ★선택한 모드★로 처리. raw는 텍스트가 있을 때만, 없으면(PDF·이미지) 자동으로 llm.\n631\t  async function runProcess(sourceId: number, hasText: boolean, signal?: AbortSignal, modelOverride?: string, reTranscribe?: boolean): Promise<{ ok: boolean; note: string; queued?: boolean }> {\n632\t    const startedAt = Date.now();\n633\t    const fellBack = uploadMode === \"raw\" && !hasText;\n634\t    const effMode = uploadMode === \"raw\" && hasText ? \"raw\" : \"llm\";\n635\t    // 사용자가 ★직접 고른 경우만★ 모델 전송 — 아니면 undefined로 보내 서버가 ★자료 형식 기반 자동 선택★.\n636\t    // diarize(화자 구분)는 ★처리 시작(분석) 시점★에 적용 — 음성·영상이면 분석 라우트가 raw를 Gemini로 재전사(화자1/2).\n637\t    const body = effMode === \"raw\" ? { mode: \"raw\" } : { mode: \"llm\", model: modelOverride ?? (modelUserPicked ? (analyzeModelId || undefined) : undefined), diarize: diarize || undefined, reTranscribe: reTranscribe || undefined };\n638\t    const res = await fetch(`/api/materials/${sourceId}/analyze`, {\n639\t      method: \"POST\", headers: { \"content-type\": \"application/json\" }, body: JSON.stringify(body), signal,\n640\t    });\n641\t    const data = await res.json();\n642\t    const took = effMode === \"raw\" ? \"\" : ` · ${fmtElapsed(Date.now() - startedAt)}`; // 완료/실패 시 최종 경과 시간\n643\t    if (!res.ok) {\n644\t      const e = String(data.error || \"\");\n645\t      // 무료 모델 한도를 넘는 큰 자료 → 기술적 오류 대신 ★행동 안내★(원본 그대로 / 더 작게).\n646\t      if (/\\b413\\b|too large|too many tokens|tokens per minute|\\bTPM\\b|context length|maximum context|RESOURCE_EXHAUSTED|한도/i.test(e)) {\n647\t        return { ok: false, note: \"자료 크기가 커서 분석할 수 없어요(무료 모델 한도 초과). 이렇게 큰 자료는 ‘원본 그대로 추가’로 올리면 분석 없이 그대로 저장·검색됩니다. 분석이 꼭 필요하면 핵심만 텍스트(.md·.txt)로 추려 더 작게 나눠 올려주세요.\" + took };\n648\t      }\n649\t      return { ok: false, note: `${toUserMessage(e, \"처리에 실패했어요.\")}${took}` };\n650\t    }\n651\t    if (effMode === \"raw\") return { ok: true, note: \"원본 그대로 추가됨 · 토큰 0\" };\n652\t    // ★L2 비동기★: 큐에 적재됨 — 즉시 반환(워커가 백그라운드 처리, 목록 폴링이 진행을 따라간다).\n653\t    if (data.queued) return { ok: true, queued: true, note: \"분석 예약됨 · 백그라운드에서 처리 중\" }; // ★queued=클라 측정 무의미(실제 처리는 워커)→소요는 서버 durationMs로★\n654\t    const sw = data.fallback ? \" · 백업 모델로 자동 전환됨\" : \"\";\n655\t    const md = data.usedModel ? ` · 모델 ${modelLabel(data.usedModel)}` : \"\";\n656\t    const prefix = fellBack ? \"텍스트 없음 → 분석함 · \" : \"\";\n657\t    const base = data.status === \"NEEDS_REVIEW\" ? \"검토 대기\" : \"분석 반영됨\";\n658\t    return { ok: true, note: prefix + base + md + sw + took };\n659\t  }\n660\t\n661\t  // [처리 시작] — 대기(staged) 항목을 순차 처리(위키는 단일 라이터). 끝나면 목록·트리 갱신.\n662\t  async function runStaged() {\n663\t    if (busy) return;\n664\t    const qScope = scope; // ★처리를 시작한 룸★ 고정(중간에 룸을 옮겨도 busy는 이 룸에만)\n665\t    const todo = staged.filter((s) => s.status === \"staged\" && s.sourceId);\n666\t    if (!todo.length) return;\n667\t    // ★유료(종량 과금) 경고★ — 선택/자동추천된 분석 모델 중 OpenAI·Claude API가 있으면 확인.\n668\t    if (uploadMode !== \"raw\") {\n669\t      const usesPaid = todo.some((it) => isPaidProvider(analyzeModels.find((m) => m.id === (modelUserPicked ? analyzeModelId : (it.reco?.model ?? analyzeModelId)))?.provider));\n670\t      if (usesPaid && !await confirmDialog(\"선택/추천된 분석 모델 중 ★사용량만큼 과금★되는 유료 모델(OpenAI·Claude API)이 있습니다. 계속할까요?\")) return;\n671\t    }\n672\t    setBusyFor(qScope, true); setErr(null);\n673\t    try {\n674\t      for (const it of todo) {\n675\t        // 표시 모델: 직접 고름이면 그 모델, 자동이면 ★서버가 고를 모델(업로드 시 reco)★."}]},"uuid":"17f3daa3-bca4-4b5d-8f8f-5ccc8a7d2ff2","timestamp":"2026-06-28T11:14:43.581Z","toolUseResult":{"type":"text","file":{"filePath":"E:\\llm-wiki\\components\\wiki\\MaterialsTab.tsx","content":"\"use client\";\n\nimport { confirmDialog } from \"@/components/ui/Dialog\";\nimport { toUserMessage } from \"./errMsg\";\nimport Avatar from \"./Avatar\";\n\nimport { useCallback, useEffect, useRef, useState, type ReactNode } from \"react\";\nimport {\n  IconUpload, IconFileText, IconCircleCheck, IconAlertTriangle, IconClockHour4,\n  IconChevronRight, IconTrash, IconCalendar, IconExternalLink, IconArrowUpRight, IconArticle,\n  IconArrowsExchange, IconArchive, IconArrowBackUp, IconTrashX, IconSparkles, IconInfoCircle, IconRefresh, IconCopy, IconX,\n} from \"@tabler/icons-react\";\nimport { typeIcon, typeLabel } from \"./fileIcons\";\nimport ModelSelect, { ModelDot, ModelBadges, type ModelOpt } from \"./ModelSelect\";\nimport { copyToClipboard } from \"./clipboard\";\nimport { kstStamp, kstDateStr, kstTimeStr } from \"@/lib/time\";\nimport { isRecent, RECENT_DAYS } from \"@/lib/recency\";\nimport { isTranscribedExtractor } from \"@/lib/transcript\";\nimport { summarizeBatch, batchSummaryText, groupStagedByModel } from \"@/lib/uploadBatch\";\nimport { useDismissedNew } from \"./useDismissedNew\";\n\n// 실패 사유가 ★출력 길이 초과(자료가 너무 커서 AI 정리가 잘림)★인지 — 이 경우 '원본 그대로 추가'를 권장한다.\nconst isTooLargeErr = (e?: string | null) => !!e && /(최대 길이|maxOutputTokens|max_tokens|잘렸|너무 큽니다)/i.test(e);\n\n// 클립보드 복사 버튼(복사됨 피드백). 실패 사유 전문 복사 등에 사용.\nfunction CopyButton({ text, label = \"복사\" }: { text: string; label?: string }) {\n  const [done, setDone] = useState(false);\n  return (\n    <button type=\"button\" className=\"mat-rowbtn\" style={{ alignSelf: \"flex-start\" }}\n      onClick={async () => { if (await copyToClipboard(text)) { setDone(true); setTimeout(() => setDone(false), 1500); } }}>\n      <IconCopy size={12} />{done ? \"복사됨\" : label}\n    </button>\n  );\n}\n\n// 모델 id를 사람이 읽기 좋은 짧은 라벨로(예: claude-cli/sonnet → \"Claude sonnet (구독)\"). 없으면 id 그대로.\nfunction modelLabel(id?: string | null): string {\n  if (!id) return \"\";\n  if (id.startsWith(\"claude-cli/\")) return `Claude ${id.split(\"/\")[1]} (구독)`;\n  if (id === \"codex\") return \"Codex\";\n  if (id.startsWith(\"claude\")) return \"Claude API\";\n  return id; // gemini-2.5-flash 등은 id 그대로 (정보성 충분)\n}\n\n// 사용량만큼 ★종량 과금★되는 공급자(API 결제) — 경고 뱃지·확인 팝업용. 구독(codex/claude-cli)·무료(gemini/groq)·로컬 제외.\nconst isPaidProvider = (p?: string) => p === \"openai\" || p === \"anthropic\";\n\n// 경과 시간 mm:ss 표기 (분석 진행 중·완료·실패 시간 표시용).\nfunction fmtElapsed(ms: number): string {\n  const s = Math.max(0, Math.floor(ms / 1000));\n  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, \"0\")}`;\n}\n\n// 원본 파일 용량 표시(B/KB/MB/GB) — 10단위 미만은 소수 1자리로 가독성.\nfunction fmtBytes(n?: number | null): string {\n  if (n == null || n < 0) return \"\";\n  if (n < 1024) return `${n} B`;\n  const u = [\"KB\", \"MB\", \"GB\", \"TB\"]; let v = n / 1024, i = 0;\n  while (v >= 1024 && i < u.length - 1) { v /= 1024; i++; }\n  return `${v < 10 ? v.toFixed(1) : Math.round(v)} ${u[i]}`;\n}\n\nfunction SourceGroup({ ym, items, onArchive, onWiki, onRecover, onAnalyze, onFileRaw, onCancel, onRestore, onPurge, deleting, acting, canceling, now, notes, durations, canManage, archivedMode, defaultOpen, seenNew, onSeen }: {\n  ym: string; items: SourceItem[]; onArchive: (s: SourceItem) => void; onWiki: (s: SourceItem) => void;\n  onRecover: (s: SourceItem) => void; onAnalyze: (s: SourceItem, reanalyze?: boolean) => void;\n  onFileRaw: (s: SourceItem) => void; onCancel: (s: SourceItem) => void;\n  onRestore?: (s: SourceItem) => void; onPurge?: (s: SourceItem) => void;\n  deleting: number | null; acting: Map<number, { label: string; at: number; ctrl: AbortController }>; canceling?: Set<number>; now: number; notes: Record<number, string>; durations: Map<number, number>; canManage: boolean; archivedMode?: boolean; defaultOpen?: boolean;\n  seenNew: (id: string) => boolean; onSeen: (s: SourceItem) => void; // 'N(최근)' 마크 — 클릭 시 제거\n}) {\n  const [open, setOpen] = useState(defaultOpen ?? false);\n  return (\n    <div>\n      <button className=\"mat-group\" onClick={() => setOpen((o) => !o)}>\n        <IconChevronRight size={13} className={`tree-caret${open ? \" open\" : \"\"}`} />\n        <IconCalendar size={14} />{ym}<span className=\"mat-group-count\">({items.length})</span>\n      </button>\n      {open && items.map((s) => {\n        const FIcon = typeIcon(s.type);\n        // '잔여'(재처리 복구) = ★텍스트 없는 중단 PENDING·FAILED만★. 전사·추출이 끝난(hasText) PENDING은\n        //   분석 대기 상태이므로 [AI로 분석]을 띄운다(음성 전사만 하고 분석 전인데 '재처리'가 뜨던 문제 수정).\n        const stuck = (s.status === \"PENDING\" && !s.hasText) || s.status === \"FAILED\";\n        const isRaw = s.status === \"APPLIED\" && s.gate === \"RAW_IMPORT\"; // '원본 그대로' 보관 — 아직 분석 안 됨\n        // [AI로 분석] 대상: 원본 그대로 보관본 + 미분석 보존본 + ★전사·추출만 되고 분석 전(PENDING+hasText)★.\n        const canAnalyze = !archivedMode && (isRaw || s.status === \"UNANALYZED\" || (s.status === \"PENDING\" && s.hasText));\n        // [다시 분석] 대상: 이미 분석된 자료(원본 보존하며 엔티티·개념 갱신).\n        const canReanalyze = !archivedMode && s.status === \"APPLIED\" && !isRaw;\n        const act = acting.get(s.id);\n        const busy = !!act;\n        const serverProc = !busy && (s.status === \"RUNNING\" || s.status === \"APPLYING\" || s.status === \"QUEUED\"); // 다른 세션·비동기 큐 등 서버측 처리 중\n        const isCanceling = !!canceling && canceling.has(s.id) && (busy || serverProc); // 취소 누른 직후~서버가 취소 확정(상태 전환)하기 전까지\n        // 처리 중 모델 + 경과 시간 — 로컬(이 클라가 누름) 시작시각 우선, 없으면 ★서버 잡 시작시각(startedAt)★.\n        //   → 비동기 큐·새로고침·다른 세션이 시작한 작업도 경과가 1초마다 증가(이전엔 클라 시작분만 카운트).\n        const procLabel = busy ? act.label : (serverProc ? modelLabel(s.model) : \"\");\n        // 서버 경과는 QUEUED·RUNNING(비동기 인제스트)만 — APPLYING(검토승인)은 잡 createdAt이 오래돼 경과가 틀림.\n        const startMs = busy ? act.at : (serverProc && (s.status === \"QUEUED\" || s.status === \"RUNNING\") && s.startedAt ? Date.parse(s.startedAt) : 0);\n        const elapsed = (busy || serverProc) && startMs ? fmtElapsed(now - startMs) : \"\";\n        // 처리 배지 문구: 단계(phase)와 경과를 함께. QUEUED는 phase(대기 중/요약 k/N), 그 외는 '처리 중 {모델} · {phase}'.\n        const procText = isCanceling ? \"취소 중…\" : (() => {\n          const label = s.status === \"QUEUED\" ? (s.phase || \"대기 중\") : `처리 중${procLabel ? ` ${procLabel}` : \"\"}${s.phase ? ` · ${s.phase}` : \"\"}`;\n          return elapsed ? `${label} · ${elapsed}` : label;\n        })();\n        const note = notes[s.id];\n        return (\n          <div key={s.id} className=\"mat-item-row\" style={{ paddingLeft: 16 }} onClick={() => onSeen(s)}>\n            <div className=\"mat-item tree\">\n              <FIcon size={17} className=\"mat-ficon\" />\n              <div className=\"mat-item-main\">\n                <div className=\"mat-item-title\" title={s.title}>{s.title}</div>\n                <div className=\"mat-item-sub\"><span className=\"mat-ext\">{typeLabel(s.type)}</span> · <span title={kstStamp(new Date(s.createdAt))}>{kstTimeStr(new Date(s.createdAt))}</span>\n                  {s.byteSize != null && <> · <span title={s.extractor && (s.extractor.startsWith(\"groq-\") || s.extractor.startsWith(\"gemini-\")) ? \"원본 음성·영상 용량\" : \"원본 파일 용량\"}>{fmtBytes(s.byteSize)}</span></>}\n                  {isRecent(s.createdAt) && !seenNew(`mat:${s.id}`) && <span className=\"new-badge\" title={`최근 ${RECENT_DAYS}일 이내 추가됨 (클릭하면 사라짐)`}>N</span>}\n                  {s.uploader\n                    ? <> · <span className=\"mat-uploader\" title={s.anonymous ? \"익명 요청 자료 — 관리자에게만 실명 표시(감사)\" : \"업로더\"}>\n                        <Avatar className=\"mat-uploader-av\" initials={s.uploader.avatar.initials} color={s.uploader.avatar.color} imageUrl={s.uploader.avatar.imageUrl} />\n                        {s.uploader.name}{s.anonymous ? \" 🔒\" : \"\"}</span></>\n                    : s.anonymous ? <> · <span className=\"mat-uploader anon\" title=\"익명 기여자 (작성자는 감사 기록에 유지됨)\">익명 기여자</span></> : null}\n                  {/* ★처리 중엔 '처리 중 {모델}', 완료 후엔 '분석 {모델}'★ — 어떤 모델이 도는지/분석했는지. */}\n                  {busy || serverProc ? (\n                    <span className=\"mat-model-badge proc\" title={isCanceling ? \"취소 중\" : \"처리 중\"}>{procText}</span>\n                  ) : s.model && ((s.status === \"APPLIED\" && !isRaw) || s.status === \"NEEDS_REVIEW\") ? (\n                    <span className=\"mat-model-badge\" title=\"이 자료를 분석한 모델\">분석 {modelLabel(s.model)}{durations.has(s.id) ? ` · ${fmtElapsed(durations.get(s.id)!)}` : s.durationMs != null ? ` · ${fmtElapsed(s.durationMs)}` : \"\"}</span>\n                  ) : null}\n                  {/* ★음성·영상 전사 출처★ — Gemini 전사는 외부 학습 경고(민감 자료 주의), Groq는 외부 전송(미학습). 분석 모델과 별개. */}\n                  {s.extractor?.startsWith(\"gemini-\") ? (\n                    <span className=\"mat-model-badge warn\" title=\"이 자료는 Gemini로 음성을 텍스트로 변환함 — 오디오가 Google로 전송·학습됩니다. 민감 자료엔 쓰지 마세요.\">Gemini 텍스트 변환 · 외부학습</span>\n                  ) : s.extractor?.startsWith(\"groq-\") ? (\n                    <span className=\"mat-model-badge\" title=\"이 자료는 Groq Whisper로 음성을 텍스트로 변환함(외부 전송, 학습엔 미사용)\">Groq 텍스트 변환</span>\n                  ) : null}\n                  {/* ★스캔 PDF 처리★ — 페이지를 이미지에서 전사(OCR)했고, 모델 한도에 맞춰 해상도를 낮췄음(다운스케일)을 명시. 원본 보존 — 품질 저하 투명성. */}\n                  {s.extractor?.startsWith(\"pdf-scan\") && (\n                    <span className=\"mat-model-badge\" title=\"스캔 PDF라 각 페이지를 이미지에서 전사(OCR)했습니다. 모델 한도에 맞춰 페이지 해상도를 낮춰(다운스케일) 전사했으며, ★원본 파일은 그대로 보존★됩니다(필요하면 더 높은 해상도로 다시 분석 가능).\">스캔 전사 · 다운스케일</span>\n                  )}\n                </div>\n                {note && <div className=\"mat-item-note\">{note}</div>}\n              </div>\n              {!archivedMode && (\n                <span className={`mat-status ${s.status === \"APPLIED\" ? (isRaw ? \"muted\" : \"ok\") : s.status === \"FAILED\" ? \"err\" : s.status === \"UNANALYZED\" ? \"warn\" : s.status === \"PENDING\" || s.status === \"RUNNING\" || s.status === \"APPLYING\" || s.status === \"QUEUED\" ? \"pend\" : \"muted\"}`}>\n                  {isCanceling ? \"취소 중…\" : busy ? \"처리 중…\" : s.status === \"APPLIED\" ? (isRaw ? \"원본 보관\" : \"반영됨\") : s.status === \"FAILED\" ? \"실패\" : s.status === \"SKIPPED_DUP\" ? \"중복\" : s.status === \"UNANALYZED\" ? \"미분석\" : s.status === \"QUEUED\" ? \"대기 중\" : s.status === \"PENDING\" ? \"분석 대기\" : s.status === \"RUNNING\" ? \"분석 중…\" : s.status === \"APPLYING\" ? \"반영 중…\" : s.status === \"NEEDS_REVIEW\" ? \"검토 대기\" : s.status ?? \"-\"}\n                </span>\n              )}\n              {/* 액션은 ★아이콘만★(고정폭) — 상태 배지·아이콘 열 정렬 유지. '재처리'·'AI로 분석'은 아래 별도 줄로 뺀다. */}\n              <div className=\"mat-acts\">\n                {/* L4: 원본 정리됨이면 열기 비활성(지식·추출본은 유지). */}\n                {s.rawEvicted\n                  ? <span className=\"mat-act\" style={{ opacity: 0.4, cursor: \"default\" }} title=\"원본은 보존정책에 따라 정리됨(분석본·위키 지식은 유지)\"><IconExternalLink size={13} /></span>\n                  : <a className=\"mat-act\" href={`/api/materials/${s.id}/raw`} target=\"_blank\" rel=\"noreferrer\" title=\"원본 열기\"><IconExternalLink size={13} /></a>}\n                {archivedMode ? (\n                  <>\n                    <button className=\"mat-act\" disabled={busy} onClick={() => onRestore!(s)} title=\"복원\"><IconArrowBackUp size={14} /></button>\n                    <button className=\"mat-del\" disabled={deleting === s.id || busy} onClick={() => onPurge!(s)} title=\"영구삭제\"><IconTrashX size={14} /></button>\n                  </>\n                ) : (\n                  <>\n                    {/* A-ⓕ: 분석이 콘텐츠 페이지를 0개 만든 경우(resultPages===0) '페이지로' 링크 숨김(가짜 404 방지). null=구버전/RAW→현행 유지. */}\n                    {!stuck && s.resultPages !== 0 && <button className=\"mat-act\" onClick={() => onWiki(s)} title=\"위키 페이지로 이동\"><IconArrowUpRight size={13} /></button>}\n                    {s.hasExtracted && (\n                      <a className=\"mat-act\" href={`/api/materials/${s.id}/extracted`} target=\"_blank\" rel=\"noreferrer\" title=\"추출본(읽은 텍스트)\"><IconArticle size={13} /></a>\n                    )}\n                    {canManage && <button className=\"mat-del\" disabled={deleting === s.id || busy} onClick={() => onArchive(s)} title=\"아카이브(삭제)\"><IconTrash size={13} /></button>}\n                  </>\n                )}\n              </div>\n            </div>\n            {/* 별도 줄: 잔여 재처리 / AI로 분석(눈에 띄는 라벨 버튼) — 행 정렬에 영향 없음 */}\n            {!archivedMode && stuck && !busy && (\n              <button className=\"mat-rowbtn\" onClick={() => onRecover(s)} title=\"이 자료를 (위쪽에서 고른 방식으로) 다시 처리\">재처리</button>\n            )}\n            {!archivedMode && !busy && canAnalyze && (\n              <button className=\"mat-rowbtn analyze\" onClick={() => onAnalyze(s)}\n                title=\"AI로 분석해 엔티티·개념으로 정리합니다\">\n                <IconSparkles size={13} />AI로 분석\n              </button>\n            )}\n            {!archivedMode && !busy && canReanalyze && (\n              <button className=\"mat-rowbtn\" onClick={() => onAnalyze(s, true)}\n                title=\"이미 분석된 자료를 최신 방식으로 다시 분석 (원본 보존, 엔티티·개념 갱신)\">\n                <IconRefresh size={13} />다시 분석\n              </button>\n            )}\n            {/* 처리 중: '분석 중' 버튼(툴팁 유지·비활성)과 취소를 ★나란히★(취소가 '분석 중'을 대체하지 않게). 경과 시간은 위 배지에. */}\n            {!archivedMode && busy && (\n              <div className=\"mat-busy-row\">\n                <button className={`mat-rowbtn ${canReanalyze ? \"\" : \"analyze\"}`} disabled\n                  title={canReanalyze ? \"이미 분석된 자료를 최신 방식으로 다시 분석 (원본 보존, 엔티티·개념 갱신)\" : \"AI로 분석해 엔티티·개념으로 정리합니다\"}>\n                  {canReanalyze ? <IconRefresh size={13} /> : <IconSparkles size={13} />}분석 중…\n                </button>\n                <button className=\"mat-rowbtn cancel\" onClick={() => onCancel(s)} title=\"분석 취소 (서버 작업도 중단)\">\n                  <IconX size={13} />취소\n                </button>\n              </div>\n            )}\n            {/* 실패 사유 — 전문 표시 + 복사. (오래 걸려 실패한 PDF 등의 원인 진단·공유용) */}\n            {!archivedMode && s.status === \"FAILED\" && s.error && (\n              <div className=\"mat-failbox\">\n                <div className=\"mat-failbox-head\">\n                  <span style={{ flex: 1, minWidth: 0, fontSize: 11.5, fontWeight: 600, color: \"var(--color-text-danger)\", overflow: \"hidden\", textOverflow: \"ellipsis\", whiteSpace: \"nowrap\" }}>「{s.title}」 실패{s.model ? ` · 모델 ${modelLabel(s.model)}` : \"\"}</span>\n                  <CopyButton text={s.error} label=\"사유 복사\" />\n                </div>\n                <pre style={{ margin: 0, maxHeight: 160, overflow: \"auto\", whiteSpace: \"pre-wrap\", wordBreak: \"break-word\", fontSize: 11.5, lineHeight: 1.5, fontFamily: \"var(--font-mono, monospace)\", color: \"var(--color-text-secondary)\", userSelect: \"text\" }}>{s.error}</pre>\n                {/* 출력 길이 초과(자료가 너무 큼)면 → 토큰 0인 '원본 그대로 추가'를 권장 + 바로 실행 */}\n                {isTooLargeErr(s.error) && s.hasText && (\n                  <div style={{ marginTop: 8, fontSize: 11.5, color: \"var(--color-text-secondary)\", lineHeight: 1.5 }}>\n                    💡 자료가 커서 AI 정리 결과가 한 번에 안 담깁니다. 원문을 그대로 보존하는 <b>원본 그대로 추가</b>(토큰 0)를 권장합니다. 더 잘게 나눠 올려 분석할 수도 있어요.\n                    <div style={{ marginTop: 6 }}>\n                      <button className=\"mat-rowbtn analyze\" disabled={busy} onClick={() => onFileRaw(s)}>\n                        <IconFileText size={13} />원본 그대로 추가\n                      </button>\n                    </div>\n                  </div>\n                )}\n              </div>\n            )}\n          </div>\n        );\n      })}\n    </div>\n  );\n}\n\ninterface SourceItem { id: number; title: string; type: string; createdAt: string; status: string | null; confidence: number | null; gate: string | null; phase?: string | null; progress?: number | null; resultPages?: number | null; startedAt?: string | null; durationMs?: number | null; byteSize?: number | null; extractStatus?: string | null; extractor?: string | null; hasExtracted?: boolean; hasText?: boolean; looksOrganized?: boolean; archived?: boolean; rawEvicted?: boolean; error?: string | null; model?: string | null; recoModel?: string | null; anonymous?: boolean; uploader?: { name: string; avatar: { initials: string; color: string; imageUrl: string | null } } | null }\ninterface UploadPolicy { provider: string; tier?: string; textOnly: boolean; vision?: boolean; exts: string[]; accept: string; note: string }\ninterface AnalyzeModel { model: string; provider: string; label: string; reason: string }\n// 스테이징(보관됨)된 한 파일/입력 — 사용자가 [처리 시작]을 누르기 전까지 대기.\ninterface Reco { model: string; provider: string; label: string; reason: string }\ninterface Staged { key: number; sourceId: number | null; name: string; hasText: boolean; status: \"staging\" | \"staged\" | \"running\" | \"done\" | \"error\" | \"skip\"; note?: string; reco?: Reco; at?: number; ctrl?: AbortController }\n\nconst extOf = (n: string) => n.toLowerCase().match(/\\.([a-z0-9]+)$/)?.[1] ?? \"\";\n\n// 새로고침 복원 시 ★아직 서버로 안 보낸 대기 항목만★ 남긴다(sourceId 있고 status===\"staged\").\n//   'running'은 서버가 이미 처리 중이거나 처리한 것(결과는 '최근 자료'에 RUNNING/반영됨으로 보임)이라\n//   ★대기에 되살리지 않는다★(같은 파일이 분석 중인데 대기에도 뜨는 중복 방지). 업로드 중('staging')·\n//   완료/실패(done/skip/error)도 버린다(결과·재처리는 '최근 자료'에서).\nfunction normalizeStaged(arr: Staged[]): Staged[] {\n  return (Array.isArray(arr) ? arr : [])\n    .filter((s) => s && s.sourceId && s.status === \"staged\")\n    .map((s) => ({ ...s, note: undefined, at: undefined, ctrl: undefined }));\n}\n\n// 업로드 원본을 ★일자(YYYY-MM-DD)★로 묶어 최신순 트리로. 항목은 하위로 들여쓰고 시각(초)만 표시.\nfunction groupByDay(sources: SourceItem[]): [string, SourceItem[]][] {\n  const m = new Map<string, SourceItem[]>();\n  for (const s of sources) {\n    const k = kstDateStr(new Date(s.createdAt)); // ★한국 시간(KST) 일자★로 묶음\n    const arr = m.get(k);\n    if (arr) arr.push(s); else m.set(k, [s]);\n  }\n  return [...m.entries()].sort((a, b) => b[0].localeCompare(a[0]));\n}\n\n// ★월(상위) → 일(하위)★ 2단계. 둘 다 최신순. 월 큰 묶음 아래에 일자별로 나눠 보기 쉽게.\nfunction groupByMonthThenDay(sources: SourceItem[]): [string, [string, SourceItem[]][]][] {\n  const m = new Map<string, [string, SourceItem[]][]>();\n  for (const [day, items] of groupByDay(sources)) {       // 이미 일자 최신순\n    const month = day.slice(0, 7);\n    const arr = m.get(month);\n    if (arr) arr.push([day, items]); else m.set(month, [[day, items]]);\n  }\n  return [...m.entries()].sort((a, b) => b[0].localeCompare(a[0]));\n}\n\n// 상위 '월' 묶음 — 펼치면 그 아래 일자 그룹(SourceGroup)들을 한 칸 들여써 보여준다.\nfunction MonthGroup({ month, count, children, defaultOpen }: { month: string; count: number; children: ReactNode; defaultOpen?: boolean }) {\n  const [open, setOpen] = useState(defaultOpen ?? false);\n  return (\n    <div className=\"mat-month\">\n      <button className=\"mat-group\" onClick={() => setOpen((o) => !o)}>\n        <IconChevronRight size={13} className={`tree-caret${open ? \" open\" : \"\"}`} />\n        <IconCalendar size={14} />{month}<span className=\"mat-group-count\">({count})</span>\n      </button>\n      {open && <div style={{ paddingLeft: 14 }}>{children}</div>}\n    </div>\n  );\n}\n\nexport default function MaterialsTab({ scope, hidden, onOpenWiki, modelsRev, dataRev, onDataChanged }: {\n  scope: string; hidden?: boolean; onOpenWiki: (path: string) => void; modelsRev?: number; dataRev?: number; onDataChanged?: () => void;\n}) {\n  const [title, setTitle] = useState(\"\");\n  const [text, setText] = useState(\"\");\n  // ★룸(scope)별 처리중 상태★ — '분석 중…'·입력 잠금이 그 처리를 시작한 룸에서만 보이게(다른 룸으로 새지 않음, ChatTab streamingScopes와 동일 패턴).\n  const [busyScopes, setBusyScopes] = useState<Set<string>>(new Set());\n  const busy = busyScopes.has(scope); // [처리 시작] 진행 중(현재 룸 기준)\n  const setBusyFor = (sc: string, on: boolean) => setBusyScopes((s) => { const n = new Set(s); if (on) n.add(sc); else n.delete(sc); return n; });\n  const [err, setErr] = useState<string | null>(null);\n  const [uploadMode, setUploadMode] = useState<\"llm\" | \"raw\">(\"llm\"); // 처리 방식(확정 시 적용)\n  const [staged, setStaged] = useState<Staged[]>([]); // 대기(스테이징)된 항목\n  const [sources, setSources] = useState<SourceItem[]>([]);\n  const [anonUpload, setAnonUpload] = useState(false); // 익명으로 업로드(표시만 숨김, uploadedBy는 감사용 유지)\n  const [diarize, setDiarize] = useState(false); // 음성·영상 화자 구분(Gemini 전용·외부학습) — STT에만 적용\n  // (회의록 처리 토글은 제거 — 전사 소스는 서버가 ★무조건 회의록으로★ 처리)\n  const [diarizeSwitched, setDiarizeSwitched] = useState(false); // 화자 구분이 분석 모델을 Gemini로 자동 전환했나(말풍선 표시)\n  const preDiarizeRef = useRef<{ model: string; picked: boolean } | null>(null); // 화자 구분 끄면 되돌릴 직전 모델\n  const [deleting, setDeleting] = useState<number | null>(null);\n  const [delNote, setDelNote] = useState<string | null>(null);\n  const [canManage, setCanManage] = useState(false); // 아카이브·영구삭제 권한(룸 관리자)\n  const [archivedSources, setArchivedSources] = useState<SourceItem[]>([]);\n  const [showArchived, setShowArchived] = useState(false);\n  const [convertExts, setConvertExts] = useState<string[]>([]);\n  const [policy, setPolicy] = useState<UploadPolicy | null>(null);\n  const [analyzeModel, setAnalyzeModel] = useState<AnalyzeModel | null>(null); // 서버 추천(기본값·사유 툴팁용)\n  const [analyzeModels, setAnalyzeModels] = useState<ModelOpt[]>([]);          // 고를 수 있는 분석 모델 목록\n  const [analyzeModelId, setAnalyzeModelId] = useState<string>(\"\");            // 적용할 분석 모델(자동추천 또는 사용자 선택)\n  const [modelUserPicked, setModelUserPicked] = useState(false);              // 사용자가 셀렉트박스로 직접 바꿨나(=자동추천 끔)\n  const [pickFor, setPickFor] = useState<{ s: SourceItem; reanalyze: boolean; recover?: boolean } | null>(null); // AI로 분석/다시 분석/재처리 모델 선택 팝업 대상\n  const [pickDiarize, setPickDiarize] = useState(false); // 재분석 팝업: 음성 소스의 화자 구분 선택(Gemini)\n  const { has: seenNew, dismiss: dismissNew } = useDismissedNew(); // 'N(최근)' 마크 — 자료 항목 클릭 시 제거\n  const [pickId, setPickId] = useState<string>(\"\");                            // 팝업에서 고른 모델\n  const [dragOver, setDragOver] = useState(false);\n  const [acting, setActing] = useState<Map<number, { label: string; at: number; ctrl: AbortController }>>(new Map()); // 처리 중 소스 id → {모델 라벨, 시작 시각, 취소 컨트롤러}\n  const [canceling, setCanceling] = useState<Set<number>>(new Set()); // 취소 누른 소스 id — 즉시 '취소 중…' 표시(서버가 상태 전환하면 폴링이 해제)\n  const [durations, setDurations] = useState<Map<number, number>>(new Map()); // 분석 끝난 소스 id → ★최종 소요(ms)★ — 완료 후에도 배지에 남겨 표시\n  const markDuration = (id: number, ms: number) => setDurations((d) => new Map(d).set(id, ms));\n  const [notes, setNotes] = useState<Record<number, string>>({}); // 처리 결과 메모(자동전환·반영 등)\n  const fileRef = useRef<HTMLInputElement>(null);\n  // 분석 경과 시간 — 처리 중(acting)일 때 1초마다 now를 갱신해 배지의 경과 시간이 흐르게 한다.\n  const [now, setNow] = useState(0);\n  const stagingRunning = staged.some((s) => s.status === \"running\"); // 대기열 처리 중에도 경과 시간 tick\n  // 서버측 처리 중(비동기 큐·다른 세션·새로고침 후) — 경과 타이머(A)가 이때도 흘러야 한다.\n  const anyServerProc = sources.some((s) => s.status === \"RUNNING\" || s.status === \"APPLYING\" || s.status === \"QUEUED\");\n  useEffect(() => {\n    // ★서버 작업도 포함★ — 빠지면 now가 갱신 안 돼(초기 0) 서버 경과가 0:00에 박제된다.\n    if (acting.size === 0 && !stagingRunning && !anyServerProc) return;\n    setNow(Date.now());\n    const t = setInterval(() => setNow(Date.now()), 1000);\n    return () => clearInterval(t);\n  }, [acting.size, stagingRunning, anyServerProc]);\n  // 대기 큐 영속화(sessionStorage) — ★scope별 저장소★. AppShell이 새로고침 후 scope를 비동기로 복원해도\n  // 해당 scope의 큐를 정확히 되살리려면 모든 scope의 큐를 ref 맵에 들고 있어야 한다(chat·위키탭과 동일 패턴).\n  const stagedStore = useRef<Record<string, Staged[]>>({});\n  const stagedRef = useRef(staged); stagedRef.current = staged;\n  const matPrevScope = useRef(scope);\n  const matFirstSave = useRef(true); // 첫(빈) 저장은 건너뛰어 복원본을 덮어쓰지 않음\n  const matRestored = useRef(false); // mount 복원 완료 전엔 빈 staged를 store에 저장하지 않음\n\n  const load = useCallback(async () => {\n    try {\n      const res = await fetch(`/api/materials?scope=${encodeURIComponent(scope)}`, { cache: \"no-store\" });\n      const d = await res.json();\n      if (res.ok) {\n        setSources(d.sources); setConvertExts(d.convertExts || []); setPolicy(d.policy || null);\n        setCanManage(Boolean(d.canManage)); setAnalyzeModel(d.analyzeModel || null);\n      }\n    } catch { /* noop */ }\n  }, [scope]);\n\n  // ★서버측 처리 중(RUNNING/APPLYING) 항목이 있으면 자동 폴링★ — 취소·완료가 수동 새로고침 없이 반영되게.\n  //   (취소=abort는 즉시 보내지만 서버가 상태를 '취소됨'으로 바꾸는 덴 시간차가 있어, 폴링으로 따라잡는다.)\n  //   anyServerProc는 위(경과 타이머)에서 정의 — 같은 값 재사용.\n  useEffect(() => {\n    if (!anyServerProc) return;\n    const t = setInterval(() => { void load(); }, 2000);\n    return () => clearInterval(t);\n  }, [anyServerProc, load]);\n  // ★서버측 처리(비동기 큐 등)가 끝나는 순간 위키 탭 등에 갱신 신호★ — 분석이 백그라운드에서 끝나면\n  //   (anyServerProc true→false 전이) 새 엔티티/개념 페이지가 위키 탭에 ★새로고침 없이★ 바로 보이게 한다.\n  //   (동기 경로는 analyzeItem/runStaged가 직접 onDataChanged를 부르고, 이건 폴링으로만 끝을 아는 비동기 완료를 커버.)\n  const prevServerProc = useRef(false);\n  useEffect(() => {\n    if (prevServerProc.current && !anyServerProc) onDataChanged?.();\n    prevServerProc.current = anyServerProc;\n  }, [anyServerProc, onDataChanged]);\n  // 서버 상태가 더 이상 처리중이 아니면 '취소 중' 표시 해제(취소 확정 → 실패/완료 박스로 전환).\n  useEffect(() => {\n    setCanceling((c) => {\n      if (c.size === 0) return c;\n      const next = new Set([...c].filter((id) => { const s = sources.find((x) => x.id === id); return !!s && (s.status === \"RUNNING\" || s.status === \"APPLYING\"); }));\n      return next.size === c.size ? c : next;\n    });\n  }, [sources]);\n\n  // 고를 수 있는 분석 모델 목록(질의와 동일 라인업). 관리자가 모델을 토글하면(modelsRev) 다시 읽는다.\n  useEffect(() => {\n    fetch(\"/api/models\", { cache: \"no-store\" }).then((r) => r.json()).then((d) => {\n      setAnalyzeModels(d.models || []);\n    }).catch(() => { /* noop */ });\n  }, [modelsRev]);\n  // ★자료를 판단해 분석 모델 자동 추천★ — 무겁/복잡한 게 있으면 구독 고품질(claude-cli·codex), 아니면 기본(Gemini).\n  //   서버가 업로드 응답에 reco(추천 모델+사유)를 실어 주고, 그중 구독 고품질 추천이 하나라도 있으면 그걸 택한다.\n  const enabledHas = (id: string) => analyzeModels.some((m) => m.id === id && m.enabled);\n  const stagedRecos = staged.map((s) => s.reco).filter((r): r is Reco => !!r);\n  const effReco: Reco | null =\n    stagedRecos.find((r) => r.provider === \"claude-cli\" && enabledHas(r.model)) // 무거운 자료 → Claude 구독 우선\n    ?? stagedRecos.find((r) => r.provider === \"codex\" && enabledHas(\"codex\"))   // 또는 codex\n    ?? stagedRecos.find((r) => enabledHas(r.model))                             // 그 외 자료 추천\n    ?? (analyzeModel && enabledHas(analyzeModel.model) ? analyzeModel : null); // 스테이징 전 = 서버 기본 추천\n  const recommendedId = effReco && enabledHas(effReco.model) ? effReco.model : (analyzeModels.find((m) => m.enabled)?.id || \"\");\n  // 추천을 셀렉트박스에 자동 반영(자료 올리면 그에 맞게 바뀜).\n  //  ★관리자가 모델을 끄면★ 현재 선택이 비활성이 될 수 있으므로 — 사용자가 직접 골랐어도(modelUserPicked)\n  //   그 선택이 더는 활성이 아니면 ★활성 추천으로 교정★한다(비활성 모델이 선택된 채 남지 않게).\n  useEffect(() => {\n    const curEnabled = !!analyzeModelId && enabledHas(analyzeModelId);\n    if (modelUserPicked && curEnabled) return; // 사용자가 고른 ★활성★ 모델은 유지\n    if (recommendedId && recommendedId !== analyzeModelId) setAnalyzeModelId(recommendedId);\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [recommendedId, modelUserPicked, analyzeModelId, analyzeModels]);\n\n  // 아카이브된 자료 목록(복원/영구삭제 뷰) — 별도 조회(?archived=1).\n  const loadArchived = useCallback(async () => {\n    try {\n      const res = await fetch(`/api/materials?scope=${encodeURIComponent(scope)}&archived=1`, { cache: \"no-store\" });\n      const d = await res.json();\n      if (res.ok) setArchivedSources(d.sources || []);\n    } catch { /* noop */ }\n  }, [scope]);\n\n  // scope 전환: 이전 룸 큐를 store에 저장 + 새 룸 큐를 store에서 복원(없으면 빈 큐). 목록·메모는 초기화.\n  useEffect(() => {\n    const prev = matPrevScope.current;\n    if (prev !== scope) {\n      if (matRestored.current) stagedStore.current[prev] = stagedRef.current; // 복원 완료 후에만 이전 큐 저장\n      matPrevScope.current = scope;\n    }\n    setSources([]); setErr(null); setDelNote(null); setArchivedSources([]); setShowArchived(false); setModelUserPicked(false);\n    // ★룸 전환 시 업로드 토글 초기화★ — 회의록·화자구분·자동전환·익명이 다른 룸으로 새지 않게(버그 수정).\n    setDiarize(false); setDiarizeSwitched(false); preDiarizeRef.current = null; setAnonUpload(false);\n    setStaged(normalizeStaged(stagedStore.current[scope] || []));\n    load();\n  }, [scope, load]);\n\n  // ★마운트 복원★ — 저장된 모드 + scope별 큐 맵을 ref로 적재하고 현재 scope 큐 복원.\n  //   (scope 효과 뒤 선언 → 마운트 시 scope 효과의 빈 큐를 덮어쓴다. store는 ref라 동기 적재되어\n  //    이후 AppShell이 scope를 바꿔도 scope 효과가 그 scope의 큐를 정확히 복원한다.)\n  useEffect(() => {\n    try {\n      const raw = sessionStorage.getItem(\"llmwiki_materials_v1\");\n      if (raw) {\n        const d = JSON.parse(raw);\n        if (d.mode === \"llm\" || d.mode === \"raw\") setUploadMode(d.mode);\n        if (d.staged && typeof d.staged === \"object\") stagedStore.current = d.staged;\n      }\n    } catch { /* noop */ }\n    matRestored.current = true;\n    setStaged(normalizeStaged(stagedStore.current[scope] || []));\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n  // 영속화 — 현재 scope 큐를 store에 반영 후 SS 저장(첫 빈 저장은 건너뜀). scope는 클로저 최신값.\n  useEffect(() => {\n    if (matFirstSave.current) { matFirstSave.current = false; return; }\n    stagedStore.current[scope] = staged;\n    try { sessionStorage.setItem(\"llmwiki_materials_v1\", JSON.stringify({ mode: uploadMode, staged: stagedStore.current })); } catch { /* noop */ }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [staged, uploadMode]);\n\n  // ★대기↔최근자료 정합성★ — 대기 항목은 그 소스가 ★아직 살아있고 미처리(PENDING)★일 때만 유지한다.\n  //   소스가 처리됐거나(RUNNING·반영됨·검토대기 등) ★삭제·교체돼 사라졌으면★(분석 시 dedup이 원본을 지우고\n  //   새로 만들어 sourceId가 바뀜) 대기에서 제거 → '분석된 파일이 대기에 그대로 남는' 중복을 막는다.\n  //   (소스 생성 직후 staging 중인 항목은 sourceId 없음 → 유지.)\n  useEffect(() => {\n    if (!sources.length) return;\n    setStaged((prev) => {\n      const next = prev.filter((s) => {\n        if (!s.sourceId) return true; // 업로드(staging) 진행 중 — 유지\n        const src = sources.find((x) => x.id === s.sourceId);\n        return !!src && src.status === \"PENDING\"; // 살아있고 아직 미처리일 때만 대기 유지\n      });\n      return next.length === prev.length ? prev : next;\n    });\n  }, [sources]);\n\n  // 교차 갱신: 위키 배너에서 [AI로 분석]하거나 다른 경로로 데이터가 바뀌면 목록 재조회(초기 마운트는 건너뜀).\n  const firstRev = useRef(true);\n  useEffect(() => {\n    if (firstRev.current) { firstRev.current = false; return; }\n    load(); if (showArchived) loadArchived();\n  }, [dataRev]); // eslint-disable-line react-hooks/exhaustive-deps\n\n  // ★자료 탭으로 (다시) 들어올 때 자동 새로고침★ — 다른 세션·경로로 바뀐 최근 자료/상태가 탭만 바꾸면 바로 보이게\n  //   한다(WikiTab과 동일 패턴, 수동 새로고침 불필요). hidden true→false 전이에만 발동.\n  const matPrevHidden = useRef(hidden);\n  useEffect(() => {\n    if (matPrevHidden.current && !hidden) { load(); if (showArchived) loadArchived(); }\n    matPrevHidden.current = hidden;\n  }, [hidden, load]); // eslint-disable-line react-hooks/exhaustive-deps\n\n  async function openWiki(s: SourceItem) {\n    try {\n      const res = await fetch(`/api/materials/${s.id}/pages`);\n      const d = await res.json();\n      // ★자료 자체의 주제(topic) 페이지로 이동★ — 분석이 만든 개념/개체 중 첫 항목이 아니라, 그 자료를 정리한\n      //   topics/ 페이지를 우선한다(없으면 첫 페이지로 폴백).\n      const paths: string[] = d.paths ?? [];\n      const target = paths.find((p) => /\\/topics\\//.test(p)) ?? paths[0];\n      if (res.ok && target) onOpenWiki(target);\n      else setDelNote(`「${s.title}」에서 생성된 위키 페이지를 찾지 못했습니다.`);\n    } catch {\n      setDelNote(\"위키 페이지를 찾지 못했습니다.\");\n    }\n  }\n\n  // 자료 아카이브(소프트 삭제) — 목록에서 숨기고 아카이브로. 원본·위키 페이지는 보존. 룸 관리자만.\n  async function archiveSource(s: SourceItem) {\n    if (!await confirmDialog(`원본 「${s.title}」을(를) 아카이브할까요?\\n목록에서 숨겨지며, 아카이브에서 복원하거나 영구삭제할 수 있습니다. (위키 페이지는 그대로 유지됩니다)`)) return;\n    setDeleting(s.id); setDelNote(null);\n    try {\n      const res = await fetch(`/api/materials/${s.id}`, { method: \"PATCH\", headers: { \"content-type\": \"application/json\" }, body: JSON.stringify({ action: \"archive\" }) });\n      const d = await res.json();\n      if (!res.ok) throw new Error(d.error || \"아카이브에 실패했습니다.\");\n      setDelNote(`「${s.title}」 아카이브됨`);\n      await Promise.all([load(), loadArchived()]);\n    } catch (e) {\n      setDelNote(`오류: ${toUserMessage(e)}`);\n    } finally {\n      setDeleting(null);\n    }\n  }\n\n  // 아카이브에서 복원 — 다시 활성 목록으로.\n  async function restoreSource(s: SourceItem) {\n    setDeleting(s.id); setDelNote(null);\n    try {\n      const res = await fetch(`/api/materials/${s.id}`, { method: \"PATCH\", headers: { \"content-type\": \"application/json\" }, body: JSON.stringify({ action: \"restore\" }) });\n      const d = await res.json();\n      if (!res.ok) throw new Error(d.error || \"복원에 실패했습니다.\");\n      setDelNote(`「${s.title}」 복원됨`);\n      await Promise.all([load(), loadArchived()]);\n    } catch (e) {\n      setDelNote(`오류: ${toUserMessage(e)}`);\n    } finally {\n      setDeleting(null);\n    }\n  }\n\n  // 영구삭제 — 원본·사이드카 제거 + 인용 위키 페이지에 '출처 소실' 표시. 되돌릴 수 없음.\n  async function purgeSource(s: SourceItem) {\n    if (!await confirmDialog(`원본 「${s.title}」을(를) 영구삭제할까요? 되돌릴 수 없습니다.\\n매핑된 위키 페이지는 보존되며 '출처 소실' 표시가 남습니다.`)) return;\n    setDeleting(s.id); setDelNote(null);\n    try {\n      const res = await fetch(`/api/materials/${s.id}`, { method: \"DELETE\" });\n      const d = await res.json();\n      if (!res.ok) throw new Error(d.error || \"삭제에 실패했습니다.\");\n      setDelNote(`「${s.title}」 영구삭제됨 · 위키 ${d.annotated}곳에 출처 소실 표시`);\n      await Promise.all([load(), loadArchived()]);\n      onDataChanged?.(); // 위키 페이지에 흔적 → 트리/리더 갱신\n    } catch (e) {\n      setDelNote(`오류: ${toUserMessage(e)}`);\n    } finally {\n      setDeleting(null);\n    }\n  }\n\n  // 파일 선택/드롭 → ★스테이징만★(자동 처리 안 함). 사용자가 모드 고르고 [처리 시작]을 눌러야 인제스트.\n  function onPickFile(e: React.ChangeEvent<HTMLInputElement>) {\n    const files = e.target.files ? [...e.target.files] : [];\n    e.target.value = \"\";\n    if (files.length) void stageFiles(files);\n  }\n  function onDrop(e: React.DragEvent) {\n    e.preventDefault();\n    setDragOver(false);\n    const files = e.dataTransfer?.files ? [...e.dataTransfer.files] : [];\n    if (files.length) void stageFiles(files);\n  }\n\n  // 스테이징 결과 해석: 중복/미분석은 더 처리할 수 없으니 'skip'(완료), 그 외는 'staged'(처리 대기).\n  function toStaged(prev: Staged, data: { status?: string; sourceId?: number; hasText?: boolean; unanalyzed?: boolean; recommended?: Reco }): Staged {\n    if (data.status === \"SKIPPED_DUP\") return { ...prev, status: \"skip\", note: \"중복(건너뜀)\", reco: data.recommended };\n    if (data.unanalyzed || !data.sourceId) return { ...prev, status: \"skip\", note: \"원본 보존(미분석)\", reco: data.recommended };\n    return { ...prev, status: \"staged\", sourceId: data.sourceId, hasText: !!data.hasText, reco: data.recommended };\n  }\n\n  // 파일을 스테이징(추출·보관만, 토큰 0). 허용 안 되는 확장자는 에러로 표시.\n  async function stageFiles(files: File[]) {\n    const allowExt = (n: string) => !policy || policy.exts.includes(extOf(n));\n    const ok = files.filter((f) => allowExt(f.name));\n    const blocked = files.filter((f) => !allowExt(f.name));\n    setErr(null);\n    const base = Date.now();\n    setStaged((prev) => [\n      ...prev,\n      ...blocked.map((f, i) => ({ key: base + 9000 + i, sourceId: null, name: f.name, hasText: false, status: \"error\" as const, note: policy?.note || \"지원하지 않는 형식\" })),\n      ...ok.map((f, i) => ({ key: base + i, sourceId: null, name: f.name, hasText: false, status: \"staging\" as const })),\n    ]);\n    const single = ok.length === 1 ? (title.trim() || undefined) : undefined;\n    for (let i = 0; i < ok.length; i++) {\n      const key = base + i;\n      const f = ok[i];\n      try {\n        // ★diarize는 업로드가 아니라 [처리 시작](분석) 때 적용★ — 업로드 전사는 항상 Groq 평문(빠른 미리보기).\n        // 모델 미전송 → 서버가 자동 모델 기준 게이팅.\n        let res: Response;\n        if (f.size > 25 * 1024 * 1024) {\n          // ★대용량(>25MB): raw-body 스트리밍★ — 서버가 RAM 통적재 없이 디스크로 흘려 받는다(§11.2).\n          //   File(디스크 기반 Blob)을 body로 보내면 클라도 메모리 사본을 안 만든다. 메타는 쿼리스트링.\n          const qs = new URLSearchParams({ scope, filename: f.name, mime: f.type || \"\" });\n          if (single) qs.set(\"title\", single);\n          if (anonUpload) qs.set(\"anonymous\", \"true\");\n          res = await fetch(`/api/materials?${qs.toString()}`, {\n            method: \"POST\", headers: { \"content-type\": \"application/octet-stream\" }, body: f,\n          });\n        } else {\n          const fd = new FormData();\n          fd.append(\"scope\", scope);\n          if (single) fd.append(\"title\", single);\n          if (anonUpload) fd.append(\"anonymous\", \"true\");\n          fd.append(\"file\", f);\n          res = await fetch(\"/api/materials\", { method: \"POST\", body: fd });\n        }\n        const data = await res.json();\n        if (!res.ok) { setStaged((p) => p.map((x) => (x.key === key ? { ...x, status: \"error\", note: data.error || \"업로드 실패\" } : x))); continue; }\n        setStaged((p) => p.map((x) => (x.key === key ? toStaged(x, data) : x)));\n      } catch (e) {\n        setStaged((p) => p.map((x) => (x.key === key ? { ...x, status: \"error\", note: toUserMessage(e) } : x)));\n      }\n    }\n    if (single) setTitle(\"\");\n  }\n\n  // 직접 입력 텍스트를 스테이징(대기열에 추가).\n  async function stageText() {\n    if (busy || !text.trim()) return;\n    setErr(null);\n    const key = Date.now();\n    const name = title.trim() || text.trim().split(\"\\n\")[0].slice(0, 40) || \"직접 입력\";\n    setStaged((prev) => [...prev, { key, sourceId: null, name, hasText: true, status: \"staging\" }]);\n    try {\n      const res = await fetch(\"/api/materials\", {\n        method: \"POST\", headers: { \"content-type\": \"application/json\" },\n        body: JSON.stringify({ scope, title: title.trim() || undefined, text, anonymous: anonUpload }),\n      });\n      const data = await res.json();\n      if (!res.ok) { setStaged((p) => p.map((x) => (x.key === key ? { ...x, status: \"error\", note: data.error || \"추가 실패\" } : x))); return; }\n      setStaged((p) => p.map((x) => (x.key === key ? toStaged(x, data) : x)));\n      setText(\"\"); setTitle(\"\");\n    } catch (e) {\n      setStaged((p) => p.map((x) => (x.key === key ? { ...x, status: \"error\", note: toUserMessage(e) } : x)));\n    }\n  }\n\n  // 스테이징된 소스를 ★선택한 모드★로 처리. raw는 텍스트가 있을 때만, 없으면(PDF·이미지) 자동으로 llm.\n  async function runProcess(sourceId: number, hasText: boolean, signal?: AbortSignal, modelOverride?: string, reTranscribe?: boolean): Promise<{ ok: boolean; note: string; queued?: boolean }> {\n    const startedAt = Date.now();\n    const fellBack = uploadMode === \"raw\" && !hasText;\n    const effMode = uploadMode === \"raw\" && hasText ? \"raw\" : \"llm\";\n    // 사용자가 ★직접 고른 경우만★ 모델 전송 — 아니면 undefined로 보내 서버가 ★자료 형식 기반 자동 선택★.\n    // diarize(화자 구분)는 ★처리 시작(분석) 시점★에 적용 — 음성·영상이면 분석 라우트가 raw를 Gemini로 재전사(화자1/2).\n    const body = effMode === \"raw\" ? { mode: \"raw\" } : { mode: \"llm\", model: modelOverride ?? (modelUserPicked ? (analyzeModelId || undefined) : undefined), diarize: diarize || undefined, reTranscribe: reTranscribe || undefined };\n    const res = await fetch(`/api/materials/${sourceId}/analyze`, {\n      method: \"POST\", headers: { \"content-type\": \"application/json\" }, body: JSON.stringify(body), signal,\n    });\n    const data = await res.json();\n    const took = effMode === \"raw\" ? \"\" : ` · ${fmtElapsed(Date.now() - startedAt)}`; // 완료/실패 시 최종 경과 시간\n    if (!res.ok) {\n      const e = String(data.error || \"\");\n      // 무료 모델 한도를 넘는 큰 자료 → 기술적 오류 대신 ★행동 안내★(원본 그대로 / 더 작게).\n      if (/\\b413\\b|too large|too many tokens|tokens per minute|\\bTPM\\b|context length|maximum context|RESOURCE_EXHAUSTED|한도/i.test(e)) {\n        return { ok: false, note: \"자료 크기가 커서 분석할 수 없어요(무료 모델 한도 초과). 이렇게 큰 자료는 ‘원본 그대로 추가’로 올리면 분석 없이 그대로 저장·검색됩니다. 분석이 꼭 필요하면 핵심만 텍스트(.md·.txt)로 추려 더 작게 나눠 올려주세요.\" + took };\n      }\n      return { ok: false, note: `${toUserMessage(e, \"처리에 실패했어요.\")}${took}` };\n    }\n    if (effMode === \"raw\") return { ok: true, note: \"원본 그대로 추가됨 · 토큰 0\" };\n    // ★L2 비동기★: 큐에 적재됨 — 즉시 반환(워커가 백그라운드 처리, 목록 폴링이 진행을 따라간다).\n    if (data.queued) return { ok: true, queued: true, note: \"분석 예약됨 · 백그라운드에서 처리 중\" }; // ★queued=클라 측정 무의미(실제 처리는 워커)→소요는 서버 durationMs로★\n    const sw = data.fallback ? \" · 백업 모델로 자동 전환됨\" : \"\";\n    const md = data.usedModel ? ` · 모델 ${modelLabel(data.usedModel)}` : \"\";\n    const prefix = fellBack ? \"텍스트 없음 → 분석함 · \" : \"\";\n    const base = data.status === \"NEEDS_REVIEW\" ? \"검토 대기\" : \"분석 반영됨\";\n    return { ok: true, note: prefix + base + md + sw + took };\n  }\n\n  // [처리 시작] — 대기(staged) 항목을 순차 처리(위키는 단일 라이터). 끝나면 목록·트리 갱신.\n  async function runStaged() {\n    if (busy) return;\n    const qScope = scope; // ★처리를 시작한 룸★ 고정(중간에 룸을 옮겨도 busy는 이 룸에만)\n    const todo = staged.filter((s) => s.status === \"staged\" && s.sourceId);\n    if (!todo.length) return;\n    // ★유료(종량 과금) 경고★ — 선택/자동추천된 분석 모델 중 OpenAI·Claude API가 있으면 확인.\n    if (uploadMode !== \"raw\") {\n      const usesPaid = todo.some((it) => isPaidProvider(analyzeModels.find((m) => m.id === (modelUserPicked ? analyzeModelId : (it.reco?.model ?? analyzeModelId)))?.provider));\n      if (usesPaid && !await confirmDialog(\"선택/추천된 분석 모델 중 ★사용량만큼 과금★되는 유료 모델(OpenAI·Claude API)이 있습니다. 계속할까요?\")) return;\n    }\n    setBusyFor(qScope, true); setErr(null);\n    try {\n      for (const it of todo) {\n        // 표시 모델: 직접 고름이면 그 모델, 자동이면 ★서버가 고를 모델(업로드 시 reco)★.","numLines":675,"startLine":1,"totalLines":1155,"truncatedByTokenCap":true}},"sourceToolAssistantUUID":"aefbaa45-362c-411e-aeda-c19fd596d95c","userType":"external","entrypoint":"cli","cwd":"E:\\llm-wiki","sessionId":"6b03d3cf-704b-46f4-952d-418e6244ad85","version":"2.1.195","gitBranch":"feat/backlog-chunked-and-storage","slug":"serene-singing-papert"}
