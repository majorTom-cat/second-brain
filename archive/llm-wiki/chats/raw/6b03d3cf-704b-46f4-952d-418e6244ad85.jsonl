{"parentUuid":"d66dbf9d-9572-43f7-ae33-e3e69cceb0b4","isSidechain":false,"promptId":"72c47ca9-455c-407a-8764-3ca32f2b9ca5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012z9GgnwNNqGeqRpJWDW4Fm","type":"tool_result","content":"The file E:\\llm-wiki\\lib\\stt.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"uuid":"d849142e-c8b2-463a-afc4-fabd162bf89e","timestamp":"2026-06-28T11:19:25.529Z","toolUseResult":{"filePath":"E:\\llm-wiki\\lib\\stt.ts","oldString":"export async function transcribe(\n  buf: Buffer,\n  filename: string,\n  mime: string,\n  opts?: { diarize?: boolean; onProgress?: (done: number, total: number) => void },\n): Promise<ExtractResult> {","newString":"export async function transcribe(\n  buf: Buffer,\n  filename: string,\n  mime: string,\n  opts?: { diarize?: boolean; onProgress?: (done: number, total: number) => void; geminiOptIn?: boolean },\n): Promise<ExtractResult> {","originalFile":"import type { ExtractResult } from \"./extract\";\nimport { groqTranscribe, openaiCompatEnabled, groqSttModel, GROQ_STT_MAX_BYTES, type TranscribeResult } from \"./openai-compat\";\nimport { geminiTranscribe, geminiEnabled } from \"./gemini\";\nimport { ffmpegAvailable, extractAudioMp3, splitAudioMp3 } from \"./convert\";\nimport { collapseTranscriptLoops, oversizeAudioNeedsSplit } from \"./transcript\";\n\n// 긴 음성 청크 전사(L1) — Groq 25MB 한도를 ffmpeg 분할로 우회. 10분 청크(16kHz mono 64k ≈ 4.8MB), 제한 병렬.\nconst STT_CHUNK_SEC = 600;\nconst STT_CHUNK_CONCURRENCY = 3;\n\n/** 청크 전사 결과들을 순서대로 이어붙임(L1). 텍스트는 빈 줄로 결합, duration 합산. 순수(테스트용). */\nexport function stitchTranscripts(parts: { text: string; durationSec?: number }[]): { text: string; durationSec?: number } {\n  const text = parts.map((p) => (p.text || \"\").trim()).filter(Boolean).join(\"\\n\\n\");\n  const dur = parts.reduce((s, p) => s + (p.durationSec ?? 0), 0);\n  return { text, durationSec: dur > 0 ? dur : undefined };\n}\n\n/** 큰 오디오를 ffmpeg로 분할해 청크별 Groq 전사 후 이어붙임. 분할/전부 실패면 null(폴백). 일부 실패는 부분 보존.\n *  onProgress(done,total)=청크 완료마다 호출(J 진행률 — '전사 k/N'). */\nasync function groqTranscribeChunked(buf: Buffer, filename: string, onProgress?: (done: number, total: number) => void): Promise<TranscribeResult | null> {\n  const split = await splitAudioMp3(buf, STT_CHUNK_SEC);\n  if (!split || !split.length) return null;\n  const chunks: Buffer[] = split; // 비-null 확정(클로저 안에서도 narrowing 유지)\n  const base = filename.replace(/\\.[^.]+$/, \"\");\n  const results: (TranscribeResult | null)[] = new Array(chunks.length).fill(null);\n  let next = 0;\n  let done = 0;\n  onProgress?.(0, chunks.length); // 시작 표시\n  async function worker() {\n    while (next < chunks.length) {\n      const i = next++;\n      try { results[i] = await groqTranscribe(chunks[i], `${base}.part${String(i).padStart(4, \"0\")}.mp3`, \"audio/mpeg\"); }\n      catch (e) { console.warn(`[stt] 청크 ${i + 1}/${chunks.length} 전사 실패: ${String(e)}`); results[i] = null; }\n      onProgress?.(++done, chunks.length); // 병렬이라도 완료 누적(순서 무관)\n    }\n  }\n  await Promise.all(Array.from({ length: Math.min(STT_CHUNK_CONCURRENCY, chunks.length) }, worker));\n  const ok = results.filter((r): r is TranscribeResult => !!r); // 순서 유지(인덱스 순)\n  if (!ok.length) return null;\n  const s = stitchTranscripts(ok);\n  return { text: s.text, durationSec: s.durationSec, model: ok[0].model };\n}\n\n// ffmpeg 선행이 필요한 컨테이너 — Groq가 직접 못 받는 영상(.mov 등). FFMPEG_CMD 설정 시에만 처리(5c).\n//   (STT_EXTS=Groq 직수 컨테이너는 extract.ts. 여기 set은 업로드 게이팅·dispatch가 import.)\nexport const STT_FFMPEG_EXTS = [\"mov\", \"mkv\", \"avi\", \"m4v\", \"wmv\", \"flv\"];\n\nfunction extLower(name: string): string {\n  return (name || \"\").toLowerCase().match(/\\.([a-z0-9]+)$/)?.[1] ?? \"\";\n}\n\n// 음성·영상 전사(STT) 오케스트레이션 — 추출 레이어(lib/extract.ts)의 한 추출기.\n// 전사문을 정규화 markdown(ExtractResult.text)으로 돌려주면, 그 뒤는 기존 ingestText가 처리한다.\n// 설계: docs/PLAN-audio-video-ingest.md.\n//   5a = Groq 기본. 5b = Groq 실패(429·오류) 시 Gemini 폴백(★Gemini는 외부 전송+무료=학습 → UI 경고는 extractor가\n//        'gemini-'로 시작하는지로 판별·표시). ★전사 모델 ≠ 분석 모델: 여기 텍스트는 .txt와 동일 취급 → 분석은 별도 선택.\n\n// Gemini STT 폴백 허용 여부(기본 on). ★외부학습 차단 정책★이면 STT_GEMINI_FALLBACK=false로 끈다(docs §E).\nexport function sttGeminiFallback(): boolean {\n  return process.env.STT_GEMINI_FALLBACK !== \"false\";\n}\n\n// ★J 전사 비동기화★(기본 OFF=현행 동기). ON이면 업로드 시 전사를 ★건너뛰고★(raw만 스테이징) [분석] 단계에서\n//   워커가 raw에서 전사 → 진행률·타이머·상태가 전 구간 일관(긴 음성 업로드 무진행 대기 해소). ship-dark.\nexport function sttAsync(): boolean {\n  return process.env.STT_ASYNC === \"true\";\n}\n// 전사 공급자 한도(429) 오류 판별(순수) — 한도는 일시적이라 폴백보다 '재처리'가 정답.\nexport function isRateLimitError(msg: string): boolean {\n  return /\\b429\\b|rate limit|한도 초과|RESOURCE_EXHAUSTED|quota/i.test(msg);\n}\n\n/** 초 → \"m:ss\"(헤더 표기용). 없거나 비정상이면 빈 문자열. */\nexport function fmtDuration(sec?: number): string {\n  if (!sec || !Number.isFinite(sec) || sec < 0) return \"\";\n  const m = Math.floor(sec / 60);\n  const s = Math.floor(sec % 60);\n  return `${m}:${String(s).padStart(2, \"0\")}`;\n}\n\n/**\n * 전사 텍스트 → 정규화 ExtractResult. 네트워크 없음(순수) — 테스트·재사용 가능.\n * quality는 전사문 글자수 기준(기존 extract 패턴). extractor는 공급자 포함 전체 라벨(예: groq-... / gemini-...).\n */\nexport function buildTranscriptResult(\n  text: string,\n  filename: string,\n  durationSec: number | undefined,\n  extractor: string,\n): ExtractResult {\n  const raw = (text || \"\").trim();\n  // ★전사 품질 가드(§F)★: 환각 반복 루프를 1주기로 접어 garbage가 분석에 들어가지 않게 한다(앞부분 정상 보존).\n  //   루프 없으면 clean===raw(불변·회귀0). 접혔으면 meta.loopCollapsed로 UI 배지/검토 신호.\n  const { text: clean, info: loop } = collapseTranscriptLoops(raw);\n  const len = clean.replace(/\\s/g, \"\").length;\n  const dur = fmtDuration(durationSec);\n  const header = `## 음성 텍스트 변환 (${filename}${dur ? `, ${dur}` : \"\"})`;\n  return {\n    text: clean ? `${header}\\n\\n${clean}` : \"\",\n    quality: len >= 40 ? \"full\" : len > 0 ? \"partial\" : \"none\", // 글자수 기준(기존) — 루프 가드는 본문 정리+마커로 처리\n    extractor,\n    meta: { durationSec, transcribed: true, ...(loop.collapsed ? { loopCollapsed: loop.removed, loopPhrase: loop.phrase } : {}) },\n  };\n}\n\n/**\n * 오디오/영상 버퍼 → 전사 ExtractResult. ★Groq 기본 → Gemini 폴백★.\n * - 둘 다 키 없으면 quality:'none'(graceful 미분석 — 호출측 dispatch가 흡수).\n * - Groq 실패(429·오류)면 Gemini로 폴백(가능할 때). 전사 오류는 throw → dispatch try/catch가 'none'+error로 흡수.\n */\nexport async function transcribe(\n  buf: Buffer,\n  filename: string,\n  mime: string,\n  opts?: { diarize?: boolean; onProgress?: (done: number, total: number) => void },\n): Promise<ExtractResult> {\n  const groq = openaiCompatEnabled();\n  const gem = geminiEnabled();\n  if (!groq && !gem) {\n    // 전사 공급자 미설정 → 원본은 보존되고 '미분석'으로 남는다(4j 패턴).\n    return { text: \"\", quality: \"none\", extractor: \"stt-unconfigured\" };\n  }\n  // 영상(.mov 등)·대용량(>25MB)은 ffmpeg로 오디오만 추출해 한도·비용 회피(5c). 미설정/실패 시 원본 그대로 시도.\n  const a = await prepareAudio(buf, filename, mime);\n  // ★G★: ffmpeg로도 못 줄인 큰 음성(>한도)은 ★조용한 Gemini inline 폴백=환각★을 막고 분할 업로드를 안내한다.\n  //   프로드는 Dockerfile ffmpeg 보유라 미발동. (geminiOptIn=false 기본 — 향후 업로드 폼 토글로 명시 허용 가능.)\n  if (oversizeAudioNeedsSplit(a.buf.byteLength, GROQ_STT_MAX_BYTES, ffmpegAvailable(), false)) {\n    throw new Error(\"긴 음성(25MB 초과)을 처리할 변환기(ffmpeg)가 서버에 없습니다. 음성을 더 짧게 나눠 올려주세요 — 큰 음성을 그대로 외부(Gemini)로 보내면 전사가 망가질 수 있어 막았습니다.\");\n  }\n  // ★화자 구분(diarize) 요청 → Gemini 전용★(Groq Whisper는 화자분리 미지원). Gemini 없으면 아래 일반 경로(Groq 평문, 구분 없음).\n  if (opts?.diarize && gem) {\n    const g = await geminiTranscribe(a.buf, a.filename, a.mime, { diarize: true });\n    return buildTranscriptResult(g.text, filename, g.durationSec, `gemini-${g.model}`);\n  }\n  // 1순위: Groq(무료·초고속). ★25MB 초과 + ffmpeg 있으면 청크 분할 전사(L1)★.\n  if (groq) {\n    const chunked = a.buf.byteLength > GROQ_STT_MAX_BYTES && ffmpegAvailable();\n    try {\n      let r: TranscribeResult | null;\n      if (chunked) {\n        r = await groqTranscribeChunked(a.buf, a.filename, opts?.onProgress);\n      } else {\n        // 비청크(≤한도) 단일 전사도 진행 표시('전사 중 1/1') — J 상태 일관(작은 음성은 빠르게 지나감).\n        opts?.onProgress?.(0, 1);\n        r = await groqTranscribe(a.buf, a.filename, a.mime);\n        opts?.onProgress?.(1, 1);\n      }\n      if (r) return buildTranscriptResult(r.text, filename, r.durationSec, `groq-${r.model}${chunked ? \"-chunked\" : \"\"}`);\n      console.warn(\"[stt] Groq 청크 전사가 결과를 못 냄 → 폴백 시도\"); // r=null(분할/전부 실패)\n    } catch (e) {\n      const msg = String(e);\n      // ★Groq 한도(429)는 일시적★ — Gemini 폴백은 긴 음성에서 잘림·환각으로 ★쓰레기 전사★를 만든다(실측).\n      //   폴백하지 말고 명확히 실패시켜 '잠시 후 재처리'를 유도(Groq 한도는 수~십분 내 리셋). (docs §E)\n      if (isRateLimitError(msg)) {\n        throw new Error(\"음성 텍스트 변환 한도(Groq 무료 등급, 시간당 약 2시간)를 초과했습니다. 잠시 후(약 10분) [재처리]하면 정상 변환됩니다. 급하면 음성을 더 짧게 잘라 올려주세요.\");\n      }\n      if (!gem || !sttGeminiFallback()) throw e; // 폴백 없음/비활성(STT_GEMINI_FALLBACK=false) → 그대로 전파\n      console.warn(`[stt] Groq 전사 실패 → Gemini 폴백: ${msg}`);\n    }\n    if (!gem || !sttGeminiFallback()) return { text: \"\", quality: \"none\", extractor: \"stt-failed\" }; // Groq뿐/폴백 비활성 → 미분석 보존\n  }\n  // 폴백(또는 Groq 미설정·Gemini만): Gemini. ★외부 전송+무료=학습 → extractor 'gemini-'로 UI 경고 판별.\n  const g = await geminiTranscribe(a.buf, a.filename, a.mime);\n  return buildTranscriptResult(g.text, filename, g.durationSec, `gemini-${g.model}`);\n}\n\n/** 영상/대용량이면 ffmpeg로 오디오(mp3)만 추출. ffmpeg 미설정/실패면 원본을 그대로 반환(graceful). */\nasync function prepareAudio(buf: Buffer, filename: string, mime: string): Promise<{ buf: Buffer; filename: string; mime: string }> {\n  const ext = extLower(filename);\n  const needFfmpeg = STT_FFMPEG_EXTS.includes(ext) || mime.startsWith(\"video/\") || buf.byteLength > GROQ_STT_MAX_BYTES;\n  if (needFfmpeg && ffmpegAvailable()) {\n    const audio = await extractAudioMp3(buf, ext || \"bin\");\n    if (audio && audio.byteLength > 0) {\n      return { buf: audio, filename: filename.replace(/\\.[^.]+$/, \"\") + \".mp3\", mime: \"audio/mpeg\" };\n    }\n  }\n  return { buf, filename, mime };\n}\n\n/** 현재 STT(전사) 사용 가능 여부 — uploadPolicy 게이팅용. Groq 또는 Gemini 키. */\nexport function sttAvailable(): boolean {\n  return openaiCompatEnabled() || geminiEnabled();\n}\n\n// 전사 소스 판별은 ★클라이언트 공용★이라 순수 모듈로 분리해 re-export(서버 import `from \"./stt\"`는 그대로 동작).\n//   (이 파일은 convert.ts→node:child_process를 끌어 클라 번들에 못 들어가므로, 순수 함수는 ./transcript에 둔다.)\nexport { isTranscribedExtractor } from \"./transcript\";\n\n/** 진단·라벨용 현행 1순위 전사 모델명. */\nexport function sttModelLabel(): string {\n  return openaiCompatEnabled() ? `groq-${groqSttModel()}` : \"gemini\";\n}\n","structuredPatch":[{"oldStart":112,"oldLines":7,"newStart":112,"newLines":7,"lines":["   buf: Buffer,","   filename: string,","   mime: string,","-  opts?: { diarize?: boolean; onProgress?: (done: number, total: number) => void },","+  opts?: { diarize?: boolean; onProgress?: (done: number, total: number) => void; geminiOptIn?: boolean },"," ): Promise<ExtractResult> {","   const groq = openaiCompatEnabled();","   const gem = geminiEnabled();"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"d66dbf9d-9572-43f7-ae33-e3e69cceb0b4","userType":"external","entrypoint":"cli","cwd":"E:\\llm-wiki","sessionId":"6b03d3cf-704b-46f4-952d-418e6244ad85","version":"2.1.195","gitBranch":"feat/backlog-chunked-and-storage","slug":"serene-singing-papert"}
