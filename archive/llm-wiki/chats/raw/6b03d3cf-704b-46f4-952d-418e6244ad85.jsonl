umber.isInteger(size) || size <= 0) return NextResponse.json({ error: \"유효한 파일 크기(size)가 필요합니다.\" }, { status: 400 });\n    try {\n      await assertScopeAllowed(user, scope); // ACL 강제지점3 — 업로드 시작 전 거부(큰 전송 차단)\n    } catch {\n      return NextResponse.json({ error: \"접근 권한이 없는 scope입니다.\" }, { status: 403 });\n    }\n    // 빠른 실패용 용량 precheck(최종 형식·모델 게이팅은 finalize의 stageBuffer에서). 음성·영상 100MB / 그 외 500MB.\n    const ext = extOf(filename);\n    const cap = capBytesFor(ext, mime);\n    if (size > cap) {\n      const isAV = isAudioVideoExt(ext, mime);\n      return NextResponse.json({ error: `파일은 ${Math.round(cap / 1024 / 1024)}MB 이하만 가능합니다.${isAV ? \" 더 긴 음성·영상은 잘라서 올려주세요.\" : \"\"}` }, { status: 413 });\n    }\n    const meta = await createChunkSession({\n      userId: user.id, scope, filename, mime,\n      title: String(body.title || \"\"), anonymous: Boolean(body.anonymous), geminiOptIn: Boolean(body.geminiOptIn), size,\n    });\n    return NextResponse.json({ uploadId: meta.uploadId, chunkSize: CHUNK_BYTES, received: 0 });\n  }\n\n  if (action === \"finalize\") {\n    const uploadId = String(body.uploadId || \"\");\n    const meta = await getChunkSession(uploadId).catch(() => null);\n    if (!meta) return NextResponse.json({ error: \"업로드 세션을 찾을 수 없습니다.\" }, { status: 404 });\n    if (meta.userId !== user.id) return NextResponse.json({ error: \"이 업로드의 소유자가 아닙니다.\" }, { status: 403 });\n    try {\n      const { tempPath } = await chunkSessionTempPath(uploadId);\n      const buf = await readFile(tempPath); // 1회 적재(추출·보관용) — 4Gi limit 내(§11.1)\n      const res = await stageBuffer(user, buf, meta.filename, meta.mime, {\n        scope: meta.scope, title: meta.title, anonymous: meta.anonymous, diarize: false, geminiOptIn: meta.geminiOptIn, modelField: \"\",\n      });\n      return res;\n    } catch (err) {\n      return NextResponse.json({ error: String(err) }, { status: 400 });\n    } finally {\n      await cleanupChunkSession(uploadId);\n    }\n  }\n\n  return NextResponse.json({ error: \"알 수 없는 action입니다(create|finalize).\" }, { status: 400 });\n}\n\n// 청크 append — octet-stream 본문, offset은 쿼리스트링. received/complete 반환. gap이면 409 + 현재 received.\nexport async function PATCH(req: Request) {\n  const user = await getSessionUser();\n  if (!user) return NextResponse.json({ error: \"로그인이 필요합니다.\" }, { status: 401 });\n  const u = new URL(req.url);\n  const uploadId = u.searchParams.get(\"uploadId\") || \"\";\n  const offset = Number(u.searchParams.get(\"offset\"));\n  if (!Number.isInteger(offset) || offset < 0) return NextResponse.json({ error: \"유효한 offset이 필요합니다.\" }, { status: 400 });\n  const meta = await getChunkSession(uploadId).catch(() => null);\n  if (!meta) return NextResponse.json({ error: \"업로드 세션을 찾을 수 없습니다(만료되었거나 다른 서버일 수 있어요).\" }, { status: 404 });\n  if (meta.userId !== user.id) return NextResponse.json({ error: \"이 업로드의 소유자가 아닙니다.\" }, { status: 403 });\n  if (!req.body) return NextResponse.json({ error: \"청크 본문이 비었습니다.\" }, { status: 400 });\n  const chunk = Buffer.from(await req.arrayBuffer());\n  try {\n    const { received, complete } = await appendChunk(uploadId, offset, chunk);\n    return NextResponse.json({ received, complete });\n  } catch (err) {\n    if (err instanceof ChunkGapError) {\n      // 클라가 received부터 다시 보내도록 — 재개 지점 동봉(409 Conflict).\n      return NextResponse.json({ error: err.message, received: err.expected }, { status: 409 });\n    }\n    return NextResponse.json({ error: String(err) }, { status: 500 });\n  }\n}\n\n// 진행 상태(재개 지점 확인). 소유자만.\nexport async function GET(req: Request) {\n  const user = await getSessionUser();\n  if (!user) return NextResponse.json({ error: \"로그인이 필요합니다.\" }, { status: 401 });\n  const uploadId = new URL(req.url).searchParams.get(\"uploadId\") || \"\";\n  const meta = await getChunkSession(uploadId).catch(() => null);\n  if (!meta) return NextResponse.json({ error: \"업로드 세션을 찾을 수 없습니다.\" }, { status: 404 });\n  if (meta.userId !== user.id) return NextResponse.json({ error: \"이 업로드의 소유자가 아닙니다.\" }, { status: 403 });\n  return NextResponse.json({ uploadId: meta.uploadId, received: meta.received, size: meta.size, complete: meta.received >= meta.size });\n}\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4506,"cache_read_input_tokens":200003,"output_tokens":2977,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":4506,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":2977,"cache_read_input_tokens":200003,"cache_creation_input_tokens":4506,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4506},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CcVaFEas5uV3RjhpQNedG","type":"assistant","uuid":"5f6c4b2b-d613-4d17-933e-6e189b9add1b","timestamp":"2026-06-28T11:25:12.005Z","userType":"external","entrypoint":"cli","cwd":"E:\\llm-wiki","sessionId":"6b03d3cf-704b-46f4-952d-418e6244ad85","version":"2.1.195","gitBranch":"feat/backlog-chunked-and-storage","slug":"serene-singing-papert"}
