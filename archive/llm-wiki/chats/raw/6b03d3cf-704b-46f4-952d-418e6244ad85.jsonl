{"parentUuid":"21795182-0a86-4ff3-9e5d-f6fe14cc57c4","isSidechain":false,"message":{"model":"claude-opus-4-8","id":"msg_01N9JXEA6AimnUaLk4KWrwxb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011jadHadSGL4s2iLYbFdxpb","name":"Read","input":{"file_path":"E:\\llm-wiki\\app\\api\\materials\\route.ts"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":131,"cache_creation_input_tokens":15295,"cache_read_input_tokens":79680,"output_tokens":1986,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":15295,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":131,"output_tokens":1986,"cache_read_input_tokens":79680,"cache_creation_input_tokens":15295,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15295},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CcVZS4Mu3vNwJidJKAZaW","type":"assistant","uuid":"65fe90b1-a8a7-4861-b91a-bdcc8aaa0813","timestamp":"2026-06-28T11:14:33.338Z","userType":"external","entrypoint":"cli","cwd":"E:\\llm-wiki","sessionId":"6b03d3cf-704b-46f4-952d-418e6244ad85","version":"2.1.195","gitBranch":"feat/backlog-chunked-and-storage","slug":"serene-singing-papert"}
{"parentUuid":"65fe90b1-a8a7-4861-b91a-bdcc8aaa0813","isSidechain":false,"promptId":"72c47ca9-455c-407a-8764-3ca32f2b9ca5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011jadHadSGL4s2iLYbFdxpb","type":"tool_result","content":"1\timport { NextResponse } from \"next/server\";\n2\timport { getSessionUser } from \"@/lib/auth/session\";\n3\timport { assertScopeAllowed, canManageScope, scopeWikiPrefix } from \"@/lib/acl/scope\";\n4\timport { prisma } from \"@/lib/db\";\n5\timport { storeForAnalysis, storeRawOnly } from \"@/lib/ingest\";\n6\timport { extractAsset, SUPPORTED_EXTS, STT_EXTS } from \"@/lib/extract\";\n7\timport { STT_FFMPEG_EXTS, sttAvailable, sttAsync, isTranscribedExtractor } from \"@/lib/stt\";\n8\timport { CONVERT_ONLY_EXTS, libreOfficeAvailable, ffmpegAvailable } from \"@/lib/convert\";\n9\timport { currentUploadPolicy, uploadPolicyForModel, uploadPoliciesForModels } from \"@/lib/uploadPolicy\";\n10\timport { listSelectableModels, resolveIngestModel, ingestModelChoice, recommendIngestModel, pickIngestModel } from \"@/lib/models\";\n11\timport { disabledModelIds, enabledModelIds } from \"@/lib/modelSettings\";\n12\timport { modelFor } from \"@/lib/anthropic\";\n13\timport { avatarForUser } from \"@/lib/avatar\";\n14\timport { terminalJobDurationMs } from \"@/lib/jobDuration\";\n15\timport { streamToTempFile, cleanupTemp, UploadTooLargeError } from \"@/lib/upload-stream\";\n16\timport { readFile } from \"node:fs/promises\";\n17\t\n18\t// 업로드 용량 상한(MB). 음성·영상은 L1 청크 전사로 긴 회의 수용(100), 문서는 L3a 스트리밍으로 상향(200).\n19\t//   ★500MB까지는 L3b 입력 청킹(거대 문서 분석) 후 — docs/PLAN-large-files-and-chunking §11.3.\n20\t//   큰 파일(STREAM_THRESHOLD 초과)은 클라가 raw-body 스트리밍으로 보내 RAM 통적재를 피한다(§11.2).\n21\tconst CAP_MB_AUDIO_VIDEO = 100;\n22\tconst CAP_MB_DOC = 500; // L3a 스트리밍 업로드 + L3b 응축(거대 텍스트 분석 가능) → 500MB. Ingress 512m와 정합.\n23\tconst STREAM_THRESHOLD = 25 * 1024 * 1024; // 이 이상은 raw-body 스트리밍 권장(클라/서버 공통 기준)\n24\t\n25\t// 자료 업로드(텍스트/MD) → 인제스트 → 위키. ACL 강제지점3(인제스트 적용). docs/06·docs/07 §2.\n26\texport const runtime = \"nodejs\";\n27\texport const maxDuration = 600; // 무거운 자료를 추론 모델(claude/codex)이 분석할 때 길어질 수 있음(타임아웃 600초와 정렬)\n28\t\n29\t// GET: scope의 최근 자료 목록\n30\texport async function GET(req: Request) {\n31\t  const user = await getSessionUser();\n32\t  if (!user) return NextResponse.json({ error: \"로그인이 필요합니다.\" }, { status: 401 });\n33\t  const scope = new URL(req.url).searchParams.get(\"scope\") ?? \"\";\n34\t  try {\n35\t    await assertScopeAllowed(user, scope);\n36\t  } catch {\n37\t    return NextResponse.json({ error: \"접근 권한이 없는 scope입니다.\" }, { status: 403 });\n38\t  }\n39\t  const wikiScope = scopeWikiPrefix(scope);\n40\t  // 기본은 활성(archivedAt=null)만. ?archived=1 → 아카이브된 자료(복원/영구삭제 뷰).\n41\t  const showArchived = new URL(req.url).searchParams.get(\"archived\") === \"1\";\n42\t  const sources = await prisma.source.findMany({\n43\t    where: { teamScope: wikiScope, archivedAt: showArchived ? { not: null } : null },\n44\t    orderBy: { id: \"desc\" },\n45\t    take: 30,\n46\t    include: { ingestJobs: { orderBy: { id: \"desc\" }, take: 1 } },\n47\t  });\n48\t  const queryModels = await listSelectableModels(); // ★결제 전 API Claude 숨김★(드롭다운용)\n49\t  const canManage = await canManageScope(user, wikiScope); // 아카이브·영구삭제 권한(룸 관리자)\n50\t  // 소스별 '자동선택 모델'(recoModel)을 동봉 — 셋·기본값을 ★1회만★ 조회하고 동기 코어로 소스마다 계산.\n51\t  const [disabled, explicitOn, fallback] = await Promise.all([disabledModelIds(), enabledModelIds(), ingestModelChoice()]);\n52\t  // 업로더 표시 — id→이름·아바타. ★익명이어도 관리자/룸관리자는 실명 확인★(감사기록 유지), 동료에겐 '익명 기여자'.\n53\t  const uploaderIds = [...new Set(sources.map((s) => s.uploadedBy).filter((x): x is number => x != null))];\n54\t  const uploaders = uploaderIds.length\n55\t    ? await prisma.user.findMany({ where: { id: { in: uploaderIds } }, select: { id: true, name: true, email: true, avatarColor: true, avatarMime: true } })\n56\t    : [];\n57\t  const userById = new Map(uploaders.map((u) => [u.id, u]));\n58\t  const canReveal = canManage || user.role === \"ADMIN\";\n59\t  return NextResponse.json({\n60\t    canManage,\n61\t    sources: sources.map((s) => {\n62\t      let prov: { hasText?: boolean; looksOrganized?: boolean } = {};\n63\t      try { prov = JSON.parse(s.provenance || \"{}\"); } catch { /* */ }\n64\t      const transcribed = isTranscribedExtractor(s.extractor); // 전사 소스 = byteSize 휴리스틱 제외 + Groq 분석 기본\n65\t      return {\n66\t        id: s.id,\n67\t        title: s.title,\n68\t        type: s.type,\n69\t        createdAt: s.createdAt.toISOString(),\n70\t        archived: Boolean(s.archivedAt),\n71\t        rawEvicted: Boolean(s.rawEvictedAt), // L4: 원본 정리됨(원본 열기 비활성·배지) — 지식·추출본은 유지\n72\t\n73\t        // 잡이 있으면 그 상태, 미분석 보존(UNANALYZED)이면 그대로, 그 외 잡 없는 신규 소스 = '분석 대기'(PENDING).\n74\t        status: s.ingestJobs[0]?.status ?? (s.extractStatus === \"UNANALYZED\" ? \"UNANALYZED\" : \"PENDING\"),\n75\t        confidence: s.ingestJobs[0]?.confidence ?? null,\n76\t        gate: s.ingestJobs[0]?.gate ?? null,\n77\t        error: s.ingestJobs[0]?.error ?? null, // 실패(FAILED) 사유 전문 — UI에서 표시·복사\n78\t        model: s.ingestJobs[0]?.model ?? null, // 분석에 쓰인 모델(실패 진단 참고)\n79\t        phase: s.ingestJobs[0]?.phase ?? null, // L2 비동기 처리 단계(대기 중/분석…) — QUEUED/RUNNING 배지 보조\n80\t        progress: s.ingestJobs[0]?.progress ?? null, // L2 진행률(0~100), null=동기/미사용\n81\t        resultPages: s.ingestJobs[0]?.resultPages ?? null, // A-ⓕ: 이 분석이 만든 콘텐츠 페이지 수(0=새 페이지 없음→링크 숨김, null=구버전)\n82\t        startedAt: s.ingestJobs[0]?.createdAt?.toISOString() ?? null, // 잡 시작(큐 적재) 시각 — ★서버 처리 경과 타이머★(클라 시작시각 없을 때)\n83\t        // 완료까지 걸린 소요(ms) — ★비동기 큐★는 [분석] 응답이 즉시 와 클라 측정이 0:00이 되므로 서버가\n84\t        //   잡의 시작~완료(createdAt~updatedAt)로 계산해 준다. 종결 상태만 의미·처리 중엔 null(라이브 타이머가 흐름).\n85\t        //   클라 durations(동기 측정)가 있으면 그쪽 우선(MaterialsTab 배지). 순수 계산은 lib/jobDuration.ts(테스트 가드).\n86\t        durationMs: terminalJobDurationMs(s.ingestJobs[0] ?? null),\n87\t        byteSize: s.byteSize ?? null, // 원본 파일 용량(업로드 바이트). 전사 소스는 오디오 바이트=원본 용량.\n88\t        // [AI로 분석]/[다시 분석]이 ★자동★(모델 미선택)일 때 서버가 고를 모델 — '처리 중 {모델}' 배지를 정확히.\n89\t        // ★전사 소스(groq-/gemini-)는 byteSize=오디오 바이트라 텍스트 길이 아님 → 크기 휴리스틱 제외 + Groq 분석 기본.\n90\t        recoModel: pickIngestModel({ type: s.type, chars: transcribed ? undefined : (s.byteSize ?? undefined), transcribed }, { disabled, explicitOn, fallback }).model,\n91\t        extractStatus: s.extractStatus ?? null,\n92\t        extractor: s.extractor ?? null,\n93\t        hasExtracted: Boolean(s.normalizedPath),\n94\t        hasText: Boolean(prov.hasText ?? s.normalizedPath), // '원본 그대로' 가능 여부\n95\t        looksOrganized: Boolean(prov.looksOrganized), // 이미 위키 형식 → '원본 그대로' 추천\n96\t        anonymous: s.anonymous, // 동료 표시용 익명 여부\n97\t        // 업로더 표시: 익명+비관리자면 숨김(null→UI '익명 기여자'). 관리자/룸관리자는 익명이어도 실명+아바타.\n98\t        uploader: (() => {\n99\t          const up = s.uploadedBy != null ? userById.get(s.uploadedBy) : null;\n100\t          if (!up || (s.anonymous && !canReveal)) return null; // 동료엔 익명 → null\n101\t          return { name: up.name || up.email, avatar: avatarForUser(up) }; // {name, avatar:{initials,color,imageUrl}}\n102\t        })(),\n103\t      };\n104\t    }),\n105\t    // LibreOffice 변환 사이드카(4j)가 켜진 환경에서만 추가 수락되는 포맷 — UI 안내·accept 확장용\n106\t    convertExts: libreOfficeAvailable() ? CONVERT_ONLY_EXTS : [],\n107\t    // 업로드 정책(기본 공급자 기준 허용 포맷·안내) — 모델 미선택 시 폴백\n108\t    policy: currentUploadPolicy(),\n109\t    // 자료 탭 모델 선택기용: 선택 가능 모델 + ★모델 id별★ 업로드 정책(선택 시 즉시 전환) + 기본 모델\n110\t    models: queryModels,\n111\t    policies: uploadPoliciesForModels(queryModels),\n112\t    defaultModel: modelFor(\"ingest\"),\n113\t    // [AI로 분석]이 자동으로 쓸 모델 + 사유(툴팁). 사용자는 모델을 고르지 않는다.\n114\t    analyzeModel: fallback,\n115\t  });\n116\t}\n117\t\n118\ttype SessionUser = NonNullable<Awaited<ReturnType<typeof getSessionUser>>>;\n119\tinterface StageOpts { scope: string; title: string; anonymous: boolean; diarize: boolean; modelField: string }\n120\t\n121\t// 업로드 버퍼 1건을 ★스테이징★(게이팅→추출→보관, 토큰 0)한다. multipart·raw-body 양쪽이 공유.\n122\t//   ACL 강제지점3·형식/모델 게이팅·용량 cap·추출(docs/17)·원본 보존을 한 곳에 모아 경로 간 불일치를 막는다\n123\t//   (전수 점검 원칙 [[sweep-all-dont-claim-fixed]] — 같은 불변식을 두 진입점에 중복 구현하지 않음).\n124\tasync function stageBuffer(user: SessionUser, buf: Buffer, filename: string, mimeType: string, opts: StageOpts): Promise<NextResponse> {\n125\t  const { scope, anonymous, diarize, modelField } = opts;\n126\t  try {\n127\t    await assertScopeAllowed(user, scope); // ACL 강제지점3\n128\t  } catch {\n129\t    return NextResponse.json({ error: \"접근 권한이 없는 scope입니다.\" }, { status: 403 });\n130\t  }\n131\t  // 사용자가 자료 탭에서 고른 인제스트 모델(검증·폴백) → ★그 모델★ 능력 기준으로 게이팅·인제스트.\n132\t  const picked = await resolveIngestModel(modelField || undefined);\n133\t  const ext = (filename.toLowerCase().match(/\\.([a-z0-9]+)$/)?.[1]) || \"\";\n134\t  const pol = uploadPolicyForModel(picked.model, picked.provider);\n135\t  const isImg = [\"image/png\", \"image/jpeg\", \"image/gif\", \"image/webp\"].includes(mimeType) || [\"png\", \"jpg\", \"jpeg\", \"gif\", \"webp\"].includes(ext);\n136\t  const isPdf = mimeType === \"application/pdf\" || ext === \"pdf\";\n137\t  // 게이팅(서버 강제): ① 형식 자체 미지원이면 400, ② 형식은 지원하나 선택 모델로는 불가면 415.\n138\t  //   음성·영상(STT)은 SUPPORTED_EXTS엔 없고 키 있을 때만 허용 → 1차 게이트에도 포함(uploadPolicy와 동일 조건).\n139\t  const sttExts = sttAvailable() ? [...STT_EXTS, ...(ffmpegAvailable() ? STT_FFMPEG_EXTS : [])] : [];\n140\t  const allExts = [...SUPPORTED_EXTS, ...(libreOfficeAvailable() ? CONVERT_ONLY_EXTS : []), ...sttExts];\n141\t  if (!allExts.includes(ext)) {\n142\t    return NextResponse.json({ error: `지원하지 않는 형식입니다(.${ext || \"?\"}). 지원: ${allExts.join(\", \")}` }, { status: 400 });\n143\t  }\n144\t  if (!pol.exts.includes(ext)) {\n145\t    return NextResponse.json({ error: pol.note }, { status: 415 });\n146\t  }\n147\t  // 음성·영상: ★긴 음성 청크 전사(L1)★로 Groq 25MB 한도를 우회하므로 100MB 허용. 문서는 L3a 스트리밍으로 200MB(§11).\n148\t  const isAudioVideo = mimeType.startsWith(\"audio/\") || mimeType.startsWith(\"video/\") || STT_EXTS.includes(ext) || STT_FFMPEG_EXTS.includes(ext);\n149\t  const capMb = isAudioVideo ? CAP_MB_AUDIO_VIDEO : CAP_MB_DOC;\n150\t  if (buf.byteLength > capMb * 1024 * 1024) {\n151\t    return NextResponse.json({ error: `파일은 ${capMb}MB 이하만 가능합니다.${isAudioVideo ? \" 더 긴 음성·영상은 잘라서 올려주세요.\" : \"\"}` }, { status: 400 });\n152\t  }\n153\t  const wikiScope = scopeWikiPrefix(scope);\n154\t  const title = opts.title.trim() || filename.replace(/\\.[^.]+$/, \"\") || \"자료\";\n155\t  const rawExt = ext || (isPdf ? \"pdf\" : \"bin\");\n156\t  const typeLabel = isPdf ? \"PDF\" : isImg ? \"IMAGE\" : (ext ? ext.toUpperCase() : \"FILE\");\n157\t  const meta = { mimeType: mimeType || undefined, byteSize: buf.byteLength, originalName: filename };\n158\t  try {\n159\t    // ★J 전사 비동기화(ship-dark)★: STT_ASYNC면 음성·영상은 ★업로드 시 전사하지 않고★ raw만 스테이징한다.\n160\t    //   [분석] 단계에서 워커가 raw에서 전사(analyzeSource의 isAudioSrc·!normalizedPath 분기) → 진행률·타이머 일관.\n161\t    //   기본 OFF면 아래 동기 전사(현행) 그대로. (긴 음성 업로드 무진행 대기 해소 — docs PLAN-multi-upload §J)\n162\t    if (sttAsync() && isAudioVideo) {\n163\t      const result = await storeForAnalysis({\n164\t        scope: wikiScope, title, type: typeLabel, text: \"\", userId: user.id, anonymous, rawBytes: buf, rawExt,\n165\t        ...meta, extractor: \"stt-pending\", extractStatus: \"NONE\",\n166\t      });\n167\t      return NextResponse.json({ ...result, extractor: \"stt-pending\", recommended: await recommendIngestModel({ type: typeLabel, transcribed: true }) });\n168\t    }\n169\t    // ★스테이징★ — 추출(토큰0)·원본 보관만. LLM 분석은 사용자가 목록에서 [분석] 버튼을 눌렀을 때.\n170\t    // 1) 추출 시도(텍스트 포맷·텍스트 PDF·오피스) — 성공 시 정규화 텍스트도 보관(분석/원본그대로가 재사용).\n171\t    const ex = await extractAsset(buf, filename, mimeType, { diarize });\n172\t    if (ex.text.trim() && ex.quality !== \"none\") {\n173\t      const result = await storeForAnalysis({\n174\t        scope: wikiScope, title, text: ex.text, type: typeLabel, userId: user.id, anonymous, rawBytes: buf, rawExt,\n175\t        ...meta, extractor: ex.extractor, extractStatus: ex.quality === \"full\" ? \"FULL\" : \"PARTIAL\",\n176\t        normalizedText: ex.text, assets: ex.assets,\n177\t      });\n178\t      return NextResponse.json({ ...result, extractor: ex.extractor, recommended: await recommendIngestModel({ chars: ex.text.length, type: typeLabel, transcribed: isTranscribedExtractor(ex.extractor) }) });\n179\t    }\n180\t    // 2) 텍스트 없음: 이미지·스캔 PDF는 비전 필요 — 비전 없는 모델 선택 시 명확히 안내(업로드 시점 게이팅 유지).\n181\t    if (!pol.vision) {\n182\t      return NextResponse.json({ error: \"이 모델은 텍스트 추출만 가능합니다. 텍스트가 없는 스캔본 PDF·이미지는 Gemini나 Claude 모델을 선택해 올려주세요.\" }, { status: 422 });\n183\t    }\n184\t    // 비전 대상은 원본만 보관(분석 때 raw를 image/document로 첨부). 텍스트가 없어 '원본 그대로'는 불가, [분석]만.\n185\t    if (isImg) {\n186\t      const result = await storeForAnalysis({ scope: wikiScope, title, type: \"IMAGE\", text: \"\", userId: user.id, anonymous, rawBytes: buf, rawExt, ...meta, extractor: \"vision\", extractStatus: \"NONE\" });\n187\t      return NextResponse.json({ ...result, extractor: \"vision\", recommended: await recommendIngestModel({ type: \"IMAGE\" }) });\n188\t    }\n189\t    if (isPdf) {\n190\t      const result = await storeForAnalysis({ scope: wikiScope, title, type: \"PDF\", text: \"\", userId: user.id, anonymous, rawBytes: buf, rawExt: \"pdf\", ...meta, extractor: \"pdf-vision\", extractStatus: \"NONE\" });\n191\t      return NextResponse.json({ ...result, extractor: \"pdf-vision\", recommended: await recommendIngestModel({ type: \"PDF\" }) });\n192\t    }\n193\t    // 3) 추출 불가(인식했으나 본문 없음) → 원본은 보존(미분석, REQ-MAT-010)\n194\t    const result = await storeRawOnly({ scope: wikiScope, title, rawBytes: buf, rawExt, userId: user.id, anonymous, ...meta });\n195\t    return NextResponse.json({ ...result, extractor: \"none\", unanalyzed: true, recommended: await recommendIngestModel({ type: typeLabel }) });\n196\t  } catch (err) {\n197\t    return NextResponse.json({ error: String(err) }, { status: 500 });\n198\t  }\n199\t}\n200\t\n201\t// POST: 텍스트/MD(JSON) 또는 파일(multipart=소형 / octet-stream=대형 스트리밍) 1건 인제스트\n202\texport async function POST(req: Request) {\n203\t  const user = await getSessionUser();\n204\t  if (!user) return NextResponse.json({ error: \"로그인이 필요합니다.\" }, { status: 401 });\n205\t\n206\t  // 업로드는 ★스테이징(추출·보관만, 토큰 0)★ — LLM/비용은 [분석] 버튼 시점에. (예산 체크는 analyze 라우트.)\n207\t  const ct = req.headers.get(\"content-type\") || \"\";\n208\t\n209\t  // 파일 업로드(multipart): 추출 레이어(docs/17)로 정규화 → 인제스트.\n210\t  // 원본 바이트는 raw로 보존(열람용), 텍스트는 파서로 추출(우선), 안 되면 네이티브 모달리티 폴백.\n211\t  if (ct.includes(\"multipart/form-data\")) {\n212\t    // 작은 파일: multipart(formData). 큰 파일은 클라가 raw-body 스트리밍으로 보낸다(아래 octet-stream 분기, §11.2).\n213\t    const form = await req.formData();\n214\t    const scope = String(form.get(\"scope\") || \"\");\n215\t    const file = form.get(\"file\");\n216\t    if (!(file instanceof File)) return NextResponse.json({ error: \"파일이 필요합니다.\" }, { status: 400 });\n217\t    const buf = Buffer.from(await file.arrayBuffer());\n218\t    return stageBuffer(user, buf, file.name, file.type, {\n219\t      scope,\n220\t      title: String(form.get(\"title\") || \"\"),\n221\t      anonymous: String(form.get(\"anonymous\") || \"\") === \"true\", // 익명 업로드(표시만 숨김, uploadedBy는 유지)\n222\t      diarize: String(form.get(\"diarize\") || \"\") === \"true\", // 음성·영상 화자 구분(Gemini 전용·외부학습) — STT에만 영향\n223\t      modelField: String(form.get(\"model\") || \"\"),\n224\t    });\n225\t  }\n226\t\n227\t  // ★대용량 raw-body 스트리밍 업로드(L3a, §11.2)★ — multipart의 RAM 통적재(formData+arrayBuffer 1~2배)를 피해\n228\t  //   본문을 청크 단위로 임시파일에 흘려보내며 sha·크기 계산(피크 메모리=청크). 메타데이터는 쿼리스트링.\n229\t  //   ACL을 ★본문 받기 전★ 확인해 권한 없으면 대용량 전송을 즉시 거부. cap 초과는 스트림 중단→413.\n230\t  if (ct.includes(\"application/octet-stream\")) {\n231\t    if (!req.body) return NextResponse.json({ error: \"본문이 비었습니다.\" }, { status: 400 });\n232\t    const u = new URL(req.url);\n233\t    const scope = u.searchParams.get(\"scope\") || \"\";\n234\t    const filename = u.searchParams.get(\"filename\") || \"upload.bin\";\n235\t    try {\n236\t      await assertScopeAllowed(user, scope); // ACL 강제지점3 — 대용량 본문 받기 전 거부\n237\t    } catch {\n238\t      return NextResponse.json({ error: \"접근 권한이 없는 scope입니다.\" }, { status: 403 });\n239\t    }\n240\t    const ext = (filename.toLowerCase().match(/\\.([a-z0-9]+)$/)?.[1]) || \"\";\n241\t    const isAV = STT_EXTS.includes(ext) || STT_FFMPEG_EXTS.includes(ext);\n242\t    const capBytes = (isAV ? CAP_MB_AUDIO_VIDEO : CAP_MB_DOC) * 1024 * 1024;\n243\t    let streamed;\n244\t    try {\n245\t      streamed = await streamToTempFile(req.body, capBytes, ext);\n246\t    } catch (err) {\n247\t      if (err instanceof UploadTooLargeError) {\n248\t        const mb = Math.round(err.limit / 1024 / 1024);\n249\t        return NextResponse.json({ error: `파일은 ${mb}MB 이하만 가능합니다.${isAV ? \" 더 긴 음성·영상은 잘라서 올려주세요.\" : \"\"}` }, { status: 413 });\n250\t      }\n251\t      return NextResponse.json({ error: String(err) }, { status: 500 });\n252\t    }\n253\t    try {\n254\t      const buf = await readFile(streamed.tempPath); // 추출·저장용 1회 적재(2배 적재 제거). 4Gi limit 내(§11.1).\n255\t      return await stageBuffer(user, buf, filename, u.searchParams.get(\"mime\") || \"\", {\n256\t        scope,\n257\t        title: u.searchParams.get(\"title\") || \"\",\n258\t        anonymous: u.searchParams.get(\"anonymous\") === \"true\",\n259\t        diarize: u.searchParams.get(\"diarize\") === \"true\",\n260\t        modelField: u.searchParams.get(\"model\") || \"\",\n261\t      });\n262\t    } finally {\n263\t      await cleanupTemp(streamed.tempPath);\n264\t    }\n265\t  }\n266\t\n267\t  const { scope, title, text, anonymous: anonRaw } = await req.json();\n268\t  const anonymous = Boolean(anonRaw); // 익명(표시만 숨김)\n269\t  const body = typeof text === \"string\" ? text.trim() : \"\";\n270\t  if (typeof scope !== \"string\" || !body) {\n271\t    return NextResponse.json({ error: \"scope와 본문(text)이 필요합니다.\" }, { status: 400 });\n272\t  }\n273\t\n274\t  // ACL 강제지점3: 인제스트 적용 — 허용 scope에만 쓸 수 있다\n275\t  try {\n276\t    await assertScopeAllowed(user, scope);\n277\t  } catch {\n278\t    return NextResponse.json({ error: \"접근 권한이 없는 scope입니다.\" }, { status: 403 });\n279\t  }\n280\t\n281\t  const wikiScope = scopeWikiPrefix(scope);\n282\t  const cleanTitle = (typeof title === \"string\" && title.trim()) || body.split(\"\\n\")[0].slice(0, 60) || \"제목 없는 자료\";\n283\t\n284\t  try {\n285\t    // 붙여넣은 텍스트도 스테이징(목록에서 [분석]/[원본 그대로] 선택). 토큰 0.\n286\t    const result = await storeForAnalysis({ scope: wikiScope, title: cleanTitle, text: body, type: \"MD\", userId: user.id, anonymous, rawBytes: Buffer.from(body, \"utf8\"), rawExt: \"md\", extractor: \"text\", extractStatus: \"FULL\", normalizedText: body });\n287\t    return NextResponse.json({ ...result, recommended: await recommendIngestModel({ chars: body.length, type: \"MD\" }) });\n288\t  } catch (err) {\n289\t    return NextResponse.json({ error: String(err) }, { status: 500 });\n290\t  }\n291\t}\n292\t"}]},"uuid":"ab3e941e-f9c4-417c-a0b6-ba456f68d674","timestamp":"2026-06-28T11:14:33.358Z","toolUseResult":{"type":"text","file":{"filePath":"E:\\llm-wiki\\app\\api\\materials\\route.ts","content":"import { NextResponse } from \"next/server\";\nimport { getSessionUser } from \"@/lib/auth/session\";\nimport { assertScopeAllowed, canManageScope, scopeWikiPrefix } from \"@/lib/acl/scope\";\nimport { prisma } from \"@/lib/db\";\nimport { storeForAnalysis, storeRawOnly } from \"@/lib/ingest\";\nimport { extractAsset, SUPPORTED_EXTS, STT_EXTS } from \"@/lib/extract\";\nimport { STT_FFMPEG_EXTS, sttAvailable, sttAsync, isTranscribedExtractor } from \"@/lib/stt\";\nimport { CONVERT_ONLY_EXTS, libreOfficeAvailable, ffmpegAvailable } from \"@/lib/convert\";\nimport { currentUploadPolicy, uploadPolicyForModel, uploadPoliciesForModels } from \"@/lib/uploadPolicy\";\nimport { listSelectableModels, resolveIngestModel, ingestModelChoice, recommendIngestModel, pickIngestModel } from \"@/lib/models\";\nimport { disabledModelIds, enabledModelIds } from \"@/lib/modelSettings\";\nimport { modelFor } from \"@/lib/anthropic\";\nimport { avatarForUser } from \"@/lib/avatar\";\nimport { terminalJobDurationMs } from \"@/lib/jobDuration\";\nimport { streamToTempFile, cleanupTemp, UploadTooLargeError } from \"@/lib/upload-stream\";\nimport { readFile } from \"node:fs/promises\";\n\n// 업로드 용량 상한(MB). 음성·영상은 L1 청크 전사로 긴 회의 수용(100), 문서는 L3a 스트리밍으로 상향(200).\n//   ★500MB까지는 L3b 입력 청킹(거대 문서 분석) 후 — docs/PLAN-large-files-and-chunking §11.3.\n//   큰 파일(STREAM_THRESHOLD 초과)은 클라가 raw-body 스트리밍으로 보내 RAM 통적재를 피한다(§11.2).\nconst CAP_MB_AUDIO_VIDEO = 100;\nconst CAP_MB_DOC = 500; // L3a 스트리밍 업로드 + L3b 응축(거대 텍스트 분석 가능) → 500MB. Ingress 512m와 정합.\nconst STREAM_THRESHOLD = 25 * 1024 * 1024; // 이 이상은 raw-body 스트리밍 권장(클라/서버 공통 기준)\n\n// 자료 업로드(텍스트/MD) → 인제스트 → 위키. ACL 강제지점3(인제스트 적용). docs/06·docs/07 §2.\nexport const runtime = \"nodejs\";\nexport const maxDuration = 600; // 무거운 자료를 추론 모델(claude/codex)이 분석할 때 길어질 수 있음(타임아웃 600초와 정렬)\n\n// GET: scope의 최근 자료 목록\nexport async function GET(req: Request) {\n  const user = await getSessionUser();\n  if (!user) return NextResponse.json({ error: \"로그인이 필요합니다.\" }, { status: 401 });\n  const scope = new URL(req.url).searchParams.get(\"scope\") ?? \"\";\n  try {\n    await assertScopeAllowed(user, scope);\n  } catch {\n    return NextResponse.json({ error: \"접근 권한이 없는 scope입니다.\" }, { status: 403 });\n  }\n  const wikiScope = scopeWikiPrefix(scope);\n  // 기본은 활성(archivedAt=null)만. ?archived=1 → 아카이브된 자료(복원/영구삭제 뷰).\n  const showArchived = new URL(req.url).searchParams.get(\"archived\") === \"1\";\n  const sources = await prisma.source.findMany({\n    where: { teamScope: wikiScope, archivedAt: showArchived ? { not: null } : null },\n    orderBy: { id: \"desc\" },\n    take: 30,\n    include: { ingestJobs: { orderBy: { id: \"desc\" }, take: 1 } },\n  });\n  const queryModels = await listSelectableModels(); // ★결제 전 API Claude 숨김★(드롭다운용)\n  const canManage = await canManageScope(user, wikiScope); // 아카이브·영구삭제 권한(룸 관리자)\n  // 소스별 '자동선택 모델'(recoModel)을 동봉 — 셋·기본값을 ★1회만★ 조회하고 동기 코어로 소스마다 계산.\n  const [disabled, explicitOn, fallback] = await Promise.all([disabledModelIds(), enabledModelIds(), ingestModelChoice()]);\n  // 업로더 표시 — id→이름·아바타. ★익명이어도 관리자/룸관리자는 실명 확인★(감사기록 유지), 동료에겐 '익명 기여자'.\n  const uploaderIds = [...new Set(sources.map((s) => s.uploadedBy).filter((x): x is number => x != null))];\n  const uploaders = uploaderIds.length\n    ? await prisma.user.findMany({ where: { id: { in: uploaderIds } }, select: { id: true, name: true, email: true, avatarColor: true, avatarMime: true } })\n    : [];\n  const userById = new Map(uploaders.map((u) => [u.id, u]));\n  const canReveal = canManage || user.role === \"ADMIN\";\n  return NextResponse.json({\n    canManage,\n    sources: sources.map((s) => {\n      let prov: { hasText?: boolean; looksOrganized?: boolean } = {};\n      try { prov = JSON.parse(s.provenance || \"{}\"); } catch { /* */ }\n      const transcribed = isTranscribedExtractor(s.extractor); // 전사 소스 = byteSize 휴리스틱 제외 + Groq 분석 기본\n      return {\n        id: s.id,\n        title: s.title,\n        type: s.type,\n        createdAt: s.createdAt.toISOString(),\n        archived: Boolean(s.archivedAt),\n        rawEvicted: Boolean(s.rawEvictedAt), // L4: 원본 정리됨(원본 열기 비활성·배지) — 지식·추출본은 유지\n\n        // 잡이 있으면 그 상태, 미분석 보존(UNANALYZED)이면 그대로, 그 외 잡 없는 신규 소스 = '분석 대기'(PENDING).\n        status: s.ingestJobs[0]?.status ?? (s.extractStatus === \"UNANALYZED\" ? \"UNANALYZED\" : \"PENDING\"),\n        confidence: s.ingestJobs[0]?.confidence ?? null,\n        gate: s.ingestJobs[0]?.gate ?? null,\n        error: s.ingestJobs[0]?.error ?? null, // 실패(FAILED) 사유 전문 — UI에서 표시·복사\n        model: s.ingestJobs[0]?.model ?? null, // 분석에 쓰인 모델(실패 진단 참고)\n        phase: s.ingestJobs[0]?.phase ?? null, // L2 비동기 처리 단계(대기 중/분석…) — QUEUED/RUNNING 배지 보조\n        progress: s.ingestJobs[0]?.progress ?? null, // L2 진행률(0~100), null=동기/미사용\n        resultPages: s.ingestJobs[0]?.resultPages ?? null, // A-ⓕ: 이 분석이 만든 콘텐츠 페이지 수(0=새 페이지 없음→링크 숨김, null=구버전)\n        startedAt: s.ingestJobs[0]?.createdAt?.toISOString() ?? null, // 잡 시작(큐 적재) 시각 — ★서버 처리 경과 타이머★(클라 시작시각 없을 때)\n        // 완료까지 걸린 소요(ms) — ★비동기 큐★는 [분석] 응답이 즉시 와 클라 측정이 0:00이 되므로 서버가\n        //   잡의 시작~완료(createdAt~updatedAt)로 계산해 준다. 종결 상태만 의미·처리 중엔 null(라이브 타이머가 흐름).\n        //   클라 durations(동기 측정)가 있으면 그쪽 우선(MaterialsTab 배지). 순수 계산은 lib/jobDuration.ts(테스트 가드).\n        durationMs: terminalJobDurationMs(s.ingestJobs[0] ?? null),\n        byteSize: s.byteSize ?? null, // 원본 파일 용량(업로드 바이트). 전사 소스는 오디오 바이트=원본 용량.\n        // [AI로 분석]/[다시 분석]이 ★자동★(모델 미선택)일 때 서버가 고를 모델 — '처리 중 {모델}' 배지를 정확히.\n        // ★전사 소스(groq-/gemini-)는 byteSize=오디오 바이트라 텍스트 길이 아님 → 크기 휴리스틱 제외 + Groq 분석 기본.\n        recoModel: pickIngestModel({ type: s.type, chars: transcribed ? undefined : (s.byteSize ?? undefined), transcribed }, { disabled, explicitOn, fallback }).model,\n        extractStatus: s.extractStatus ?? null,\n        extractor: s.extractor ?? null,\n        hasExtracted: Boolean(s.normalizedPath),\n        hasText: Boolean(prov.hasText ?? s.normalizedPath), // '원본 그대로' 가능 여부\n        looksOrganized: Boolean(prov.looksOrganized), // 이미 위키 형식 → '원본 그대로' 추천\n        anonymous: s.anonymous, // 동료 표시용 익명 여부\n        // 업로더 표시: 익명+비관리자면 숨김(null→UI '익명 기여자'). 관리자/룸관리자는 익명이어도 실명+아바타.\n        uploader: (() => {\n          const up = s.uploadedBy != null ? userById.get(s.uploadedBy) : null;\n          if (!up || (s.anonymous && !canReveal)) return null; // 동료엔 익명 → null\n          return { name: up.name || up.email, avatar: avatarForUser(up) }; // {name, avatar:{initials,color,imageUrl}}\n        })(),\n      };\n    }),\n    // LibreOffice 변환 사이드카(4j)가 켜진 환경에서만 추가 수락되는 포맷 — UI 안내·accept 확장용\n    convertExts: libreOfficeAvailable() ? CONVERT_ONLY_EXTS : [],\n    // 업로드 정책(기본 공급자 기준 허용 포맷·안내) — 모델 미선택 시 폴백\n    policy: currentUploadPolicy(),\n    // 자료 탭 모델 선택기용: 선택 가능 모델 + ★모델 id별★ 업로드 정책(선택 시 즉시 전환) + 기본 모델\n    models: queryModels,\n    policies: uploadPoliciesForModels(queryModels),\n    defaultModel: modelFor(\"ingest\"),\n    // [AI로 분석]이 자동으로 쓸 모델 + 사유(툴팁). 사용자는 모델을 고르지 않는다.\n    analyzeModel: fallback,\n  });\n}\n\ntype SessionUser = NonNullable<Awaited<ReturnType<typeof getSessionUser>>>;\ninterface StageOpts { scope: string; title: string; anonymous: boolean; diarize: boolean; modelField: string }\n\n// 업로드 버퍼 1건을 ★스테이징★(게이팅→추출→보관, 토큰 0)한다. multipart·raw-body 양쪽이 공유.\n//   ACL 강제지점3·형식/모델 게이팅·용량 cap·추출(docs/17)·원본 보존을 한 곳에 모아 경로 간 불일치를 막는다\n//   (전수 점검 원칙 [[sweep-all-dont-claim-fixed]] — 같은 불변식을 두 진입점에 중복 구현하지 않음).\nasync function stageBuffer(user: SessionUser, buf: Buffer, filename: string, mimeType: string, opts: StageOpts): Promise<NextResponse> {\n  const { scope, anonymous, diarize, modelField } = opts;\n  try {\n    await assertScopeAllowed(user, scope); // ACL 강제지점3\n  } catch {\n    return NextResponse.json({ error: \"접근 권한이 없는 scope입니다.\" }, { status: 403 });\n  }\n  // 사용자가 자료 탭에서 고른 인제스트 모델(검증·폴백) → ★그 모델★ 능력 기준으로 게이팅·인제스트.\n  const picked = await resolveIngestModel(modelField || undefined);\n  const ext = (filename.toLowerCase().match(/\\.([a-z0-9]+)$/)?.[1]) || \"\";\n  const pol = uploadPolicyForModel(picked.model, picked.provider);\n  const isImg = [\"image/png\", \"image/jpeg\", \"image/gif\", \"image/webp\"].includes(mimeType) || [\"png\", \"jpg\", \"jpeg\", \"gif\", \"webp\"].includes(ext);\n  const isPdf = mimeType === \"application/pdf\" || ext === \"pdf\";\n  // 게이팅(서버 강제): ① 형식 자체 미지원이면 400, ② 형식은 지원하나 선택 모델로는 불가면 415.\n  //   음성·영상(STT)은 SUPPORTED_EXTS엔 없고 키 있을 때만 허용 → 1차 게이트에도 포함(uploadPolicy와 동일 조건).\n  const sttExts = sttAvailable() ? [...STT_EXTS, ...(ffmpegAvailable() ? STT_FFMPEG_EXTS : [])] : [];\n  const allExts = [...SUPPORTED_EXTS, ...(libreOfficeAvailable() ? CONVERT_ONLY_EXTS : []), ...sttExts];\n  if (!allExts.includes(ext)) {\n    return NextResponse.json({ error: `지원하지 않는 형식입니다(.${ext || \"?\"}). 지원: ${allExts.join(\", \")}` }, { status: 400 });\n  }\n  if (!pol.exts.includes(ext)) {\n    return NextResponse.json({ error: pol.note }, { status: 415 });\n  }\n  // 음성·영상: ★긴 음성 청크 전사(L1)★로 Groq 25MB 한도를 우회하므로 100MB 허용. 문서는 L3a 스트리밍으로 200MB(§11).\n  const isAudioVideo = mimeType.startsWith(\"audio/\") || mimeType.startsWith(\"video/\") || STT_EXTS.includes(ext) || STT_FFMPEG_EXTS.includes(ext);\n  const capMb = isAudioVideo ? CAP_MB_AUDIO_VIDEO : CAP_MB_DOC;\n  if (buf.byteLength > capMb * 1024 * 1024) {\n    return NextResponse.json({ error: `파일은 ${capMb}MB 이하만 가능합니다.${isAudioVideo ? \" 더 긴 음성·영상은 잘라서 올려주세요.\" : \"\"}` }, { status: 400 });\n  }\n  const wikiScope = scopeWikiPrefix(scope);\n  const title = opts.title.trim() || filename.replace(/\\.[^.]+$/, \"\") || \"자료\";\n  const rawExt = ext || (isPdf ? \"pdf\" : \"bin\");\n  const typeLabel = isPdf ? \"PDF\" : isImg ? \"IMAGE\" : (ext ? ext.toUpperCase() : \"FILE\");\n  const meta = { mimeType: mimeType || undefined, byteSize: buf.byteLength, originalName: filename };\n  try {\n    // ★J 전사 비동기화(ship-dark)★: STT_ASYNC면 음성·영상은 ★업로드 시 전사하지 않고★ raw만 스테이징한다.\n    //   [분석] 단계에서 워커가 raw에서 전사(analyzeSource의 isAudioSrc·!normalizedPath 분기) → 진행률·타이머 일관.\n    //   기본 OFF면 아래 동기 전사(현행) 그대로. (긴 음성 업로드 무진행 대기 해소 — docs PLAN-multi-upload §J)\n    if (sttAsync() && isAudioVideo) {\n      const result = await storeForAnalysis({\n        scope: wikiScope, title, type: typeLabel, text: \"\", userId: user.id, anonymous, rawBytes: buf, rawExt,\n        ...meta, extractor: \"stt-pending\", extractStatus: \"NONE\",\n      });\n      return NextResponse.json({ ...result, extractor: \"stt-pending\", recommended: await recommendIngestModel({ type: typeLabel, transcribed: true }) });\n    }\n    // ★스테이징★ — 추출(토큰0)·원본 보관만. LLM 분석은 사용자가 목록에서 [분석] 버튼을 눌렀을 때.\n    // 1) 추출 시도(텍스트 포맷·텍스트 PDF·오피스) — 성공 시 정규화 텍스트도 보관(분석/원본그대로가 재사용).\n    const ex = await extractAsset(buf, filename, mimeType, { diarize });\n    if (ex.text.trim() && ex.quality !== \"none\") {\n      const result = await storeForAnalysis({\n        scope: wikiScope, title, text: ex.text, type: typeLabel, userId: user.id, anonymous, rawBytes: buf, rawExt,\n        ...meta, extractor: ex.extractor, extractStatus: ex.quality === \"full\" ? \"FULL\" : \"PARTIAL\",\n        normalizedText: ex.text, assets: ex.assets,\n      });\n      return NextResponse.json({ ...result, extractor: ex.extractor, recommended: await recommendIngestModel({ chars: ex.text.length, type: typeLabel, transcribed: isTranscribedExtractor(ex.extractor) }) });\n    }\n    // 2) 텍스트 없음: 이미지·스캔 PDF는 비전 필요 — 비전 없는 모델 선택 시 명확히 안내(업로드 시점 게이팅 유지).\n    if (!pol.vision) {\n      return NextResponse.json({ error: \"이 모델은 텍스트 추출만 가능합니다. 텍스트가 없는 스캔본 PDF·이미지는 Gemini나 Claude 모델을 선택해 올려주세요.\" }, { status: 422 });\n    }\n    // 비전 대상은 원본만 보관(분석 때 raw를 image/document로 첨부). 텍스트가 없어 '원본 그대로'는 불가, [분석]만.\n    if (isImg) {\n      const result = await storeForAnalysis({ scope: wikiScope, title, type: \"IMAGE\", text: \"\", userId: user.id, anonymous, rawBytes: buf, rawExt, ...meta, extractor: \"vision\", extractStatus: \"NONE\" });\n      return NextResponse.json({ ...result, extractor: \"vision\", recommended: await recommendIngestModel({ type: \"IMAGE\" }) });\n    }\n    if (isPdf) {\n      const result = await storeForAnalysis({ scope: wikiScope, title, type: \"PDF\", text: \"\", userId: user.id, anonymous, rawBytes: buf, rawExt: \"pdf\", ...meta, extractor: \"pdf-vision\", extractStatus: \"NONE\" });\n      return NextResponse.json({ ...result, extractor: \"pdf-vision\", recommended: await recommendIngestModel({ type: \"PDF\" }) });\n    }\n    // 3) 추출 불가(인식했으나 본문 없음) → 원본은 보존(미분석, REQ-MAT-010)\n    const result = await storeRawOnly({ scope: wikiScope, title, rawBytes: buf, rawExt, userId: user.id, anonymous, ...meta });\n    return NextResponse.json({ ...result, extractor: \"none\", unanalyzed: true, recommended: await recommendIngestModel({ type: typeLabel }) });\n  } catch (err) {\n    return NextResponse.json({ error: String(err) }, { status: 500 });\n  }\n}\n\n// POST: 텍스트/MD(JSON) 또는 파일(multipart=소형 / octet-stream=대형 스트리밍) 1건 인제스트\nexport async function POST(req: Request) {\n  const user = await getSessionUser();\n  if (!user) return NextResponse.json({ error: \"로그인이 필요합니다.\" }, { status: 401 });\n\n  // 업로드는 ★스테이징(추출·보관만, 토큰 0)★ — LLM/비용은 [분석] 버튼 시점에. (예산 체크는 analyze 라우트.)\n  const ct = req.headers.get(\"content-type\") || \"\";\n\n  // 파일 업로드(multipart): 추출 레이어(docs/17)로 정규화 → 인제스트.\n  // 원본 바이트는 raw로 보존(열람용), 텍스트는 파서로 추출(우선), 안 되면 네이티브 모달리티 폴백.\n  if (ct.includes(\"multipart/form-data\")) {\n    // 작은 파일: multipart(formData). 큰 파일은 클라가 raw-body 스트리밍으로 보낸다(아래 octet-stream 분기, §11.2).\n    const form = await req.formData();\n    const scope = String(form.get(\"scope\") || \"\");\n    const file = form.get(\"file\");\n    if (!(file instanceof File)) return NextResponse.json({ error: \"파일이 필요합니다.\" }, { status: 400 });\n    const buf = Buffer.from(await file.arrayBuffer());\n    return stageBuffer(user, buf, file.name, file.type, {\n      scope,\n      title: String(form.get(\"title\") || \"\"),\n      anonymous: String(form.get(\"anonymous\") || \"\") === \"true\", // 익명 업로드(표시만 숨김, uploadedBy는 유지)\n      diarize: String(form.get(\"diarize\") || \"\") === \"true\", // 음성·영상 화자 구분(Gemini 전용·외부학습) — STT에만 영향\n      modelField: String(form.get(\"model\") || \"\"),\n    });\n  }\n\n  // ★대용량 raw-body 스트리밍 업로드(L3a, §11.2)★ — multipart의 RAM 통적재(formData+arrayBuffer 1~2배)를 피해\n  //   본문을 청크 단위로 임시파일에 흘려보내며 sha·크기 계산(피크 메모리=청크). 메타데이터는 쿼리스트링.\n  //   ACL을 ★본문 받기 전★ 확인해 권한 없으면 대용량 전송을 즉시 거부. cap 초과는 스트림 중단→413.\n  if (ct.includes(\"application/octet-stream\")) {\n    if (!req.body) return NextResponse.json({ error: \"본문이 비었습니다.\" }, { status: 400 });\n    const u = new URL(req.url);\n    const scope = u.searchParams.get(\"scope\") || \"\";\n    const filename = u.searchParams.get(\"filename\") || \"upload.bin\";\n    try {\n      await assertScopeAllowed(user, scope); // ACL 강제지점3 — 대용량 본문 받기 전 거부\n    } catch {\n      return NextResponse.json({ error: \"접근 권한이 없는 scope입니다.\" }, { status: 403 });\n    }\n    const ext = (filename.toLowerCase().match(/\\.([a-z0-9]+)$/)?.[1]) || \"\";\n    const isAV = STT_EXTS.includes(ext) || STT_FFMPEG_EXTS.includes(ext);\n    const capBytes = (isAV ? CAP_MB_AUDIO_VIDEO : CAP_MB_DOC) * 1024 * 1024;\n    let streamed;\n    try {\n      streamed = await streamToTempFile(req.body, capBytes, ext);\n    } catch (err) {\n      if (err instanceof UploadTooLargeError) {\n        const mb = Math.round(err.limit / 1024 / 1024);\n        return NextResponse.json({ error: `파일은 ${mb}MB 이하만 가능합니다.${isAV ? \" 더 긴 음성·영상은 잘라서 올려주세요.\" : \"\"}` }, { status: 413 });\n      }\n      return NextResponse.json({ error: String(err) }, { status: 500 });\n    }\n    try {\n      const buf = await readFile(streamed.tempPath); // 추출·저장용 1회 적재(2배 적재 제거). 4Gi limit 내(§11.1).\n      return await stageBuffer(user, buf, filename, u.searchParams.get(\"mime\") || \"\", {\n        scope,\n        title: u.searchParams.get(\"title\") || \"\",\n        anonymous: u.searchParams.get(\"anonymous\") === \"true\",\n        diarize: u.searchParams.get(\"diarize\") === \"true\",\n        modelField: u.searchParams.get(\"model\") || \"\",\n      });\n    } finally {\n      await cleanupTemp(streamed.tempPath);\n    }\n  }\n\n  const { scope, title, text, anonymous: anonRaw } = await req.json();\n  const anonymous = Boolean(anonRaw); // 익명(표시만 숨김)\n  const body = typeof text === \"string\" ? text.trim() : \"\";\n  if (typeof scope !== \"string\" || !body) {\n    return NextResponse.json({ error: \"scope와 본문(text)이 필요합니다.\" }, { status: 400 });\n  }\n\n  // ACL 강제지점3: 인제스트 적용 — 허용 scope에만 쓸 수 있다\n  try {\n    await assertScopeAllowed(user, scope);\n  } catch {\n    return NextResponse.json({ error: \"접근 권한이 없는 scope입니다.\" }, { status: 403 });\n  }\n\n  const wikiScope = scopeWikiPrefix(scope);\n  const cleanTitle = (typeof title === \"string\" && title.trim()) || body.split(\"\\n\")[0].slice(0, 60) || \"제목 없는 자료\";\n\n  try {\n    // 붙여넣은 텍스트도 스테이징(목록에서 [분석]/[원본 그대로] 선택). 토큰 0.\n    const result = await storeForAnalysis({ scope: wikiScope, title: cleanTitle, text: body, type: \"MD\", userId: user.id, anonymous, rawBytes: Buffer.from(body, \"utf8\"), rawExt: \"md\", extractor: \"text\", extractStatus: \"FULL\", normalizedText: body });\n    return NextResponse.json({ ...result, recommended: await recommendIngestModel({ chars: body.length, type: \"MD\" }) });\n  } catch (err) {\n    return NextResponse.json({ error: String(err) }, { status: 500 });\n  }\n}\n","numLines":292,"startLine":1,"totalLines":292}},"sourceToolAssistantUUID":"65fe90b1-a8a7-4861-b91a-bdcc8aaa0813","userType":"external","entrypoint":"cli","cwd":"E:\\llm-wiki","sessionId":"6b03d3cf-704b-46f4-952d-418e6244ad85","version":"2.1.195","gitBranch":"feat/backlog-chunked-and-storage","slug":"serene-singing-papert"}
