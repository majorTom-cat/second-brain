{"parentUuid":"7d166de0-1aa0-4a03-9f62-7acb52dcf90e","isSidechain":false,"promptId":"72c47ca9-455c-407a-8764-3ca32f2b9ca5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013X8Lz4SgYLeNSvMwyZfXUR","type":"tool_result","content":"1\timport { promises as fs } from \"node:fs\";\n2\timport { getSessionUser } from \"@/lib/auth/session\";\n3\timport { allowedScopes, scopeWikiPrefix } from \"@/lib/acl/scope\";\n4\timport { prisma } from \"@/lib/db\";\n5\timport { wikiAbsPath } from \"@/lib/wiki/paths\";\n6\t\n7\t// 원본 자료 열람 — 업로드한 PDF·이미지·md 원본 그대로 반환(미리보기/다운로드). ACL 검사.\n8\texport const runtime = \"nodejs\";\n9\t\n10\tconst CTYPE: Record<string, string> = {\n11\t  pdf: \"application/pdf\",\n12\t  png: \"image/png\",\n13\t  jpg: \"image/jpeg\",\n14\t  jpeg: \"image/jpeg\",\n15\t  gif: \"image/gif\",\n16\t  webp: \"image/webp\",\n17\t  md: \"text/markdown; charset=utf-8\",\n18\t  txt: \"text/plain; charset=utf-8\",\n19\t};\n20\t\n21\texport async function GET(req: Request, { params }: { params: Promise<{ id: string }> }) {\n22\t  const user = await getSessionUser();\n23\t  if (!user) return new Response(\"로그인이 필요합니다.\", { status: 401 });\n24\t  const id = Number((await params).id);\n25\t  if (!Number.isInteger(id) || id <= 0) return new Response(\"잘못된 id입니다.\", { status: 400 });\n26\t\n27\t  const source = await prisma.source.findUnique({ where: { id } });\n28\t  if (!source) return new Response(\"자료를 찾을 수 없습니다.\", { status: 404 });\n29\t\n30\t  // ACL: 접근 가능한 scope의 자료만\n31\t  const allowed = new Set((await allowedScopes(user)).map((s) => scopeWikiPrefix(s.id)));\n32\t  if (!allowed.has(source.teamScope)) return new Response(\"접근 권한이 없습니다.\", { status: 403 });\n33\t\n34\t  // L4 보존정책: 원본이 정리된 자료(rawEvictedAt)는 410 Gone — 지식·정규화본은 유지(추출본/위키로 안내).\n35\t  if (source.rawEvictedAt) return new Response(\"이 자료의 원본은 보존정책에 따라 정리되었습니다(분석본·위키 지식은 유지). 추출본을 보거나 위키 페이지를 참고하세요.\", { status: 410 });\n36\t\n37\t  let bytes: Buffer;\n38\t  try {\n39\t    bytes = await fs.readFile(wikiAbsPath(source.rawPath));\n40\t  } catch {\n41\t    return new Response(\"원본 파일을 찾을 수 없습니다.\", { status: 404 });\n42\t  }\n43\t\n44\t  const ext = (source.rawPath.split(\".\").pop() || \"\").toLowerCase();\n45\t  const ctype = CTYPE[ext] || \"application/octet-stream\";\n46\t  const filename = encodeURIComponent(`${source.title}.${ext}`);\n47\t  return new Response(new Uint8Array(bytes), {\n48\t    headers: {\n49\t      \"content-type\": ctype,\n50\t      \"content-disposition\": `inline; filename*=UTF-8''${filename}`,\n51\t      \"cache-control\": \"private, max-age=60\",\n52\t    },\n53\t  });\n54\t}\n55\t"}]},"uuid":"8f195b6b-d295-4444-87f3-47e3358acccc","timestamp":"2026-06-28T11:27:09.279Z","toolUseResult":{"type":"text","file":{"filePath":"E:\\llm-wiki\\app\\api\\materials\\[id]\\raw\\route.ts","content":"import { promises as fs } from \"node:fs\";\nimport { getSessionUser } from \"@/lib/auth/session\";\nimport { allowedScopes, scopeWikiPrefix } from \"@/lib/acl/scope\";\nimport { prisma } from \"@/lib/db\";\nimport { wikiAbsPath } from \"@/lib/wiki/paths\";\n\n// 원본 자료 열람 — 업로드한 PDF·이미지·md 원본 그대로 반환(미리보기/다운로드). ACL 검사.\nexport const runtime = \"nodejs\";\n\nconst CTYPE: Record<string, string> = {\n  pdf: \"application/pdf\",\n  png: \"image/png\",\n  jpg: \"image/jpeg\",\n  jpeg: \"image/jpeg\",\n  gif: \"image/gif\",\n  webp: \"image/webp\",\n  md: \"text/markdown; charset=utf-8\",\n  txt: \"text/plain; charset=utf-8\",\n};\n\nexport async function GET(req: Request, { params }: { params: Promise<{ id: string }> }) {\n  const user = await getSessionUser();\n  if (!user) return new Response(\"로그인이 필요합니다.\", { status: 401 });\n  const id = Number((await params).id);\n  if (!Number.isInteger(id) || id <= 0) return new Response(\"잘못된 id입니다.\", { status: 400 });\n\n  const source = await prisma.source.findUnique({ where: { id } });\n  if (!source) return new Response(\"자료를 찾을 수 없습니다.\", { status: 404 });\n\n  // ACL: 접근 가능한 scope의 자료만\n  const allowed = new Set((await allowedScopes(user)).map((s) => scopeWikiPrefix(s.id)));\n  if (!allowed.has(source.teamScope)) return new Response(\"접근 권한이 없습니다.\", { status: 403 });\n\n  // L4 보존정책: 원본이 정리된 자료(rawEvictedAt)는 410 Gone — 지식·정규화본은 유지(추출본/위키로 안내).\n  if (source.rawEvictedAt) return new Response(\"이 자료의 원본은 보존정책에 따라 정리되었습니다(분석본·위키 지식은 유지). 추출본을 보거나 위키 페이지를 참고하세요.\", { status: 410 });\n\n  let bytes: Buffer;\n  try {\n    bytes = await fs.readFile(wikiAbsPath(source.rawPath));\n  } catch {\n    return new Response(\"원본 파일을 찾을 수 없습니다.\", { status: 404 });\n  }\n\n  const ext = (source.rawPath.split(\".\").pop() || \"\").toLowerCase();\n  const ctype = CTYPE[ext] || \"application/octet-stream\";\n  const filename = encodeURIComponent(`${source.title}.${ext}`);\n  return new Response(new Uint8Array(bytes), {\n    headers: {\n      \"content-type\": ctype,\n      \"content-disposition\": `inline; filename*=UTF-8''${filename}`,\n      \"cache-control\": \"private, max-age=60\",\n    },\n  });\n}\n","numLines":55,"startLine":1,"totalLines":55}},"sourceToolAssistantUUID":"7d166de0-1aa0-4a03-9f62-7acb52dcf90e","userType":"external","entrypoint":"cli","cwd":"E:\\llm-wiki","sessionId":"6b03d3cf-704b-46f4-952d-418e6244ad85","version":"2.1.195","gitBranch":"feat/backlog-chunked-and-storage","slug":"serene-singing-papert"}
